@page "/data"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IApplicationDatabase Database
@inject AppState State
@inject NavigationManager Navigation
@implements IDisposable

<section class="flex flex-col gap-4">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <div class="panel-eyebrow">Evidence</div>
            <h2 class="panel-title">Evidence worksheet</h2>
            <p class="mt-1 text-sm text-ink-soft">Source and calculated fields are kept visually separate.</p>
        </div>
        <div class="text-right">
            <div class="metric text-metric-sm tabular-nums">@FilteredRows.Count</div>
            <div class="label-instrument mt-1">Engineer rows</div>
        </div>
    </div>

    <div class="flex items-center gap-3">
        <div class="segmented" role="group" aria-label="Worksheet view">
            <button type="button" aria-pressed="@(_tab == Tab.Rows)" @onclick="() => _tab = Tab.Rows">
                Evidence rows <span class="ml-1 tabular-nums">@FilteredRows.Count</span>
            </button>
            <button type="button" aria-pressed="@(_tab == Tab.History)" @onclick="() => _tab = Tab.History">
                Import ledger <span class="ml-1 tabular-nums">@_history.Count</span>
            </button>
        </div>
        <label class="ml-auto flex items-center gap-1.5 text-xs text-ink-soft">
            <input type="checkbox" @bind="_allMonths" @bind:after="ReloadHistoryAsync" />
            All months
        </label>
    </div>

    @if (_tab == Tab.Rows)
    {
        <div class="flex items-center justify-between gap-4">
            <input class="field w-64 px-3 py-1.5 text-sm text-ink outline-none placeholder:text-muted" aria-label="Filter engineer or code" @bind="_filter" @bind:event="oninput" placeholder="Filter engineer or code…" />
            <span class="text-2xs text-muted">Calculated groups are marked separately; source gaps remain em dashes rather than zeros.</span>
        </div>
        @if (FilteredRows.Count == 0)
        {
            <div class="well bg-well-deep p-8 text-center text-sm text-muted">
                @(State.Performance.Count == 0
                    ? $"Nothing imported for {State.SelectedMonth:MMMM yyyy} yet."
                    : $"No engineer matches “{_filter}”.")
            </div>
        }
        else
        {
            <div class="plate overflow-x-auto p-1">
                <QuickGrid Items="@FilteredRows.AsQueryable()" Class="epa-grid">
                    <TemplateColumn Title="Engineer" Sortable="true" SortBy="@_byName"><strong class="whitespace-nowrap font-medium text-ink">@context.EmployeeName</strong></TemplateColumn>
                    <PropertyColumn Title="Code" Property="@(x => x.EmployeeCode)" Sortable="true" />
                    <TemplateColumn Title="Operational" Align="Align.Right" Sortable="true" SortBy="@_byScore"><b class="@($"metric text-sm {Analytics.BandTextClass(Analytics.ScoreBand(context.OperationalScore))}")">@Analytics.Format(context.OperationalScore)</b></TemplateColumn>
                    <TemplateColumn Title="TS score" Align="Align.Right"><span class="tabular-nums">@Num(context.TimesheetCompletionScore)</span></TemplateColumn>
                    <TemplateColumn Title="Approval score" Align="Align.Right"><span class="tabular-nums">@Num(context.ApprovalScore)</span></TemplateColumn>
                    <TemplateColumn Title="Attendance score" Align="Align.Right"><span class="tabular-nums">@Num(context.AttendanceDisciplineScore)</span></TemplateColumn>
                    <TemplateColumn Title="Compliance (h)" Align="Align.Right"><span class="tabular-nums">@Num(context.ComplianceHours)</span></TemplateColumn>
                    <TemplateColumn Title="Entered (h)" Align="Align.Right" Sortable="true" SortBy="@_byEntered"><span class="tabular-nums">@Num(context.EnteredHours)</span></TemplateColumn>
                    <TemplateColumn Title="Approved (h)" Align="Align.Right" Sortable="true" SortBy="@_byApproved"><span class="tabular-nums">@Num(context.ApprovedHours)</span></TemplateColumn>
                    <TemplateColumn Title="Billable (h)" Align="Align.Right" Sortable="true" SortBy="@_byBillable"><span class="tabular-nums">@Num(context.BillableHours)</span></TemplateColumn>
                    <TemplateColumn Title="Non-bill (h)" Align="Align.Right"><span class="tabular-nums">@Num(context.NonBillableHours)</span></TemplateColumn>
                    <TemplateColumn Title="Training (h)" Align="Align.Right"><span class="tabular-nums">@Num(context.TrainingHours)</span></TemplateColumn>
                    <TemplateColumn Title="Office (h)" Align="Align.Right"><span class="tabular-nums">@Num(context.OfficeHours)</span></TemplateColumn>
                    <TemplateColumn Title="Detailed (h)" Align="Align.Right"><span class="tabular-nums">@Num(context.DetailedHours)</span></TemplateColumn>
                    <TemplateColumn Title="Entries" Align="Align.Right" Sortable="true" SortBy="@_byEntries"><span class="tabular-nums">@(context.DetailedEntries == 0 ? "—" : context.DetailedEntries.ToString())</span></TemplateColumn>
                    <TemplateColumn Title="Projects" Align="Align.Right"><span class="tabular-nums">@(context.UniqueProjects == 0 ? "—" : context.UniqueProjects.ToString())</span></TemplateColumn>
                    <TemplateColumn Title="Punch (h)" Align="Align.Right" Sortable="true" SortBy="@_byPunch"><span class="tabular-nums">@Num(context.PunchHours)</span></TemplateColumn>
                    <TemplateColumn Title="Attendance TS (h)" Align="Align.Right"><span class="tabular-nums">@Num(context.AttendanceTimesheetHours)</span></TemplateColumn>
                    <TemplateColumn Title="Variance (h)" Align="Align.Right"><span class="tabular-nums">@Signed(context.ReconciliationVariance)</span></TemplateColumn>
                    <TemplateColumn Title="Attend (d)" Align="Align.Right"><span class="tabular-nums">@Num(context.AttendanceDays)</span></TemplateColumn>
                    <TemplateColumn Title="Leave (d)" Align="Align.Right"><span class="tabular-nums">@Num(context.LeaveDays)</span></TemplateColumn>
                    <TemplateColumn Title="Filled (d)" Align="Align.Right" Sortable="true" SortBy="@_byFilled"><span class="tabular-nums">@context.TimesheetFilledDays / @context.ExpectedTimesheetDays</span></TemplateColumn>
                    <TemplateColumn Title="Missing punch" Align="Align.Right"><span class="tabular-nums">@Count(context.MissingPunchDays)</span></TemplateColumn>
                    <TemplateColumn Title="Late" Align="Align.Right"><span class="tabular-nums">@Count(context.LateDays)</span></TemplateColumn>
                    <TemplateColumn Title="Early" Align="Align.Right"><span class="tabular-nums">@Count(context.EarlyDays)</span></TemplateColumn>
                    <TemplateColumn Title="Less duration" Align="Align.Right"><span class="tabular-nums">@Count(context.LessDurationDays)</span></TemplateColumn>
                    <TemplateColumn Title="Utilization" Align="Align.Right"><span class="tabular-nums">@(context.HasSummaryData ? $"{Analytics.Format(context.Utilization)}%" : "—")</span></TemplateColumn>
                    <TemplateColumn Title="Sources">
                        <span class="flex gap-1">
                            @if (context.ComplianceHours > 0) { <span class="badge bg-surface-inset text-muted" title="Monthly utilization summary">MS</span> }
                            @if (context.DetailedEntries > 0) { <span class="badge bg-surface-inset text-muted" title="Detailed timesheet">DT</span> }
                            @if (context.AttendanceDays > 0 || context.PunchHours > 0) { <span class="badge bg-surface-inset text-muted" title="Attendance and leave">AT</span> }
                        </span>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        }
    }
    else
    {
        <div>
            @if (_history.Count == 0)
            {
                <div class="well bg-well-deep p-8 text-center text-sm text-muted">No uploads recorded@(_allMonths ? "" : $" for {State.SelectedMonth:MMMM yyyy}") yet.</div>
            }
            else
            {
                <div class="plate overflow-x-auto p-1">
                    <QuickGrid Items="@_history.AsQueryable()" Class="epa-grid">
                        <TemplateColumn Title="Uploaded"><span class="whitespace-nowrap tabular-nums">@context.ImportedLocal.ToString("dd MMM yyyy, HH:mm")</span></TemplateColumn>
                        <TemplateColumn Title="Input"><span class="flex items-center gap-1.5"><span class="badge bg-surface-inset text-muted">@Initial(context.ReportType)</span> @Label(context.ReportType)</span></TemplateColumn>
                        <TemplateColumn Title="Reporting month"><span class="tabular-nums">@(new DateTime(context.Year, context.Month, 1).ToString("MMMM yyyy"))</span></TemplateColumn>
                        <TemplateColumn Title="File"><span class="block max-w-xs truncate" title="@context.OriginalFileName">@context.OriginalFileName</span></TemplateColumn>
                        <TemplateColumn Title="Rows" Align="Align.Right"><span class="tabular-nums">@(context.RowCount == 0 ? "—" : context.RowCount.ToString())</span></TemplateColumn>
                        <TemplateColumn Title="Effect">
                            <span class="@(context.ReplacedExisting ? "text-warning" : "text-ink-soft")">
                                @(context.ReportType == ReportType.EngineerReviewWorkbook
                                    ? context.ReplacedExisting ? "Updated review evidence" : "Added review evidence"
                                    : context.ReplacedExisting ? "Replaced earlier file" : "First upload")
                            </span>
                        </TemplateColumn>
                    </QuickGrid>
                </div>
            }
        </div>
    }
</section>

@code {
    private enum Tab { Rows, History }
    private Tab _tab = Tab.Rows;
    private string _filter = string.Empty;
    private bool _allMonths;
    private IReadOnlyList<ImportHistoryItem> _history = [];

    private static readonly GridSort<MonthlyPerformanceItem> _byName = GridSort<MonthlyPerformanceItem>.ByAscending(x => x.EmployeeName);
    private static readonly GridSort<MonthlyPerformanceItem> _byScore = GridSort<MonthlyPerformanceItem>.ByDescending(x => x.OperationalScore);
    private static readonly GridSort<MonthlyPerformanceItem> _byFilled = GridSort<MonthlyPerformanceItem>.ByDescending(x => x.TimesheetFilledDays);
    private static readonly GridSort<MonthlyPerformanceItem> _byEntered = GridSort<MonthlyPerformanceItem>.ByDescending(x => x.EnteredHours);
    private static readonly GridSort<MonthlyPerformanceItem> _byApproved = GridSort<MonthlyPerformanceItem>.ByDescending(x => x.ApprovedHours);
    private static readonly GridSort<MonthlyPerformanceItem> _byBillable = GridSort<MonthlyPerformanceItem>.ByDescending(x => x.BillableHours);
    private static readonly GridSort<MonthlyPerformanceItem> _byPunch = GridSort<MonthlyPerformanceItem>.ByDescending(x => x.PunchHours);
    private static readonly GridSort<MonthlyPerformanceItem> _byEntries = GridSort<MonthlyPerformanceItem>.ByDescending(x => x.DetailedEntries);

    private IReadOnlyList<MonthlyPerformanceItem> FilteredRows => string.IsNullOrWhiteSpace(_filter)
        ? State.Performance
        : State.Performance.Where(x => x.EmployeeName.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
            (x.EmployeeCode?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false)).ToArray();

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        await ReloadHistoryAsync();
    }

    private void OnStateChanged() => InvokeAsync(async () => { await ReloadHistoryAsync(); StateHasChanged(); });
    private async Task ReloadHistoryAsync()
    {
        var history = _allMonths
            ? await Database.GetImportHistoryAsync()
            : await Database.GetImportHistoryAsync(State.SelectedMonth.Year, State.SelectedMonth.Month);
        _history = history.Where(x => AppState.IsFiscalMonth(new DateTime(x.Year, x.Month, 1))).ToArray();
    }
    public void Dispose() => State.Changed -= OnStateChanged;

    private static string Num(decimal value) => value <= 0 ? "—" : Analytics.Format(value);
    private static string Signed(decimal value) => value == 0 ? "—" : value > 0 ? $"+{Analytics.Format(value)}" : Analytics.Format(value);
    private static string Count(int value) => value == 0 ? "—" : value.ToString();
    private static string Initial(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "MS", ReportType.DetailedTimesheetTransactions => "DT", ReportType.AttendanceLeaveUaaTimesheet => "AT", _ => "ER" };
    private static string Label(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "Monthly utilization summary", ReportType.DetailedTimesheetTransactions => "Detailed timesheet", ReportType.AttendanceLeaveUaaTimesheet => "Attendance and leave", _ => "Engineer reviews" };
}
