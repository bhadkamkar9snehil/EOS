@page "/employee/{Name}"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IJSRuntime JS
@inject AppState State
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="flex flex-col gap-6">
    @if (Months.Count == 0)
    {
        <div class="plate flex flex-col items-start gap-3 p-8">
            <div>
                <div class="panel-eyebrow">Portrait</div>
                <h2 class="panel-title">No history for @Name</h2>
            </div>
            <p class="text-sm text-ink-soft">No imported rows were found for this person across the months currently loaded.</p>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/overview")'>Back to team performance</button>
        </div>
    }
    else
    {
        <header class="plate flex flex-wrap items-center gap-5 p-4">
            <button type="button" class="control px-2.5 py-1.5 text-sm font-medium text-ink-soft hover:control-hover active:control-pressed" @onclick='() => Navigation.NavigateTo("/overview")'>← Team performance</button>
            <div class="relative">
                <button type="button" class="group flex items-center gap-2.5 rounded-md px-2 py-1 transition-colors duration-150 ease-press hover:bg-surface-inset" aria-haspopup="listbox" aria-expanded="@_personPickerOpen" @onclick="TogglePersonPicker">
                    <span class="well flex h-10 w-10 items-center justify-center !rounded-full font-display text-sm font-semibold text-ink-soft">@Analytics.Initials(Name)</span>
                    <span class="flex flex-col text-left"><strong class="font-display text-sm font-semibold text-ink">@Name</strong><small class="label-instrument">@EmployeeIdentity</small></span>
                    <span class="text-muted transition-opacity duration-150 group-hover:opacity-100 md:opacity-60" aria-hidden="true">⌄</span>
                </button>
                @if (_personPickerOpen)
                {
                    <div class="floating absolute left-0 top-14 z-20 max-h-96 w-72 overflow-y-auto p-2" role="listbox" aria-label="Select team member">
                        <span class="panel-eyebrow block px-2 py-1">Select team member</span>
                        <div class="flex flex-col">
                            @foreach (var personName in SelectableNames)
                            {
                                <button type="button" class="@($"flex items-center gap-2 rounded-md px-2 py-1.5 text-left transition-colors duration-150 ease-press hover:bg-surface-inset {(PersonName.Matches(personName, Name) ? "bg-primary-soft" : "")}")" role="option" aria-selected="@PersonName.Matches(personName, Name)" @onclick="() => SelectPerson(personName)">
                                    <span class="well flex h-7 w-7 shrink-0 items-center justify-center !rounded-full font-display text-3xs font-semibold text-ink-soft">@Analytics.Initials(personName)</span>
                                    <span class="flex flex-col"><b class="text-sm font-medium text-ink">@personName</b><small class="text-3xs tabular-nums text-muted">@EmployeeIdentityFor(personName)</small></span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="flex flex-col">
                <span class="@($"metric text-metric-lg {Analytics.BandTextClass(Analytics.ScoreBand(Latest.OperationalScore))}")">@Analytics.Format(Latest.OperationalScore, "0")</span>
                <span class="metric-delta mt-1 text-ink-soft">@ScoreMovement</span>
                <span class="label-instrument mt-0.5">Operational score · <span class="tabular-nums">@LatestLabel</span></span>
            </div>
            <div class="ml-auto flex flex-wrap gap-5">
                <span class="flex flex-col"><b class="metric text-metric-sm">@Analytics.Format(Latest.Workload(), "0.0")</b><small class="label-instrument mt-1">Hours / day</small></span>
                <span class="flex flex-col"><b class="metric text-metric-sm">@Analytics.Format(Latest.Utilization, "0")%</b><small class="label-instrument mt-1">Utilization</small></span>
                <span class="flex flex-col"><b class="metric text-metric-sm">@ExceptionTotal</b><small class="label-instrument mt-1">Exception days</small></span>
                <span class="flex flex-col"><b class="metric text-metric-sm">@Months.Count</b><small class="label-instrument mt-1">Loaded months</small></span>
            </div>
        </header>

        <section class="grid grid-cols-1 gap-4 xl:grid-cols-[1.4fr_1fr]">
            <div class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Composition</div>
                        <h2 class="panel-title">Operational score decomposition</h2>
                    </div>
                    <span class="label-instrument ml-auto">Peer ratings scored separately</span>
                </div>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                    @PortraitMetric("Timesheet completion", Latest.HasSummaryData ? Latest.TimesheetCompletionScore : null)
                    @PortraitMetric("Approval completion", Latest.HasSummaryData ? Latest.ApprovalScore : null)
                    @PortraitMetric("Attendance discipline", Latest.AttendanceDisciplineScore)
                    @PortraitMetric("Utilization", Latest.HasSummaryData ? Latest.Utilization : null)
                    @PortraitMetric("Workload balance", WorkloadIndex(Latest))
                    @PortraitMetric("Reconciliation quality", ReconciliationIndex(Latest))
                </div>
                <div class="well mt-4 grid grid-cols-2 gap-3 p-3 sm:grid-cols-3">
                    @SourceFact("Expected days", Analytics.Format(Latest.ExpectedTimesheetDays, "0.#"))
                    @SourceFact("Filled days", Analytics.Format(Latest.TimesheetFilledDays, "0.#"))
                    @SourceFact("Entered hours", Analytics.Format(Latest.EnteredHours, "0.0"))
                    @SourceFact("Approved hours", Analytics.Format(Latest.ApprovedHours, "0.0"))
                    @SourceFact("Punch variance", Signed(Latest.ReconciliationVariance) + " h")
                    @SourceFact("Projects", Latest.UniqueProjects.ToString())
                </div>
            </div>
            <div class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Rhythm</div>
                        <h2 class="panel-title">Weekly operating rhythm</h2>
                    </div>
                    <span class="label-instrument ml-auto">Hours · coverage · discipline</span>
                </div>
                <div class="well p-2">
                    <div id="portrait-weekly" class="h-[260px]"></div>
                </div>
            </div>
        </section>

        <section class="grid grid-cols-1 gap-4 xl:grid-cols-[1.4fr_1fr]">
            <div class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">History</div>
                        <h2 class="panel-title">Six-month performance history</h2>
                    </div>
                    <span class="label-instrument ml-auto">Score and its three weighted inputs</span>
                </div>
                <div class="well p-2">
                    <div id="portrait-history" class="h-[260px]"></div>
                </div>
            </div>
            <aside class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Evidence</div>
                        <h2 class="panel-title">Intervention evidence</h2>
                    </div>
                    <span class="label-instrument ml-auto tabular-nums">@LatestLabel</span>
                </div>
                <ul class="flex flex-col divide-y divide-line-soft">
                    @if (Alerts.Count == 0)
                    {
                        <li class="py-1.5"><strong class="text-sm font-semibold text-ink">No active alert rule</strong><small class="block text-2xs text-muted">No anomaly rule fired for the current month.</small></li>
                    }
                    else
                    {
                        @foreach (var alert in Alerts.Take(6)) { <li class="py-1.5"><strong class="@($"text-sm font-semibold {Level(alert.Level)}")">@alert.Headline</strong><small class="block text-2xs text-muted">@alert.Detail</small></li> }
                    }
                    @if (Latest.MissingPunchDays > 0) { <li class="py-1.5"><strong class="text-sm font-semibold text-ink">Missing punch · <span class="tabular-nums">@Latest.MissingPunchDays</span> day(s)</strong><small class="block text-2xs text-muted">Attendance evidence is incomplete on those days.</small></li> }
                    @if (Latest.LateDays > 0) { <li class="py-1.5"><strong class="text-sm font-semibold text-ink">Late arrival · <span class="tabular-nums">@Latest.LateDays</span> day(s)</strong><small class="block text-2xs text-muted">Punctuality contributed to attendance discipline.</small></li> }
                    @if (Latest.EarlyDays > 0) { <li class="py-1.5"><strong class="text-sm font-semibold text-ink">Early departure · <span class="tabular-nums">@Latest.EarlyDays</span> day(s)</strong><small class="block text-2xs text-muted">Early departures contributed to attendance discipline.</small></li> }
                    @if (Latest.LessDurationDays > 0) { <li class="py-1.5"><strong class="text-sm font-semibold text-ink">Short duration · <span class="tabular-nums">@Latest.LessDurationDays</span> day(s)</strong><small class="block text-2xs text-muted">Office duration fell below the configured threshold.</small></li> }
                </ul>
            </aside>
        </section>

        <section class="grid grid-cols-1 gap-4 xl:grid-cols-[1.4fr_1fr]">
            <div class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Peers</div>
                        <h2 class="panel-title">Peer evidence</h2>
                    </div>
                    <div class="ml-auto flex flex-col items-end">
                        <b class="metric text-metric-sm">@(Peer.ReceivedCount == 0 ? "—" : Analytics.Format(Peer.AverageReceived, "0.00"))</b>
                        <span class="label-instrument mt-1">Raw average</span>
                        <small class="mt-0.5 text-3xs tabular-nums text-muted">@Peer.ReceivedCount received · @Peer.GivenCount given · @PeerSignalStatus · reliable floor @ReliablePeerRating</small>
                    </div>
                </div>
                @if (Peer.ReceivedCount == 0)
                {
                    <p class="text-sm text-muted">No peer ratings were received for this employee in @LatestLabel.</p>
                }
                else
                {
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-[280px_1fr]">
                        <div class="well p-2">
                            <div id="portrait-peer-radar" class="h-[260px]" aria-label="Employee peer aspect profile"></div>
                        </div>
                        <div class="flex flex-col gap-2">
                            @PeerAspect("Collaboration", Peer.Collaboration, TeamPeerAverage(x => x.Collaboration))
                            @PeerAspect("Communication", Peer.Communication, TeamPeerAverage(x => x.Communication))
                            @PeerAspect("Reliability", Peer.Reliability, TeamPeerAverage(x => x.Reliability))
                            @PeerAspect("Technical help", Peer.TechnicalHelp, TeamPeerAverage(x => x.TechnicalHelp))
                        </div>
                    </div>
                    <div class="mt-4 overflow-x-auto">
                        <div class="label-instrument grid min-w-[520px] grid-cols-[1fr_3rem_3rem_3rem_3rem_3rem] gap-2 border-b border-line pb-1"><span>Reviewer</span><span>Collab</span><span>Comms</span><span>Reliable</span><span>Tech</span><span>Overall</span></div>
                        @foreach (var review in Peer.Received.OrderByDescending(x => x.Average).ThenBy(x => x.ReviewerName))
                        {
                            <div class="group grid min-w-[520px] grid-cols-[1fr_3rem_3rem_3rem_3rem_3rem] items-center gap-2 border-b border-line-soft py-1.5 text-xs transition-colors duration-100 ease-press hover:bg-surface-inset">
                                <span class="flex flex-col"><strong class="font-medium text-ink">@review.ReviewerName</strong>@if (!string.IsNullOrWhiteSpace(review.Comment)) { <small class="text-3xs text-muted">@review.Comment</small> }</span>
                                <b class="tabular-nums text-ink-soft">@Analytics.Format(review.Collaboration, "0.0")</b><b class="tabular-nums text-ink-soft">@Analytics.Format(review.Communication, "0.0")</b><b class="tabular-nums text-ink-soft">@Analytics.Format(review.Reliability, "0.0")</b><b class="tabular-nums text-ink-soft">@Analytics.Format(review.TechnicalHelp, "0.0")</b><strong class="tabular-nums font-semibold text-ink">@Analytics.Format(review.Average, "0.00")</strong>
                            </div>
                        }
                    </div>
                }
            </div>

            <aside class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Ledger</div>
                        <h2 class="panel-title">Work and evidence ledger</h2>
                    </div>
                    <span class="label-instrument ml-auto">Most recent month first</span>
                </div>
                <div class="flex flex-col gap-2.5">
                    @PortraitHours("Billable", Latest.BillableHours, Latest.EnteredHours)
                    @PortraitHours("Detailed", Latest.DetailedHours, Latest.EnteredHours)
                    @PortraitHours("Non-billable", Latest.NonBillableHours, Latest.EnteredHours)
                    @PortraitHours("Training", Latest.TrainingHours, Latest.EnteredHours)
                </div>
                <div class="well mt-3 flex justify-between p-2.5">
                    <span class="flex flex-col"><b class="metric text-sm">@Latest.DetailedEntries</b><small class="label-instrument mt-1">Detailed entries</small></span>
                    <span class="flex flex-col"><b class="metric text-sm">@Latest.UniqueProjects</b><small class="label-instrument mt-1">Projects</small></span>
                    <span class="flex flex-col"><b class="metric text-sm">@Analytics.Format(Latest.BillableHours, "0.0")</b><small class="label-instrument mt-1">Billable h</small></span>
                </div>
                <ul class="mt-3 flex max-h-64 flex-col divide-y divide-line-soft overflow-y-auto">
                    @foreach (var month in Months.OrderByDescending(x => x.Year).ThenByDescending(x => x.Month))
                    {
                        <li class="group py-1.5">
                            <strong class="flex items-center gap-2 text-sm font-semibold tabular-nums text-ink">@(new DateTime(month.Year, month.Month, 1).ToString("MMM yyyy")) <span class="@($"metric text-sm {Analytics.BandTextClass(Analytics.ScoreBand(month.OperationalScore))}")">@Analytics.Format(month.OperationalScore)</span></strong>
                            <small class="block text-2xs tabular-nums text-muted">@Analytics.Format(month.Workload(), "0.0") h/day · @Analytics.Format(month.BillableHours, "0.0") billable h · @month.TimesheetFilledDays/@month.ExpectedTimesheetDays days filled</small>
                        </li>
                    }
                </ul>
            </aside>
        </section>
    }
</div>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    private bool _rendered;
    private bool _personPickerOpen;

    protected override void OnInitialized() => State.Changed += OnStateChanged;
    protected override void OnParametersSet() { State.SpotlightName = Name; _rendered = false; _personPickerOpen = false; }
    private void OnStateChanged() { _rendered = false; InvokeAsync(StateHasChanged); }

    private IReadOnlyList<MonthlyPerformanceItem> Months => State.History.Where(x => PersonName.Matches(x.EmployeeName, Name)).GroupBy(x => (x.Year, x.Month)).Select(g => g.First()).OrderBy(x => x.Year).ThenBy(x => x.Month).ToArray();
    private MonthlyPerformanceItem Latest => Months[^1];
    private string LatestLabel => new DateTime(Latest.Year, Latest.Month, 1).ToString("MMMM yyyy");
    private EmployeeListItem? Employee => State.Employees.FirstOrDefault(x => PersonName.Matches(x.Name, Name));
    private IReadOnlyList<string> SelectableNames => State.History.Select(x => x.EmployeeName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToArray();
    private Analytics.PeerBreakdown Peer => Analytics.PeerBreakdownFor(State.PeerReviews, Name);
    private Analytics.PeerStanding? Standing => Analytics.Peers(State.PeerReviews).Standings.FirstOrDefault(x => PersonName.Matches(x.Name, Name));
    private string ReliablePeerRating => Standing is null ? "—" : Analytics.Format(Standing.ConfidenceLowerBound, "0.00");
    private string PeerSignalStatus => Standing is null ? "no signal" : Standing.IsEstablished ? "established" : "provisional";
    private string EmployeeIdentity => Employee is null ? "No employee master record" : $"{Employee.EmployeeCode} · Level {Employee.SeniorityLevel}{(string.IsNullOrWhiteSpace(Employee.TeamName) ? "" : $" · {Employee.TeamName}")}";
    private string EmployeeIdentityFor(string personName)
    {
        var employee = State.Employees.FirstOrDefault(x => PersonName.Matches(x.Name, personName));
        return employee is null ? "No employee master record" : $"{employee.EmployeeCode} · Level {employee.SeniorityLevel}{(string.IsNullOrWhiteSpace(employee.TeamName) ? "" : $" · {employee.TeamName}")}";
    }
    private void TogglePersonPicker() => _personPickerOpen = !_personPickerOpen;
    private void SelectPerson(string personName)
    {
        _personPickerOpen = false;
        if (!PersonName.Matches(personName, Name)) Navigation.NavigateTo($"/employee/{Uri.EscapeDataString(personName)}");
    }
    private IReadOnlyList<WeeklyPerformanceItem> WeeklyRows => State.WeeklyPerformance.Where(x => x.ExpectedDays > 0 && PersonName.Matches(x.EmployeeName, Name)).OrderBy(x => x.WeekStart).ToArray();
    private int ExceptionTotal => Latest.MissingPunchDays + Latest.LateDays + Latest.EarlyDays + Latest.LessDurationDays;

    private IReadOnlyList<Anomaly> Alerts
    {
        get
        {
            var previous = State.History.Where(x => x.Year == State.SelectedMonth.AddMonths(-1).Year && x.Month == State.SelectedMonth.AddMonths(-1).Month).GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase).ToDictionary(x => x.Key, x => x.First().OperationalScore, StringComparer.OrdinalIgnoreCase);
            return Analytics.Anomalies(State.Performance, previous).Where(x => PersonName.Matches(x.EmployeeName, Name)).ToArray();
        }
    }

    private decimal? PreviousScore => Months.Count < 2 ? null : Months[^2].OperationalScore;
    private string ScoreMovement => PreviousScore is null ? "no prior month" : Latest.OperationalScore > PreviousScore ? $"up {Analytics.Format(Latest.OperationalScore - PreviousScore.Value)}" : Latest.OperationalScore < PreviousScore ? $"down {Analytics.Format(PreviousScore.Value - Latest.OperationalScore)}" : "unchanged";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_rendered || Months.Count == 0) return;
        _rendered = true;
        var labels = Months.Select(m => new DateTime(m.Year, m.Month, 1).ToString("MMM yy")).ToArray();
        await JS.InvokeVoidAsync("epaEchartsLoader.ensureLoaded");
        await JS.InvokeVoidAsync("epaAtlas.portraitHistory", "portrait-history", labels, new object[]
        {
            new { name = "Operational score", role = "operational", values = Months.Select(m => (object)m.OperationalScore).ToArray() },
            new { name = "Timesheet", role = "timesheet", values = Months.Select(m => m.HasSummaryData ? (object)m.TimesheetCompletionScore : null).ToArray() },
            new { name = "Attendance", role = "attendance", values = Months.Select(m => (object)m.AttendanceDisciplineScore).ToArray() },
            new { name = "Approval", role = "approval", values = Months.Select(m => m.HasSummaryData ? (object)m.ApprovalScore : null).ToArray() }
        });

        await JS.InvokeVoidAsync("epaAtlas.portraitWeekly", "portrait-weekly", WeeklyRows.Select(x => x.WeekStart.ToString("dd MMM")).ToArray(), WeeklyRows.Select(x => new { punch = x.PunchHours, timesheet = x.TimesheetHours, fill = x.TimesheetFillRate, attendance = x.AttendanceDisciplineScore }).ToArray());

        var team = new[] { TeamPeerAverage(x => x.Collaboration), TeamPeerAverage(x => x.Communication), TeamPeerAverage(x => x.Reliability), TeamPeerAverage(x => x.TechnicalHelp) };
        var individual = Peer.Received.Select(x => new { name = x.ReviewerName, values = new[] { x.Collaboration, x.Communication, x.Reliability, x.TechnicalHelp } }).ToArray();
        await JS.InvokeVoidAsync("epaAtlas.portraitPeerRadar", "portrait-peer-radar", new[] { "Collaboration", "Communication", "Reliability", "Technical help" }, individual, new[] { Peer.Collaboration, Peer.Communication, Peer.Reliability, Peer.TechnicalHelp }, team);
    }

    private decimal TeamPeerAverage(Func<PeerReviewItem, decimal> selector) { var values = State.PeerReviews.Select(selector).Where(x => x > 0).ToArray(); return values.Length == 0 ? 0 : decimal.Round(values.Average(), 2); }
    private static decimal WorkloadIndex(MonthlyPerformanceItem item) => Analytics.WorkloadCeiling <= 0 ? 0 : Math.Clamp(item.Workload() * 100m / Analytics.WorkloadCeiling, 0, 100);
    private static decimal ReconciliationIndex(MonthlyPerformanceItem item) => Math.Clamp(100m - Math.Abs(item.ReconciliationVariance) * 2m, 0, 100);
    private static string CssPct(decimal value) => Math.Clamp(value, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    private static string Signed(decimal value) => value > 0 ? $"+{Analytics.Format(value)}" : Analytics.Format(value);
    private static string Level(AlertLevel level) => level switch { AlertLevel.Critical => "text-critical", AlertLevel.Serious => "text-serious", _ => "text-warning" };

    private RenderFragment PortraitMetric(string label, decimal? value) =>
        @<div class="group">
            <label class="flex items-center justify-between text-xs"><span class="text-ink-soft">@label</span><b class="metric text-sm">@(value is null ? "—" : Analytics.Format(value.Value, "0") + "%")</b></label>
            <span class="track mt-1.5 block h-1.5"><i class="block h-full rounded-full bg-petrol" style="@($"width:{CssPct(value ?? 0)}")"></i></span>
        </div>;
    private RenderFragment PortraitHours(string label, decimal value, decimal total) =>
        @<div class="group">
            <label class="flex items-center justify-between text-xs"><span class="text-ink-soft">@label</span><b class="metric text-sm">@Analytics.Format(value, "0.0") h</b></label>
            <span class="track mt-1.5 block h-1.5"><i class="block h-full rounded-full bg-chart-1" style="@($"width:{CssPct(total <= 0 ? 0 : value * 100m / total)}")"></i></span>
        </div>;
    private RenderFragment SourceFact(string label, string value) => @<span class="flex flex-col"><b class="metric text-sm">@value</b><small class="label-instrument mt-1">@label</small></span>;
    private RenderFragment PeerAspect(string label, decimal value, decimal team) =>
        @<div class="group">
            <span class="flex items-baseline justify-between"><strong class="text-xs font-medium text-ink-soft">@label</strong><small class="text-3xs tabular-nums text-muted">@Analytics.Format(value, "0.00") employee · @Analytics.Format(team, "0.00") team</small></span>
            <span class="track relative mt-1.5 block h-1.5">
                <i class="absolute inset-y-0 left-0 rounded-full bg-chart-2" style="@($"width:{CssPct(value * 20m)}")"></i>
                <i class="absolute top-1/2 h-2.5 w-0.5 -translate-y-1/2 bg-ink-soft opacity-70 transition-opacity duration-150 group-hover:opacity-100" title="Team average" style="@($"left:{CssPct(team * 20m)}")"></i>
            </span>
        </div>;

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        if (State.SpotlightName == Name) State.SpotlightName = null;
        foreach (var id in new[] { "portrait-history", "portrait-weekly", "portrait-peer-radar" }) { try { await JS.InvokeVoidAsync("epaAtlas.dispose", id); } catch (JSDisconnectedException) { } }
    }
}
