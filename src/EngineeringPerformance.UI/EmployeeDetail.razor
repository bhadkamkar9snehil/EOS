@page "/employee/{Name}"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IJSRuntime JS
@inject AppState State
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="portrait-page">
    @if (Months.Count == 0)
    {
        <div class="empty-state">
            <h2>No history for @Name</h2>
            <p>No imported rows were found for this person across the months currently loaded.</p>
            <button class="action" @onclick='() => Navigation.NavigateTo("/overview")'>Back to team performance</button>
        </div>
    }
    else
    {
        <section class="portrait-hero">
            <div class="portrait-identity">
                <button class="portrait-back" @onclick='() => Navigation.NavigateTo("/overview")'>← Team performance</button>
                <div class="portrait-person">
                    <span class="avatar big">@Analytics.Initials(Name)</span>
                    <div>
                        <h2>@Name</h2>
                        <small>@EmployeeIdentity</small>
                    </div>
                </div>
                <div class="portrait-score">
                    <strong class="@Analytics.ScoreBand(Latest.OperationalScore)">@Analytics.Format(Latest.OperationalScore, "0")</strong>
                    <span>Operational score<br />@LatestLabel</span>
                </div>
                <div class="pulse-score-meta">
                    <span>@ScoreMovement</span>
                    <span>@Months.Count month(s) loaded</span>
                </div>
            </div>

            <div class="portrait-fingerprint">
                <h3>Operational fingerprint</h3>
                <div class="portrait-metrics">
                    @PortraitMetric("Timesheet completion", Latest.HasSummaryData ? Latest.TimesheetCompletionScore : null)
                    @PortraitMetric("Approval", Latest.HasSummaryData ? Latest.ApprovalScore : null)
                    @PortraitMetric("Attendance discipline", Latest.AttendanceDisciplineScore)
                    @PortraitMetric("Utilization", Latest.HasSummaryData ? Latest.Utilization : null)
                    @PortraitMetric("Workload balance", WorkloadIndex(Latest))
                    @PortraitMetric("Reconciliation", ReconciliationIndex(Latest))
                </div>
            </div>

            <div class="portrait-rhythm">
                <h3>Attendance rhythm</h3>
                <div class="portrait-rhythm-bars" aria-label="Weekly attendance discipline">
                    @if (WeeklyRhythm.Count == 0)
                    {
                        <span class="chart-note">No dated weekly attendance rows for this period.</span>
                    }
                    else
                    {
                        @foreach (var value in WeeklyRhythm)
                        {
                            <i style="--v:@CssPct(value)" title="@Analytics.Format(value, "0")% attendance discipline"></i>
                        }
                    }
                </div>
                <div class="pulse-score-meta"><span>@ExceptionTotal exception day(s)</span><span>@Signed(Latest.ReconciliationVariance) h variance</span></div>
            </div>
        </section>

        <section class="portrait-main">
            <div class="portrait-history">
                <div class="atlas-panel-head">
                    <div><h2>Performance history</h2><small>Score and its operating inputs across loaded months</small></div>
                </div>
                <div id="portrait-history"></div>
            </div>

            <aside class="portrait-evidence">
                <div class="atlas-panel-head"><div><h2>Intervention evidence</h2><small>@LatestLabel</small></div></div>
                <ul class="portrait-evidence-list">
                    @if (Alerts.Count == 0)
                    {
                        <li><strong>No active alert rule</strong><small>No anomaly rule fired for the current month.</small></li>
                    }
                    else
                    {
                        @foreach (var alert in Alerts.Take(6))
                        {
                            <li><strong class="@Level(alert.Level)">@alert.Headline</strong><small>@alert.Detail</small></li>
                        }
                    }
                    @if (Latest.MissingPunchDays > 0) { <li><strong>Missing punch · @Latest.MissingPunchDays day(s)</strong><small>Attendance evidence is incomplete on those days.</small></li> }
                    @if (Latest.LateDays > 0) { <li><strong>Late arrival · @Latest.LateDays day(s)</strong><small>Punctuality contributed to attendance discipline.</small></li> }
                    @if (Latest.LessDurationDays > 0) { <li><strong>Short duration · @Latest.LessDurationDays day(s)</strong><small>Recorded office duration fell below the configured threshold.</small></li> }
                </ul>
            </aside>
        </section>

        <section class="portrait-lower">
            <section>
                <div class="atlas-panel-head"><div><h2>Work mix</h2><small>@LatestLabel</small></div></div>
                <div class="portrait-metrics">
                    @PortraitHours("Billable", Latest.BillableHours, Latest.EnteredHours)
                    @PortraitHours("Non-billable", Latest.NonBillableHours, Latest.EnteredHours)
                    @PortraitHours("Training", Latest.TrainingHours, Latest.EnteredHours)
                    @PortraitHours("Detailed", Latest.DetailedHours, Latest.EnteredHours)
                </div>
                <div class="pulse-score-meta"><span>@Latest.UniqueProjects project(s)</span><span>@Latest.DetailedEntries detailed entries</span></div>
            </section>

            <section>
                <div class="atlas-panel-head"><div><h2>Peer signal</h2><small>@LatestLabel</small></div></div>
                @if (Peer.ReceivedCount == 0 && Peer.GivenCount == 0)
                {
                    <p class="chart-note">No peer review evidence is loaded for this employee in the selected month.</p>
                }
                else
                {
                    <div class="portrait-score"><strong>@(Peer.ReceivedCount == 0 ? "—" : Analytics.Format(Peer.AverageReceived, "0.00"))</strong><span>Average received<br />@Peer.ReceivedCount reviews</span></div>
                    <div class="portrait-metrics">
                        @PortraitMetric("Collaboration", ScalePeer(Peer.Collaboration))
                        @PortraitMetric("Communication", ScalePeer(Peer.Communication))
                        @PortraitMetric("Reliability", ScalePeer(Peer.Reliability))
                        @PortraitMetric("Technical help", ScalePeer(Peer.TechnicalHelp))
                    </div>
                }
            </section>

            <section>
                <div class="atlas-panel-head"><div><h2>Monthly ledger</h2><small>Most recent first</small></div></div>
                <ul class="portrait-evidence-list">
                    @foreach (var month in Months.OrderByDescending(x => x.Year).ThenByDescending(x => x.Month).Take(6))
                    {
                        <li>
                            <strong>@(new DateTime(month.Year, month.Month, 1).ToString("MMM yyyy")) · <span class="@Analytics.ScoreBand(month.OperationalScore)">@Analytics.Format(month.OperationalScore)</span></strong>
                            <small>@Analytics.Format(month.Workload(), "0.0") h/day · @Analytics.Format(month.BillableHours, "0.0") billable h · @month.TimesheetFilledDays/@month.ExpectedTimesheetDays filled</small>
                        </li>
                    }
                </ul>
            </section>
        </section>
    }
</div>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    private bool _rendered;

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    protected override void OnParametersSet()
    {
        State.SpotlightName = Name;
        _rendered = false;
    }

    private void OnStateChanged()
    {
        _rendered = false;
        InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<MonthlyPerformanceItem> Months => State.History
        .Where(x => PersonName.Matches(x.EmployeeName, Name))
        .GroupBy(x => (x.Year, x.Month)).Select(g => g.First())
        .OrderBy(x => x.Year).ThenBy(x => x.Month).ToArray();

    private MonthlyPerformanceItem Latest => Months.OrderByDescending(x => x.Year).ThenByDescending(x => x.Month).First();
    private string LatestLabel => new DateTime(Latest.Year, Latest.Month, 1).ToString("MMMM yyyy");
    private EmployeeListItem? Employee => State.Employees.FirstOrDefault(x => PersonName.Matches(x.Name, Name));
    private Analytics.PeerBreakdown Peer => Analytics.PeerBreakdownFor(State.PeerReviews, Name);
    private string EmployeeIdentity => Employee is null
        ? "No employee master record"
        : $"{Employee.EmployeeCode} · Level {Employee.SeniorityLevel}{(string.IsNullOrWhiteSpace(Employee.TeamName) ? "" : $" · {Employee.TeamName}")}";

    private IReadOnlyList<Anomaly> Alerts
    {
        get
        {
            var previous = State.History
                .Where(x => x.Year == State.SelectedMonth.AddMonths(-1).Year && x.Month == State.SelectedMonth.AddMonths(-1).Month)
                .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(x => x.Key, x => x.First().OperationalScore, StringComparer.OrdinalIgnoreCase);
            return Analytics.Anomalies(State.Performance, previous).Where(x => PersonName.Matches(x.EmployeeName, Name)).ToArray();
        }
    }

    private decimal? PreviousScore
    {
        get
        {
            if (Months.Count < 2) return null;
            return Months[^2].OperationalScore;
        }
    }

    private string ScoreMovement => PreviousScore is null ? "No prior month" : Latest.OperationalScore > PreviousScore ? $"↑ {Analytics.Format(Latest.OperationalScore - PreviousScore.Value)} vs prior" : Latest.OperationalScore < PreviousScore ? $"↓ {Analytics.Format(PreviousScore.Value - Latest.OperationalScore)} vs prior" : "No change vs prior";

    private IReadOnlyList<decimal> WeeklyRhythm => State.WeeklyPerformance
        .Where(x => x.ExpectedDays > 0 && PersonName.Matches(x.EmployeeName, Name))
        .OrderBy(x => x.WeekStart)
        .Select(x => x.AttendanceDisciplineScore)
        .ToArray();

    private int ExceptionTotal => Latest.MissingPunchDays + Latest.LateDays + Latest.EarlyDays + Latest.LessDurationDays;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_rendered || Months.Count == 0) return;
        _rendered = true;
        var labels = Months.Select(m => new DateTime(m.Year, m.Month, 1).ToString("MMM yy")).ToArray();
        await JS.InvokeVoidAsync("epaAtlas.portraitHistory", "portrait-history", labels, new object[]
        {
            new { name = "Operational score", role = "operational", values = Months.Select(m => (object)m.OperationalScore).ToArray() },
            new { name = "Timesheet", role = "timesheet", values = Months.Select(m => m.HasSummaryData ? (object)m.TimesheetCompletionScore : null).ToArray() },
            new { name = "Attendance", role = "attendance", values = Months.Select(m => (object)m.AttendanceDisciplineScore).ToArray() },
            new { name = "Approval", role = "approval", values = Months.Select(m => m.HasSummaryData ? (object)m.ApprovalScore : null).ToArray() }
        });
    }

    private static decimal WorkloadIndex(MonthlyPerformanceItem item) => Analytics.WorkloadCeiling <= 0 ? 0 : Math.Clamp(item.Workload() * 100m / Analytics.WorkloadCeiling, 0, 100);
    private static decimal ReconciliationIndex(MonthlyPerformanceItem item) => Math.Clamp(100m - Math.Abs(item.ReconciliationVariance) * 2m, 0, 100);
    private static decimal? ScalePeer(decimal value) => value <= 0 ? null : Math.Clamp(value * 20m, 0, 100);
    private static string CssPct(decimal value) => Math.Clamp(value, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    private static string Signed(decimal value) => value > 0 ? $"+{Analytics.Format(value)}" : Analytics.Format(value);
    private static string Level(AlertLevel level) => level switch { AlertLevel.Critical => "critical", AlertLevel.Serious => "serious", _ => "warning" };

    private RenderFragment PortraitMetric(string label, decimal? value) => @<div class="portrait-metric">
        <label><span>@label</span><b>@(value is null ? "—" : Analytics.Format(value.Value, "0") + "%")</b></label>
        <span class="portrait-metric-track"><i style="--v:@CssPct(value ?? 0)"></i></span>
    </div>;

    private RenderFragment PortraitHours(string label, decimal value, decimal total) => @<div class="portrait-metric">
        <label><span>@label</span><b>@Analytics.Format(value, "0.0") h</b></label>
        <span class="portrait-metric-track"><i style="--v:@CssPct(total <= 0 ? 0 : value * 100m / total)"></i></span>
    </div>;

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        if (State.SpotlightName == Name) State.SpotlightName = null;
        try { await JS.InvokeVoidAsync("epaAtlas.dispose", "portrait-history"); } catch (JSDisconnectedException) { }
    }
}
