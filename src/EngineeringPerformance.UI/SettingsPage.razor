@page "/settings"
@inject AppState State
@inject NavigationManager Navigation

<section class="flex flex-col gap-6">
    <div>
        <h2 class="text-xl font-bold text-ink">Settings</h2>
        <p class="mt-1 text-sm text-ink-soft">EOS uses one fixed Performance Atlas interface — there is no theme picker.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <section class="card">
            <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-surface-inset text-base text-ink-soft">◫</span>
                <div><h3 class="text-sm font-bold text-ink">Local application</h3><p class="text-xs text-ink-soft">All performance data and imported files remain on this computer.</p></div>
            </div>
            <dl class="mt-3 flex flex-col divide-y divide-line">
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="text-ink-soft">Database</dt><dd class="text-right text-ink">%LOCALAPPDATA%\EngineeringPerformance</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="text-ink-soft">Imported files</dt><dd class="text-right text-ink">%LOCALAPPDATA%\EngineeringPerformance\Imports</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="text-ink-soft">Storage mode</dt><dd class="text-right text-ink">SQLite with WAL</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="text-ink-soft">Calculation</dt><dd class="text-right text-ink">Immediate, in process</dd></div>
            </dl>
        </section>

        <section class="card">
            <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-surface-inset text-base text-ink-soft">▤</span>
                <div><h3 class="text-sm font-bold text-ink">Diagnostics</h3><p class="text-xs text-ink-soft">App version, database location, and a log tail for troubleshooting.</p></div>
            </div>
            <button type="button" class="btn btn-secondary mt-3" @onclick='() => Navigation.NavigateTo("/diagnostics")'>Open Diagnostics</button>
        </section>
    </div>
</section>
