@page "/settings"
@inject AppState State
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject EngineeringPerformance.Application.IUpdateService Updates
@implements IDisposable

<section class="flex flex-col gap-6">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <section class="plate p-4 lg:col-span-2">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Appearance</div>
                    <h2 class="panel-title">Theme</h2>
                </div>
                <span class="label-instrument ml-auto">Charts and tables follow the theme</span>
            </div>

            @* Each tile carries data-theme, so the swatches below render that theme's REAL tokens
               rather than a hand-copied preview palette that could drift from it. *@
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 xl:grid-cols-6" role="radiogroup" aria-label="Theme">
                @ThemeTile("system", "System", "Follows Windows")
                @ThemeTile("light", "Light", "Warm Atlas cream")
                @ThemeTile("slate", "Slate", "Cool neutral light")
                @ThemeTile("dark", "Dark", "Graphite")
                @ThemeTile("midnight", "Midnight", "True black / OLED")
                @ThemeTile("contrast", "Contrast", "High contrast, WCAG AAA")
            </div>
        </section>

        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Release</div>
                    <h2 class="panel-title">Updates</h2>
                </div>
                <span class="ml-auto flex items-center gap-1.5">
                    <i class="@UpdateLampClass" aria-hidden="true"></i>
                    <span class="label-instrument">@UpdateStateLabel</span>
                </span>
            </div>
            <dl class="flex flex-col divide-y divide-line-soft">
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Installed</dt><dd class="tabular-nums text-ink">@Updates.Status.CurrentVersion</dd></div>
                @if (Updates.Status.AvailableVersion is { } available)
                {
                    <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Available</dt><dd class="tabular-nums text-ink">@available</dd></div>
                }
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Last checked</dt><dd class="tabular-nums text-ink">@(Updates.Status.LastSuccessfulCheckAt?.ToString("dd MMM · HH:mm") ?? "—")</dd></div>
                @if (Updates.Status.Phase == EngineeringPerformance.Application.UpdatePhase.Downloading)
                {
                    <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Download</dt><dd class="tabular-nums text-ink">@(Updates.Status.DownloadProgress ?? 0)%</dd></div>
                }
            </dl>
            <div class="mt-4 flex flex-wrap gap-2">
                @if (Updates.Status.Phase is EngineeringPerformance.Application.UpdatePhase.Idle or EngineeringPerformance.Application.UpdatePhase.Current or EngineeringPerformance.Application.UpdatePhase.Failed)
                {
                    <button type="button" class="btn btn-secondary" @onclick="CheckForUpdatesAsync">@(Updates.Status.Phase == EngineeringPerformance.Application.UpdatePhase.Failed ? "Retry" : "Check")</button>
                }
                else if (Updates.Status.Phase == EngineeringPerformance.Application.UpdatePhase.Available)
                {
                    <button type="button" class="btn btn-primary" @onclick="DownloadUpdateAsync">Download v@(Updates.Status.AvailableVersion)</button>
                }
                else if (Updates.Status.Phase == EngineeringPerformance.Application.UpdatePhase.ReadyToRestart)
                {
                    <button type="button" class="btn btn-primary" @onclick="Updates.RestartAndApply">Restart · v@(Updates.Status.AvailableVersion)</button>
                }
                else if (Updates.Status.Phase == EngineeringPerformance.Application.UpdatePhase.Checking)
                {
                    <button type="button" class="btn btn-secondary" disabled>Checking</button>
                }
                else if (Updates.Status.Phase == EngineeringPerformance.Application.UpdatePhase.Downloading)
                {
                    <button type="button" class="btn btn-primary" disabled>Downloading · @(Updates.Status.DownloadProgress ?? 0)%</button>
                }
            </div>
        </section>

        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Storage</div>
                    <h2 class="panel-title">Local application</h2>
                </div>
                <span class="ml-auto flex items-center gap-1.5">
                    <i class="lamp h-2 w-2 text-good" aria-hidden="true"></i>
                    <span class="label-instrument">On this computer only</span>
                </span>
            </div>
            <dl class="flex flex-col divide-y divide-line-soft">
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Database</dt><dd class="text-right font-mono text-2xs text-ink">%LOCALAPPDATA%\EOS\Data</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Imported files</dt><dd class="text-right font-mono text-2xs text-ink">%LOCALAPPDATA%\EOS\Data\Imports</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Storage mode</dt><dd class="text-right text-ink">SQLite with WAL</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Calculation</dt><dd class="text-right text-ink">Immediate, in process</dd></div>
            </dl>
        </section>

        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Support</div>
                    <h2 class="panel-title">Diagnostics</h2>
                </div>
            </div>
            <button type="button" class="btn btn-secondary mt-3" @onclick='() => Navigation.NavigateTo("/diagnostics")'>Open Diagnostics</button>
        </section>
    </div>
</section>

@code {
    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        Updates.Changed += OnUpdateChanged;
    }
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    private void OnUpdateChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Updates.Changed -= OnUpdateChanged;
    }

    private Task CheckForUpdatesAsync() => Updates.CheckNowAsync();
    private Task DownloadUpdateAsync() => Updates.DownloadAsync();

    private string UpdateLampClass => $"h-2 w-2 {Updates.Status.Phase switch
    {
        EngineeringPerformance.Application.UpdatePhase.Current or EngineeringPerformance.Application.UpdatePhase.ReadyToRestart => "lamp text-good",
        EngineeringPerformance.Application.UpdatePhase.Checking or EngineeringPerformance.Application.UpdatePhase.Downloading or EngineeringPerformance.Application.UpdatePhase.Available => "lamp text-warning",
        EngineeringPerformance.Application.UpdatePhase.Failed => "lamp text-critical",
        _ => "lamp-off"
    }}";

    private string UpdateStateLabel => Updates.Status.Phase switch
    {
        EngineeringPerformance.Application.UpdatePhase.Unsupported => "Development build",
        EngineeringPerformance.Application.UpdatePhase.Idle => "Not checked",
        EngineeringPerformance.Application.UpdatePhase.Checking => "Checking",
        EngineeringPerformance.Application.UpdatePhase.Current => "Current",
        EngineeringPerformance.Application.UpdatePhase.Available => "Available",
        EngineeringPerformance.Application.UpdatePhase.Downloading => "Downloading",
        EngineeringPerformance.Application.UpdatePhase.ReadyToRestart => "Ready",
        _ => Updates.Status.FailureCode ?? "Failed"
    };

    // "system" has no palette of its own, so its swatch previews whichever concrete theme the OS
    // currently resolves to — otherwise it would be the one tile showing nothing.
    private string PreviewTheme(string mode) => mode == "system" ? State.ResolvedTheme : mode;

    private RenderFragment ThemeTile(string mode, string label, string description) =>
        @<button type="button" role="radio" aria-checked="@(State.ThemeMode == mode ? "true" : "false")"
                 aria-label="@label theme — @description" title="@description"
                 class="@($"control flex flex-col gap-2 p-2 text-left hover:control-hover active:control-pressed {(State.ThemeMode == mode ? "!border-primary ring-2 ring-primary/40" : string.Empty)}")"
                 @onclick="() => State.SetThemeAsync(JS, mode)">
            <span data-theme="@PreviewTheme(mode)" class="flex h-9 overflow-hidden rounded-sm border border-line bg-canvas" aria-hidden="true">
                <span class="w-1/4 bg-chassis"></span>
                <span class="w-1/4 bg-surface"></span>
                <span class="w-1/4 bg-well"></span>
                <span class="w-1/4 bg-primary"></span>
            </span>
            <span class="flex min-w-0 flex-col">
                <strong class="truncate text-xs font-semibold text-ink">@label</strong>
                <small class="truncate text-3xs text-muted">@description</small>
            </span>
        </button>;
}
