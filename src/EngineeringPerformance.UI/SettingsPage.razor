@page "/settings"
@inject IJSRuntime JS
@inject AppState State

<section class="single-pane wide settings-page">
    <div class="section-title settings-title">
        <div>
            <h2>Appearance</h2>
            <p>EOS now uses one fixed product colour system with two physical renderings. Minimal is the precision editorial Atlas. Realist is the fully tactile skeuomorphic instrument console.</p>
        </div>
        <span class="current-theme-label">Interface <strong>@Title(_skin)</strong></span>
    </div>

    <div class="skin-choices" role="radiogroup" aria-label="Interface style">
        <button type="button" class="skin-choice @(_skin == "minimal" ? "selected" : null)" aria-pressed="@(_skin == "minimal")" @onclick='() => ApplySkinAsync("minimal")'>
            <span class="skin-choice-preview minimal" aria-hidden="true"></span>
            <strong>Minimal</strong>
            <small>The current Performance Atlas: flat editorial plates, calibrated rules, restrained depth and the same EOS orange / petrol / graphite semantics.</small>
        </button>
        <button type="button" class="skin-choice @(_skin == "realist" ? "selected" : null)" aria-pressed="@(_skin == "realist")" @onclick='() => ApplySkinAsync("realist")'>
            <span class="skin-choice-preview realist" aria-hidden="true"></span>
            <strong>Realist</strong>
            <small>Full skeuomorphism: forged chassis, ivory instrument plates, screws, bevels, recessed controls, indicator lamps and physically tactile buttons.</small>
        </button>
    </div>

    <div class="appearance-controls" aria-label="Appearance behaviour">
        <section class="appearance-control">
            <span>Colour system</span>
            <div class="appearance-fixed-value"><b>EOS Instrument</b><small>Graphite · first-light orange · petrol blue · intervention red</small></div>
            <small>One palette is shared by Minimal and Realist so meaning never changes with rendering style.</small>
        </section>

        <section class="appearance-control">
            <span>Chart vibrancy</span>
            <div class="segmented">
                @foreach (var value in new[] { "restrained", "balanced", "vivid" })
                {
                    <button type="button" class="@(_intensity == value ? "selected" : null)" @onclick="() => ApplyIntensityAsync(value)">@Title(value)</button>
                }
            </div>
            <small>Only categorical chart chroma and selection emphasis change.</small>
        </section>

        <section class="appearance-control">
            <span>Interface density</span>
            <div class="segmented">
                @foreach (var value in new[] { "comfortable", "compact" })
                {
                    <button type="button" class="@(_density == value ? "selected" : null)" @onclick="() => ApplyDensityAsync(value)">@Title(value)</button>
                }
            </div>
            <small>Comfortable is the normal production setting.</small>
        </section>

        <section class="appearance-control">
            <span>Motion</span>
            <div class="segmented">
                @foreach (var value in new[] { "system", "reduced", "full" })
                {
                    <button type="button" class="@(_motion == value ? "selected" : null)" @onclick="() => ApplyMotionAsync(value)">@Title(value)</button>
                }
            </div>
            <small>System honours Windows reduced-motion preference.</small>
        </section>
    </div>

    <div class="settings-section-grid">
        <section class="settings-card">
            <div class="settings-card-head">
                <span class="settings-card-icon">◫</span>
                <div><h3>Local application</h3><p>All performance data and imported files remain on this computer.</p></div>
            </div>
            <dl class="settings-list compact-list">
                <div><dt>Database</dt><dd>%LOCALAPPDATA%\EngineeringPerformance</dd></div>
                <div><dt>Imported files</dt><dd>%LOCALAPPDATA%\EngineeringPerformance\Imports</dd></div>
                <div><dt>Storage mode</dt><dd>SQLite with WAL</dd></div>
                <div><dt>Calculation</dt><dd>Immediate, in process</dd></div>
            </dl>
        </section>

        <section class="settings-card">
            <div class="settings-card-head">
                <span class="settings-card-icon">◎</span>
                <div><h3>Rendering contract</h3><p>Minimal and Realist share the same data hierarchy, semantic palette, chart roles, accessibility rules and interaction state.</p></div>
            </div>
            <div class="settings-facts">
                <div><span>Product palette</span><strong>EOS Instrument · fixed</strong></div>
                <div><span>Interface renderings</span><strong>Minimal · Realist</strong></div>
                <div><span>Semantic status palette</span><strong>Stable across both looks</strong></div>
                <div><span>Generated categorical palette</span><strong>OKLCH · 8 series</strong></div>
                <div><span>Focus contrast target</span><strong>3:1 minimum</strong></div>
                <div><span>Operational text floor</span><strong>10.5 px</strong></div>
                <div><span>Data or scoring impact</span><strong>None</strong></div>
            </div>
        </section>
    </div>
</section>

@code {
    private string _skin = "minimal";
    private string _intensity = "balanced";
    private string _density = "comfortable";
    private string _motion = "system";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _skin = await JS.InvokeAsync<string>("epaSkin.get");
        _intensity = await JS.InvokeAsync<string>("epaTheme.intensity.get");
        _density = await JS.InvokeAsync<string>("epaTheme.density.get");
        _motion = await JS.InvokeAsync<string>("epaTheme.motion.get");
        StateHasChanged();
    }

    private async Task ApplySkinAsync(string value)
    {
        _skin = await JS.InvokeAsync<string>("epaSkin.apply", value);
        State.ShowMessage($"Interface style set to {Title(_skin)}.");
    }

    private async Task ApplyIntensityAsync(string value)
    {
        _intensity = await JS.InvokeAsync<string>("epaTheme.intensity.apply", value);
        State.ShowMessage($"Chart vibrancy set to {Title(value)}.");
    }

    private async Task ApplyDensityAsync(string value)
    {
        _density = await JS.InvokeAsync<string>("epaTheme.density.apply", value);
        State.ShowMessage($"Interface density set to {Title(value)}.");
    }

    private async Task ApplyMotionAsync(string value)
    {
        _motion = await JS.InvokeAsync<string>("epaTheme.motion.apply", value);
        State.ShowMessage($"Motion preference set to {Title(value)}.");
    }

    private static string Title(string value) => value switch
    {
        "full" => "Full",
        _ => char.ToUpperInvariant(value[0]) + value[1..]
    };
}
