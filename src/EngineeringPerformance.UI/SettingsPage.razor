@page "/settings"
@inject AppState State
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<section class="flex flex-col gap-6">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Appearance</div>
                    <h2 class="panel-title">Theme</h2>
                </div>
                <span class="label-instrument ml-auto">"System" follows Windows</span>
            </div>
            <div class="segmented" role="radiogroup" aria-label="Theme">
                @ThemeOption("light", "Light")
                @ThemeOption("dark", "Dark")
                @ThemeOption("system", "System")
            </div>
        </section>

        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Storage</div>
                    <h2 class="panel-title">Local application</h2>
                </div>
                <span class="ml-auto flex items-center gap-1.5">
                    <i class="lamp h-2 w-2 text-good" aria-hidden="true"></i>
                    <span class="label-instrument">On this computer only</span>
                </span>
            </div>
            <dl class="flex flex-col divide-y divide-line-soft">
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Database</dt><dd class="text-right font-mono text-2xs text-ink">%LOCALAPPDATA%\EOS\Data</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Imported files</dt><dd class="text-right font-mono text-2xs text-ink">%LOCALAPPDATA%\EOS\Data\Imports</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Storage mode</dt><dd class="text-right text-ink">SQLite with WAL</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument">Calculation</dt><dd class="text-right text-ink">Immediate, in process</dd></div>
            </dl>
        </section>

        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Support</div>
                    <h2 class="panel-title">Diagnostics</h2>
                </div>
            </div>
            <p class="text-xs text-ink-soft">App version, database location, and a log tail for troubleshooting.</p>
            <button type="button" class="btn btn-secondary mt-3" @onclick='() => Navigation.NavigateTo("/diagnostics")'>Open Diagnostics</button>
        </section>
    </div>
</section>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;

    private RenderFragment ThemeOption(string mode, string label) =>
        @* .segmented styles the selected child off aria-checked, so no conditional class string is needed. *@
        @<button type="button" role="radio" aria-checked="@(State.ThemeMode == mode ? "true" : "false")" aria-label="@label theme"
                 class="@($"cursor-pointer hover:text-ink {(State.ThemeMode == mode ? "is-active" : string.Empty)}")"
                 @onclick="() => State.SetThemeAsync(JS, mode)">
            @label
        </button>;
}
