@page "/discipline"
@using System.Globalization
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject AppState State
@inject IApplicationDatabase Database
@inject NavigationManager Navigation
@implements IDisposable

<div class="discipline-page">
    @if (Snapshot is null)
    {
        <div class="empty-state discipline-loading">
            <h2>Building obligation evidence</h2>
            <p>Reading accountable workdays and the latest system-generated filing timestamps.</p>
        </div>
    }
    else if (Snapshot.Obligations.Count == 0)
    {
        <header class="discipline-heading">
            <div>
                <span class="atlas-section-label">Execution discipline</span>
                <h2>What is happening with compliance right now?</h2>
                <p>Directives become person-specific obligations. System evidence determines whether each obligation was completed and whether it was on time.</p>
            </div>
        </header>
        <div class="empty-state discipline-empty">
            <h2>No daily obligations for @State.SelectedMonth.ToString("MMMM yyyy")</h2>
            <p>@(Snapshot.Notice ?? "The selected month has no accountable workdays.")</p>
            <button class="action" @onclick='() => Navigation.NavigateTo("/imports")'>Open data imports</button>
        </div>
    }
    else
    {
        <header class="discipline-heading">
            <div>
                <span class="atlas-section-label">Execution discipline</span>
                <h2>What is happening with compliance right now?</h2>
                <p>Day-level obligations from system evidence. Participation and punctuality remain separate; completed-late obligations never become on-time.</p>
            </div>
            <button type="button" class="discipline-config-trigger" @onclick="ToggleConfiguration">@(_showConfiguration ? "Close configuration" : "Configure directive")</button>
        </header>

        @if (!string.IsNullOrWhiteSpace(Snapshot.Notice))
        {
            <div class="discipline-notice"><strong>Evidence note</strong><span>@Snapshot.Notice</span></div>
        }

        @if (_showConfiguration)
        {
            <section class="directive-config" aria-label="Timesheet filing directive configuration">
                <div>
                    <span class="atlas-section-label">Timesheet filing directive</span>
                    <strong>Next working day deadline</strong>
                    <small>Changes recalculate every visible obligation from the source timestamps; source data is not modified.</small>
                </div>
                <label>Cutoff hour<input type="number" min="0" max="23" @bind="_dueHour" /></label>
                <label>Minute<input type="number" min="0" max="59" @bind="_dueMinute" /></label>
                <label>Grace (minutes)<input type="number" min="0" max="1440" @bind="_graceMinutes" /></label>
                <label>Required hours<input type="number" min="0.5" max="24" step="0.5" @bind="_requiredHours" /></label>
                <label class="directive-check"><input type="checkbox" @bind="_saturdayWorking" /><span>Saturday is a working day</span></label>
                <button type="button" class="action" disabled="@State.Busy" @onclick="SaveConfigurationAsync">Save &amp; recalculate</button>
            </section>
        }

        <section class="discipline-overview" aria-label="Obligation outcomes">
            <div class="discipline-kpis">
                <div><span>Expected</span><strong>@Snapshot.Expected</strong><small>person × workday obligations</small></div>
                <div><span>Participation</span><strong>@Snapshot.Participation.ToString("0.0")%</strong><small>@Snapshot.Completed completed</small></div>
                <div><span>On-time compliance</span><strong>@Snapshot.OnTimeCompliance.ToString("0.0")%</strong><small>@Snapshot.OnTime of @Snapshot.Expected expected</small></div>
                <div><span>Punctuality</span><strong>@Snapshot.Punctuality.ToString("0.0")%</strong><small>on time among completed</small></div>
            </div>

            <div class="population-panel">
                <div class="population-title">
                    <div><span class="atlas-section-label">Population outcome</span><strong>@State.SelectedMonth.ToString("MMM yyyy")</strong></div>
                    <small>Every segment is an obligation, not an employee score.</small>
                </div>
                <div class="population-bar" role="img" aria-label="@PopulationAria">
                    @if (Snapshot.OnTime > 0) { <button class="on-time" style="width:@Percent(Snapshot.OnTime)%" title="On time: @Snapshot.OnTime" @onclick='() => SetOutcomeFilter(ObligationOutcome.OnTime)'></button> }
                    @if (Snapshot.Late > 0) { <button class="late" style="width:@Percent(Snapshot.Late)%" title="Late: @Snapshot.Late" @onclick='() => SetOutcomeFilter(ObligationOutcome.Late)'></button> }
                    @if (Snapshot.Overdue > 0) { <button class="overdue" style="width:@Percent(Snapshot.Overdue)%" title="Overdue: @Snapshot.Overdue" @onclick='() => SetOutcomeFilter(ObligationOutcome.Overdue)'></button> }
                    @if (Snapshot.Pending > 0) { <button class="pending" style="width:@Percent(Snapshot.Pending)%" title="Pending: @Snapshot.Pending" @onclick='() => SetOutcomeFilter(ObligationOutcome.Pending)'></button> }
                    @if (Snapshot.Exceptions > 0) { <button class="excused" style="width:@Percent(Snapshot.Exceptions)%" title="Exceptions: @Snapshot.Exceptions"></button> }
                </div>
                <div class="population-legend">
                    @Legend("on-time", "On time", Snapshot.OnTime)
                    @Legend("late", "Late", Snapshot.Late)
                    @Legend("overdue", "Overdue", Snapshot.Overdue)
                    @Legend("pending", "Pending", Snapshot.Pending)
                    @if (Snapshot.Exceptions > 0) { @Legend("excused", "Exceptions", Snapshot.Exceptions) }
                </div>
            </div>
        </section>

        <section class="deadline-distribution">
            <div class="discipline-section-title">
                <div><span class="atlas-section-label">Deadline-relative submission distribution</span><small>Hours before or after the filing deadline</small></div>
                <div class="distribution-key"><span>Early</span><b>Deadline</b><span>Late</span></div>
            </div>
            <div class="distribution-plot" aria-label="Submission times relative to deadline">
                <div class="distribution-axis"></div>
                <div class="deadline-zero"><i></i><span>0</span></div>
                <span class="edge-label early-edge">−48h or earlier</span>
                <span class="edge-label late-edge">+48h or later</span>
                @foreach (var point in DistributionPoints)
                {
                    <button class="distribution-dot @(point.Outcome == ObligationOutcome.Late ? "late" : "on-time")"
                            style="left:@DistributionPosition(point)% ; bottom:@DistributionLane(point)px"
                            title="@DistributionTitle(point)"
                            @onclick="() => SelectObligation(point)"></button>
                }
            </div>
        </section>

        <section class="discipline-workspace">
            <div class="discipline-matrix-panel">
                <div class="discipline-section-title matrix-title">
                    <div><span class="atlas-section-label">Engineer × directive matrix</span><small>Click a status to inspect its evidence trail</small></div>
                    <input value="@_filter" @oninput="OnFilterChanged" placeholder="Filter engineer…" aria-label="Filter engineer" />
                </div>
                <div class="discipline-matrix" role="table">
                    <div class="matrix-head" role="row"><span>Engineer</span><span>Timesheet filing</span><span>Peer review submission</span></div>
                    @foreach (var row in MatrixRows)
                    {
                        <div class="matrix-row @(_selectedEmployee == row.EmployeeName ? "selected" : null)" role="row">
                            <button class="matrix-person" @onclick="() => SelectEmployee(row.EmployeeName)"><strong>@row.EmployeeName</strong><small>@row.Summary</small></button>
                            <button class="matrix-status @OutcomeClass(row.Outcome)" title="@row.TimesheetTitle" @onclick="() => SelectEmployee(row.EmployeeName)">
                                <i></i><span>@OutcomeText(row.Outcome)</span>
                            </button>
                            <span class="matrix-status unavailable" title="Assignment and submission timestamps are required"><i></i><span>Feed required</span></span>
                        </div>
                    }
                </div>
            </div>

            <aside class="evidence-panel">
                @if (SelectedObligation is null)
                {
                    <div class="evidence-empty"><span class="atlas-section-label">Evidence trail</span><strong>Select an engineer or submission</strong><p>The obligation’s trigger, deadline, system evidence, and permanent outcome will appear here.</p></div>
                }
                else
                {
                    var item = SelectedObligation;
                    <div class="evidence-heading"><span class="atlas-section-label">Evidence trail</span><strong>@item.EmployeeName</strong><small>@item.DirectiveName · @item.TriggeredAt.ToString("dd MMM yyyy")</small></div>
                    <dl class="evidence-timeline">
                        <div><dt>Workday</dt><dd>@item.TriggeredAt.ToString("dd MMM · dddd")</dd></div>
                        <div><dt>Due</dt><dd>@item.DueAt.ToString("dd MMM · HH:mm")</dd></div>
                        <div><dt>Completed</dt><dd>@(item.CompletedAt?.ToString("dd MMM · HH:mm") ?? "—")</dd></div>
                    </dl>
                    <div class="evidence-outcome @OutcomeClass(item.Outcome)"><span>@OutcomeText(item.Outcome)</span><strong>@DelayText(item)</strong></div>
                    <dl class="evidence-facts">
                        <div><dt>Required hours</dt><dd>@item.RequiredHours.ToString("0.#") h</dd></div>
                        <div><dt>Recorded hours</dt><dd>@item.RecordedHours.ToString("0.##") h</dd></div>
                        <div><dt>Evidence rows</dt><dd>@item.EvidenceRows</dd></div>
                        <div><dt>Source</dt><dd title="@item.EvidenceSource">@item.EvidenceSource</dd></div>
                    </dl>
                    <div class="exception-controls">
                        <span class="atlas-section-label">Exception</span>
                        <p>Exceptions are explicit and auditable. They never rewrite the source timestamps.</p>
                        <input value="@_exceptionReason" @oninput="OnExceptionReasonChanged" placeholder="Reason required…" aria-label="Exception reason" />
                        <div>
                            <button type="button" disabled="@State.Busy" @onclick="() => ApplyExceptionAsync(ObligationOutcome.Excused)">Excuse</button>
                            <button type="button" disabled="@State.Busy" @onclick="() => ApplyExceptionAsync(ObligationOutcome.NotApplicable)">Not applicable</button>
                            <button type="button" disabled="@State.Busy" @onclick="() => ApplyExceptionAsync(ObligationOutcome.Waived)">Waive</button>
                            @if (item.ExceptionReason is not null)
                            {
                                <button type="button" class="clear" disabled="@State.Busy" @onclick="ClearExceptionAsync">Clear</button>
                            }
                        </div>
                        @if (item.ExceptionReason is not null)
                        {
                            <small>Recorded @(item.ExceptionRecordedAt?.ToString("dd MMM yyyy · HH:mm") ?? "unknown") · @item.ExceptionReason</small>
                        }
                    </div>
                    <div class="employee-obligation-list">
                        <span class="atlas-section-label">This engineer · @State.SelectedMonth.ToString("MMM")</span>
                        @foreach (var obligation in SelectedEmployeeObligations)
                        {
                            <button class="@(obligation.Key == item.Key ? "selected" : null)" @onclick="() => SelectObligation(obligation)">
                                <span>@obligation.TriggeredAt.ToString("dd MMM")</span><i class="@OutcomeClass(obligation.Outcome)"></i><strong>@OutcomeText(obligation.Outcome)</strong>
                            </button>
                        }
                    </div>
                }
            </aside>
        </section>

    }
</div>

@code {
    private ExecutionDisciplineSettings _settings = ExecutionDisciplineSettings.Default;
    private bool _showConfiguration;
    private int _dueHour = 10, _dueMinute, _graceMinutes;
    private decimal _requiredHours = 8m;
    private bool _saturdayWorking = true;
    private string _filter = string.Empty;
    private string? _selectedEmployee;
    private string? _selectedObligationKey;
    private ObligationOutcome? _outcomeFilter;
    private string _exceptionReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        _settings = await Database.GetExecutionDisciplineSettingsAsync();
        LoadSettingsFields();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;

    private ExecutionDisciplineSnapshot? Snapshot => State.ExecutionDiscipline;

    private void ToggleConfiguration() => _showConfiguration = !_showConfiguration;

    private void LoadSettingsFields()
    {
        _dueHour = _settings.TimesheetDueHour;
        _dueMinute = _settings.TimesheetDueMinute;
        _graceMinutes = _settings.GraceMinutes;
        _requiredHours = _settings.RequiredDailyHours;
        _saturdayWorking = _settings.SaturdayIsWorkingDay;
    }

    private async Task SaveConfigurationAsync()
    {
        var settings = new ExecutionDisciplineSettings(_dueHour, _dueMinute, _graceMinutes, _requiredHours, _saturdayWorking);
        await State.RunAsync(async () =>
        {
            await Database.SaveExecutionDisciplineSettingsAsync(settings);
            _settings = settings;
            await State.RefreshAsync();
            State.ShowMessage("Timesheet filing directive saved and obligations recalculated.");
            _showConfiguration = false;
        });
    }

    private RenderFragment Legend(string css, string label, int count) => @<button class="@css" @onclick="() => SetOutcomeFilter(ParseOutcome(css))"><i></i><span>@label</span><strong>@count</strong></button>;

    private static ObligationOutcome ParseOutcome(string css) => css switch
    {
        "on-time" => ObligationOutcome.OnTime,
        "late" => ObligationOutcome.Late,
        "overdue" => ObligationOutcome.Overdue,
        "excused" => ObligationOutcome.Excused,
        _ => ObligationOutcome.Pending
    };

    private void SetOutcomeFilter(ObligationOutcome outcome)
    {
        _outcomeFilter = _outcomeFilter == outcome ? null : outcome;
        var first = Snapshot?.Obligations.FirstOrDefault(x => x.Outcome == outcome);
        if (first is not null) SelectObligation(first);
    }

    private void OnFilterChanged(ChangeEventArgs args) => _filter = args.Value?.ToString() ?? string.Empty;
    private void OnExceptionReasonChanged(ChangeEventArgs args) => _exceptionReason = args.Value?.ToString() ?? string.Empty;

    private IReadOnlyList<ObligationItem> DistributionPoints => Snapshot?.Obligations
        .Where(x => x.CompletedAt is not null)
        .OrderBy(x => x.CompletedAt)
        .Take(120)
        .ToArray() ?? [];

    private string DistributionPosition(ObligationItem item)
    {
        var hours = Math.Clamp((item.MinutesRelativeToDeadline ?? 0) / 60d, -48d, 48d);
        return ((hours + 48d) / 96d * 100d).ToString("0.###", CultureInfo.InvariantCulture);
    }

    private static int DistributionLane(ObligationItem item) => 24 + Math.Abs(item.Key.GetHashCode(StringComparison.Ordinal)) % 52;
    private static string DistributionTitle(ObligationItem item) => $"{item.EmployeeName} · {item.TriggeredAt:dd MMM}: {DelayText(item)}";

    private IReadOnlyList<MatrixRow> MatrixRows
    {
        get
        {
            var obligations = Snapshot?.Obligations ?? [];
            if (_outcomeFilter is { } outcome)
                obligations = outcome == ObligationOutcome.Excused
                    ? obligations.Where(x => x.Outcome is ObligationOutcome.Excused or ObligationOutcome.NotApplicable or ObligationOutcome.Waived).ToArray()
                    : obligations.Where(x => x.Outcome == outcome).ToArray();
            return obligations
                .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
                .Where(x => string.IsNullOrWhiteSpace(_filter) || x.Key.Contains(_filter, StringComparison.OrdinalIgnoreCase))
                .Select(group =>
                {
                    var rows = group.ToArray();
                    var aggregate = AggregateOutcome(rows);
                    return new MatrixRow(
                        group.Key,
                        aggregate,
                        $"{rows.Count(x => x.Outcome == ObligationOutcome.OnTime)} on time · {rows.Count(x => x.Outcome == ObligationOutcome.Late)} late · {rows.Count(x => x.Outcome == ObligationOutcome.Overdue)} overdue",
                        $"{rows.Length} obligations · {rows.Count(x => x.CompletedAt is not null)} completed");
                })
                .OrderBy(x => OutcomeRank(x.Outcome))
                .ThenBy(x => x.EmployeeName)
                .ToArray();
        }
    }

    private static ObligationOutcome AggregateOutcome(IReadOnlyList<ObligationItem> rows) =>
        rows.Any(x => x.Outcome == ObligationOutcome.Overdue) ? ObligationOutcome.Overdue :
        rows.Any(x => x.Outcome == ObligationOutcome.Late) ? ObligationOutcome.Late :
        rows.Any(x => x.Outcome == ObligationOutcome.Pending) ? ObligationOutcome.Pending : ObligationOutcome.OnTime;

    private static int OutcomeRank(ObligationOutcome outcome) => outcome switch
    {
        ObligationOutcome.Overdue => 0,
        ObligationOutcome.Late => 1,
        ObligationOutcome.Pending => 2,
        _ => 3
    };

    private void SelectEmployee(string employeeName)
    {
        _selectedEmployee = employeeName;
        var selected = Snapshot?.Obligations
            .Where(x => x.EmployeeName.Equals(employeeName, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => OutcomeRank(x.Outcome))
            .ThenByDescending(x => x.TriggeredAt)
            .FirstOrDefault();
        _selectedObligationKey = selected?.Key;
        _exceptionReason = selected?.ExceptionReason ?? string.Empty;
    }

    private void SelectObligation(ObligationItem item)
    {
        _selectedEmployee = item.EmployeeName;
        _selectedObligationKey = item.Key;
        _exceptionReason = item.ExceptionReason ?? string.Empty;
    }

    private async Task ApplyExceptionAsync(ObligationOutcome outcome)
    {
        var item = SelectedObligation;
        if (item is null) return;
        await State.RunAsync(async () =>
        {
            await Database.SetObligationExceptionAsync(item.Key, outcome, _exceptionReason);
            await State.RefreshAsync();
            State.ShowMessage($"{OutcomeText(outcome)} recorded for {item.EmployeeName} on {item.TriggeredAt:dd MMM}.");
        });
    }

    private async Task ClearExceptionAsync()
    {
        var item = SelectedObligation;
        if (item is null) return;
        await State.RunAsync(async () =>
        {
            await Database.SetObligationExceptionAsync(item.Key, null, null);
            _exceptionReason = string.Empty;
            await State.RefreshAsync();
            State.ShowMessage($"Exception cleared for {item.EmployeeName} on {item.TriggeredAt:dd MMM}.");
        });
    }

    private ObligationItem? SelectedObligation => Snapshot?.Obligations.FirstOrDefault(x => x.Key == _selectedObligationKey);
    private IReadOnlyList<ObligationItem> SelectedEmployeeObligations => string.IsNullOrWhiteSpace(_selectedEmployee)
        ? []
        : Snapshot?.Obligations.Where(x => x.EmployeeName.Equals(_selectedEmployee, StringComparison.OrdinalIgnoreCase)).OrderByDescending(x => x.TriggeredAt).ToArray() ?? [];

    private string Percent(int count) => Snapshot?.Obligations.Count > 0
        ? (count * 100d / Snapshot.Obligations.Count).ToString("0.###", CultureInfo.InvariantCulture)
        : "0";

    private string PopulationAria => $"{Snapshot?.OnTime ?? 0} on time, {Snapshot?.Late ?? 0} late, {Snapshot?.Overdue ?? 0} overdue, {Snapshot?.Pending ?? 0} pending, {Snapshot?.Exceptions ?? 0} exceptions";

    private static string OutcomeClass(ObligationOutcome outcome) => outcome switch
    {
        ObligationOutcome.OnTime => "on-time",
        ObligationOutcome.Late => "late",
        ObligationOutcome.Overdue => "overdue",
        ObligationOutcome.Pending => "pending",
        ObligationOutcome.Excused => "excused",
        ObligationOutcome.Waived => "waived",
        _ => "not-applicable"
    };

    private static string OutcomeText(ObligationOutcome outcome) => outcome switch
    {
        ObligationOutcome.OnTime => "On time",
        ObligationOutcome.NotApplicable => "Not applicable",
        _ => outcome.ToString()
    };

    private static string DelayText(ObligationItem item)
    {
        if (item.Outcome == ObligationOutcome.Overdue) return $"overdue by {Duration((int)Math.Max(0, (DateTime.Now - item.DueAt).TotalMinutes))}";
        if (item.Outcome == ObligationOutcome.Pending) return $"due in {Duration((int)Math.Max(0, (item.DueAt - DateTime.Now).TotalMinutes))}";
        if (item.MinutesRelativeToDeadline is null) return OutcomeText(item.Outcome);
        return item.MinutesRelativeToDeadline <= 0
            ? $"{Duration(Math.Abs(item.MinutesRelativeToDeadline.Value))} early"
            : $"{Duration(item.MinutesRelativeToDeadline.Value)} late";
    }

    private static string Duration(int minutes)
    {
        var span = TimeSpan.FromMinutes(Math.Abs(minutes));
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d {span.Hours}h";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h {span.Minutes}m";
        return $"{span.Minutes}m";
    }

    private sealed record MatrixRow(string EmployeeName, ObligationOutcome Outcome, string TimesheetTitle, string Summary);
}
