<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.7" />
    <!-- Matches Infrastructure's version; these had drifted (10.0.7 here vs 10.0.10 there), which
         leaves NuGet silently unifying to the higher one at restore rather than it being stated. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EngineeringPerformance.Domain\EngineeringPerformance.Domain.csproj" />
    <ProjectReference Include="..\EngineeringPerformance.Application\EngineeringPerformance.Application.csproj" />
  </ItemGroup>

  <!--
    Compiles wwwroot/tailwind-input.css (the single design-token source, see that file's own
    header comment) into wwwroot/tailwind.css using the Tailwind standalone CLI binary — no
    Node/npm toolchain, matching the rest of this repo's build. The binary itself is not
    committed (~100MB); it's fetched into a repo-root .tailwind/ cache on first build so the
    styling pipeline is deterministic without introducing a Node package toolchain.
  -->
  <PropertyGroup>
    <TailwindCliPath>$(MSBuildProjectDirectory)\..\..\.tailwind\tailwindcss.exe</TailwindCliPath>
    <TailwindCliUrl>https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-windows-x64.exe</TailwindCliUrl>
    <TailwindInputCss>$(MSBuildProjectDirectory)\wwwroot\tailwind-input.css</TailwindInputCss>
    <TailwindOutputCss>$(MSBuildProjectDirectory)\wwwroot\tailwind.css</TailwindOutputCss>
  </PropertyGroup>

  <Target Name="EnsureTailwindCli" BeforeTargets="CompileTailwindCss">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(TailwindCliPath)'))" Condition="!Exists('$(TailwindCliPath)')" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Invoke-WebRequest -Uri '$(TailwindCliUrl)' -OutFile '$(TailwindCliPath)'&quot;"
          Condition="!Exists('$(TailwindCliPath)')" />
  </Target>

  <!--
    Always runs, deliberately not gated by MSBuild's Inputs/Outputs incremental-build tracking:
    Tailwind's own CLI is fast (well under a second) and does its own content scan, and a stale
    tailwind.css from a missed dependency would be a much worse failure mode (silently wrong
    styling with no build error) than the small unconditional cost of always recompiling.
  -->
  <Target Name="CompileTailwindCss" BeforeTargets="Build;Publish">
    <Exec Command="&quot;$(TailwindCliPath)&quot; -i &quot;$(TailwindInputCss)&quot; -o &quot;$(TailwindOutputCss)&quot; --minify" />
  </Target>

  <!--
    The browser loads wwwroot/*.js as plain scripts, so a syntax error does not fail the build —
    it just silently prevents the file's globals from ever being defined. That is exactly what
    happened once: an unbalanced paren in charts.js meant window.epaCharts never existed, and every
    chart driven by it rendered nothing for an entire release without a single error surfacing.
    Node's check flag parses each file without executing it, catching that class of bug at build time.

    IgnoreExitCode + a node-presence check keeps this advisory rather than a hard dependency:
    the project has no JS toolchain and must still build cleanly on a machine without Node installed.
  -->
  <Target Name="CheckWwwrootJsSyntax" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="where node" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NodeMissing" />
    </Exec>
    <ItemGroup Condition="'$(NodeMissing)' == '0'">
      <WwwrootJs Include="$(MSBuildProjectDirectory)\wwwroot\*.js" Exclude="$(MSBuildProjectDirectory)\wwwroot\echarts.min.js" />
    </ItemGroup>
    <Exec Command="node --check &quot;%(WwwrootJs.FullPath)&quot;"
          Condition="'$(NodeMissing)' == '0'"
          StandardOutputImportance="low" />
  </Target>

</Project>
