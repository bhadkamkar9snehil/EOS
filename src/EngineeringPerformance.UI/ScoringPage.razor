@page "/scoring"
@using EngineeringPerformance.Application
@inject IApplicationDatabase Database
@inject IScoringPresetService Presets
@inject AppState State
@inject IJSRuntime JS

<section class="single-pane wide scoring-page">
    <div class="section-title">
        <div>
            <h2>Operational score configuration</h2>
            <p>Controls the operational score shown everywhere in EOS.</p>
        </div>
    </div>

    <div class="operational-scoring-layout">
        <div class="card operational-weight-card">
            <div class="card-head">
                <h2>Operational weights</h2>
                <small>Persisted locally</small>
            </div>

            <div class="operational-weight-list">
                @OperationalWeight("Timesheet completion", "Entered hours against compliance hours", () => _timesheet, v => _timesheet = v)
                @OperationalWeight("Approval completion", "Approved hours against entered hours", () => _approval, v => _approval = v)
                @OperationalWeight("Attendance discipline", "Filled days, punches, duration and punctuality", () => _attendance, v => _attendance = v)
            </div>

            <div class="scoring-save-row">
                <div class="weight-total-panel @(IsOperationalValid ? "valid" : "invalid")">
                    <span>Total</span>
                    <strong>@Analytics.Format(OperationalTotal, "0.#")%</strong>
                    <small>@OperationalValidationText</small>
                </div>
                <button class="action secondary" @onclick="ResetOperational" disabled="@State.Busy">Reset 55 / 15 / 30</button>
                <button class="action" @onclick="SaveAndRecalculateAsync" disabled="@(State.Busy || !IsOperationalValid)">Save &amp; recalculate</button>
            </div>
        </div>

        <div class="card operational-preview-card">
            <div class="card-head">
                <h2>Current weighting</h2>
                <small>Applied proportionally when a source is unavailable</small>
            </div>
            <div class="operational-weight-stack" role="img" aria-label="@OperationalStackDescription">
                @if (_timesheet > 0) { <i class="weight-timesheet" style="flex:@Analytics.Svg((double)_timesheet)"></i> }
                @if (_approval > 0) { <i class="weight-approval" style="flex:@Analytics.Svg((double)_approval)"></i> }
                @if (_attendance > 0) { <i class="weight-attendance" style="flex:@Analytics.Svg((double)_attendance)"></i> }
            </div>
            <ul class="operational-legend">
                <li><i class="weight-timesheet"></i><span>Timesheet completion</span><b>@Analytics.Format(_timesheet, "0.#")%</b></li>
                <li><i class="weight-approval"></i><span>Approval completion</span><b>@Analytics.Format(_approval, "0.#")%</b></li>
                <li><i class="weight-attendance"></i><span>Attendance discipline</span><b>@Analytics.Format(_attendance, "0.#")%</b></li>
            </ul>
            <div class="callout scoring-callout">
                <strong>Recalculation scope</strong>
                <p>Saving recalculates every existing monthly row.</p>
            </div>
        </div>
    </div>

    <div class="section-title scoring-secondary-title">
        <div>
            <h2>Scoring presets</h2>
            <p>Applying a preset saves and recalculates immediately.</p>
        </div>
    </div>

    <div class="card">
        <div class="operational-weight-list">
            @foreach (var preset in _presets)
            {
                <div class="operational-weight-row">
                    <span>
                        <strong>@preset.Name</strong>
                        <small>@Analytics.Format(preset.Settings.TimesheetCompletionWeight, "0.#")% timesheet · @Analytics.Format(preset.Settings.ApprovalCompletionWeight, "0.#")% approval · @Analytics.Format(preset.Settings.AttendanceDisciplineWeight, "0.#")% attendance</small>
                    </span>
                    <span class="weight-input">
                        <button class="action secondary" @onclick="() => ApplyPresetAsync(preset)" disabled="@State.Busy">Apply</button>
                        @if (!preset.IsBuiltIn)
                        {
                            <button class="action secondary" @onclick="() => DeletePresetAsync(preset.Name)" disabled="@State.Busy">Delete</button>
                        }
                    </span>
                </div>
            }
        </div>
        <div class="scoring-save-row">
            <input placeholder="New preset name" value="@_newPresetName" @oninput="e => _newPresetName = e.Value?.ToString() ?? string.Empty" />
            <button class="action" @onclick="SaveCurrentAsPresetAsync" disabled="@(State.Busy || string.IsNullOrWhiteSpace(_newPresetName) || !IsOperationalValid)">Save current weights as preset</button>
        </div>
    </div>

    <div class="section-title scoring-secondary-title">
        <div>
            <h2>Review framework preview</h2>
            <p>Planning preview — does not alter the score above.</p>
        </div>
    </div>

    <div class="scoring-grid">
        <div class="scoring-col">
            <div class="card">
                <div class="card-head"><h2>Review category weights</h2><small>Preview only</small></div>
                <div class="weight-list">
                    @Weight("Assignment execution", () => _execution, v => _execution = v)
                    @Weight("Ownership &amp; accountability", () => _ownership, v => _ownership = v)
                    @Weight("Collaboration", () => _collaboration, v => _collaboration = v)
                    @Weight("Operational discipline", () => _discipline, v => _discipline = v)
                    @Weight("Professional excellence", () => _excellence, v => _excellence = v)
                    @Weight("Continuous improvement", () => _improvement, v => _improvement = v)
                    @Weight("Growth &amp; learning", () => _growth, v => _growth = v)
                </div>
            </div>
        </div>

        <div class="scoring-col">
            <div class="card">
                <div class="card-head"><h2>Review-weight validation</h2><small>Must total 100%</small></div>
                <div class="validation-row">
                    <span class="weight-total @(IsReviewValid ? "valid" : "invalid")">@Analytics.Format(ReviewTotal, "0.#")%</span>
                    <span class="validation-verdict @(IsReviewValid ? "ok" : "bad")">@(IsReviewValid ? "Valid preview" : ReviewTotal > 100 ? $"Over by {Analytics.Format(ReviewTotal - 100, "0.#")}" : $"Under by {Analytics.Format(100 - ReviewTotal, "0.#")}")</span>
                </div>
            </div>
            <div class="card">
                <div class="card-head"><h2>Score bands</h2><small>Applied across the application</small></div>
                <ul class="band-list">
                    @foreach (var (band, label, range) in Bands)
                    {
                        <li><i class="@band"></i><span>@label</span><b>@range</b></li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

@code {
    private decimal _timesheet = 55m;
    private decimal _approval = 15m;
    private decimal _attendance = 30m;

    private decimal _execution = 25, _ownership = 15, _collaboration = 15, _discipline = 15,
                    _excellence = 10, _improvement = 10, _growth = 10;

    private IReadOnlyList<ScoringPreset> _presets = [];
    private string _newPresetName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var settings = await Database.GetOperationalScoringSettingsAsync();
        _timesheet = settings.TimesheetCompletionWeight;
        _approval = settings.ApprovalCompletionWeight;
        _attendance = settings.AttendanceDisciplineWeight;
        _presets = await Presets.GetPresetsAsync();
    }

    private async Task ApplyPresetAsync(ScoringPreset preset)
    {
        _timesheet = preset.Settings.TimesheetCompletionWeight;
        _approval = preset.Settings.ApprovalCompletionWeight;
        _attendance = preset.Settings.AttendanceDisciplineWeight;
        await SaveAndRecalculateAsync();
        State.ShowMessage($"Applied preset “{preset.Name}”.");
    }

    private async Task SaveCurrentAsPresetAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPresetName)) return;
        await State.RunAsync(async () =>
        {
            var settings = new OperationalScoringSettings(_timesheet, _approval, _attendance);
            await Presets.SavePresetAsync(_newPresetName, settings);
            _presets = await Presets.GetPresetsAsync();
            State.ShowMessage($"Preset “{_newPresetName}” saved.");
            _newPresetName = string.Empty;
        });
    }

    private async Task DeletePresetAsync(string name)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete preset \"{name}\"?");
        if (!confirmed) return;
        await State.RunAsync(async () =>
        {
            await Presets.DeletePresetAsync(name);
            _presets = await Presets.GetPresetsAsync();
            State.ShowMessage($"Preset “{name}” deleted.");
        });
    }

    private decimal OperationalTotal => _timesheet + _approval + _attendance;
    private bool IsOperationalValid => _timesheet >= 0 && _approval >= 0 && _attendance >= 0 && OperationalTotal == 100m;
    private string OperationalValidationText => IsOperationalValid ? "Ready to apply" : OperationalTotal > 100m
        ? $"Reduce by {Analytics.Format(OperationalTotal - 100m, "0.#")}%"
        : $"Add {Analytics.Format(100m - OperationalTotal, "0.#")}%";

    private string OperationalStackDescription => $"Timesheet completion {_timesheet}%, approval completion {_approval}%, attendance discipline {_attendance}%";

    private async Task SaveAndRecalculateAsync()
    {
        await State.RunAsync(async () =>
        {
            var settings = new OperationalScoringSettings(_timesheet, _approval, _attendance);
            var count = await Database.SaveOperationalScoringSettingsAsync(settings);
            await State.RefreshAsync();
            State.ShowMessage($"Operational scoring saved. {count} monthly performance rows recalculated.");
        });
    }

    private void ResetOperational()
    {
        _timesheet = 55m;
        _approval = 15m;
        _attendance = 30m;
    }

    private decimal ReviewTotal => _execution + _ownership + _collaboration + _discipline + _excellence + _improvement + _growth;
    private bool IsReviewValid => ReviewTotal == 100m;

    private static IEnumerable<(string Band, string Label, string Range)> Bands =>
    [
        ("good", "Strong", "85 and above"),
        ("warning", "On track", "70 – 84"),
        ("serious", "At risk", "55 – 69"),
        ("critical", "Critical", "below 55")
    ];

    private RenderFragment OperationalWeight(string label, string detail, Func<decimal> get, Action<decimal> set) =>
        @<label class="operational-weight-row">
            <span><strong>@label</strong><small>@detail</small></span>
            <span class="weight-input"><input type="number" min="0" max="100" step="1" value="@get()" @onchange="e => set(decimal.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 0, 100) : 0)" /><b>%</b></span>
        </label>;

    private RenderFragment Weight(string label, Func<decimal> get, Action<decimal> set) =>
        @<label class="weight-row">
            <span>@((MarkupString)label)</span>
            <input type="number" min="0" max="100" value="@get()" @onchange="e => set(decimal.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 0, 100) : 0)" />
            <b>%</b>
        </label>;
}
