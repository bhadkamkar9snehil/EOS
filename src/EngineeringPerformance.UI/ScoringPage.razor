@page "/scoring"
@using EngineeringPerformance.Application

@* Current scoring configuration. Weights are held in this page only — they are not
   persisted, versioned by month, or applied to already-calculated scores. The copy
   below says so plainly rather than implying historical behaviour that does not exist. *@

<section class="single-pane">
    <div class="scoring-grid">
        <div class="scoring-col">
            <div class="section-title">
                <div><h2>Category weights</h2></div>
            </div>
            <div class="weight-list">
                @Weight("Assignment execution", () => _execution, v => _execution = v)
                @Weight("Ownership &amp; accountability", () => _ownership, v => _ownership = v)
                @Weight("Collaboration", () => _collaboration, v => _collaboration = v)
                @Weight("Operational discipline", () => _discipline, v => _discipline = v)
                @Weight("Professional excellence", () => _excellence, v => _excellence = v)
                @Weight("Continuous improvement", () => _improvement, v => _improvement = v)
                @Weight("Growth &amp; learning", () => _growth, v => _growth = v)
            </div>
        </div>

        <div class="scoring-col">
            <div class="card">
                <div class="card-head">
                    <h2>Weight validation</h2>
                    <small>Must total 100%</small>
                </div>
                <div class="validation-row">
                    <span class="weight-total @(IsValid ? "valid" : "invalid")">@Analytics.Format(WeightTotal, "0.#")%</span>
                    <span class="validation-verdict @(IsValid ? "ok" : "bad")">
                        @(IsValid ? "Valid" : WeightTotal > 100
                            ? $"Over by {Analytics.Format(WeightTotal - 100, "0.#")} — reduce"
                            : $"Under by {Analytics.Format(100 - WeightTotal, "0.#")} — add")
                    </span>
                </div>
                <div class="weight-stack" role="img" aria-label="@StackDescription">
                    @foreach (var (label, value, tone) in Categories)
                    {
                        @if (value > 0)
                        {
                            <i class="@tone" style="flex:@Analytics.Svg((double)value)" title="@label — @Analytics.Format(value, "0.#")%"></i>
                        }
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <h2>Contribution preview</h2>
                    <small>Worked example, not live data</small>
                </div>
                <p class="chart-note preview-lead">
                    A hypothetical engineer scoring @PreviewRating out of 5 in every category would land at
                    <b>@Analytics.Format(PreviewTotal)</b> out of 100. Each bar is that category's share.
                </p>
                <ul class="contribution-list">
                    @foreach (var (label, value, tone) in Categories)
                    {
                        <li>
                            <span class="contribution-label">@((MarkupString)label)</span>
                            <span class="contribution-track"><i class="@tone" style="width:@Analytics.Svg((double)(WeightTotal <= 0 ? 0 : value / WeightTotal * 100))%"></i></span>
                            <b>@Analytics.Format(value * PreviewRating / 5m, "0.#") / @Analytics.Format(value, "0.#")</b>
                        </li>
                    }
                </ul>
            </div>

            <div class="card">
                <div class="card-head">
                    <h2>Score bands</h2>
                    <small>Applied across the application</small>
                </div>
                <ul class="band-list">
                    @foreach (var (band, label, range) in Bands)
                    {
                        <li><i class="@band"></i><span>@label</span><b>@range</b></li>
                    }
                </ul>
                <p class="chart-note">
                    Bands are fixed in <code>Analytics.ScoreBand</code> and are not editable here.
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private decimal _execution = 25, _ownership = 15, _collaboration = 15, _discipline = 15,
                    _excellence = 10, _improvement = 10, _growth = 10;

    /// <summary>Illustrative rating used by the preview; deliberately a constant, not imported data.</summary>
    private const decimal PreviewRating = 4m;

    private decimal WeightTotal => _execution + _ownership + _collaboration + _discipline + _excellence + _improvement + _growth;
    private bool IsValid => WeightTotal == 100m;
    private decimal PreviewTotal => WeightTotal * PreviewRating / 5m;

    // Tones reuse the score-band palette so a weight bar and a score chip read the same way.
    private IEnumerable<(string Label, decimal Value, string Tone)> Categories =>
    [
        ("Assignment execution", _execution, "good"),
        ("Ownership &amp; accountability", _ownership, "warning"),
        ("Collaboration", _collaboration, "serious"),
        ("Operational discipline", _discipline, "critical"),
        ("Professional excellence", _excellence, "good"),
        ("Continuous improvement", _improvement, "warning"),
        ("Growth &amp; learning", _growth, "serious")
    ];

    private static IEnumerable<(string Band, string Label, string Range)> Bands =>
    [
        ("good", "Strong", "85 and above"),
        ("warning", "On track", "70 – 84"),
        ("serious", "At risk", "55 – 69"),
        ("critical", "Critical", "below 55")
    ];

    /// <summary>Text alternative for the stacked bar, so the split is not conveyed by colour alone.</summary>
    private string StackDescription =>
        "Weight split: " + string.Join(", ", Categories
            .Where(x => x.Value > 0)
            .Select(x => $"{x.Label.Replace("&amp;", "and")} {Analytics.Format(x.Value, "0.#")}%"));

    private RenderFragment Weight(string label, Func<decimal> get, Action<decimal> set) =>
        @<label class="weight-row">
            <span>@((MarkupString)label)</span>
            <input type="number" min="0" max="100" value="@get()"
                   @onchange="e => set(decimal.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 0, 100) : 0)" />
            <b>%</b>
        </label>;
}
