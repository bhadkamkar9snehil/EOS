@page "/scoring"
@using EngineeringPerformance.Application
@inject IApplicationDatabase Database
@inject IScoringPresetService Presets
@inject AppState State
@inject IJSRuntime JS

<section class="flex flex-col gap-6">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        @* The weight editor is the calibration panel of this instrument: each input is
           a labelled channel with its own engraved rail, and the total reads out below. *@
        <div class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Calibration</div>
                    <h2 class="panel-title">Operational weights</h2>
                </div>
                <span class="label-instrument ml-auto">Persisted locally</span>
            </div>

            <div class="flex flex-col divide-y divide-line-soft">
                @OperationalWeight("Timesheet completion", "Entered hours against compliance hours", "bg-chart-1", () => _timesheet, v => _timesheet = v)
                @OperationalWeight("Approval completion", "Approved hours against entered hours", "bg-chart-2", () => _approval, v => _approval = v)
                @OperationalWeight("Attendance discipline", "Filled days, punches, duration and punctuality", "bg-chart-3", () => _attendance, v => _attendance = v)
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-3">
                <div class="well flex flex-1 items-baseline gap-2.5 px-3 py-2">
                    <span class="label-instrument">Total</span>
                    <strong class="@($"metric text-metric-sm {(IsOperationalValid ? "text-good" : "text-critical")}")">@Analytics.Format(OperationalTotal, "0.#")%</strong>
                    <small class="@($"metric-delta {(IsOperationalValid ? "text-good" : "text-critical")}")">@OperationalValidationText</small>
                </div>
                <button class="btn btn-secondary" @onclick="ResetOperational" disabled="@State.Busy">Reset <span class="tnum">55 / 15 / 30</span></button>
                <button class="btn btn-primary" @onclick="SaveAndRecalculateAsync" disabled="@(State.Busy || !IsOperationalValid)">Save &amp; recalculate</button>
            </div>
        </div>

        <div class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Distribution</div>
                    <h2 class="panel-title">Current weighting</h2>
                </div>
                <span class="label-instrument ml-auto">Rescaled when a source is missing</span>
            </div>
            <div class="track flex h-3 overflow-hidden" role="img" aria-label="@OperationalStackDescription">
                @if (_timesheet > 0) { <i class="bg-chart-1" style="@($"flex:{Analytics.Svg((double)_timesheet)}")"></i> }
                @if (_approval > 0) { <i class="bg-chart-2" style="@($"flex:{Analytics.Svg((double)_approval)}")"></i> }
                @if (_attendance > 0) { <i class="bg-chart-3" style="@($"flex:{Analytics.Svg((double)_attendance)}")"></i> }
            </div>
            <ul class="mt-3 flex flex-col gap-1.5 text-sm">
                <li class="flex items-center gap-2"><i class="lamp h-2 w-2 text-chart-1"></i><span class="flex-1 text-ink-soft">Timesheet completion</span><b class="metric text-sm">@Analytics.Format(_timesheet, "0.#")%</b></li>
                <li class="flex items-center gap-2"><i class="lamp h-2 w-2 text-chart-2"></i><span class="flex-1 text-ink-soft">Approval completion</span><b class="metric text-sm">@Analytics.Format(_approval, "0.#")%</b></li>
                <li class="flex items-center gap-2"><i class="lamp h-2 w-2 text-chart-3"></i><span class="flex-1 text-ink-soft">Attendance discipline</span><b class="metric text-sm">@Analytics.Format(_attendance, "0.#")%</b></li>
            </ul>
            <div class="mt-4 rounded-lg bg-surface-inset p-3">
                <div class="label-instrument">Recalculation scope</div>
            </div>
        </div>
    </div>

    <div class="plate p-4">
        <div class="panel-head">
            <div>
                <div class="panel-eyebrow">Library</div>
                <h2 class="panel-title">Scoring presets</h2>
            </div>
            <span class="label-instrument ml-auto"><span class="tnum">@_presets.Count</span> saved · applying recalculates immediately</span>
        </div>
        <div class="flex flex-col divide-y divide-line-soft">
            @foreach (var preset in _presets)
            {
                <div class="group flex items-center justify-between gap-3 py-2.5">
                    <span>
                        <strong class="block text-sm font-medium text-ink">@preset.Name</strong>
                        <small class="label-instrument"><span class="tnum">@Analytics.Format(preset.Settings.TimesheetCompletionWeight, "0.#")%</span> timesheet · <span class="tnum">@Analytics.Format(preset.Settings.ApprovalCompletionWeight, "0.#")%</span> approval · <span class="tnum">@Analytics.Format(preset.Settings.AttendanceDisciplineWeight, "0.#")%</span> attendance</small>
                    </span>
                    <span class="flex gap-2 opacity-70 transition-opacity duration-150 ease-press group-hover:opacity-100">
                        <button class="btn btn-secondary" @onclick="() => ApplyPresetAsync(preset)" disabled="@State.Busy">Apply</button>
                        @if (!preset.IsBuiltIn)
                        {
                            <button class="btn btn-secondary" @onclick="() => DeletePresetAsync(preset.Name)" disabled="@State.Busy">Delete</button>
                        }
                    </span>
                </div>
            }
        </div>
        <div class="mt-3 flex gap-2">
            <input class="field flex-1 px-3 py-1.5 text-sm text-ink outline-none placeholder:text-muted" aria-label="New preset name" placeholder="New preset name" value="@_newPresetName" @oninput="e => _newPresetName = e.Value?.ToString() ?? string.Empty" />
            <button class="btn btn-primary" @onclick="SaveCurrentAsPresetAsync" disabled="@(State.Busy || string.IsNullOrWhiteSpace(_newPresetName) || !IsOperationalValid)">Save current weights as preset</button>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Preview · not applied</div>
                    <h2 class="panel-title">Review category weights</h2>
                </div>
            </div>
            <div class="flex flex-col divide-y divide-line-soft">
                @Weight("Assignment execution", () => _execution, v => _execution = v)
                @Weight("Ownership &amp; accountability", () => _ownership, v => _ownership = v)
                @Weight("Collaboration", () => _collaboration, v => _collaboration = v)
                @Weight("Operational discipline", () => _discipline, v => _discipline = v)
                @Weight("Professional excellence", () => _excellence, v => _excellence = v)
                @Weight("Continuous improvement", () => _improvement, v => _improvement = v)
                @Weight("Growth &amp; learning", () => _growth, v => _growth = v)
            </div>
        </div>

        <div class="flex flex-col gap-4">
            <div class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Validation</div>
                        <h2 class="panel-title">Review-weight total</h2>
                    </div>
                </div>
                <div class="@($"metric text-metric {(IsReviewValid ? "text-good" : "text-critical")}")">@Analytics.Format(ReviewTotal, "0.#")%</div>
                <div class="@($"metric-delta mt-1 {(IsReviewValid ? "text-good" : "text-critical")}")">@(IsReviewValid ? "Valid preview" : ReviewTotal > 100 ? $"Over by {Analytics.Format(ReviewTotal - 100, "0.#")}" : $"Under by {Analytics.Format(100 - ReviewTotal, "0.#")}")</div>
                <div class="label-instrument mt-1">Must total 100%</div>
            </div>
            <div class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Reference</div>
                        <h2 class="panel-title">Score bands</h2>
                    </div>
                </div>
                <ul class="flex flex-col gap-1.5">
                    @foreach (var (band, label, range) in Bands)
                    {
                        <li class="flex items-center gap-2 text-sm"><i class="@($"lamp h-2 w-2 {Analytics.BandTextClass(band)}")"></i><span class="flex-1 text-ink-soft">@label</span><b class="metric text-sm">@range</b></li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

@code {
    private decimal _timesheet = 55m;
    private decimal _approval = 15m;
    private decimal _attendance = 30m;

    private decimal _execution = 25, _ownership = 15, _collaboration = 15, _discipline = 15,
                    _excellence = 10, _improvement = 10, _growth = 10;

    private IReadOnlyList<ScoringPreset> _presets = [];
    private string _newPresetName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var settings = await Database.GetOperationalScoringSettingsAsync();
        _timesheet = settings.TimesheetCompletionWeight;
        _approval = settings.ApprovalCompletionWeight;
        _attendance = settings.AttendanceDisciplineWeight;
        _presets = await Presets.GetPresetsAsync();
    }

    private async Task ApplyPresetAsync(ScoringPreset preset)
    {
        _timesheet = preset.Settings.TimesheetCompletionWeight;
        _approval = preset.Settings.ApprovalCompletionWeight;
        _attendance = preset.Settings.AttendanceDisciplineWeight;
        await SaveAndRecalculateAsync();
        State.ShowMessage($"Applied preset “{preset.Name}”.");
    }

    private async Task SaveCurrentAsPresetAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPresetName)) return;
        await State.RunAsync(async () =>
        {
            var settings = new OperationalScoringSettings(_timesheet, _approval, _attendance);
            await Presets.SavePresetAsync(_newPresetName, settings);
            _presets = await Presets.GetPresetsAsync();
            State.ShowMessage($"Preset “{_newPresetName}” saved.");
            _newPresetName = string.Empty;
        });
    }

    private async Task DeletePresetAsync(string name)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete preset \"{name}\"?");
        if (!confirmed) return;
        await State.RunAsync(async () =>
        {
            await Presets.DeletePresetAsync(name);
            _presets = await Presets.GetPresetsAsync();
            State.ShowMessage($"Preset “{name}” deleted.");
        });
    }

    private decimal OperationalTotal => _timesheet + _approval + _attendance;
    private bool IsOperationalValid => _timesheet >= 0 && _approval >= 0 && _attendance >= 0 && OperationalTotal == 100m;
    private string OperationalValidationText => IsOperationalValid ? "Ready to apply" : OperationalTotal > 100m
        ? $"Reduce by {Analytics.Format(OperationalTotal - 100m, "0.#")}%"
        : $"Add {Analytics.Format(100m - OperationalTotal, "0.#")}%";

    private string OperationalStackDescription => $"Timesheet completion {_timesheet}%, approval completion {_approval}%, attendance discipline {_attendance}%";

    private async Task SaveAndRecalculateAsync()
    {
        await State.RunAsync(async () =>
        {
            var settings = new OperationalScoringSettings(_timesheet, _approval, _attendance);
            var count = await Database.SaveOperationalScoringSettingsAsync(settings);
            await State.RefreshAsync();
            State.ShowMessage($"Operational scoring saved. {count} monthly performance rows recalculated.");
        });
    }

    private void ResetOperational()
    {
        _timesheet = 55m;
        _approval = 15m;
        _attendance = 30m;
    }

    private decimal ReviewTotal => _execution + _ownership + _collaboration + _discipline + _excellence + _improvement + _growth;
    private bool IsReviewValid => ReviewTotal == 100m;

    private static IEnumerable<(string Band, string Label, string Range)> Bands =>
    [
        ("good", "Strong", "85 and above"),
        ("warning", "On track", "70 – 84"),
        ("serious", "At risk", "55 – 69"),
        ("critical", "Critical", "below 55")
    ];

    // A calibration channel: label, engraved rail showing the current setting against
    // the 0–100 scale, and the numeric readout. Markup only — the binding is unchanged.
    private RenderFragment OperationalWeight(string label, string detail, string barClass, Func<decimal> get, Action<decimal> set) =>
        @<label class="group flex flex-col gap-1.5 py-3">
            <span class="flex items-center justify-between gap-3">
                <strong class="flex-1 text-sm font-medium text-ink">@label</strong>
                <span class="control flex items-center gap-1 px-2 py-1">
                    <input type="number" min="0" max="100" step="1" aria-label="@label weight percent" class="w-12 bg-transparent text-right text-sm tabular-nums text-ink outline-none" value="@get()" @onchange="e => set(decimal.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 0, 100) : 0)" /><b class="label-instrument">%</b>
                </span>
            </span>
            <span class="track flex h-1.5 overflow-hidden" role="img" aria-hidden="true">
                <i class="@($"{barClass} rounded-full transition-[width] duration-150 ease-press")" style="@($"width:{Analytics.Svg((double)get())}%")"></i>
            </span>
        </label>;

    private RenderFragment Weight(string label, Func<decimal> get, Action<decimal> set) =>
        @<label class="group flex flex-col gap-1.5 py-2.5">
            <span class="flex items-center justify-between gap-3">
                <span class="flex-1 text-sm text-ink-soft">@((MarkupString)label)</span>
                <span class="control flex items-center gap-1 px-2 py-1">
                    <input type="number" min="0" max="100" class="w-12 bg-transparent text-right text-sm tabular-nums text-ink outline-none" value="@get()" @onchange="e => set(decimal.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 0, 100) : 0)" /><b class="label-instrument">%</b>
                </span>
            </span>
            <span class="track flex h-1 overflow-hidden" role="img" aria-hidden="true">
                <i class="rounded-full bg-chart-6 transition-[width] duration-150 ease-press" style="@($"width:{Analytics.Svg((double)get())}%")"></i>
            </span>
        </label>;
}
