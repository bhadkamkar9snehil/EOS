@page "/scoring"
@using EngineeringPerformance.Application
@inject IApplicationDatabase Database
@inject IScoringPresetService Presets
@inject AppState State
@inject IJSRuntime JS

<section class="flex flex-col gap-6">
    <div>
        <h2 class="text-xl font-bold text-ink">Operational score configuration</h2>
        <p class="mt-1 text-sm text-ink-soft">Controls the operational score shown everywhere in EOS.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="card">
            <div class="panel-head"><h2 class="text-sm font-bold text-ink">Operational weights</h2><small class="text-[11px] text-muted">Persisted locally</small></div>

            <div class="flex flex-col divide-y divide-line">
                @OperationalWeight("Timesheet completion", "Entered hours against compliance hours", () => _timesheet, v => _timesheet = v)
                @OperationalWeight("Approval completion", "Approved hours against entered hours", () => _approval, v => _approval = v)
                @OperationalWeight("Attendance discipline", "Filled days, punches, duration and punctuality", () => _attendance, v => _attendance = v)
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-3">
                <div class="@($"flex flex-1 items-center gap-2 rounded-lg px-3 py-2 {(IsOperationalValid ? "bg-good-soft" : "bg-critical-soft")}")">
                    <span class="text-xs text-ink-soft">Total</span>
                    <strong class="@($"text-base font-bold {(IsOperationalValid ? "text-good" : "text-critical")}")">@Analytics.Format(OperationalTotal, "0.#")%</strong>
                    <small class="text-[11px] text-ink-soft">@OperationalValidationText</small>
                </div>
                <button class="btn btn-secondary" @onclick="ResetOperational" disabled="@State.Busy">Reset 55 / 15 / 30</button>
                <button class="btn btn-primary" @onclick="SaveAndRecalculateAsync" disabled="@(State.Busy || !IsOperationalValid)">Save &amp; recalculate</button>
            </div>
        </div>

        <div class="card">
            <div class="panel-head"><h2 class="text-sm font-bold text-ink">Current weighting</h2><small class="text-[11px] text-muted">Applied proportionally when a source is unavailable</small></div>
            <div class="flex h-3 overflow-hidden rounded-full bg-line" role="img" aria-label="@OperationalStackDescription">
                @if (_timesheet > 0) { <i class="bg-chart-1" style="@($"flex:{Analytics.Svg((double)_timesheet)}")"></i> }
                @if (_approval > 0) { <i class="bg-chart-2" style="@($"flex:{Analytics.Svg((double)_approval)}")"></i> }
                @if (_attendance > 0) { <i class="bg-chart-3" style="@($"flex:{Analytics.Svg((double)_attendance)}")"></i> }
            </div>
            <ul class="mt-3 flex flex-col gap-1.5 text-sm">
                <li class="flex items-center gap-2"><i class="h-2.5 w-2.5 rounded-full bg-chart-1"></i><span class="flex-1 text-ink-soft">Timesheet completion</span><b class="font-semibold text-ink">@Analytics.Format(_timesheet, "0.#")%</b></li>
                <li class="flex items-center gap-2"><i class="h-2.5 w-2.5 rounded-full bg-chart-2"></i><span class="flex-1 text-ink-soft">Approval completion</span><b class="font-semibold text-ink">@Analytics.Format(_approval, "0.#")%</b></li>
                <li class="flex items-center gap-2"><i class="h-2.5 w-2.5 rounded-full bg-chart-3"></i><span class="flex-1 text-ink-soft">Attendance discipline</span><b class="font-semibold text-ink">@Analytics.Format(_attendance, "0.#")%</b></li>
            </ul>
            <div class="mt-4 rounded-lg bg-surface-inset p-3">
                <strong class="block text-xs font-semibold text-ink">Recalculation scope</strong>
                <p class="mt-0.5 text-xs text-ink-soft">Saving recalculates every existing monthly row.</p>
            </div>
        </div>
    </div>

    <div>
        <h2 class="text-lg font-bold text-ink">Scoring presets</h2>
        <p class="mt-1 text-sm text-ink-soft">Applying a preset saves and recalculates immediately.</p>
    </div>

    <div class="card">
        <div class="flex flex-col divide-y divide-line">
            @foreach (var preset in _presets)
            {
                <div class="flex items-center justify-between gap-3 py-2.5">
                    <span>
                        <strong class="block text-sm font-medium text-ink">@preset.Name</strong>
                        <small class="text-[11px] text-muted">@Analytics.Format(preset.Settings.TimesheetCompletionWeight, "0.#")% timesheet · @Analytics.Format(preset.Settings.ApprovalCompletionWeight, "0.#")% approval · @Analytics.Format(preset.Settings.AttendanceDisciplineWeight, "0.#")% attendance</small>
                    </span>
                    <span class="flex gap-2">
                        <button class="btn btn-secondary" @onclick="() => ApplyPresetAsync(preset)" disabled="@State.Busy">Apply</button>
                        @if (!preset.IsBuiltIn)
                        {
                            <button class="btn btn-secondary" @onclick="() => DeletePresetAsync(preset.Name)" disabled="@State.Busy">Delete</button>
                        }
                    </span>
                </div>
            }
        </div>
        <div class="mt-3 flex gap-2">
            <input class="flex-1 rounded-lg border border-line bg-surface-inset px-3 py-1.5 text-sm text-ink outline-none placeholder:text-muted focus:border-primary" placeholder="New preset name" value="@_newPresetName" @oninput="e => _newPresetName = e.Value?.ToString() ?? string.Empty" />
            <button class="btn btn-primary" @onclick="SaveCurrentAsPresetAsync" disabled="@(State.Busy || string.IsNullOrWhiteSpace(_newPresetName) || !IsOperationalValid)">Save current weights as preset</button>
        </div>
    </div>

    <div>
        <h2 class="text-lg font-bold text-ink">Review framework preview</h2>
        <p class="mt-1 text-sm text-ink-soft">Planning preview — does not alter the score above.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="card">
            <div class="panel-head"><h2 class="text-sm font-bold text-ink">Review category weights</h2><small class="text-[11px] text-muted">Preview only</small></div>
            <div class="flex flex-col divide-y divide-line">
                @Weight("Assignment execution", () => _execution, v => _execution = v)
                @Weight("Ownership &amp; accountability", () => _ownership, v => _ownership = v)
                @Weight("Collaboration", () => _collaboration, v => _collaboration = v)
                @Weight("Operational discipline", () => _discipline, v => _discipline = v)
                @Weight("Professional excellence", () => _excellence, v => _excellence = v)
                @Weight("Continuous improvement", () => _improvement, v => _improvement = v)
                @Weight("Growth &amp; learning", () => _growth, v => _growth = v)
            </div>
        </div>

        <div class="flex flex-col gap-4">
            <div class="card">
                <div class="panel-head"><h2 class="text-sm font-bold text-ink">Review-weight validation</h2><small class="text-[11px] text-muted">Must total 100%</small></div>
                <div class="flex items-center gap-3">
                    <span class="@($"rounded-lg px-3 py-1.5 text-base font-bold {(IsReviewValid ? "bg-good-soft text-good" : "bg-critical-soft text-critical")}")">@Analytics.Format(ReviewTotal, "0.#")%</span>
                    <span class="@($"text-xs font-medium {(IsReviewValid ? "text-good" : "text-critical")}")">@(IsReviewValid ? "Valid preview" : ReviewTotal > 100 ? $"Over by {Analytics.Format(ReviewTotal - 100, "0.#")}" : $"Under by {Analytics.Format(100 - ReviewTotal, "0.#")}")</span>
                </div>
            </div>
            <div class="card">
                <div class="panel-head"><h2 class="text-sm font-bold text-ink">Score bands</h2><small class="text-[11px] text-muted">Applied across the application</small></div>
                <ul class="flex flex-col gap-1.5">
                    @foreach (var (band, label, range) in Bands)
                    {
                        <li class="flex items-center gap-2 text-sm"><i class="@($"h-2.5 w-2.5 rounded-full {Analytics.BandBgClass(band)}")"></i><span class="flex-1 text-ink-soft">@label</span><b class="font-semibold text-ink">@range</b></li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

@code {
    private decimal _timesheet = 55m;
    private decimal _approval = 15m;
    private decimal _attendance = 30m;

    private decimal _execution = 25, _ownership = 15, _collaboration = 15, _discipline = 15,
                    _excellence = 10, _improvement = 10, _growth = 10;

    private IReadOnlyList<ScoringPreset> _presets = [];
    private string _newPresetName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var settings = await Database.GetOperationalScoringSettingsAsync();
        _timesheet = settings.TimesheetCompletionWeight;
        _approval = settings.ApprovalCompletionWeight;
        _attendance = settings.AttendanceDisciplineWeight;
        _presets = await Presets.GetPresetsAsync();
    }

    private async Task ApplyPresetAsync(ScoringPreset preset)
    {
        _timesheet = preset.Settings.TimesheetCompletionWeight;
        _approval = preset.Settings.ApprovalCompletionWeight;
        _attendance = preset.Settings.AttendanceDisciplineWeight;
        await SaveAndRecalculateAsync();
        State.ShowMessage($"Applied preset “{preset.Name}”.");
    }

    private async Task SaveCurrentAsPresetAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPresetName)) return;
        await State.RunAsync(async () =>
        {
            var settings = new OperationalScoringSettings(_timesheet, _approval, _attendance);
            await Presets.SavePresetAsync(_newPresetName, settings);
            _presets = await Presets.GetPresetsAsync();
            State.ShowMessage($"Preset “{_newPresetName}” saved.");
            _newPresetName = string.Empty;
        });
    }

    private async Task DeletePresetAsync(string name)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete preset \"{name}\"?");
        if (!confirmed) return;
        await State.RunAsync(async () =>
        {
            await Presets.DeletePresetAsync(name);
            _presets = await Presets.GetPresetsAsync();
            State.ShowMessage($"Preset “{name}” deleted.");
        });
    }

    private decimal OperationalTotal => _timesheet + _approval + _attendance;
    private bool IsOperationalValid => _timesheet >= 0 && _approval >= 0 && _attendance >= 0 && OperationalTotal == 100m;
    private string OperationalValidationText => IsOperationalValid ? "Ready to apply" : OperationalTotal > 100m
        ? $"Reduce by {Analytics.Format(OperationalTotal - 100m, "0.#")}%"
        : $"Add {Analytics.Format(100m - OperationalTotal, "0.#")}%";

    private string OperationalStackDescription => $"Timesheet completion {_timesheet}%, approval completion {_approval}%, attendance discipline {_attendance}%";

    private async Task SaveAndRecalculateAsync()
    {
        await State.RunAsync(async () =>
        {
            var settings = new OperationalScoringSettings(_timesheet, _approval, _attendance);
            var count = await Database.SaveOperationalScoringSettingsAsync(settings);
            await State.RefreshAsync();
            State.ShowMessage($"Operational scoring saved. {count} monthly performance rows recalculated.");
        });
    }

    private void ResetOperational()
    {
        _timesheet = 55m;
        _approval = 15m;
        _attendance = 30m;
    }

    private decimal ReviewTotal => _execution + _ownership + _collaboration + _discipline + _excellence + _improvement + _growth;
    private bool IsReviewValid => ReviewTotal == 100m;

    private static IEnumerable<(string Band, string Label, string Range)> Bands =>
    [
        ("good", "Strong", "85 and above"),
        ("warning", "On track", "70 – 84"),
        ("serious", "At risk", "55 – 69"),
        ("critical", "Critical", "below 55")
    ];

    private RenderFragment OperationalWeight(string label, string detail, Func<decimal> get, Action<decimal> set) =>
        @<label class="flex items-center justify-between gap-3 py-2.5">
            <span class="flex-1"><strong class="block text-sm font-medium text-ink">@label</strong><small class="text-[11px] text-muted">@detail</small></span>
            <span class="flex items-center gap-1 rounded-lg border border-line bg-surface-inset px-2 py-1">
                <input type="number" min="0" max="100" step="1" class="w-12 bg-transparent text-right text-sm text-ink outline-none" value="@get()" @onchange="e => set(decimal.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 0, 100) : 0)" /><b class="text-xs text-muted">%</b>
            </span>
        </label>;

    private RenderFragment Weight(string label, Func<decimal> get, Action<decimal> set) =>
        @<label class="flex items-center justify-between gap-3 py-2.5">
            <span class="flex-1 text-sm text-ink-soft">@((MarkupString)label)</span>
            <span class="flex items-center gap-1 rounded-lg border border-line bg-surface-inset px-2 py-1">
                <input type="number" min="0" max="100" class="w-12 bg-transparent text-right text-sm text-ink outline-none" value="@get()" @onchange="e => set(decimal.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 0, 100) : 0)" /><b class="text-xs text-muted">%</b>
            </span>
        </label>;
}
