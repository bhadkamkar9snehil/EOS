@using System.Globalization
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<section class="card" aria-label="Peer rating network">
    <header class="panel-head">
        <div>
            <h2 class="text-sm font-bold text-ink">Peer rating network</h2>
            <small class="text-[11px] text-muted">Arrow: reviewer → colleague · line strength: selected rating</small>
        </div>
        @if (ShowAtlasButton)
        {
            <button type="button" class="btn btn-secondary ml-auto" @onclick='() => Navigation.NavigateTo("/peer-insights")'>Open collaboration atlas</button>
        }
    </header>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap gap-1 rounded-lg bg-surface-inset p-1" role="group" aria-label="Peer rating aspect">
            @foreach (var aspect in Aspects)
            {
                <button type="button" class="@($"rounded-md px-2.5 py-1 text-xs font-medium {(_aspect == aspect.Key ? "bg-surface text-primary shadow-sm" : "text-ink-soft hover:text-ink")}")" aria-pressed="@(_aspect == aspect.Key)" @onclick="() => SelectAspect(aspect.Key)">@aspect.Label</button>
            }
        </div>
        <div class="flex gap-3 text-[11px] text-muted"><span>As of @DateTime.Today.ToString("yyyy-MM-dd")</span><span>Reporting period: <b class="text-ink-soft">@SelectedMonth.ToString("MMMM yyyy")</b></span></div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-3">
        <div class="relative">
            <input class="w-56 rounded-lg border border-line bg-surface-inset px-3 py-1.5 text-sm text-ink outline-none placeholder:text-muted focus:border-primary" value="@_search" @oninput="OnSearch" @onfocus="OpenSearch" placeholder="Search people" aria-label="Search people" />
            @if (_searchOpen && SearchResults.Count > 0)
            {
                <div class="absolute left-0 top-10 z-20 w-56 rounded-lg border border-line bg-surface p-1 shadow-lg">
                    @foreach (var person in SearchResults)
                    {
                        <button type="button" class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm hover:bg-surface-inset" @onclick="() => FocusPerson(person)"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-surface-inset text-[10px] font-semibold text-ink-soft">@Analytics.Initials(person)</span><b class="font-medium text-ink">@person</b></button>
                    }
                </div>
            }
        </div>

        <div class="flex flex-1 items-center justify-center gap-2 text-xs text-ink-soft" aria-label="Focused employee navigation">
            <button type="button" class="rounded px-1.5 py-0.5 hover:bg-surface-inset" title="Previous person" @onclick="PreviousPerson">‹</button>
            <span>Previous: <b class="text-ink">@PreviousName</b></span>
            <strong class="rounded-full bg-primary-soft px-2.5 py-1 text-primary">Focused: @_focusName</strong>
            <span>Next: <b class="text-ink">@NextName</b></span>
            <button type="button" class="rounded px-1.5 py-0.5 hover:bg-surface-inset" title="Next person" @onclick="NextPerson">›</button>
        </div>

        <div class="flex items-center gap-3">
            <div class="flex gap-1 rounded-lg bg-surface-inset p-1" role="group" aria-label="Connection emphasis">
                @foreach (var option in Directions)
                {
                    <button type="button" class="@($"rounded-md px-2.5 py-1 text-xs font-medium {(_direction == option.Key ? "bg-surface text-primary shadow-sm" : "text-ink-soft hover:text-ink")}")" aria-pressed="@(_direction == option.Key)" @onclick="() => SelectDirection(option.Key)">@option.Label</button>
                }
            </div>
            <div class="flex items-center gap-1.5 text-xs text-ink-soft"><span>Coverage</span><b class="text-ink">@Analytics.Format(FocusCoverage, "0")%</b></div>
        </div>
    </div>

    <div class="relative mt-4 grid grid-cols-1 gap-4 lg:grid-cols-[1fr_140px_1fr]" id="@_mapId">
        <canvas aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full"></canvas>

        <div class="relative z-10">
            <h3 class="text-xs font-semibold text-ink-soft">People who rated @_focusFirstName <span class="font-normal text-muted">(Inbound)</span></h3>
            <div class="mt-2 grid grid-cols-[1fr_2.5rem_2.5rem_2.5rem_2.5rem] gap-1 border-b border-line pb-1 text-[10px] font-semibold text-muted"><span></span><b>Overall</b><span>Collab</span><span>Comm</span><span>Reliab</span></div>
            <div class="mt-1 flex flex-col divide-y divide-line">
                @if (Inbound.Count == 0)
                {
                    <div class="py-3 text-xs text-muted">No inbound ratings for this period.</div>
                }
                @foreach (var relationship in Inbound)
                {
                    @RelationshipRow(relationship, true)
                }
            </div>
        </div>

        <div class="relative z-10 flex flex-col items-center justify-center gap-1 self-start rounded-xl border border-primary-soft bg-primary-soft px-4 py-4 text-center lg:self-center">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-xs font-bold text-white">@Analytics.Initials(_focusName)</span>
            <strong class="text-sm font-semibold text-ink">@_focusName</strong>
            <b class="text-lg font-bold text-primary">@Analytics.Format(FocusAverage, "0.0")</b>
        </div>

        <div class="relative z-10">
            <h3 class="text-xs font-semibold text-ink-soft">People @_focusFirstName rated <span class="font-normal text-muted">(Outbound)</span></h3>
            <div class="mt-2 grid grid-cols-[1fr_2.5rem_2.5rem_2.5rem_2.5rem_4rem] gap-1 border-b border-line pb-1 text-[10px] font-semibold text-muted"><span></span><b>Overall</b><span>Collab</span><span>Comm</span><span>Reliab</span><span>Reciprocal?</span></div>
            <div class="mt-1 flex flex-col divide-y divide-line">
                @if (Outbound.Count == 0)
                {
                    <div class="py-3 text-xs text-muted">No outbound ratings for this period.</div>
                }
                @foreach (var relationship in Outbound)
                {
                    @RelationshipRow(relationship, false)
                }
            </div>
        </div>
    </div>

    @if (SelectedRelationship is not null)
    {
        var selected = SelectedRelationship;
        var reciprocal = ReciprocalOf(selected);
        <div class="mt-4 rounded-xl border border-line bg-surface-inset p-4">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-ink-soft">
                <span>Selected relationship: <b class="text-ink">@selected.Reviewer</b> → <strong class="text-ink">@selected.Subject</strong></span>
                <span>Feedback count: <b class="text-ink">@selected.Count</b></span>
                <span>Reciprocal: <b class="text-ink">@(reciprocal is null ? "No" : "Yes")</b></span>
                <button type="button" class="text-base text-muted hover:text-ink" title="Close relationship details" @onclick="ClearRelationship">×</button>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
                @PersonDetail("Reviewer", selected.Reviewer)
                @PersonDetail("Recipient", selected.Subject)
                @MetricDetail("Overall rating", selected.Overall, reciprocal?.Overall)
                <div class="col-span-2 md:col-span-2">
                    <label class="block text-[10px] text-muted">Four aspects (out of 5)</label>
                    <div class="mt-1 flex flex-wrap gap-3">
                        @AspectDetail("Collaboration", selected.Collaboration, reciprocal?.Collaboration)
                        @AspectDetail("Communication", selected.Communication, reciprocal?.Communication)
                        @AspectDetail("Reliability", selected.Reliability, reciprocal?.Reliability)
                        @AspectDetail("Technical help", selected.TechnicalHelp, reciprocal?.TechnicalHelp)
                    </div>
                </div>
                <div><label class="block text-[10px] text-muted">Rating gap <small>(Reviewer - Recipient)</small></label><strong class="text-sm font-semibold text-ink">@Gap(selected.Overall, reciprocal?.Overall)</strong></div>
                <div><label class="block text-[10px] text-muted">Feedback count <small>(This relationship)</small></label><strong class="text-sm font-semibold text-ink">@selected.Count</strong></div>
                <div><label class="block text-[10px] text-muted">Reciprocal</label><strong class="text-sm font-semibold text-ink">@(reciprocal is null ? "No" : "Yes")</strong><small class="block text-[11px] text-muted">@(reciprocal is null ? $"{selected.Subject} has not rated {selected.Reviewer}" : $"{selected.Subject} rated {selected.Reviewer}")</small></div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PeerReviewItem> Reviews { get; set; } = [];
    [Parameter, EditorRequired] public DateTime SelectedMonth { get; set; }
    [Parameter] public bool ShowAtlasButton { get; set; }
    [Parameter] public string? InitialFocusName { get; set; }

    private static readonly Option[] Aspects = [new("overall", "Overall"), new("collaboration", "Collaboration"), new("communication", "Communication"), new("reliability", "Reliability"), new("technicalHelp", "Technical help")];
    private static readonly Option[] Directions = [new("inbound", "Inbound"), new("outbound", "Outbound"), new("both", "Both")];
    private readonly string _mapId = $"peer-relationship-map-{Guid.NewGuid():N}";
    private string _aspect = "overall";
    private string _direction = "both";
    private string _focusName = string.Empty;
    private string _search = string.Empty;
    private bool _searchOpen;
    private bool _connectorsPending = true;
    private string? _selectedKey;

    private string[] People => Reviews.SelectMany(x => new[] { x.ReviewerName, x.SubjectName }).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToArray();
    private string _focusFirstName => string.IsNullOrWhiteSpace(_focusName) ? "this person" : _focusName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? _focusName;
    private int FocusIndex => Math.Max(0, Array.FindIndex(People, x => PersonName.Matches(x, _focusName)));
    private string PreviousName => People.Length < 2 ? "—" : People[(FocusIndex - 1 + People.Length) % People.Length];
    private string NextName => People.Length < 2 ? "—" : People[(FocusIndex + 1) % People.Length];
    private IReadOnlyList<string> SearchResults => string.IsNullOrWhiteSpace(_search) ? [] : People.Where(x => x.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)).Take(7).ToArray();
    private IReadOnlyList<Relationship> Relationships => Reviews.GroupBy(x => (Reviewer: PersonName.Normalize(x.ReviewerName), Subject: PersonName.Normalize(x.SubjectName))).Select(group => new Relationship(
        group.Key.Reviewer, group.Key.Subject, group.Count(),
        decimal.Round(group.Average(x => x.Average), 2), decimal.Round(group.Average(x => x.Collaboration), 2),
        decimal.Round(group.Average(x => x.Communication), 2), decimal.Round(group.Average(x => x.Reliability), 2),
        decimal.Round(group.Average(x => x.TechnicalHelp), 2))).ToArray();
    private IReadOnlyList<Relationship> Inbound => Relationships.Where(x => PersonName.Matches(x.Subject, _focusName)).OrderByDescending(AspectValue).ThenBy(x => x.Reviewer).ToArray();
    private IReadOnlyList<Relationship> Outbound => Relationships.Where(x => PersonName.Matches(x.Reviewer, _focusName)).OrderByDescending(AspectValue).ThenBy(x => x.Subject).ToArray();
    private Relationship? SelectedRelationship => Relationships.FirstOrDefault(x => x.Key == _selectedKey);
    private decimal FocusAverage
    {
        get
        {
            var values = Inbound.Select(AspectValue).Where(x => x > 0).ToArray();
            return values.Length == 0 ? 0 : decimal.Round(values.Average(), 1);
        }
    }
    private decimal FocusCoverage => People.Length <= 1 ? 0 : decimal.Round((Inbound.Count + Outbound.Count) * 100m / ((People.Length - 1) * 2m), 0);

    protected override void OnParametersSet()
    {
        if (People.Length == 0) { _focusName = string.Empty; return; }
        if (!string.IsNullOrWhiteSpace(InitialFocusName) && People.Any(x => PersonName.Matches(x, InitialFocusName!))) _focusName = People.First(x => PersonName.Matches(x, InitialFocusName!));
        if (string.IsNullOrWhiteSpace(_focusName) || !People.Any(x => PersonName.Matches(x, _focusName)))
            _focusName = Reviews.GroupBy(x => x.SubjectName, StringComparer.OrdinalIgnoreCase).OrderByDescending(x => x.Count()).ThenBy(x => x.Key).First().Key;
        if (_selectedKey is not null && Relationships.All(x => x.Key != _selectedKey)) _selectedKey = null;
        _connectorsPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_connectorsPending || string.IsNullOrWhiteSpace(_focusName)) return;
        _connectorsPending = false;
        var inbound = Inbound.Select(x => new { id = RowId(x), rating = (double)AspectValue(x), selected = x.Key == _selectedKey }).ToArray();
        var outbound = Outbound.Select(x => new { id = RowId(x), rating = (double)AspectValue(x), selected = x.Key == _selectedKey, reciprocal = ReciprocalOf(x) is not null }).ToArray();
        await JS.InvokeVoidAsync("epaAtlas.peerRelationshipConnectors", _mapId, inbound, outbound, _direction);
    }

    private RenderFragment RelationshipRow(Relationship relationship, bool inbound) =>
        @<button id="@RowId(relationship)" type="button" class="@($"grid w-full items-center gap-1 rounded-md px-1 py-1.5 text-left hover:bg-surface-inset {(inbound ? "grid-cols-[1fr_2.5rem_2.5rem_2.5rem_2.5rem]" : "grid-cols-[1fr_2.5rem_2.5rem_2.5rem_2.5rem_4rem]")} {(relationship.Key == _selectedKey ? "bg-primary-soft" : "")} {(DirectionMuted(inbound) ? "opacity-40" : "")}")" @onclick="() => SelectRelationship(relationship)">
            <span class="flex min-w-0 items-center gap-1.5"><i class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-surface-inset text-[9px] font-semibold not-italic text-ink-soft">@Analytics.Initials(inbound ? relationship.Reviewer : relationship.Subject)</i><b class="truncate text-xs font-medium text-ink">@(inbound ? relationship.Reviewer : relationship.Subject)</b></span>
            <strong class="@($"text-xs font-semibold {RatingClass(AspectValue(relationship))}")">@Analytics.Format(AspectValue(relationship), "0.0")</strong>
            @RatingCell(relationship.Collaboration)
            @RatingCell(relationship.Communication)
            @RatingCell(relationship.Reliability)
            @if (!inbound) { <em class="@($"not-italic text-[10px] font-semibold {(ReciprocalOf(relationship) is null ? "text-muted" : "text-good")}")">@(ReciprocalOf(relationship) is null ? "No" : "Yes")</em> }
        </button>;

    private RenderFragment RatingCell(decimal value) => @<span class="text-xs tabular-nums text-ink-soft">@Analytics.Format(value, "0.0")</span>;
    private RenderFragment PersonDetail(string label, string name) => @<div><label class="block text-[10px] text-muted">@label</label><span class="mt-0.5 flex items-center gap-1.5"><i class="flex h-5 w-5 items-center justify-center rounded-full bg-surface text-[9px] font-semibold not-italic text-ink-soft">@Analytics.Initials(name)</i><b class="text-sm font-medium text-ink">@name</b></span></div>;
    private RenderFragment MetricDetail(string label, decimal value, decimal? reciprocal) => @<div><label class="block text-[10px] text-muted">@label</label><strong class="text-sm font-semibold text-ink">@Analytics.Format(value, "0.0")</strong>@if (reciprocal.HasValue) { <b class="ml-1 text-xs text-muted">(@Analytics.Format(reciprocal.Value, "0.0"))</b> }</div>;
    private RenderFragment AspectDetail(string label, decimal value, decimal? reciprocal) => @<span class="text-xs"><label class="block text-[10px] text-muted">@label</label><b class="text-ink">@Analytics.Format(value, "0.0")</b>@if (reciprocal.HasValue) { <small class="ml-1 text-muted">(@Analytics.Format(reciprocal.Value, "0.0"))</small> }</span>;

    private void OnSearch(ChangeEventArgs args) { _search = args.Value?.ToString() ?? string.Empty; _searchOpen = true; }
    private void OpenSearch(FocusEventArgs _) => _searchOpen = true;
    private void FocusPerson(string name) { _focusName = name; _search = string.Empty; _searchOpen = false; _selectedKey = null; _connectorsPending = true; }
    private void PreviousPerson() => FocusPerson(PreviousName);
    private void NextPerson() => FocusPerson(NextName);
    private void SelectAspect(string aspect) { _aspect = aspect; _connectorsPending = true; }
    private void SelectDirection(string direction) { _direction = direction; _connectorsPending = true; }
    private void SelectRelationship(Relationship relationship) { _selectedKey = relationship.Key; _connectorsPending = true; }
    private void ClearRelationship() { _selectedKey = null; _connectorsPending = true; }
    private bool DirectionMuted(bool inbound) => _direction != "both" && ((_direction == "inbound") != inbound);
    private Relationship? ReciprocalOf(Relationship relationship) => Relationships.FirstOrDefault(x => PersonName.Matches(x.Reviewer, relationship.Subject) && PersonName.Matches(x.Subject, relationship.Reviewer));
    private decimal AspectValue(Relationship x) => _aspect switch { "collaboration" => x.Collaboration, "communication" => x.Communication, "reliability" => x.Reliability, "technicalHelp" => x.TechnicalHelp, _ => x.Overall };
    private string RatingClass(decimal value) => value < 3m ? "text-critical" : value >= 4m ? "text-good" : "text-ink";
    private static string Gap(decimal value, decimal? reciprocal) => reciprocal.HasValue ? (value - reciprocal.Value).ToString("+0.0;-0.0;0.0", CultureInfo.InvariantCulture) : "—";
    private string RowId(Relationship relationship) => $"{_mapId}-{Math.Abs(StringComparer.OrdinalIgnoreCase.GetHashCode(relationship.Key)):x}";

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("epaAtlas.disposePeerRelationshipConnectors", _mapId); }
        catch (JSDisconnectedException) { }
    }

    private sealed record Option(string Key, string Label);
    private sealed record Relationship(string Reviewer, string Subject, int Count, decimal Overall, decimal Collaboration, decimal Communication, decimal Reliability, decimal TechnicalHelp)
    {
        public string Key => $"{Reviewer}|{Subject}";
    }
}
