@page "/imports"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IApplicationDatabase Database
@inject IFileDialogService Dialogs
@inject AppState State
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="flex flex-col gap-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <div class="panel-eyebrow">Data operations</div>
            <h2 class="panel-title">Import and evidence workspace</h2>
        </div>
        <div class="flex items-end gap-6">
            <div class="text-right">
                <div class="metric text-metric-sm tabular-nums">@State.SystemReadyCount<span class="text-muted">/3</span></div>
                <div class="label-instrument mt-1">ERP inputs</div>
            </div>
            <div class="text-right">
                <div class="metric text-metric-sm tabular-nums">@ReviewReviewerCount</div>
                <div class="label-instrument mt-1">@(ReviewReviewerCount == 1 ? "Reviewer" : "Reviewers")</div>
            </div>
            @if (_workspace == Workspace.Intake)
            {
                <button class="btn btn-primary" @onclick="UploadZipAsync" disabled="@State.Busy">Import package</button>
            }
        </div>
    </header>

    <nav class="plate grid grid-cols-1 gap-2 p-2 sm:grid-cols-3" aria-label="Data operations views">
        <button type="button" class="@WorkspaceButtonClass(Workspace.Intake)" aria-pressed="@(_workspace == Workspace.Intake)" @onclick="() => _workspace = Workspace.Intake">
            <strong>Daily import</strong><span class="badge bg-surface-inset text-muted">@State.SystemReadyCount/3</span>
        </button>
        <button type="button" class="@WorkspaceButtonClass(Workspace.History)" aria-pressed="@(_workspace == Workspace.History)" @onclick="() => _workspace = Workspace.History">
            <strong>Import ledger</strong><span class="badge bg-surface-inset text-muted">@_allHistoryCount</span>
        </button>
        <button type="button" class="@WorkspaceButtonClass(Workspace.Rows)" aria-pressed="@(_workspace == Workspace.Rows)" @onclick="() => _workspace = Workspace.Rows">
            <strong>Evidence rows</strong><span class="badge bg-surface-inset text-muted">@State.Performance.Count</span>
        </button>
    </nav>

    @if (_workspace == Workspace.Intake)
    {
    <section class="plate grid grid-cols-1 gap-2 p-3 sm:grid-cols-2 lg:grid-cols-5" aria-label="Import workflow">
        @PipelineNode(1, "Period", true, State.SelectedMonth.ToString("MMM yy"))
        @PipelineNode(2, "ERP evidence", State.SystemReadyCount >= 3, $"{State.SystemReadyCount}/3")
        @PipelineNode(3, "Normalize", State.Performance.Count > 0, State.Performance.Count == 0 ? "waiting" : $"{State.Performance.Count} people")
        @PipelineNode(4, "Review evidence", State.ReviewsUploaded, State.ReviewsUploaded ? "loaded" : "optional")
        @PipelineNode(5, "Atlas", State.Performance.Count > 0, State.Performance.Count > 0 ? "ready" : "waiting")
    </section>

    <div class="grid grid-cols-1 gap-4 xl:grid-cols-[1fr_300px]">
        <section class="flex flex-col gap-4">
            <section class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Peer review intake</div>
                        <h2 class="panel-title">Add returned employee reviews</h2>
                    </div>
                    <div class="ml-auto flex shrink-0 gap-2">
                        <button class="btn btn-primary" @onclick="AddReviewsAsync" disabled="@State.Busy">Add review files</button>
                        <button class="btn btn-secondary" @onclick="BeginReplaceReviews" disabled="@State.Busy">Replace month set</button>
                    </div>
                </div>

                <div class="well mt-4 grid grid-cols-2 gap-3 p-3 sm:grid-cols-4" aria-label="Loaded review evidence">
                    <div><div class="metric text-metric-sm tabular-nums">@ReviewReviewerCount</div><div class="label-instrument mt-1">Reviewers loaded</div></div>
                    <div><div class="metric text-metric-sm tabular-nums">@State.PeerReviews.Count</div><div class="label-instrument mt-1">Feedback entries</div></div>
                    <div><div class="metric text-metric-sm tabular-nums">@ReviewSubjectCount</div><div class="label-instrument mt-1">People reviewed</div></div>
                    <div><div class="metric text-sm tabular-nums">@(LastReviewImport is { } last ? last.ImportedLocal.ToString("dd MMM · HH:mm") : "Not yet")</div><div class="label-instrument mt-1">Last review upload</div></div>
                </div>

                @if (_confirmReplaceReviews)
                {
                    <div class="mt-3 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-critical-soft bg-critical-soft p-3" role="alert">
                        <strong class="block text-sm font-semibold text-critical">Replace all reviews · @State.SelectedMonth.ToString("MMMM yyyy")</strong>
                        <div class="flex gap-2">
                            <button class="btn btn-danger" @onclick="ReplaceReviewsAsync" disabled="@State.Busy">Choose replacement files</button>
                            <button class="btn btn-secondary" @onclick="CancelReplaceReviews" disabled="@State.Busy">Cancel</button>
                        </div>
                    </div>
                }

                @if (_lastReviewImport is { } result)
                {
                    <div class="well mt-3 p-3">
                        <div class="mb-2">
                            <div class="metric text-metric-sm tabular-nums">@result.AcceptedWorkbooks</div>
                            <div class="label-instrument mt-1">Workbooks accepted</div>
                            <div class="mt-1 text-xs tabular-nums text-muted">@result.AddedReviews added · @result.UpdatedReviews updated · @result.RemovedReviews removed · @result.TotalReviews total</div>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            @foreach (var file in result.Files)
                            {
                                <span class="flex items-center gap-2 rounded-md bg-surface p-1.5 text-xs" data-state="@(file.Accepted ? "accepted" : "rejected")" title="@(file.Error ?? file.ReviewerName)">
                                    <i class="@($"h-2 w-2 shrink-0 lamp {(file.Accepted ? "text-good" : "text-critical")}")" aria-hidden="true"></i>
                                    <b class="@(file.Accepted ? "text-good" : "text-critical")">@(file.Accepted ? "Accepted" : "Rejected")</b>
                                    <i class="not-italic text-ink-soft">@file.FileName</i>
                                    <em class="not-italic tabular-nums text-muted">@(file.Accepted ? $"{file.ReviewerName} · {file.ReviewCount} entries" : file.Error)</em>
                                </span>
                            }
                        </div>
                    </div>
                }

            </section>

            <section class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Register</div>
                        <h2 class="panel-title">Source register</h2>
                    </div>
                    <span class="label-instrument ml-auto tabular-nums">@State.SelectedMonth.ToString("MMMM yyyy")</span>
                </div>

                <div class="overflow-x-auto rounded-lg">
                    <div class="source-register-grid chassis rounded-md px-3 py-2 text-3xs font-semibold uppercase tracking-wide text-on-chassis-soft">
                        <span>Source</span><span>Expected export</span><span>Loaded evidence</span><span>Period</span><span>Imported</span><span>State</span><span>Action</span>
                    </div>
                    @foreach (var slot in State.Snapshot?.SourceSlots ?? [])
                    {
                        var ready = slot.Status == SourceStatus.Uploaded;
                        <div class="source-register-grid group border-b border-line-soft px-3 py-2.5 text-xs transition-colors duration-100 hover:bg-surface-inset" data-state="@(ready ? "accepted" : "open")">
                            <div class="flex items-center gap-2">
                                <i class="well flex h-7 w-7 shrink-0 items-center justify-center !rounded-md font-display text-3xs font-semibold not-italic text-ink-soft">@Initial(slot.ReportType)</i>
                                <strong class="truncate font-medium text-ink" title="@Label(slot.ReportType)">@Label(slot.ReportType)</strong>
                            </div>
                            <code class="block truncate text-2xs text-ink-soft" title="@ExpectedFileName(slot.ReportType)">@ExpectedFileName(slot.ReportType)</code>
                            <span class="block truncate text-ink-soft" title="@slot.FileName">@(slot.FileName ?? "—")</span>
                            <span class="whitespace-nowrap tabular-nums text-ink-soft">@State.SelectedMonth.ToString("MMM yyyy")</span>
                            <span class="whitespace-nowrap tabular-nums text-ink-soft">@(ImportedAt(slot.ReportType) is { } at ? at.ToString("dd MMM · HH:mm") : "—")</span>
                            <div class="flex items-center gap-1.5">
                                <i class="@($"h-2 w-2 shrink-0 {(ready ? "lamp text-good" : "lamp-off")}")" aria-hidden="true"></i>
                                <span class="@(ready ? "text-2xs text-good" : "text-2xs text-muted")">@(ready ? "Accepted" : "Open")</span>
                            </div>
                            <div>
                                @if (slot.ReportType == ReportType.EngineerReviewWorkbook)
                                {
                                    <button class="btn btn-secondary !px-2.5 !py-1 !text-2xs" @onclick="AddReviewsAsync" disabled="@State.Busy">Add files</button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary !px-2.5 !py-1 !text-2xs" @onclick="() => UploadAsync(slot.ReportType)" disabled="@State.Busy">@(ready ? "Replace" : "Load")</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>

        </section>

        <aside class="plate h-fit p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Checks</div>
                    <h2 class="panel-title">Pipeline status</h2>
                </div>
            </div>
            <div class="flex flex-col gap-2">
                @ValidationSignal("Local database", "SQLite available", true, "DB")
                @ValidationSignal("Roster", State.Employees.Count == 0 ? "No employees configured" : $"{State.Employees.Count} employees", State.Employees.Count > 0, "ID")
                @ValidationSignal("ERP evidence", $"{State.SystemReadyCount} of 3 required exports", State.SystemReadyCount >= 3, "ERP")
                @ValidationSignal("Review evidence", State.ReviewsUploaded ? "Review workbooks loaded" : "Not yet collected", State.ReviewsUploaded, "REV", true)
                @ValidationSignal("Calculated layer", State.Performance.Count == 0 ? "Waiting for valid source rows" : $"{State.Performance.Count} employee rows ready", State.Performance.Count > 0, "FX")
            </div>

            @if (State.Performance.Count > 0)
            {
                <div class="well mt-4 p-3">
                    <div class="label-instrument">Next</div>
                    <strong class="mt-1 block text-sm font-semibold text-ink">Performance Atlas is ready</strong>
                    <button class="btn btn-secondary mt-2 w-full" @onclick='() => Navigation.NavigateTo("/overview")'>Open team performance →</button>
                </div>
            }
        </aside>
    </div>
    }
    else
    {
        <DataBrowserPage Embedded="true" InitialView="@(_workspace == Workspace.History ? "history" : "rows")" />
    }
</div>

@code {
    private enum Workspace { Intake, History, Rows }
    private Workspace _workspace = Workspace.Intake;
    private IReadOnlyList<ImportHistoryItem> _history = [];
    private int _allHistoryCount;
    private ReviewImportResult? _lastReviewImport;
    private bool _confirmReplaceReviews;

    private int ReviewReviewerCount => State.PeerReviews.Select(x => x.ReviewerCode).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private int ReviewSubjectCount => State.PeerReviews.Select(x => x.SubjectCode).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private ImportHistoryItem? LastReviewImport => _history.FirstOrDefault(x => x.ReportType == ReportType.EngineerReviewWorkbook);

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        await ReloadHistoryAsync();
    }

    private void OnStateChanged() => InvokeAsync(async () => { await ReloadHistoryAsync(); StateHasChanged(); });
    public void Dispose() => State.Changed -= OnStateChanged;
    private async Task ReloadHistoryAsync()
    {
        _history = await Database.GetImportHistoryAsync(State.SelectedMonth.Year, State.SelectedMonth.Month);
        _allHistoryCount = (await Database.GetImportHistoryAsync())
            .Count(x => AppState.IsFiscalMonth(new DateTime(x.Year, x.Month, 1)));
    }
    private DateTime? ImportedAt(ReportType type) => _history.Where(x => x.ReportType == type).Select(x => (DateTime?)x.ImportedLocal).FirstOrDefault();

    private string WorkspaceButtonClass(Workspace workspace) => _workspace == workspace
        ? "control-pressed flex min-h-16 items-center justify-between gap-3 rounded-md border border-primary/45 bg-primary-soft px-4 py-3 font-display text-sm text-ink shadow-well"
        : "control flex min-h-16 items-center justify-between gap-3 rounded-md px-4 py-3 font-display text-sm text-ink transition-colors hover:bg-surface-inset";

    private RenderFragment PipelineNode(int number, string label, bool ready, string detail) =>
        @<div class="well flex w-full items-center gap-2.5 px-3 py-2" data-state="@(ready ? "ready" : "waiting")">
            <i class="@($"h-2 w-2 shrink-0 {(ready ? "lamp text-good" : "lamp-off")}")" aria-hidden="true"></i>
            <span class="flex flex-col leading-tight">
                <strong class="text-xs font-semibold text-ink"><span class="label-instrument mr-1 tabular-nums">@number</span>@label</strong>
                <small class="text-3xs tabular-nums text-muted">@detail</small>
            </span>
        </div>;

    private RenderFragment ValidationSignal(string title, string detail, bool good, string badge, bool optional = false) =>
        @<div class="well flex items-center gap-2 p-2" data-state="@(good ? "good" : optional ? "optional" : "missing")">
            <i class="@($"flex h-7 w-7 shrink-0 items-center justify-center rounded-md font-display text-[9px] font-semibold not-italic {(good ? "bg-good-soft text-good" : optional ? "bg-warning-soft text-warning" : "bg-critical-soft text-critical")}")">@badge</i>
            <span class="flex min-w-0 flex-1 flex-col"><strong class="truncate text-xs font-semibold text-ink">@title</strong><small class="truncate text-3xs tabular-nums text-muted">@detail</small></span>
            <i class="@($"h-2 w-2 shrink-0 {(good ? "lamp text-good" : optional ? "lamp text-warning" : "lamp text-critical")}")" title="@(good ? "Ready" : optional ? "Optional" : "Missing")" aria-hidden="true"></i>
        </div>;

    private async Task UploadAsync(ReportType type)
    {
        var path = Dialogs.PickWorkbook();
        if (path is null) return;
        await State.RunAsync(async () =>
        {
            ImportPreview? preview = null;
            try { preview = await Database.PreviewImportSourceAsync(type, State.SelectedMonth.Year, State.SelectedMonth.Month, path); }
            catch (NotSupportedException) { /* preview unavailable on this database implementation — import directly */ }

            if (preview is not null)
            {
                var summary = $"{Path.GetFileName(path)} → {Label(type)}\n\n" +
                    $"{preview.RowsAdded} row(s) added, {preview.RowsUpdated} updated, {preview.RowsUnchanged} unchanged, {preview.TotalRows} total.\n\n" +
                    "Proceed with this import?";
                var confirmed = await JS.InvokeAsync<bool>("confirm", summary);
                if (!confirmed) return;
            }

            await Database.ImportSourceAsync(type, State.SelectedMonth.Year, State.SelectedMonth.Month, path);
            await State.RefreshAsync();
            State.ShowMessage($"{Path.GetFileName(path)} imported into “{Label(type)}”.");
        });
    }

    private Task AddReviewsAsync() => ImportReviewsAsync(ReviewImportMode.MergeReviewers);

    private void BeginReplaceReviews() => _confirmReplaceReviews = true;
    private void CancelReplaceReviews() => _confirmReplaceReviews = false;
    private Task ReplaceReviewsAsync() => ImportReviewsAsync(ReviewImportMode.ReplaceMonth);

    private async Task ImportReviewsAsync(ReviewImportMode mode)
    {
        var paths = Dialogs.PickReviewWorkbooksOrZip();
        if (paths.Count == 0) return;
        _confirmReplaceReviews = false;
        await State.RunAsync(async () =>
        {
            _lastReviewImport = await Database.ImportEngineerReviewsAsync(
                State.SelectedMonth.Year,
                State.SelectedMonth.Month,
                paths,
                mode);
            await State.RefreshAsync();
            var rejected = _lastReviewImport.Files.Count(x => !x.Accepted);
            var message = $"{_lastReviewImport.AcceptedWorkbooks} review workbook(s) accepted; {_lastReviewImport.TotalReviews} feedback entries now loaded.";
            if (rejected > 0) message += $" {rejected} file(s) were rejected; see the intake details.";
            State.ShowMessage(message, rejected > 0);
        });
    }

    private async Task UploadZipAsync()
    {
        var path = Dialogs.PickWorkbookOrZip();
        if (path is null) return;
        if (!path.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
        {
            State.ShowMessage("Select a ZIP package for combined import.", true);
            return;
        }
        await State.RunAsync(async () =>
        {
            var count = await Database.ImportPackageAsync(State.SelectedMonth.Year, State.SelectedMonth.Month, path);
            await State.RefreshAsync();
            State.ShowMessage(count == 0 ? "No recognizable workbooks were found in the ZIP." : $"{count} workbook(s) imported from the package.", count == 0);
        });
    }

    private static string Initial(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "MS", ReportType.DetailedTimesheetTransactions => "DT", ReportType.AttendanceLeaveUaaTimesheet => "AT", _ => "ER" };
    private static string Label(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "Monthly utilization summary", ReportType.DetailedTimesheetTransactions => "Detailed timesheet", ReportType.AttendanceLeaveUaaTimesheet => "Attendance and leave", _ => "Engineer reviews" };
    private static string Description(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "Monthly capacity and utilization", ReportType.DetailedTimesheetTransactions => "Daily project and effort entries", ReportType.AttendanceLeaveUaaTimesheet => "Punch, leave, UAA and compliance", _ => "Self and peer ratings" };
    private static string ExpectedFileName(ReportType type) => type switch
    {
        ReportType.MonthlyTimesheetSummary => "RPwiseTimesheetUtilazationReport<dd-MMM-yyyy>_<hh_mm_ss>.xlsx",
        ReportType.DetailedTimesheetTransactions => "LV_Timesheet_ManagerHead_Rpt.xlsx",
        ReportType.AttendanceLeaveUaaTimesheet => "LV_LeaveSummaryforRP.xlsx",
        _ => "<Code>_<Name>_<yyyy_MM>_Review.xlsx"
    };
    private static string ErpSource(ReportType type) => type switch
    {
        ReportType.MonthlyTimesheetSummary => "ERP → RP-wise Timesheet Utilization Report",
        ReportType.DetailedTimesheetTransactions => "ERP → Timesheet Manager/Head Report",
        ReportType.AttendanceLeaveUaaTimesheet => "ERP → Leave Summary for RP",
        _ => "Generated by EOS, returned by engineers"
    };
}
