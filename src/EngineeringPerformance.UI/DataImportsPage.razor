@page "/imports"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IApplicationDatabase Database
@inject IFileDialogService Dialogs
@inject AppState State
@inject NavigationManager Navigation
@implements IDisposable

<div class="workbench-page imports-workbench">
    <header class="workbench-header">
        <div>
            <h2>Evidence pipeline</h2>
            <p>Load source evidence for @State.SelectedMonth.ToString("MMMM yyyy"). EOS detects workbook structure, validates the reporting period and recalculates the analytical layer from accepted inputs.</p>
        </div>
        <div class="workbench-summary">
            <div><span>ERP inputs</span><strong>@State.SystemReadyCount / 3</strong></div>
            <div><span>Review input</span><strong>@(ReviewReviewerCount == 0 ? "Open" : $"{ReviewReviewerCount} reviewer{(ReviewReviewerCount == 1 ? "" : "s")}")</strong></div>
            <button class="action" @onclick="UploadZipAsync" disabled="@State.Busy">Import package</button>
        </div>
    </header>

    <section class="import-pipeline" aria-label="Import workflow">
        @PipelineNode(1, "Period", true, State.SelectedMonth.ToString("MMM yy"))
        @PipelineNode(2, "ERP evidence", State.SystemReadyCount >= 3, $"{State.SystemReadyCount}/3")
        @PipelineNode(3, "Normalize", State.Performance.Count > 0, State.Performance.Count == 0 ? "waiting" : $"{State.Performance.Count} people")
        @PipelineNode(4, "Review evidence", State.ReviewsUploaded, State.ReviewsUploaded ? "loaded" : "optional")
        @PipelineNode(5, "Atlas", State.Performance.Count > 0, State.Performance.Count > 0 ? "ready" : "waiting")
    </section>

    <div class="page-grid imports-grid">
        <section class="primary-pane">
            <section class="review-intake" aria-labelledby="review-intake-title">
                <header class="review-intake-head">
                    <span class="review-intake-badge">REV</span>
                    <div>
                        <span class="atlas-section-label">Peer review intake · @State.SelectedMonth.ToString("MMMM yyyy")</span>
                        <h2 id="review-intake-title">Add returned employee reviews</h2>
                        <p>Select one workbook, several employee workbooks, or a ZIP. Each reviewer is updated independently; everybody else stays untouched.</p>
                    </div>
                    <div class="review-intake-actions">
                        <button class="action" @onclick="AddReviewsAsync" disabled="@State.Busy">Add review files</button>
                        <button class="secondary-action" @onclick="BeginReplaceReviews" disabled="@State.Busy">Replace month set</button>
                    </div>
                </header>

                <div class="review-intake-stats" aria-label="Loaded review evidence">
                    <div><span>Reviewers loaded</span><strong>@ReviewReviewerCount</strong></div>
                    <div><span>Feedback entries</span><strong>@State.PeerReviews.Count</strong></div>
                    <div><span>People reviewed</span><strong>@ReviewSubjectCount</strong></div>
                    <div><span>Last review upload</span><strong>@(LastReviewImport is { } last ? last.ImportedLocal.ToString("dd MMM · HH:mm") : "Not yet")</strong></div>
                </div>

                @if (_confirmReplaceReviews)
                {
                    <div class="review-replace-confirm" role="alert">
                        <div><strong>Replace every review for @State.SelectedMonth.ToString("MMMM yyyy")?</strong><span>The files you select next become the complete month set. This cannot affect other months.</span></div>
                        <button class="danger" @onclick="ReplaceReviewsAsync" disabled="@State.Busy">Choose replacement files</button>
                        <button class="secondary-action" @onclick="CancelReplaceReviews" disabled="@State.Busy">Cancel</button>
                    </div>
                }

                @if (_lastReviewImport is { } result)
                {
                    <div class="review-import-result">
                        <div class="review-result-summary">
                            <strong>@result.AcceptedWorkbooks workbook(s) accepted</strong>
                            <span>@result.AddedReviews added · @result.UpdatedReviews updated · @result.RemovedReviews removed · @result.TotalReviews total</span>
                        </div>
                        <div class="review-file-results">
                            @foreach (var file in result.Files)
                            {
                                <span class="@(file.Accepted ? "accepted" : "rejected")" title="@(file.Error ?? file.ReviewerName)">
                                    <b>@(file.Accepted ? "Accepted" : "Rejected")</b>
                                    <i>@file.FileName</i>
                                    <em>@(file.Accepted ? $"{file.ReviewerName} · {file.ReviewCount} entries" : file.Error)</em>
                                </span>
                            }
                        </div>
                    </div>
                }

                <footer><strong>Safe merge</strong><span>Re-uploading one employee’s workbook replaces only that reviewer’s entries for this month.</span></footer>
            </section>
            <div class="atlas-panel-head">
                <div><h2>Source register</h2><small>Expected export → detected workbook → accepted reporting period</small></div>
                <span class="atlas-caption">Replace an input to recalculate the month from the new evidence.</span>
            </div>

            <div class="import-table evidence-register">
                <div class="table-head import-grid">
                    <span class="cell">Source</span>
                    <span class="cell">Expected export</span>
                    <span class="cell">Loaded evidence</span>
                    <span class="cell">Period</span>
                    <span class="cell">Imported</span>
                    <span class="cell">State</span>
                    <span class="cell">Action</span>
                </div>
                @foreach (var slot in State.Snapshot?.SourceSlots ?? [])
                {
                    var ready = slot.Status == SourceStatus.Uploaded;
                    <div class="import-row import-grid @(ready ? "source-ready" : "source-open")">
                        <div class="cell">
                            <div class="input-name">
                                <i>@Initial(slot.ReportType)</i>
                                <span><strong>@Label(slot.ReportType)</strong><small>@Description(slot.ReportType)</small></span>
                            </div>
                        </div>
                        <div class="cell">
                            <span class="expected"><code title="@ExpectedFileName(slot.ReportType)">@ExpectedFileName(slot.ReportType)</code><small title="@ErpSource(slot.ReportType)">@ErpSource(slot.ReportType)</small></span>
                        </div>
                        <div class="cell"><span class="filename" title="@slot.FileName">@(slot.FileName ?? "—")</span></div>
                        <div class="cell"><span class="filename">@State.SelectedMonth.ToString("MMM yyyy")</span></div>
                        <div class="cell"><span class="filename">@(ImportedAt(slot.ReportType) is { } at ? at.ToString("dd MMM · HH:mm") : "—")</span></div>
                        <div class="cell"><span class="source-state @(ready ? "ready" : null)"><i></i>@(ready ? "Accepted" : "Open")</span></div>
                        <div class="cell">
                            @if (slot.ReportType == ReportType.EngineerReviewWorkbook)
                            {
                                <button class="source-action" @onclick="AddReviewsAsync" disabled="@State.Busy">Add files</button>
                            }
                            else
                            {
                                <button class="source-action" @onclick="() => UploadAsync(slot.ReportType)" disabled="@State.Busy">@(ready ? "Replace" : "Load")</button>
                            }
                        </div>
                    </div>
                }
            </div>

            <details class="import-method-note">
                <summary>Reporting-period rules</summary>
                <div>
                    <p>Attendance and detailed-timesheet rows carry their own dates, so EOS files each row into its actual reporting month.</p>
                    <p>The monthly utilization summary contains one aggregate per employee for the requested ERP period. A file spanning multiple calendar months is rejected rather than estimated. Export one summary per calendar month.</p>
                </div>
            </details>
        </section>

        <aside class="activity-pane validation-rail">
            <div class="atlas-panel-head"><div><h2>Pipeline status</h2><small>Evidence checks for this month</small></div></div>
            @ValidationSignal("Local database", "SQLite available", true, "DB")
            @ValidationSignal("Roster", State.Employees.Count == 0 ? "No employees configured" : $"{State.Employees.Count} employees", State.Employees.Count > 0, "ID")
            @ValidationSignal("ERP evidence", $"{State.SystemReadyCount} of 3 required exports", State.SystemReadyCount >= 3, "ERP")
            @ValidationSignal("Review evidence", State.ReviewsUploaded ? "Review workbooks loaded" : "Not yet collected", State.ReviewsUploaded, "REV", true)
            @ValidationSignal("Calculated layer", State.Performance.Count == 0 ? "Waiting for valid source rows" : $"{State.Performance.Count} employee rows ready", State.Performance.Count > 0, "FX")

            @if (State.Performance.Count > 0)
            {
                <div class="validation-next">
                    <span class="atlas-section-label">Next</span>
                    <strong>Performance Atlas is ready</strong>
                    <button class="action secondary" @onclick='() => Navigation.NavigateTo("/overview")'>Open team performance →</button>
                </div>
            }
        </aside>
    </div>
</div>

@code {
    private IReadOnlyList<ImportHistoryItem> _history = [];
    private ReviewImportResult? _lastReviewImport;
    private bool _confirmReplaceReviews;

    private int ReviewReviewerCount => State.PeerReviews.Select(x => x.ReviewerCode).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private int ReviewSubjectCount => State.PeerReviews.Select(x => x.SubjectCode).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private ImportHistoryItem? LastReviewImport => _history.FirstOrDefault(x => x.ReportType == ReportType.EngineerReviewWorkbook);

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        await ReloadHistoryAsync();
    }

    private void OnStateChanged() => InvokeAsync(async () => { await ReloadHistoryAsync(); StateHasChanged(); });
    public void Dispose() => State.Changed -= OnStateChanged;
    private async Task ReloadHistoryAsync() => _history = await Database.GetImportHistoryAsync(State.SelectedMonth.Year, State.SelectedMonth.Month);
    private DateTime? ImportedAt(ReportType type) => _history.Where(x => x.ReportType == type).Select(x => (DateTime?)x.ImportedLocal).FirstOrDefault();

    private RenderFragment PipelineNode(int number, string label, bool ready, string detail) => @<div class="pipeline-node @(ready ? "ready" : null)">
        <i>@(ready ? "✓" : number.ToString())</i><span><strong>@label</strong><small>@detail</small></span>
    </div>;

    private RenderFragment ValidationSignal(string title, string detail, bool good, string badge, bool optional = false) => @<div class="validation-signal @(good ? "good" : optional ? "optional" : "warn")">
        <i>@badge</i><span><strong>@title</strong><small>@detail</small></span><b>@(good ? "●" : optional ? "○" : "!")</b>
    </div>;

    private async Task UploadAsync(ReportType type)
    {
        var path = Dialogs.PickWorkbook();
        if (path is null) return;
        await State.RunAsync(async () =>
        {
            await Database.ImportSourceAsync(type, State.SelectedMonth.Year, State.SelectedMonth.Month, path);
            await State.RefreshAsync();
            State.ShowMessage($"{Path.GetFileName(path)} imported into “{Label(type)}”.");
        });
    }

    private Task AddReviewsAsync() => ImportReviewsAsync(ReviewImportMode.MergeReviewers);

    private void BeginReplaceReviews() => _confirmReplaceReviews = true;
    private void CancelReplaceReviews() => _confirmReplaceReviews = false;
    private Task ReplaceReviewsAsync() => ImportReviewsAsync(ReviewImportMode.ReplaceMonth);

    private async Task ImportReviewsAsync(ReviewImportMode mode)
    {
        var paths = Dialogs.PickReviewWorkbooksOrZip();
        if (paths.Count == 0) return;
        _confirmReplaceReviews = false;
        await State.RunAsync(async () =>
        {
            _lastReviewImport = await Database.ImportEngineerReviewsAsync(
                State.SelectedMonth.Year,
                State.SelectedMonth.Month,
                paths,
                mode);
            await State.RefreshAsync();
            var rejected = _lastReviewImport.Files.Count(x => !x.Accepted);
            var message = $"{_lastReviewImport.AcceptedWorkbooks} review workbook(s) accepted; {_lastReviewImport.TotalReviews} feedback entries now loaded.";
            if (rejected > 0) message += $" {rejected} file(s) were rejected; see the intake details.";
            State.ShowMessage(message, rejected > 0);
        });
    }

    private async Task UploadZipAsync()
    {
        var path = Dialogs.PickWorkbookOrZip();
        if (path is null) return;
        if (!path.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
        {
            State.ShowMessage("Select a ZIP package for combined import.", true);
            return;
        }
        await State.RunAsync(async () =>
        {
            var count = await Database.ImportPackageAsync(State.SelectedMonth.Year, State.SelectedMonth.Month, path);
            await State.RefreshAsync();
            State.ShowMessage(count == 0 ? "No recognizable workbooks were found in the ZIP." : $"{count} workbook(s) imported from the package.", count == 0);
        });
    }

    private static string Initial(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "MS", ReportType.DetailedTimesheetTransactions => "DT", ReportType.AttendanceLeaveUaaTimesheet => "AT", _ => "ER" };
    private static string Label(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "Monthly utilization summary", ReportType.DetailedTimesheetTransactions => "Detailed timesheet", ReportType.AttendanceLeaveUaaTimesheet => "Attendance and leave", _ => "Engineer reviews" };
    private static string Description(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "Monthly capacity and utilization", ReportType.DetailedTimesheetTransactions => "Daily project and effort entries", ReportType.AttendanceLeaveUaaTimesheet => "Punch, leave, UAA and compliance", _ => "Self and peer ratings" };
    private static string ExpectedFileName(ReportType type) => type switch
    {
        ReportType.MonthlyTimesheetSummary => "RPwiseTimesheetUtilazationReport<dd-MMM-yyyy>_<hh_mm_ss>.xlsx",
        ReportType.DetailedTimesheetTransactions => "LV_Timesheet_ManagerHead_Rpt.xlsx",
        ReportType.AttendanceLeaveUaaTimesheet => "LV_LeaveSummaryforRP.xlsx",
        _ => "<Code>_<Name>_<yyyy_MM>_Review.xlsx"
    };
    private static string ErpSource(ReportType type) => type switch
    {
        ReportType.MonthlyTimesheetSummary => "ERP → RP-wise Timesheet Utilization Report",
        ReportType.DetailedTimesheetTransactions => "ERP → Timesheet Manager/Head Report",
        ReportType.AttendanceLeaveUaaTimesheet => "ERP → Leave Summary for RP",
        _ => "Generated by EOS, returned by engineers"
    };
}
