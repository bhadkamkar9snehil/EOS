@page "/imports"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IApplicationDatabase Database
@inject IFileDialogService Dialogs
@inject AppState State
@inject NavigationManager Navigation
@implements IDisposable

<div class="page-grid">
    <section class="primary-pane">
        <div class="section-title">
            <div><h2>Data inputs</h2><p>The ERP exports keep their system-generated names. Match each row using the expected export below — detection uses workbook columns, so a renamed file still lands in the right slot.</p></div>
            <button class="action" @onclick="UploadZipAsync" disabled="@State.Busy">Upload ZIP</button>
        </div>
        <ol class="workflow">
            @WorkflowStep(1, "Select reporting month", true)
            @WorkflowStep(2, "Upload the three ERP exports", State.SystemReadyCount >= 3)
            @WorkflowStep(3, "Validate imported rows", State.Performance.Count > 0)
            @WorkflowStep(4, "Generate review templates", State.ReviewsUploaded)
            @WorkflowStep(5, "Upload completed reviews", State.ReviewsUploaded)
            @WorkflowStep(6, "Review calculated scores", State.Performance.Count > 0 && State.ReviewsUploaded)
        </ol>

        <div class="import-table">
            <div class="table-head import-grid">
                <span class="cell">Input</span><span class="cell">Expected ERP export</span><span class="cell">Loaded file</span><span class="cell">Reporting period</span><span class="cell">Imported at</span><span class="cell">Status</span><span class="cell">Action</span>
            </div>
            @foreach (var slot in State.Snapshot?.SourceSlots ?? [])
            {
                <div class="import-row import-grid">
                    <div class="cell">
                        <div class="input-name"><i>@Initial(slot.ReportType)</i><span><strong>@Label(slot.ReportType)</strong><small>@Description(slot.ReportType)</small></span></div>
                    </div>
                    <div class="cell">
                        <span class="expected"><code title="@ExpectedFileName(slot.ReportType)">@ExpectedFileName(slot.ReportType)</code><small title="@ErpSource(slot.ReportType)">@ErpSource(slot.ReportType)</small></span>
                    </div>
                    <div class="cell">
                        <span class="filename" title="@slot.FileName">@(slot.FileName ?? "—")</span>
                    </div>
                    <div class="cell">
                        <span class="filename">@State.SelectedMonth.ToString("MMMM yyyy")</span>
                    </div>
                    <div class="cell">
                        <span class="filename">@(ImportedAt(slot.ReportType) is { } at ? at.ToString("dd MMM, HH:mm") : "—")</span>
                    </div>
                    <div class="cell">
                        <span class="status @(slot.Status == SourceStatus.Uploaded ? "ok" : null)">@(slot.Status == SourceStatus.Uploaded ? "Ready" : "Not uploaded")</span>
                    </div>
                    <div class="cell">
                        <button @onclick="() => UploadAsync(slot.ReportType)" disabled="@State.Busy">@(slot.Status == SourceStatus.Uploaded ? "Replace" : "Upload")</button>
                    </div>
                </div>
            }
        </div>
        <div class="callout">
            <strong>Which month does an export belong to?</strong>
            <p>
                The attendance and detailed-timesheet exports carry a date on every row, so they can span
                several months and each row is filed under its own month automatically.
            </p>
            <p>
                The utilization summary is different: it is a single total per employee for whatever period
                the ERP was asked for. A summary covering more than one calendar month is rejected rather
                than split, because nothing in the file says how much of each total belongs to which month —
                any division would be an estimate presented as a reported figure. Export it once per
                calendar month (<code>01-Aug-2026 to 31-Aug-2026</code>) and it will import.
            </p>
        </div>
    </section>
    <aside class="activity-pane">
        <h2>Validation</h2>
        @Activity("Database", "SQLite is available and writable.", true)
        @Activity("Employees", State.Employees.Count == 0 ? "No employees configured." : $"{State.Employees.Count} employees in scope.", State.Employees.Count > 0)
        @Activity("System inputs", $"{State.SystemReadyCount} of 3 ERP exports uploaded.", State.SystemReadyCount >= 3)
        @Activity("Engineer reviews", State.ReviewsUploaded ? "Review workbook loaded." : "Review workbook not uploaded.", State.ReviewsUploaded)
        @Activity("Calculated scores", State.Performance.Count == 0 ? "No scores for this month yet." : $"{State.Performance.Count} engineers scored.", State.Performance.Count > 0)
        @if (State.Performance.Count > 0)
        {
            <button class="link wide-link" @onclick='() => Navigation.NavigateTo("/overview")'>View overview →</button>
        }
    </aside>
</div>

@code {
    private IReadOnlyList<ImportHistoryItem> _history = [];

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        await ReloadHistoryAsync();
    }

    private void OnStateChanged() => InvokeAsync(async () => { await ReloadHistoryAsync(); StateHasChanged(); });
    public void Dispose() => State.Changed -= OnStateChanged;

    private async Task ReloadHistoryAsync() =>
        _history = await Database.GetImportHistoryAsync(State.SelectedMonth.Year, State.SelectedMonth.Month);

    /// <summary>Most recent recorded import for a slot, or null when it predates the audit log.</summary>
    private DateTime? ImportedAt(ReportType type) =>
        _history.Where(x => x.ReportType == type).Select(x => (DateTime?)x.ImportedLocal).FirstOrDefault();

    private RenderFragment WorkflowStep(int number, string label, bool done) =>
        @<li class="workflow-step @(done ? "done" : null)"><i>@(done ? "✓" : number.ToString())</i>@label</li>;

    private async Task UploadAsync(ReportType type)
    {
        // Engineer reviews arrive as one workbook per engineer, so that slot also takes a ZIP.
        var path = type == ReportType.EngineerReviewWorkbook ? Dialogs.PickWorkbookOrZip() : Dialogs.PickWorkbook();
        if (path is null) return;
        await State.RunAsync(async () =>
        {
            if (type == ReportType.EngineerReviewWorkbook)
            {
                var count = await Database.ImportEngineerReviewsAsync(State.SelectedMonth.Year, State.SelectedMonth.Month, path);
                await State.RefreshAsync();
                State.ShowMessage($"Peer feedback read from {count} review workbook(s).");
            }
            else
            {
                await Database.ImportSourceAsync(type, State.SelectedMonth.Year, State.SelectedMonth.Month, path);
                await State.RefreshAsync();
                State.ShowMessage($"{Path.GetFileName(path)} imported into “{Label(type)}”.");
            }
        });
    }

    private async Task UploadZipAsync()
    {
        var path = Dialogs.PickWorkbookOrZip(); if (path is null) return;
        if (!path.EndsWith(".zip", StringComparison.OrdinalIgnoreCase)) { State.ShowMessage("Select a ZIP package for combined import.", true); return; }
        await State.RunAsync(async () =>
        {
            var count = await Database.ImportPackageAsync(State.SelectedMonth.Year, State.SelectedMonth.Month, path);
            await State.RefreshAsync();
            State.ShowMessage(count == 0 ? "No recognizable workbooks were found in the ZIP." : $"{count} workbook(s) imported from the package.", count == 0);
        });
    }

    private RenderFragment Activity(string title, string detail, bool good) => @<div class="activity"><i class="@(good ? "good" : "warn")">@(good ? "✓" : "!")</i><span><strong>@title</strong><small>@detail</small></span></div>;

    private static string Initial(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "MS", ReportType.DetailedTimesheetTransactions => "DT", ReportType.AttendanceLeaveUaaTimesheet => "AT", _ => "ER" };
    private static string Label(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "Monthly utilization summary", ReportType.DetailedTimesheetTransactions => "Detailed timesheet", ReportType.AttendanceLeaveUaaTimesheet => "Attendance and leave", _ => "Engineer reviews" };
    private static string Description(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "Monthly capacity and utilization", ReportType.DetailedTimesheetTransactions => "Daily project and effort entries", ReportType.AttendanceLeaveUaaTimesheet => "Punch, leave, UAA and compliance", _ => "Self and peer ratings" };
    private static string ExpectedFileName(ReportType type) => type switch
    {
        ReportType.MonthlyTimesheetSummary => "RPwiseTimesheetUtilazationReport<dd-MMM-yyyy>_<hh_mm_ss>.xlsx",
        ReportType.DetailedTimesheetTransactions => "LV_Timesheet_ManagerHead_Rpt.xlsx",
        ReportType.AttendanceLeaveUaaTimesheet => "LV_LeaveSummaryforRP.xlsx",
        _ => "<Code>_<Name>_<yyyy_MM>_Review.xlsx"
    };
    private static string ErpSource(ReportType type) => type switch
    {
        ReportType.MonthlyTimesheetSummary => "ERP → RP-wise Timesheet Utilization Report",
        ReportType.DetailedTimesheetTransactions => "ERP → Timesheet Manager/Head Report",
        ReportType.AttendanceLeaveUaaTimesheet => "ERP → Leave Summary for RP",
        _ => "Produced on the Templates screen, returned by engineers"
    };
}
