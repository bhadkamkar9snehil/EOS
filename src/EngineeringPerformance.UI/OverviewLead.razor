@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject AppState State
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (State.Performance.Count > 0)
{
    <section class="overview-lead">
        <section class="score-distribution-strip card">
            <div class="score-distribution-heading">
                <div>
                    <h2>Score distribution</h2>
                    <small>@State.Performance.Count engineers</small>
                </div>
                <strong>@Analytics.Format(TeamScore)</strong>
            </div>
            <div class="score-distribution-track" aria-label="Operational score distribution">
                @foreach (var band in Bands.Where(x => x.Count > 0))
                {
                    <div class="distribution-segment @band.ClassName"
                         style="flex:@band.Count"
                         title="@band.Range: @band.Count engineer(s)">
                        <span>@band.Range</span>
                        <b>@band.Count</b>
                    </div>
                }
            </div>
        </section>

        <div class="kpi-row overview-primary-kpis">
            @Kpi("Team operational score", Analytics.Format(TeamScore), Analytics.ScoreBand(TeamScore), TeamScoreDeltaLabel)
            @Kpi("Attendance discipline", $"{Analytics.Format(Average(x => x.AttendanceDisciplineScore))}%", "", "Attendance-derived score")
            @Kpi("Timesheet completion", $"{Analytics.Format(Average(x => x.TimesheetCompletionScore, true))}%", "", "Engineers present in the monthly utilization export")
            @Kpi("Approval completion", $"{Analytics.Format(Average(x => x.ApprovalScore, true))}%", "", "Approved hours divided by entered hours")
            @Kpi("Average utilization", $"{Analytics.Format(Average(x => x.Utilization, true))}%", "", "Entered hours divided by compliance hours")
            @Kpi("Open alerts", Alerts.Count.ToString(), Alerts.Any(x => x.Level == AlertLevel.Critical) ? "critical" : "warning", "Derived from the selected month's imports")
        </div>

        <div class="kpi-row overview-secondary-kpis">
            @Kpi("Billable share", $"{Analytics.Format(BillableShare)}%", "", "Billable hours as a share of entered hours")
            @Kpi("Entered hours", $"{Analytics.Format(State.Performance.Sum(x => x.EnteredHours))} h", "", null)
            @Kpi("Approved hours", $"{Analytics.Format(State.Performance.Sum(x => x.ApprovedHours))} h", "good", null)
            @Kpi("Timesheet coverage", $"{Analytics.Format(TimesheetCoverage)}%", TimesheetCoverage >= 90 ? "good" : "warning", "Filled attendance-timesheet days")
            @Kpi("Missing timesheet days", MissingTimesheetDays.ToString(), MissingTimesheetDays > 0 ? "warning" : "good", null)
            @Kpi("Reconciliation gap", $"{Analytics.Format(AbsoluteVariance)} h", AbsoluteVariance >= 100 ? "critical" : "warning", "Absolute punch-hours versus timesheet-hours difference")
        </div>

        <section class="period-analysis card">
            <div class="card-head period-analysis-head">
                <div>
                    <h2>Performance over time</h2>
                    <small>Cross-month operational scores and factual week-over-week attendance discipline for all employees</small>
                </div>
                <span class="period-source-note">Weekly view excludes monthly utilization totals because they cannot be divided without estimation.</span>
            </div>

            <div class="period-analysis-grid">
                <section class="period-panel">
                    <div class="period-panel-head">
                        <div><h3>Cross-month analysis</h3><small>@MonthLabels.Length loaded month(s)</small></div>
                        <span>Operational score</span>
                    </div>
                    @if (MonthLabels.Length < 2)
                    {
                        <div class="period-empty">Import another month to compare employee scores across time.</div>
                    }
                    else
                    {
                        <div id="overview-cross-month" class="echart period-heatmap" style="height:@CrossMonthHeightPx}px"></div>
                    }
                </section>

                <section class="period-panel">
                    <div class="period-panel-head">
                        <div><h3>Week-over-week performance</h3><small>@WeekLabels.Length week(s) in @State.SelectedMonth.ToString("MMMM yyyy")</small></div>
                        <span>Attendance discipline</span>
                    </div>
                    @if (WeekLabels.Length == 0)
                    {
                        <div class="period-empty">Dated attendance rows are required for a weekly view.</div>
                    }
                    else
                    {
                        <div id="overview-weekly" class="echart period-heatmap" style="height:@WeeklyHeightPx}px"></div>
                    }
                </section>
            </div>
        </section>
    </section>
}

@code {
    private bool _pending = true;
    private string? _signature;

    protected override void OnInitialized() => State.Changed += OnChanged;

    private void OnChanged()
    {
        _pending = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var signature = $"{State.SelectedMonth:yyyyMM}|{State.Performance.Count}|{State.History.Count}|{State.WeeklyPerformance.Count}|{State.Performance.Sum(x => x.OperationalScore):0.0}";
        if (!_pending && signature == _signature) return;
        _pending = false;
        _signature = signature;

        if (MonthLabels.Length >= 2)
        {
            await JS.InvokeVoidAsync(
                "epaCharts.heatmap",
                "overview-cross-month",
                MonthLabels,
                CrossMonthNames,
                CrossMonthCells,
                true);
        }

        if (WeekLabels.Length > 0)
        {
            await JS.InvokeVoidAsync(
                "epaCharts.heatmap",
                "overview-weekly",
                WeekLabels,
                WeeklyNames,
                WeeklyCells,
                true);
        }
    }

    private decimal TeamScore => State.Performance.Count == 0
        ? 0
        : decimal.Round(State.Performance.Average(x => x.OperationalScore), 1);

    private decimal PreviousTeamScore
    {
        get
        {
            var previous = State.SelectedMonth.AddMonths(-1);
            var rows = State.History.Where(x => x.Year == previous.Year && x.Month == previous.Month).ToArray();
            return rows.Length == 0 ? 0 : decimal.Round(rows.Average(x => x.OperationalScore), 1);
        }
    }

    private string? TeamScoreDeltaLabel => PreviousTeamScore <= 0
        ? null
        : $"{(TeamScore - PreviousTeamScore >= 0 ? "+" : "")}{Analytics.Format(TeamScore - PreviousTeamScore)} vs {State.SelectedMonth.AddMonths(-1):MMM}";

    private decimal Average(Func<MonthlyPerformanceItem, decimal> selector, bool summaryOnly = false)
    {
        var rows = summaryOnly ? State.Performance.Where(x => x.HasSummaryData).ToArray() : State.Performance.ToArray();
        return rows.Length == 0 ? 0 : decimal.Round(rows.Average(selector), 1);
    }

    private decimal BillableShare
    {
        get
        {
            var entered = State.Performance.Sum(x => x.EnteredHours);
            return entered <= 0 ? 0 : decimal.Round(State.Performance.Sum(x => x.BillableHours) * 100m / entered, 1);
        }
    }

    private decimal TimesheetCoverage
    {
        get
        {
            var expected = State.Performance.Sum(x => x.ExpectedTimesheetDays);
            return expected <= 0 ? 0 : decimal.Round(State.Performance.Sum(x => x.TimesheetFilledDays) * 100m / expected, 1);
        }
    }

    private int MissingTimesheetDays => State.Performance.Sum(x => Math.Max(0, x.ExpectedTimesheetDays - x.TimesheetFilledDays));
    private decimal AbsoluteVariance => State.Performance.Sum(x => Math.Abs(x.ReconciliationVariance));

    private IReadOnlyList<Anomaly> Alerts
    {
        get
        {
            var previous = State.SelectedMonth.AddMonths(-1);
            var previousScores = State.History
                .Where(x => x.Year == previous.Year && x.Month == previous.Month)
                .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(x => x.Key, x => x.First().OperationalScore, StringComparer.OrdinalIgnoreCase);
            return Analytics.Anomalies(State.Performance, previousScores);
        }
    }

    private BandItem[] Bands =>
    [
        new("good", "85–100", State.Performance.Count(x => x.OperationalScore >= 85)),
        new("warning", "70–84", State.Performance.Count(x => x.OperationalScore >= 70 && x.OperationalScore < 85)),
        new("serious", "55–69", State.Performance.Count(x => x.OperationalScore >= 55 && x.OperationalScore < 70)),
        new("critical", "<55", State.Performance.Count(x => x.OperationalScore < 55))
    ];

    private DateTime[] CrossMonths => State.History
        .Select(x => new DateTime(x.Year, x.Month, 1))
        .Distinct()
        .OrderBy(x => x)
        .ToArray();

    private string[] MonthLabels => CrossMonths.Select(x => x.ToString("MMM yy")).ToArray();

    private string[] CrossMonthNames => State.History
        .Select(x => x.EmployeeName)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(name => State.Performance.FirstOrDefault(x => PersonName.Matches(x.EmployeeName, name))?.OperationalScore ?? 0)
        .ThenBy(x => x)
        .ToArray();

    private object[] CrossMonthCells
    {
        get
        {
            var months = CrossMonths;
            var names = CrossMonthNames;
            return State.History.Select(row =>
            {
                var monthIndex = Array.FindIndex(months, x => x.Year == row.Year && x.Month == row.Month);
                var nameIndex = Array.FindIndex(names, x => PersonName.Matches(x, row.EmployeeName));
                return (object)new
                {
                    x = monthIndex,
                    y = nameIndex,
                    value = row.OperationalScore,
                    tooltip = $"{row.EmployeeName} · {new DateTime(row.Year, row.Month, 1):MMMM yyyy}: {Analytics.Format(row.OperationalScore)}"
                };
            }).Where(x => x is not null).ToArray();
        }
    }

    private DateTime[] Weeks => State.WeeklyPerformance.Select(x => x.WeekStart).Distinct().OrderBy(x => x).ToArray();
    private string[] WeekLabels => Weeks.Select(x => $"{x:dd MMM}–{x.AddDays(6):dd MMM}").ToArray();

    private string[] WeeklyNames => State.WeeklyPerformance
        .Where(x => x.ExpectedDays > 0)
        .Select(x => x.EmployeeName)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToArray();

    private object[] WeeklyCells
    {
        get
        {
            var weeks = Weeks;
            var names = WeeklyNames;
            return State.WeeklyPerformance
                .Where(row => row.ExpectedDays > 0)
                .Select(row => (object)new
                {
                    x = Array.IndexOf(weeks, row.WeekStart),
                    y = Array.FindIndex(names, x => PersonName.Matches(x, row.EmployeeName)),
                    value = row.AttendanceDisciplineScore,
                    tooltip = $"{row.EmployeeName} · {row.WeekStart:dd MMM}–{row.WeekEnd:dd MMM}: " +
                              $"discipline {Analytics.Format(row.AttendanceDisciplineScore)}, " +
                              $"fill {Analytics.Format(row.TimesheetFillRate)}%, " +
                              $"punch {Analytics.Format(row.PunchHours)} h, timesheet {Analytics.Format(row.TimesheetHours)} h, " +
                              $"missing punch {row.MissingPunchDays}, late {row.LateDays}, early {row.EarlyDays}, short {row.LessDurationDays}"
                })
                .ToArray();
        }
    }

    private int CrossMonthHeightPx => Math.Clamp(90 + CrossMonthNames.Length * 27, 330, 590);
    private int WeeklyHeightPx => Math.Clamp(90 + WeeklyNames.Length * 27, 330, 590);

    private RenderFragment Kpi(string label, string value, string? tone, string? hint) => @<div class="kpi @tone" title="@hint">
        <span class="kpi-label">@label</span>
        <span class="kpi-value"><strong>@value</strong></span>
        @if (!string.IsNullOrWhiteSpace(hint))
        {
            <small class="kpi-hint">@hint</small>
        }
    </div>;

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnChanged;
        foreach (var id in new[] { "overview-cross-month", "overview-weekly" })
        {
            try { await JS.InvokeVoidAsync("epaCharts.dispose", id); } catch (JSDisconnectedException) { }
        }
    }

    private sealed record BandItem(string ClassName, string Range, int Count);
}
