@page "/employees"
@using System.ComponentModel.DataAnnotations
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IFileDialogService Dialogs
@inject IApplicationDatabase Database
@inject AppState State
@inject NavigationManager Navigation
@implements IDisposable

<section class="flex flex-col gap-6">
    <header class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <div class="panel-eyebrow">Roster</div>
            <h2 class="panel-title">People &amp; teams</h2>
        </div>
        <div class="flex items-center gap-3">
            @if (ExcludedCount > 0)
            {
                <span class="badge gap-1.5 bg-warning-soft text-warning"><i class="lamp h-1.5 w-1.5" aria-hidden="true"></i><span class="tabular-nums">@ExcludedCount</span> excluded from analysis</span>
            }
            <button class="btn btn-secondary" @onclick="ImportRosterAsync" disabled="@State.Busy">Import ERP roster</button>
        </div>
    </header>

    <details class="plate">
        <summary class="panel-title cursor-pointer p-4">Add employee or create team</summary>
        <div class="grid grid-cols-1 gap-4 border-t border-line p-4 lg:grid-cols-2">
            <EditForm Model="_newEmployee" OnValidSubmit="AddEmployeeAsync">
                <DataAnnotationsValidator />
                <div class="flex flex-wrap items-end gap-3">
                    <span class="label-instrument w-full">Add employee</span>
                    <label class="flex flex-col gap-1 text-xs text-ink-soft">Employee code
                        <InputText @bind-Value="_newEmployee.Code" placeholder="E1042" class="w-28 field px-2.5 py-1.5 text-sm text-ink outline-none focus:ring-1 focus:ring-primary" />
                        <ValidationMessage For="() => _newEmployee.Code" class="text-critical" />
                    </label>
                    <label class="flex flex-1 flex-col gap-1 text-xs text-ink-soft">Employee name
                        <InputText @bind-Value="_newEmployee.Name" placeholder="Full name" class="w-full field px-2.5 py-1.5 text-sm text-ink outline-none focus:ring-1 focus:ring-primary" />
                        <ValidationMessage For="() => _newEmployee.Name" class="text-critical" />
                    </label>
                    <label class="flex flex-col gap-1 text-xs text-ink-soft">Level
                        <InputNumber @bind-Value="_newEmployee.Level" min="1" max="99" class="w-16 field px-2.5 py-1.5 text-sm text-ink outline-none focus:ring-1 focus:ring-primary" />
                        <ValidationMessage For="() => _newEmployee.Level" class="text-critical" />
                    </label>
                    <button type="submit" class="btn btn-primary" disabled="@State.Busy">Add employee</button>
                </div>
            </EditForm>

            <EditForm Model="_newTeam" OnValidSubmit="AddTeamAsync">
                <DataAnnotationsValidator />
                <div class="flex flex-wrap items-end gap-3">
                    <span class="label-instrument w-full">Create team</span>
                    <label class="flex flex-1 flex-col gap-1 text-xs text-ink-soft">Team name
                        <InputText @bind-Value="_newTeam.Name" placeholder="e.g. X-Force Execution" class="w-full field px-2.5 py-1.5 text-sm text-ink outline-none focus:ring-1 focus:ring-primary" />
                        <ValidationMessage For="() => _newTeam.Name" class="text-critical" />
                    </label>
                    <button type="submit" class="btn btn-secondary" disabled="@State.Busy">Create team</button>
                </div>
            </EditForm>
        </div>
    </details>

    @if (State.Teams.Count > 0)
    {
        <details class="plate">
            <summary class="cursor-pointer p-4"><span class="panel-title">Team structure</span> <span class="label-instrument ml-2 tabular-nums">@State.Teams.Count team(s)</span></summary>
            <div class="grid grid-cols-1 gap-3 border-t border-line p-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var team in State.Teams)
                {
                    <div class="group rounded-lg border border-line-soft bg-surface-inset p-3">
                        <div class="flex items-center gap-2">
                            <input class="field min-w-0 flex-1 px-2.5 py-1 text-sm font-medium text-ink outline-none focus:ring-1 focus:ring-primary" aria-label="Team name" value="@(_editTeamNames.TryGetValue(team.Id, out var n) ? n : team.Name)"
                                   @onchange="e => _editTeamNames[team.Id] = e.Value?.ToString() ?? string.Empty" />
                            <span class="badge bg-surface-raised text-ink-soft" title="Members">@team.MemberCount</span>
                        </div>
                        @{ var avg = TeamAverageScore(team); }
                        <div class="mt-2.5 flex flex-col">
                            @if (avg is not null)
                            {
                                <b class="@($"metric text-metric-sm {Analytics.BandTextClass(Analytics.ScoreBand(avg.Value))}")">@Analytics.Format(avg.Value)</b>
                                <span class="label-instrument mt-1">Avg operational score</span>
                            }
                            else
                            {
                                <span class="text-2xs text-muted">No scored members this month</span>
                            }
                        </div>
                        <div class="mt-2.5 flex gap-2">
                            <button class="btn btn-secondary !px-2.5 !py-1 !text-2xs" @onclick="() => RenameTeamAsync(team)" disabled="@(State.Busy || !IsTeamRenamed(team))">Rename</button>
                            <button class="btn btn-danger !px-2.5 !py-1 !text-2xs" @onclick="() => DeleteTeamAsync(team)" disabled="@State.Busy">Delete</button>
                        </div>
                    </div>
                }
            </div>
        </details>
    }

    <div class="plate overflow-hidden">
        <div class="chassis label-instrument grid grid-cols-[5rem_1.6fr_5.5rem_9rem_6rem_7rem_5rem_5.5rem_11rem] items-center gap-2 border-b border-chassis-deep px-3 py-2 !text-on-chassis-soft">
            <span>Code</span><span>Engineer</span><span>Level</span><span>Team</span><span>Billable</span><span>Employment</span><span title="Daily commute classification imported from the ERP roster.">Commute</span><span>Analysis</span><span>Actions</span>
        </div>
        <Virtualize TItem="EmployeeListItem" Items="_employeesSnapshot" Context="employee" ItemSize="58">
            @{ var editing = _editingEmployeeId == employee.Id; }
            <div class="@($"group grid grid-cols-[5rem_1.6fr_5.5rem_9rem_6rem_7rem_5rem_5.5rem_11rem] items-center gap-2 border-b border-line-soft px-3 py-2 text-xs transition-colors duration-100 ease-press hover:bg-surface-inset {(employee.IsExcluded ? "opacity-50" : "")} {(editing ? "bg-primary-soft/30" : "")}")">
                <div><code class="text-2xs tabular-nums text-ink-soft">@employee.EmployeeCode</code></div>
                <div>
                    <span class="flex flex-col">
                        <strong class="font-medium text-ink">@employee.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(employee.Email)) { <small class="text-3xs text-muted">@employee.Email</small> }
                    </span>
                </div>

                <div>
                    @if (editing)
                    {
                        <div class="flex items-center gap-1">
                            <button class="control flex h-6 w-6 items-center justify-center text-ink-soft hover:control-hover active:control-pressed" title="Decrease level" @onclick="() => AdjustLevel(employee, -1)">−</button>
                            <input type="number" min="1" max="99" class="field w-10 px-1 py-0.5 text-center text-xs tabular-nums text-ink outline-none focus:ring-1 focus:ring-primary" value="@(_editLevel.TryGetValue(employee.Id, out var l) ? l : employee.SeniorityLevel)" @onchange="e => _editLevel[employee.Id] = int.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 1, 99) : employee.SeniorityLevel" />
                            <button class="control flex h-6 w-6 items-center justify-center text-ink-soft hover:control-hover active:control-pressed" title="Increase level" @onclick="() => AdjustLevel(employee, 1)">+</button>
                        </div>
                    }
                    else
                    {
                        <span class="badge bg-surface-inset text-ink-soft">Level @employee.SeniorityLevel</span>
                    }
                </div>

                <div>
                    @if (editing)
                    {
                        <select class="field w-full px-1.5 py-1 text-xs text-ink outline-none focus:ring-1 focus:ring-primary" value="@(employee.TeamId?.ToString() ?? "")" @onchange="e => AssignTeamAsync(employee, e.Value?.ToString())">
                            <option value="">— Unassigned —</option>
                            @foreach (var team in State.Teams) { <option value="@team.Id">@team.Name</option> }
                        </select>
                    }
                    else
                    {
                        <span class="text-ink-soft">@(string.IsNullOrWhiteSpace(employee.TeamName) ? "Unassigned" : employee.TeamName)</span>
                    }
                </div>

                <div>
                    @if (editing)
                    {
                        <label class="inline-flex items-center" title="@(employee.IsConsultant ? "Consultants are always non-billable" : employee.IsNonBillable ? "Currently non-billable" : "Currently billable")">
                            <input type="checkbox" aria-label="Billable status for @employee.Name" checked="@(!employee.IsNonBillable)" disabled="@employee.IsConsultant" @onchange="e => SetNonBillableAsync(employee, !(bool)(e.Value ?? false))" />
                        </label>
                    }
                    else
                    {
                        <span class="badge bg-surface-inset text-ink-soft">@(employee.IsNonBillable ? "Non-billable" : "Billable")</span>
                    }
                </div>

                <div>
                    @if (editing)
                    {
                        <span class="flex flex-col gap-1">
                            @if (employee.IsConsultant) { <span class="badge bg-info-soft text-info w-fit">Consultant</span> }
                            <select class="field w-full px-1.5 py-1 text-3xs text-ink outline-none focus:ring-1 focus:ring-primary" value="@(employee.ProbationOverride is null ? "auto" : employee.ProbationOverride.Value ? "on" : "off")"
                                    title="Probation status — Auto follows the ERP roster's completion date"
                                    @onchange="e => SetProbationAsync(employee, e.Value?.ToString())">
                                <option value="auto">Auto (@(employee.IsOnProbation ? "on" : "off"))</option>
                                <option value="on">On</option>
                                <option value="off">Off</option>
                            </select>
                        </span>
                    }
                    else
                    {
                        <span>
                            @if (employee.IsConsultant) { <span class="badge bg-info-soft text-info">Consultant</span> }
                            else if (employee.IsOnProbation) { <span class="badge bg-warning-soft text-warning">Probation</span> }
                            else { <span class="badge bg-surface-inset text-ink-soft">Permanent</span> }
                        </span>
                    }
                </div>

                <div>
                    @if (editing)
                    {
                        <select class="field w-full px-1.5 py-1 text-xs text-ink outline-none focus:ring-1 focus:ring-primary" value="@(employee.IsUpdown ? "on" : "off")" title="Daily commute classification" @onchange="e => SetUpdownAsync(employee, e.Value?.ToString())">
                            <option value="on">Yes</option><option value="off">No</option>
                        </select>
                    }
                    else
                    {
                        <span class="text-ink-soft">@(employee.IsUpdown ? "Yes" : "No")</span>
                    }
                </div>

                <div>
                    @if (editing)
                    {
                        <label class="inline-flex items-center" title="@(employee.IsExcluded ? "Excluded from every Overview figure" : "Counted in the analysis")">
                            <input type="checkbox" aria-label="Analysis inclusion for @employee.Name" checked="@(!employee.IsExcluded)" @onchange="e => ToggleExclusionAsync(employee, !(bool)(e.Value ?? false))" />
                        </label>
                    }
                    else
                    {
                        <span class="badge bg-surface-inset text-ink-soft">@(employee.IsExcluded ? "Excluded" : "Included")</span>
                    }
                </div>

                <div>
                    <div class="flex flex-wrap items-center gap-1.5">
                        <button class="btn btn-secondary !px-2 !py-1 !text-2xs" @onclick="() => OpenAnalysis(employee)" title="Open performance portrait">Portrait →</button>
                        @if (editing)
                        {
                            <button class="btn btn-primary !px-2 !py-1 !text-2xs" @onclick="() => SaveEmployeeAsync(employee)" disabled="@(State.Busy || !IsDirty(employee))">Save</button>
                            <button class="btn btn-secondary !px-2 !py-1 !text-2xs" @onclick="StopEditing">Done</button>
                            <button class="btn btn-danger !px-2 !py-1 !text-2xs" @onclick="() => RemoveEmployeeAsync(employee.Id)" disabled="@State.Busy">Remove</button>
                        }
                        else
                        {
                            <button class="btn btn-secondary !px-2 !py-1 !text-2xs" @onclick="() => StartEditing(employee)">Edit</button>
                        }
                    </div>
                </div>
            </div>
        </Virtualize>
        @if (State.Employees.Count == 0)
        {
            <div class="empty-slot">No employees</div>
        }
    </div>
</section>

@code {
    // Virtualize requires ICollection<TItem>; materialized once per state refresh here instead of
    // on every render, since State.Employees (IReadOnlyList) doesn't itself satisfy that constraint.
    private List<EmployeeListItem> _employeesSnapshot = [];

    protected override void OnInitialized()
    {
        _employeesSnapshot = [.. State.Employees];
        State.Changed += OnStateChanged;
    }

    private void OnStateChanged()
    {
        _employeesSnapshot = [.. State.Employees];
        InvokeAsync(StateHasChanged);
    }
    public void Dispose() => State.Changed -= OnStateChanged;

    private int? _editingEmployeeId;
    private int ExcludedCount => State.Employees.Count(x => x.IsExcluded);

    private decimal? TeamAverageScore(TeamItem team)
    {
        var names = State.Employees.Where(e => e.TeamId == team.Id).Select(e => e.Name).ToArray();
        var scores = State.Performance.Where(i => names.Any(n => PersonName.Matches(i.EmployeeName, n)) && i.OperationalScore > 0)
            .Select(i => i.OperationalScore).ToArray();
        return scores.Length == 0 ? null : decimal.Round(scores.Average(), 1);
    }

    private NewEmployeeModel _newEmployee = new();
    private readonly Dictionary<int, int> _editLevel = [];
    private NewTeamModel _newTeam = new();
    private readonly Dictionary<int, string> _editTeamNames = [];

    private sealed class NewEmployeeModel
    {
        [Required(ErrorMessage = "Employee code is required.")]
        public string Code { get; set; } = string.Empty;
        [Required(ErrorMessage = "Employee name is required.")]
        public string Name { get; set; } = string.Empty;
        [Range(1, 99, ErrorMessage = "Seniority level must be between 1 and 99.")]
        public int Level { get; set; } = 1;
    }

    private sealed class NewTeamModel
    {
        [Required(ErrorMessage = "Enter a team name first.")]
        public string Name { get; set; } = string.Empty;
    }

    private void StartEditing(EmployeeListItem employee)
    {
        _editingEmployeeId = employee.Id;
        if (!_editLevel.ContainsKey(employee.Id)) _editLevel[employee.Id] = employee.SeniorityLevel;
    }
    private void StopEditing() => _editingEmployeeId = null;

    private async Task AddEmployeeAsync() => await RunAsync(async () =>
    {
        await Database.AddEmployeeAsync(_newEmployee.Code, _newEmployee.Name, _newEmployee.Level);
        _newEmployee = new NewEmployeeModel();
        State.ShowMessage("Employee added.");
    });

    private async Task SaveEmployeeAsync(EmployeeListItem employee)
    {
        var level = _editLevel.TryGetValue(employee.Id, out var l) ? l : employee.SeniorityLevel;
        if (level is < 1 or > 99) { State.ShowMessage("Seniority level must be between 1 and 99.", true); return; }
        await RunAsync(async () =>
        {
            await Database.UpdateEmployeeAsync(employee.Id, employee.Name, level);
            _editLevel[employee.Id] = level;
            State.ShowMessage($"{employee.Name} updated to level {level}.");
        });
    }

    private bool IsDirty(EmployeeListItem employee) => _editLevel.TryGetValue(employee.Id, out var l) && l != employee.SeniorityLevel;

    private void AdjustLevel(EmployeeListItem employee, int delta)
    {
        var current = _editLevel.TryGetValue(employee.Id, out var l) ? l : employee.SeniorityLevel;
        _editLevel[employee.Id] = Math.Clamp(current + delta, 1, 99);
    }

    private async Task ToggleExclusionAsync(EmployeeListItem employee, bool excluded) => await RunAsync(async () =>
    {
        await Database.SetExclusionAsync(employee.Name, excluded);
        State.ShowMessage(excluded ? $"{employee.Name} is excluded from the analysis." : $"{employee.Name} is included in the analysis.");
    });

    private void OpenAnalysis(EmployeeListItem employee) => Navigation.NavigateTo($"/employee/{Uri.EscapeDataString(employee.Name)}");

    private async Task RemoveEmployeeAsync(int id) => await RunAsync(async () =>
    {
        await Database.RemoveEmployeeAsync(id);
        if (_editingEmployeeId == id) _editingEmployeeId = null;
        State.ShowMessage("Employee removed.");
    });

    private async Task ImportRosterAsync()
    {
        var path = Dialogs.PickWorkbook(); if (path is null) return;
        await RunAsync(async () =>
        {
            var changed = await Database.ImportEmployeeRosterAsync(path);
            State.ShowMessage(changed == 0 ? "Roster imported — no new employees or seniority changes." : $"Roster imported: {changed} employee(s) created or updated.");
        });
    }

    private bool IsTeamRenamed(TeamItem team) => _editTeamNames.TryGetValue(team.Id, out var name) && !string.IsNullOrWhiteSpace(name) && name.Trim() != team.Name;

    private async Task AddTeamAsync() => await RunAsync(async () =>
    {
        await Database.AddTeamAsync(_newTeam.Name);
        var created = _newTeam.Name.Trim();
        _newTeam = new NewTeamModel();
        State.ShowMessage($"Team “{created}” created.");
    });

    private async Task RenameTeamAsync(TeamItem team)
    {
        var name = _editTeamNames[team.Id];
        await RunAsync(async () =>
        {
            await Database.RenameTeamAsync(team.Id, name);
            _editTeamNames.Remove(team.Id);
            State.ShowMessage($"Team renamed to “{name.Trim()}”.");
        });
    }

    private async Task DeleteTeamAsync(TeamItem team) => await RunAsync(async () =>
    {
        await Database.DeleteTeamAsync(team.Id);
        State.ShowMessage($"Team “{team.Name}” deleted; {team.MemberCount} member(s) unassigned.");
    });

    private async Task AssignTeamAsync(EmployeeListItem employee, string? teamId) => await RunAsync(async () =>
    {
        int? id = int.TryParse(teamId, out var parsed) ? parsed : null;
        await Database.AssignTeamAsync(employee.Id, id);
        State.ShowMessage($"{employee.Name} {(id is null ? "unassigned" : "assigned")}.");
    });

    private async Task SetNonBillableAsync(EmployeeListItem employee, bool nonBillable) => await RunAsync(async () =>
    {
        await Database.SetNonBillableAsync(employee.Id, nonBillable);
        State.ShowMessage($"{employee.Name} marked {(nonBillable ? "non-billable" : "billable")}.");
    });

    private async Task SetUpdownAsync(EmployeeListItem employee, string? mode) => await RunAsync(async () =>
    {
        var value = mode == "on";
        await Database.SetUpdownAsync(employee.Id, value);
        State.ShowMessage($"{employee.Name} commute set to {(value ? "Yes" : "No")}.");
    });

    private async Task SetProbationAsync(EmployeeListItem employee, string? mode) => await RunAsync(async () =>
    {
        bool? value = mode switch { "on" => true, "off" => false, _ => null };
        await Database.SetProbationAsync(employee.Id, value);
        State.ShowMessage($"{employee.Name} probation set to {(value is null ? "auto (roster)" : value.Value ? "on" : "off")}.");
    });

    private async Task RunAsync(Func<Task> action) => await State.RunAsync(async () => { await action(); await State.RefreshAsync(); });
}
