@page "/employees"
@using System.ComponentModel.DataAnnotations
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IFileDialogService Dialogs
@inject IApplicationDatabase Database
@inject AppState State
@inject NavigationManager Navigation
@implements IDisposable

@* Employee master, teams and classification in one place: identity (code, name,
   seniority, analysis inclusion), team assignment, and billable/consultant/probation
   status all live on the same row instead of being split across two screens. *@

<section class="single-pane wide">
    <div class="section-title compact actions-only">
        <div class="section-actions">
            @if (ExcludedCount > 0)
            {
                <span class="excluded-pill">@ExcludedCount excluded from analysis</span>
            }
            <button class="action secondary small" @onclick="ImportRosterAsync" disabled="@State.Busy">Import from ERP roster</button>
        </div>
    </div>

    @* Two independent creation actions, each in its own labelled panel — previously they were
       two identical bars and it was not obvious they wrote to different tables. *@
    <div class="create-panels">
        <EditForm Model="_newEmployee" OnValidSubmit="AddEmployeeAsync">
            <DataAnnotationsValidator />
            <div class="form-row">
                <span class="form-legend">Add employee</span>
                <label>Employee code
                    <InputText @bind-Value="_newEmployee.Code" placeholder="E1042" />
                    <ValidationMessage For="() => _newEmployee.Code" />
                </label>
                <label class="grow">Employee name
                    <InputText @bind-Value="_newEmployee.Name" placeholder="Full name" />
                    <ValidationMessage For="() => _newEmployee.Name" />
                </label>
                <label>Level
                    <InputNumber @bind-Value="_newEmployee.Level" min="1" max="99" />
                    <ValidationMessage For="() => _newEmployee.Level" />
                </label>
                <button type="submit" class="action" disabled="@State.Busy">Add employee</button>
            </div>
        </EditForm>

        <EditForm Model="_newTeam" OnValidSubmit="AddTeamAsync">
            <DataAnnotationsValidator />
            <div class="form-row">
                <span class="form-legend">Create team</span>
                <label class="grow">Team name
                    <InputText @bind-Value="_newTeam.Name" placeholder="e.g. X-Force Execution" />
                    <ValidationMessage For="() => _newTeam.Name" />
                </label>
                <button type="submit" class="action secondary" disabled="@State.Busy">Create team</button>
            </div>
        </EditForm>
    </div>
    @if (State.Teams.Count > 0)
    {
        <div class="team-grid compact">
            @foreach (var team in State.Teams)
            {
                <div class="team-card">
                    <div class="team-card-head">
                        <input class="cell-input team-name" value="@(_editTeamNames.TryGetValue(team.Id, out var n) ? n : team.Name)"
                               @onchange="e => _editTeamNames[team.Id] = e.Value?.ToString() ?? string.Empty" />
                        <span class="team-count">@team.MemberCount</span>
                    </div>
                    @{ var avg = TeamAverageScore(team); }
                    <div class="team-card-stat">
                        @if (avg is not null)
                        {
                            <b class="@Analytics.ScoreBand(avg.Value)">@Analytics.Format(avg.Value)</b><span>avg operational score</span>
                        }
                        else
                        {
                            <span class="muted-note">No scored members yet this month</span>
                        }
                    </div>
                    <div class="team-card-actions">
                        <button class="action small" @onclick="() => RenameTeamAsync(team)" disabled="@(State.Busy || !IsTeamRenamed(team))">Rename</button>
                        <button class="danger" @onclick="() => DeleteTeamAsync(team)" disabled="@State.Busy">Delete</button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="data-table">
        <div class="table-head roster full">
            <span class="cell">Code</span>
            <span class="cell">Engineer</span>
            <span class="cell">Level</span>
            <span class="cell">Team</span>
            <span class="cell">Billable</span>
            <span class="cell">Employment</span>
            <span class="cell"
                  title="Daily train commuter. UAA may be raised regularly and normal departure is around 18:00.">
                Up-down
            </span>
            <span class="cell">In analysis</span>
            <span class="cell">Actions</span>
        </div>
        <Virtualize TItem="EmployeeListItem" Items="State.Employees.ToList()" Context="employee" ItemSize="58">
            <div class="data-row roster full @(employee.IsExcluded ? "excluded" : null)">
                <div class="cell"><code>@employee.EmployeeCode</code></div>
                <div class="cell">
                    <span class="roster-name">
                        <strong>@employee.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(employee.Email))
                        {
                            <small>@employee.Email</small>
                        }
                    </span>
                </div>
                <div class="cell">
                    <div class="level-editor">
                        <button title="Decrease level" @onclick="() => AdjustLevel(employee, -1)">−</button>
                        <input type="number" min="1" max="99" value="@(_editLevel.TryGetValue(employee.Id, out var l) ? l : employee.SeniorityLevel)" @onchange="e => _editLevel[employee.Id] = int.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 1, 99) : employee.SeniorityLevel" />
                        <button title="Increase level" @onclick="() => AdjustLevel(employee, 1)">+</button>
                    </div>
                </div>
                <div class="cell">
                    <select class="team-select" value="@(employee.TeamId?.ToString() ?? "")"
                            @onchange="e => AssignTeamAsync(employee, e.Value?.ToString())">
                        <option value="">— Unassigned —</option>
                        @foreach (var team in State.Teams)
                        {
                            <option value="@team.Id">@team.Name</option>
                        }
                    </select>
                </div>
                <div class="cell">
                    <label class="switch" title="@(employee.IsConsultant ? "Consultants are always non-billable" : "Non-billable engineers are excluded from billable-capacity tracking")">
                        <input type="checkbox" checked="@(!employee.IsNonBillable)" disabled="@employee.IsConsultant"
                               @onchange="e => SetNonBillableAsync(employee, !(bool)(e.Value ?? false))" />
                        <span>@(employee.IsNonBillable ? "Non-billable" : "Billable")</span>
                    </label>
                </div>
                <div class="cell">
                    <span class="tag-row">
                        @if (employee.IsConsultant)
                        {
                            <span class="tag consultant">Consultant</span>
                        }
                        <select class="team-select probation-select" value="@(employee.ProbationOverride is null ? "auto" : employee.ProbationOverride.Value ? "on" : "off")"
                                title="Probation status — Auto follows the ERP roster's completion date"
                                @onchange="e => SetProbationAsync(employee, e.Value?.ToString())">
                            <option value="auto">Probation: Auto (@(employee.IsOnProbation ? "on" : "off"))</option>
                            <option value="on">Probation: On</option>
                            <option value="off">Probation: Off</option>
                        </select>
                    </span>
                </div>
                <div class="cell">
                    <select class="team-select updown-select"
                            value="@(employee.UpdownOverride is null ? "auto" : employee.UpdownOverride.Value ? "on" : "off")"
                            title="Auto follows the ERP roster. Up-down employees commute daily and normally leave around 18:00."
                            @onchange="e => SetUpdownAsync(employee, e.Value?.ToString())">
                        <option value="auto">Auto (@(employee.IsUpdown ? "yes" : "no"))</option>
                        <option value="on">Up-down</option>
                        <option value="off">Not up-down</option>
                    </select>
                </div>
                <div class="cell">
                    <label class="switch" title="@(employee.IsExcluded ? "Excluded from every Overview figure" : "Counted in the analysis")">
                        <input type="checkbox" checked="@(!employee.IsExcluded)" @onchange="e => ToggleExclusionAsync(employee, !(bool)(e.Value ?? false))" />
                        <span>@(employee.IsExcluded ? "Excluded" : "Included")</span>
                    </label>
                </div>
                <div class="cell">
                    <div class="row-actions">
                        <button class="action small secondary" @onclick="() => OpenAnalysis(employee)" title="Open full performance analysis">Analysis →</button>
                        <button class="action small" @onclick="() => SaveEmployeeAsync(employee)" disabled="@(State.Busy || !IsDirty(employee))">Save</button>
                        <button class="danger" @onclick="() => RemoveEmployeeAsync(employee.Id)" disabled="@State.Busy">Remove</button>
                    </div>
                </div>
            </div>
        </Virtualize>
        @if (State.Employees.Count == 0)
        {
            <div class="table-empty">No employees yet. Add one above, or import the ERP roster — it registers every engineer it finds.</div>
        }
    </div>
</section>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;

    private int ExcludedCount => State.Employees.Count(x => x.IsExcluded);

    private decimal? TeamAverageScore(TeamItem team)
    {
        var names = State.Employees.Where(e => e.TeamId == team.Id).Select(e => e.Name).ToArray();
        var scores = State.Performance.Where(i => names.Any(n => PersonName.Matches(i.EmployeeName, n)) && i.OperationalScore > 0)
            .Select(i => i.OperationalScore).ToArray();
        return scores.Length == 0 ? null : decimal.Round(scores.Average(), 1);
    }

    private NewEmployeeModel _newEmployee = new();
    private readonly Dictionary<int, int> _editLevel = [];

    private NewTeamModel _newTeam = new();
    private readonly Dictionary<int, string> _editTeamNames = [];

    private sealed class NewEmployeeModel
    {
        [Required(ErrorMessage = "Employee code is required.")]
        public string Code { get; set; } = string.Empty;

        [Required(ErrorMessage = "Employee name is required.")]
        public string Name { get; set; } = string.Empty;

        [Range(1, 99, ErrorMessage = "Seniority level must be between 1 and 99.")]
        public int Level { get; set; } = 1;
    }

    private sealed class NewTeamModel
    {
        [Required(ErrorMessage = "Enter a team name first.")]
        public string Name { get; set; } = string.Empty;
    }

    // ---------- Employees ----------

    private async Task AddEmployeeAsync() =>
        await RunAsync(async () =>
        {
            await Database.AddEmployeeAsync(_newEmployee.Code, _newEmployee.Name, _newEmployee.Level);
            _newEmployee = new NewEmployeeModel();
            State.ShowMessage("Employee added.");
        });

    // Names come from the ERP roster and are the key every import matches on, so they are shown
    // read-only here — editing one locally would silently orphan that person's imported rows.
    private async Task SaveEmployeeAsync(EmployeeListItem employee)
    {
        var level = _editLevel.TryGetValue(employee.Id, out var l) ? l : employee.SeniorityLevel;
        if (level is < 1 or > 99) { State.ShowMessage("Seniority level must be between 1 and 99.", true); return; }
        await RunAsync(async () =>
        {
            await Database.UpdateEmployeeAsync(employee.Id, employee.Name, level);
            State.ShowMessage($"{employee.Name} updated to level {level}.");
        });
    }

    private bool IsDirty(EmployeeListItem employee) =>
        _editLevel.TryGetValue(employee.Id, out var l) && l != employee.SeniorityLevel;

    private void AdjustLevel(EmployeeListItem employee, int delta)
    {
        var current = _editLevel.TryGetValue(employee.Id, out var l) ? l : employee.SeniorityLevel;
        _editLevel[employee.Id] = Math.Clamp(current + delta, 1, 99);
    }

    private async Task ToggleExclusionAsync(EmployeeListItem employee, bool excluded) =>
        await RunAsync(async () =>
        {
            await Database.SetExclusionAsync(employee.Name, excluded);
            State.ShowMessage(excluded ? $"{employee.Name} is excluded from the analysis." : $"{employee.Name} is included in the analysis.");
        });

    private void OpenAnalysis(EmployeeListItem employee) => Navigation.NavigateTo($"/employee/{Uri.EscapeDataString(employee.Name)}");

    private async Task RemoveEmployeeAsync(int id) =>
        await RunAsync(async () => { await Database.RemoveEmployeeAsync(id); State.ShowMessage("Employee removed."); });

    private async Task ImportRosterAsync()
    {
        var path = Dialogs.PickWorkbook(); if (path is null) return;
        await RunAsync(async () =>
        {
            var changed = await Database.ImportEmployeeRosterAsync(path);
            State.ShowMessage(changed == 0 ? "Roster imported — no new employees or seniority changes." : $"Roster imported: {changed} employee(s) created or updated.");
        });
    }

    // ---------- Teams ----------

    private bool IsTeamRenamed(TeamItem team) =>
        _editTeamNames.TryGetValue(team.Id, out var name) && !string.IsNullOrWhiteSpace(name) && name.Trim() != team.Name;

    private async Task AddTeamAsync() =>
        await RunAsync(async () =>
        {
            await Database.AddTeamAsync(_newTeam.Name);
            var created = _newTeam.Name.Trim();
            _newTeam = new NewTeamModel();
            State.ShowMessage($"Team “{created}” created.");
        });

    private async Task RenameTeamAsync(TeamItem team)
    {
        var name = _editTeamNames[team.Id];
        await RunAsync(async () =>
        {
            await Database.RenameTeamAsync(team.Id, name);
            _editTeamNames.Remove(team.Id);
            State.ShowMessage($"Team renamed to “{name.Trim()}”.");
        });
    }

    private async Task DeleteTeamAsync(TeamItem team) =>
        await RunAsync(async () =>
        {
            await Database.DeleteTeamAsync(team.Id);
            State.ShowMessage($"Team “{team.Name}” deleted; {team.MemberCount} member(s) unassigned.");
        });

    private async Task AssignTeamAsync(EmployeeListItem employee, string? teamId) =>
        await RunAsync(async () =>
        {
            int? id = int.TryParse(teamId, out var parsed) ? parsed : null;
            await Database.AssignTeamAsync(employee.Id, id);
            State.ShowMessage($"{employee.Name} {(id is null ? "unassigned" : "assigned")}.");
        });

    private async Task SetNonBillableAsync(EmployeeListItem employee, bool nonBillable) =>
        await RunAsync(async () =>
        {
            await Database.SetNonBillableAsync(employee.Id, nonBillable);
            State.ShowMessage($"{employee.Name} marked {(nonBillable ? "non-billable" : "billable")}.");
        });

    private async Task SetUpdownAsync(EmployeeListItem employee, string? mode) =>
        await RunAsync(async () =>
        {
            bool? value = mode switch
            {
                "on" => true,
                "off" => false,
                _ => null
            };

            await Database.SetUpdownAsync(employee.Id, value);

            State.ShowMessage(
                $"{employee.Name} Up-down status set to " +
                (value is null
                    ? "Auto (ERP roster)."
                    : value.Value
                        ? "Up-down."
                        : "Not up-down."));
        });

    private async Task SetProbationAsync(EmployeeListItem employee, string? mode) =>
        await RunAsync(async () =>
        {
            bool? value = mode switch { "on" => true, "off" => false, _ => null };
            await Database.SetProbationAsync(employee.Id, value);
            State.ShowMessage($"{employee.Name} probation set to {(value is null ? "auto (roster)" : value.Value ? "on" : "off")}.");
        });

    private async Task RunAsync(Func<Task> action) =>
        await State.RunAsync(async () => { await action(); await State.RefreshAsync(); });
}
