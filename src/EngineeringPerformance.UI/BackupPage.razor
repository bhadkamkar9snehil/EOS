@page "/backup"
@using EngineeringPerformance.Application
@inject IBackupService Backups
@inject IFileDialogService Dialogs
@inject AppState State
@inject IJSRuntime JS

<section class="flex flex-col gap-6">
    <h2 class="text-xl font-bold text-ink">Backup &amp; restore</h2>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="card">
            <div class="panel-head"><h2 class="text-sm font-bold text-ink">Create a backup</h2><small class="text-2xs text-muted">Database + scoring settings</small></div>
            <p class="text-sm text-ink-soft">Saved to <code class="text-xs">@Backups.DefaultBackupDirectory</code></p>
            <div class="mt-4 flex gap-2">
                <button class="btn btn-secondary" @onclick="ExportToDefaultAsync" disabled="@State.Busy">Backup now</button>
                <button class="btn btn-secondary" @onclick="ExportToChosenFolderAsync" disabled="@State.Busy">Backup to a chosen folder…</button>
            </div>
        </div>

        <div class="card">
            <div class="panel-head"><h2 class="text-sm font-bold text-ink">Restore from backup</h2><small class="text-2xs text-muted">Replaces the current database</small></div>
            <div class="rounded-lg border border-critical-soft bg-critical-soft p-3">
                <strong class="block text-sm font-semibold text-critical">This is destructive</strong>
                <p class="mt-1 text-xs text-ink-soft">Replaces all current data. A safety backup is taken first. Restart EOS afterward.</p>
            </div>
            <div class="mt-4 flex gap-2">
                <button class="btn btn-primary" @onclick="RestoreAsync" disabled="@State.Busy">Choose backup file to restore…</button>
            </div>
        </div>
    </div>

    <div>
        <h2 class="text-lg font-bold text-ink">Recent backups</h2>
        <p class="mt-1 text-sm text-ink-soft">Most recent first, from the default backup folder.</p>
    </div>

    <div class="card">
        @if (_backups.Count == 0)
        {
            <p class="text-sm text-muted">No backups yet. Use "Backup now" above to create the first one.</p>
        }
        else
        {
            <div class="flex flex-col divide-y divide-line">
                <div class="grid grid-cols-[1fr_10rem_6rem] gap-2 pb-2 text-3xs font-semibold uppercase tracking-wide text-muted">
                    <span>File</span><span>Created</span><span>Size</span>
                </div>
                @foreach (var backup in _backups)
                {
                    <div class="grid grid-cols-[1fr_10rem_6rem] items-center gap-2 py-2 text-sm">
                        <span class="truncate text-ink">@backup.FileName</span>
                        <span class="text-ink-soft">@backup.CreatedUtc.ToLocalTime().ToString("g")</span>
                        <span class="text-ink-soft">@FormatSize(backup.SizeBytes)</span>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private IReadOnlyList<BackupFileInfo> _backups = [];

    protected override async Task OnInitializedAsync() => await RefreshListAsync();

    private async Task RefreshListAsync() => _backups = await Backups.ListBackupsAsync();

    private async Task ExportToDefaultAsync()
    {
        await State.RunAsync(async () =>
        {
            var result = await Backups.ExportBackupAsync();
            await RefreshListAsync();
            State.ShowMessage($"Backup created: {Path.GetFileName(result.FilePath)} ({FormatSize(result.SizeBytes)}).");
        });
    }

    private async Task ExportToChosenFolderAsync()
    {
        var folder = Dialogs.PickFolder("Choose a backup destination folder");
        if (folder is null) return;
        await State.RunAsync(async () =>
        {
            var result = await Backups.ExportBackupAsync(folder);
            State.ShowMessage($"Backup created: {result.FilePath} ({FormatSize(result.SizeBytes)}).");
        });
    }

    private async Task RestoreAsync()
    {
        var file = Dialogs.PickBackupFile();
        if (file is null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Restore from {Path.GetFileName(file)}? This replaces all current data. Your current database will be backed up first, but you should still be certain.");
        if (!confirmed) return;
        await State.RunAsync(async () =>
        {
            var result = await Backups.RestoreBackupAsync(file);
            await RefreshListAsync();
            State.ShowMessage($"Restore complete. Previous database saved to {result.SafetyBackupPath}. Please restart EOS now for the restored data to take effect.");
        });
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }
}
