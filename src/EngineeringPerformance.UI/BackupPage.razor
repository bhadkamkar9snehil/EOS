@page "/backup"
@using EngineeringPerformance.Application
@inject IBackupService Backups
@inject IFileDialogService Dialogs
@inject AppState State
@inject IJSRuntime JS

<section class="flex flex-col gap-6">
    <div class="grid grid-cols-1 gap-4 @@3xl:grid-cols-2">
        <div class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Export</div>
                    <h2 class="panel-title">Create a backup</h2>
                </div>
                <span class="ml-auto flex items-center gap-1.5">
                    <i class="@($"h-2 w-2 {(_backups.Count > 0 ? "lamp text-good" : "lamp-off")}")" aria-hidden="true"></i>
                    <span class="label-instrument"><span class="tnum">@_backups.Count</span> on disk</span>
                </span>
            </div>
            <div class="text-sm text-ink-soft"><span class="label-instrument mr-1">Folder</span><code class="font-mono text-2xs">@Backups.DefaultBackupDirectory</code></div>
            <div class="mt-4 flex gap-2">
                <button class="btn btn-secondary" @onclick="ExportToDefaultAsync" disabled="@State.Busy">Backup now</button>
                <button class="btn btn-secondary" @onclick="ExportToChosenFolderAsync" disabled="@State.Busy">Backup to a chosen folder…</button>
            </div>
        </div>

        <div class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Import</div>
                    <h2 class="panel-title">Restore from backup</h2>
                </div>
                <span class="ml-auto flex items-center gap-1.5">
                    <i class="lamp h-2 w-2 text-critical" aria-hidden="true"></i>
                    <span class="label-instrument">Destructive</span>
                </span>
            </div>
            <div class="flex flex-wrap gap-2 rounded-lg border border-critical-soft bg-critical-soft p-3">
                <span class="badge bg-surface text-critical">Full replacement</span>
                <span class="badge bg-surface text-ink-soft">Safety backup</span>
                <span class="badge bg-surface text-warning">Restart required</span>
            </div>
            <div class="mt-4 flex gap-2">
                <button class="btn btn-primary" @onclick="RestoreAsync" disabled="@State.Busy">Choose backup file to restore…</button>
            </div>
        </div>
    </div>

    <div class="plate p-4">
        <div class="panel-head">
            <div>
                <div class="panel-eyebrow">History</div>
                <h2 class="panel-title">Recent backups</h2>
            </div>
            <span class="label-instrument ml-auto">Most recent first · default folder</span>
        </div>
        @if (_backups.Count == 0)
        {
            <p class="text-sm text-muted">No backups</p>
        }
        else
        {
            <div class="flex flex-col divide-y divide-line-soft">
                <div class="chassis grid grid-cols-[1fr_10rem_6rem] gap-2 rounded-md px-3 py-2">
                    <span class="label-instrument !text-on-chassis-soft">File</span>
                    <span class="label-instrument !text-on-chassis-soft">Created</span>
                    <span class="label-instrument !text-on-chassis-soft">Size</span>
                </div>
                @foreach (var backup in _backups)
                {
                    <div class="group grid grid-cols-[1fr_10rem_6rem] items-center gap-2 px-3 py-2 text-sm transition-colors duration-100 ease-press hover:bg-surface-inset">
                        <span class="truncate font-mono text-2xs text-ink" title="@backup.FileName">@backup.FileName</span>
                        <span class="tabular-nums text-ink-soft">@backup.CreatedUtc.ToLocalTime().ToString("g")</span>
                        <span class="tabular-nums text-ink-soft">@FileSizeFormat.Format(backup.SizeBytes)</span>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private IReadOnlyList<BackupFileInfo> _backups = [];

    protected override async Task OnInitializedAsync() => await RefreshListAsync();

    private async Task RefreshListAsync() => _backups = await Backups.ListBackupsAsync();

    private async Task ExportToDefaultAsync()
    {
        await State.RunAsync(async () =>
        {
            var result = await Backups.ExportBackupAsync();
            await RefreshListAsync();
            State.ShowMessage($"Backup created: {Path.GetFileName(result.FilePath)} ({FileSizeFormat.Format(result.SizeBytes)}).");
        });
    }

    private async Task ExportToChosenFolderAsync()
    {
        var folder = Dialogs.PickFolder("Choose a backup destination folder");
        if (folder is null) return;
        await State.RunAsync(async () =>
        {
            var result = await Backups.ExportBackupAsync(folder);
            State.ShowMessage($"Backup created: {result.FilePath} ({FileSizeFormat.Format(result.SizeBytes)}).");
        });
    }

    private async Task RestoreAsync()
    {
        var file = Dialogs.PickBackupFile();
        if (file is null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Restore from {Path.GetFileName(file)}? This replaces all current data. Your current database will be backed up first, but you should still be certain.");
        if (!confirmed) return;
        await State.RunAsync(async () =>
        {
            var result = await Backups.RestoreBackupAsync(file);
            await RefreshListAsync();
            State.ShowMessage($"Restore complete. Previous database saved to {result.SafetyBackupPath}. Please restart EOS now for the restored data to take effect.");
        });
    }
}
