@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject AppState State
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@if (Months.Count > 0)
{
    <section class="analytics-extension employee-extension">
        <header class="analytics-section-head">
            <div>
                <span class="analytics-eyebrow">Current operating profile</span>
                <h2>@LatestLabel in one decision view</h2>
                <p>Current-month capacity, attendance and delivery metrics first; longitudinal diagnostics follow below.</p>
            </div>
            <button class="action secondary small" @onclick='() => Navigation.NavigateTo("/data")'>Open numerical audit →</button>
        </header>

        <div class="metric-ribbon employee-ribbon">
            @Metric("Operational score", Latest.OperationalScore, "", Analytics.ScoreBand(Latest.OperationalScore))
            @Metric("Utilization", Latest.Utilization, "%", Latest.Utilization >= 75 ? "good" : "warning")
            @Metric("Timesheet days", Latest.TimesheetFilledDays, $"/ {Latest.ExpectedTimesheetDays}", Latest.TimesheetFilledDays >= Latest.ExpectedTimesheetDays ? "good" : "warning")
            @Metric("Reconciliation", Latest.ReconciliationVariance, "h", Math.Abs(Latest.ReconciliationVariance) >= 40 ? "risk" : "neutral", true)
            @Metric("Detailed entries", Latest.DetailedEntries, "", "primary")
            @Metric("Projects", Latest.UniqueProjects, "", "accent")
        </div>

        <div class="employee-current-grid">
            <section class="card span-7 command-chart">
                <div class="card-head"><div><h2>Current-month hours profile</h2><small>Imported totals across capacity, timesheet and attendance</small></div></div>
                <div id="employee-current-hours" class="echart"></div>
            </section>
            <section class="card span-5 command-chart">
                <div class="card-head"><div><h2>Attendance exception profile</h2><small>Counts are days, not severity scores</small></div></div>
                <div id="employee-current-exceptions" class="echart"></div>
            </section>
        </div>

        <div class="metric-matrix employee-matrix">
            <section><h3>Scores</h3>@Value("Operational", Latest.OperationalScore)@Value("Timesheet", Latest.TimesheetCompletionScore, Latest.HasSummaryData)@Value("Approval", Latest.ApprovalScore, Latest.HasSummaryData)@Value("Attendance", Latest.AttendanceDisciplineScore)</section>
            <section><h3>Capacity & timesheets</h3>@Value("Compliance hours", Latest.ComplianceHours, Latest.HasSummaryData)@Value("Entered hours", Latest.EnteredHours)@Value("Approved hours", Latest.ApprovedHours)@Value("Utilization", Latest.Utilization, Latest.HasSummaryData, "%")</section>
            <section><h3>Work allocation</h3>@Value("Billable hours", Latest.BillableHours)@Value("Non-billable hours", Latest.NonBillableHours)@Value("Training hours", Latest.TrainingHours)@Value("Office hours", Latest.OfficeHours)</section>
            <section><h3>Attendance</h3>@Value("Punch hours", Latest.PunchHours)@Value("Attendance TS hours", Latest.AttendanceTimesheetHours)@Value("Variance", Latest.ReconciliationVariance, true, "h", true)@Value("Attendance days", Latest.AttendanceDays)</section>
            <section><h3>Exceptions</h3>@Count("Missing punch", Latest.MissingPunchDays)@Count("Late", Latest.LateDays)@Count("Early", Latest.EarlyDays)@Count("Less duration", Latest.LessDurationDays)</section>
            <section><h3>Delivery activity</h3>@Value("Detailed hours", Latest.DetailedHours)@Count("Detailed entries", Latest.DetailedEntries)@Count("Unique projects", Latest.UniqueProjects)@Value("Leave days", Latest.LeaveDays)</section>
        </div>

        <details class="history-expansion" open>
            <summary>
                <span><strong>Expanded operational history</strong><small>Allocation, reconciliation, exceptions and delivery over @Months.Count loaded month(s)</small></span>
                <span class="history-toggle">Show / hide</span>
            </summary>
            <div class="extension-grid employee-history-grid">
                <section class="card span-6"><div class="card-head"><h2>Hours history</h2><small>Allocation and capacity</small></div><div id="employee-hours-history" class="echart tall"></div></section>
                <section class="card span-6"><div class="card-head"><h2>Attendance reconciliation</h2><small>Punch, timesheet and variance</small></div><div id="employee-attendance-history" class="echart tall"></div></section>
                <section class="card span-6"><div class="card-head"><h2>Exception history</h2><small>Monthly exception days</small></div><div id="employee-exception-history" class="echart"></div></section>
                <section class="card span-6"><div class="card-head"><h2>Delivery activity history</h2><small>Detailed hours, entries and projects</small></div><div id="employee-delivery-history" class="echart"></div></section>
            </div>
        </details>
    </section>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    private bool _pending = true;
    private string? _signature;

    private IReadOnlyList<MonthlyPerformanceItem> Months => State.History
        .Where(x => PersonName.Matches(x.EmployeeName, Name))
        .GroupBy(x => (x.Year, x.Month)).Select(g => g.First())
        .OrderBy(x => x.Year).ThenBy(x => x.Month).ToArray();
    private MonthlyPerformanceItem Latest => Months[^1];
    private string LatestLabel => new DateTime(Latest.Year, Latest.Month, 1).ToString("MMMM yyyy");

    protected override void OnInitialized() => State.Changed += OnChanged;
    protected override void OnParametersSet() => _pending = true;
    private void OnChanged() { _pending = true; InvokeAsync(StateHasChanged); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var signature = $"{Name}|{Months.Count}|{Months.Sum(x => x.OperationalScore):0.0}";
        if (!_pending && signature == _signature) return;
        _pending = false;
        _signature = signature;
        if (Months.Count == 0) return;

        await JS.InvokeVoidAsync("epaEchartsLoader.ensureLoaded");
        await JS.InvokeVoidAsync("epaCharts.verticalBars", "employee-current-hours",
            new[] { "Compliance", "Entered", "Approved", "Billable", "Non-billable", "Training", "Office", "Punch" },
            new object[]
            {
                new
                {
                    name = "Hours",
                    color = "#0F6E9E",
                    values = new object?[]
                    {
                        Latest.HasSummaryData ? Latest.ComplianceHours : null,
                        Latest.EnteredHours,
                        Latest.ApprovedHours,
                        Latest.BillableHours,
                        Latest.NonBillableHours,
                        Latest.TrainingHours,
                        Latest.OfficeHours,
                        Latest.PunchHours
                    }
                }
            }, null, " h");

        await JS.InvokeVoidAsync("epaCharts.verticalBars", "employee-current-exceptions",
            new[] { "Missing punch", "Late", "Early", "Less duration", "Missing TS" },
            new object[]
            {
                new
                {
                    name = "Days",
                    color = "#C85A22",
                    values = new object[]
                    {
                        Latest.MissingPunchDays,
                        Latest.LateDays,
                        Latest.EarlyDays,
                        Latest.LessDurationDays,
                        Math.Max(0, Latest.ExpectedTimesheetDays - Latest.TimesheetFilledDays)
                    }
                }
            }, null, " d");

        var labels = Months.Select(x => new DateTime(x.Year, x.Month, 1).ToString("MMM yy")).ToArray();
        await JS.InvokeVoidAsync("epaCharts.verticalBars", "employee-hours-history", labels, new object[]
        {
            new { name = "Billable", color = "#0F6E9E", values = Months.Select(x => (object)x.BillableHours).ToArray() },
            new { name = "Non-billable", color = "#C85A22", values = Months.Select(x => (object)x.NonBillableHours).ToArray() },
            new { name = "Training", color = "#7A4BB0", values = Months.Select(x => (object)x.TrainingHours).ToArray() },
            new { name = "Compliance", color = "#1E8C5A", values = Months.Select(x => x.HasSummaryData ? (object)x.ComplianceHours : null).ToArray() }
        }, null, " h");

        await JS.InvokeVoidAsync("epaCharts.multiline", "employee-attendance-history", labels, new object[]
        {
            new { name = "Punch hours", color = "#0F6E9E", values = Months.Select(x => (object)x.PunchHours).ToArray() },
            new { name = "Attendance TS", color = "#1E8C5A", values = Months.Select(x => (object)x.AttendanceTimesheetHours).ToArray() },
            new { name = "Variance", color = "#C85A22", values = Months.Select(x => (object)x.ReconciliationVariance).ToArray() }
        });

        await JS.InvokeVoidAsync("epaCharts.verticalBars", "employee-exception-history", labels, new object[]
        {
            new { name = "Missing punch", color = "#A94236", values = Months.Select(x => (object)x.MissingPunchDays).ToArray() },
            new { name = "Late", color = "#A9762A", values = Months.Select(x => (object)x.LateDays).ToArray() },
            new { name = "Early", color = "#C85A22", values = Months.Select(x => (object)x.EarlyDays).ToArray() },
            new { name = "Less duration", color = "#7A4BB0", values = Months.Select(x => (object)x.LessDurationDays).ToArray() }
        }, null, " d");

        await JS.InvokeVoidAsync("epaCharts.multiline", "employee-delivery-history", labels, new object[]
        {
            new { name = "Detailed hours", color = "#0F6E9E", values = Months.Select(x => (object)x.DetailedHours).ToArray() },
            new { name = "Entries", color = "#C85A22", values = Months.Select(x => (object)x.DetailedEntries).ToArray() },
            new { name = "Projects", color = "#1E8C5A", values = Months.Select(x => (object)x.UniqueProjects).ToArray() }
        });
    }

    private RenderFragment Value(string label, decimal value, bool available = true, string suffix = "", bool signed = false) => @<div><span>@label</span><b>@(available ? (signed && value > 0 ? "+" : "") + Analytics.Format(value) + (suffix == "" ? "" : " " + suffix) : "—")</b></div>;
    private RenderFragment Count(string label, int value) => @<div><span>@label</span><b>@value</b></div>;
    private RenderFragment Metric(string label, decimal value, string suffix, string tone, bool signed = false) => @<div class="metric-tile @tone"><span>@label</span><strong>@(signed && value > 0 ? "+" : "")@Analytics.Format(value)</strong><small>@suffix</small></div>;

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnChanged;
        foreach (var id in new[] { "employee-current-hours", "employee-current-exceptions", "employee-hours-history", "employee-attendance-history", "employee-exception-history", "employee-delivery-history" })
        {
            try { await JS.InvokeVoidAsync("epaCharts.dispose", id); } catch (JSDisconnectedException) { }
        }
    }
}
