@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject AppState State
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@if (Months.Count > 0)
{
    <section class="flex flex-col gap-4">
        <header class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <span class="block text-3xs font-semibold uppercase tracking-wide text-muted">Current operating profile</span>
                <h2 class="text-lg font-bold text-ink">@LatestLabel in one decision view</h2>
            </div>
            <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/data")'>Open numerical audit →</button>
        </header>

        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            @Metric("Operational score", Latest.OperationalScore, "", Analytics.BandSoftClass(Analytics.ScoreBand(Latest.OperationalScore)))
            @Metric("Utilization", Latest.Utilization, "%", Latest.Utilization >= 75 ? "bg-good-soft text-good" : "bg-warning-soft text-warning")
            @Metric("Timesheet days", Latest.TimesheetFilledDays, $"/ {Latest.ExpectedTimesheetDays}", Latest.TimesheetFilledDays >= Latest.ExpectedTimesheetDays ? "bg-good-soft text-good" : "bg-warning-soft text-warning")
            @Metric("Reconciliation", Latest.ReconciliationVariance, "h", Math.Abs(Latest.ReconciliationVariance) >= 40 ? "bg-critical-soft text-critical" : "bg-surface-inset text-ink-soft", true)
            @Metric("Detailed entries", Latest.DetailedEntries, "", "bg-info-soft text-info")
            @Metric("Projects", Latest.UniqueProjects, "", "bg-primary-soft text-primary")
        </div>

        <div class="grid grid-cols-1 gap-4 xl:grid-cols-12">
            <section class="card xl:col-span-7">
                <div class="panel-head"><h2 class="text-sm font-bold text-ink">Current-month hours profile</h2><small class="text-2xs text-muted">Imported totals across capacity, timesheet and attendance</small></div>
                <div id="employee-current-hours" class="h-[260px]"></div>
            </section>
            <section class="card xl:col-span-5">
                <div class="panel-head"><h2 class="text-sm font-bold text-ink">Attendance exception profile</h2><small class="text-2xs text-muted">Counts are days, not severity scores</small></div>
                <div id="employee-current-exceptions" class="h-[260px]"></div>
            </section>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
            <section><h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Scores</h3><div class="mt-1 flex flex-col gap-1">@Value("Operational", Latest.OperationalScore)@Value("Timesheet", Latest.TimesheetCompletionScore, Latest.HasSummaryData)@Value("Approval", Latest.ApprovalScore, Latest.HasSummaryData)@Value("Attendance", Latest.AttendanceDisciplineScore)</div></section>
            <section><h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Capacity &amp; timesheets</h3><div class="mt-1 flex flex-col gap-1">@Value("Compliance hours", Latest.ComplianceHours, Latest.HasSummaryData)@Value("Entered hours", Latest.EnteredHours)@Value("Approved hours", Latest.ApprovedHours)@Value("Utilization", Latest.Utilization, Latest.HasSummaryData, "%")</div></section>
            <section><h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Work allocation</h3><div class="mt-1 flex flex-col gap-1">@Value("Billable hours", Latest.BillableHours)@Value("Non-billable hours", Latest.NonBillableHours)@Value("Training hours", Latest.TrainingHours)@Value("Office hours", Latest.OfficeHours)</div></section>
            <section><h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Attendance</h3><div class="mt-1 flex flex-col gap-1">@Value("Punch hours", Latest.PunchHours)@Value("Attendance TS hours", Latest.AttendanceTimesheetHours)@Value("Variance", Latest.ReconciliationVariance, true, "h", true)@Value("Attendance days", Latest.AttendanceDays)</div></section>
            <section><h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Exceptions</h3><div class="mt-1 flex flex-col gap-1">@Count("Missing punch", Latest.MissingPunchDays)@Count("Late", Latest.LateDays)@Count("Early", Latest.EarlyDays)@Count("Less duration", Latest.LessDurationDays)</div></section>
            <section><h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Delivery activity</h3><div class="mt-1 flex flex-col gap-1">@Value("Detailed hours", Latest.DetailedHours)@Count("Detailed entries", Latest.DetailedEntries)@Count("Unique projects", Latest.UniqueProjects)@Value("Leave days", Latest.LeaveDays)</div></section>
        </div>

        <details class="rounded-xl border border-line bg-surface" open>
            <summary class="flex cursor-pointer items-center justify-between gap-3 p-4">
                <span><strong class="text-sm font-semibold text-ink">Expanded operational history</strong><small class="ml-2 text-2xs text-muted">Allocation, reconciliation, exceptions and delivery over @Months.Count loaded month(s)</small></span>
                <span class="text-xs font-medium text-primary">Show / hide</span>
            </summary>
            <div class="grid grid-cols-1 gap-4 border-t border-line p-4 xl:grid-cols-2">
                <section class="card"><div class="panel-head"><h2 class="text-sm font-bold text-ink">Hours history</h2><small class="text-2xs text-muted">Allocation and capacity</small></div><div id="employee-hours-history" class="h-[320px]"></div></section>
                <section class="card"><div class="panel-head"><h2 class="text-sm font-bold text-ink">Attendance reconciliation</h2><small class="text-2xs text-muted">Punch, timesheet and variance</small></div><div id="employee-attendance-history" class="h-[320px]"></div></section>
                <section class="card"><div class="panel-head"><h2 class="text-sm font-bold text-ink">Exception history</h2><small class="text-2xs text-muted">Monthly exception days</small></div><div id="employee-exception-history" class="h-[260px]"></div></section>
                <section class="card"><div class="panel-head"><h2 class="text-sm font-bold text-ink">Delivery activity history</h2><small class="text-2xs text-muted">Detailed hours, entries and projects</small></div><div id="employee-delivery-history" class="h-[260px]"></div></section>
            </div>
        </details>
    </section>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    private bool _pending = true;
    private string? _signature;

    private IReadOnlyList<MonthlyPerformanceItem> Months => State.History
        .Where(x => PersonName.Matches(x.EmployeeName, Name))
        .GroupBy(x => (x.Year, x.Month)).Select(g => g.First())
        .OrderBy(x => x.Year).ThenBy(x => x.Month).ToArray();
    private MonthlyPerformanceItem Latest => Months[^1];
    private string LatestLabel => new DateTime(Latest.Year, Latest.Month, 1).ToString("MMMM yyyy");

    protected override void OnInitialized() => State.Changed += OnChanged;
    protected override void OnParametersSet() => _pending = true;
    private void OnChanged() { _pending = true; InvokeAsync(StateHasChanged); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var signature = $"{Name}|{Months.Count}|{Months.Sum(x => x.OperationalScore):0.0}";
        if (!_pending && signature == _signature) return;
        _pending = false;
        _signature = signature;
        if (Months.Count == 0) return;

        await JS.InvokeVoidAsync("epaEchartsLoader.ensureLoaded");
        await JS.InvokeVoidAsync("epaCharts.verticalBars", "employee-current-hours",
            new[] { "Compliance", "Entered", "Approved", "Billable", "Non-billable", "Training", "Office", "Punch" },
            new object[]
            {
                new
                {
                    name = "Hours",
                    color = "#0F6E9E",
                    values = new object?[]
                    {
                        Latest.HasSummaryData ? Latest.ComplianceHours : null,
                        Latest.EnteredHours,
                        Latest.ApprovedHours,
                        Latest.BillableHours,
                        Latest.NonBillableHours,
                        Latest.TrainingHours,
                        Latest.OfficeHours,
                        Latest.PunchHours
                    }
                }
            }, null, " h");

        await JS.InvokeVoidAsync("epaCharts.verticalBars", "employee-current-exceptions",
            new[] { "Missing punch", "Late", "Early", "Less duration", "Missing TS" },
            new object[]
            {
                new
                {
                    name = "Days",
                    color = "#C85A22",
                    values = new object[]
                    {
                        Latest.MissingPunchDays,
                        Latest.LateDays,
                        Latest.EarlyDays,
                        Latest.LessDurationDays,
                        Math.Max(0, Latest.ExpectedTimesheetDays - Latest.TimesheetFilledDays)
                    }
                }
            }, null, " d");

        var labels = Months.Select(x => new DateTime(x.Year, x.Month, 1).ToString("MMM yy")).ToArray();
        await JS.InvokeVoidAsync("epaCharts.verticalBars", "employee-hours-history", labels, new object[]
        {
            new { name = "Billable", color = "#0F6E9E", values = Months.Select(x => (object)x.BillableHours).ToArray() },
            new { name = "Non-billable", color = "#C85A22", values = Months.Select(x => (object)x.NonBillableHours).ToArray() },
            new { name = "Training", color = "#7A4BB0", values = Months.Select(x => (object)x.TrainingHours).ToArray() },
            new { name = "Compliance", color = "#1E8C5A", values = Months.Select(x => x.HasSummaryData ? (object)x.ComplianceHours : null).ToArray() }
        }, null, " h");

        await JS.InvokeVoidAsync("epaCharts.multiline", "employee-attendance-history", labels, new object[]
        {
            new { name = "Punch hours", color = "#0F6E9E", values = Months.Select(x => (object)x.PunchHours).ToArray() },
            new { name = "Attendance TS", color = "#1E8C5A", values = Months.Select(x => (object)x.AttendanceTimesheetHours).ToArray() },
            new { name = "Variance", color = "#C85A22", values = Months.Select(x => (object)x.ReconciliationVariance).ToArray() }
        });

        await JS.InvokeVoidAsync("epaCharts.verticalBars", "employee-exception-history", labels, new object[]
        {
            new { name = "Missing punch", color = "#A94236", values = Months.Select(x => (object)x.MissingPunchDays).ToArray() },
            new { name = "Late", color = "#A9762A", values = Months.Select(x => (object)x.LateDays).ToArray() },
            new { name = "Early", color = "#C85A22", values = Months.Select(x => (object)x.EarlyDays).ToArray() },
            new { name = "Less duration", color = "#7A4BB0", values = Months.Select(x => (object)x.LessDurationDays).ToArray() }
        }, null, " d");

        await JS.InvokeVoidAsync("epaCharts.multiline", "employee-delivery-history", labels, new object[]
        {
            new { name = "Detailed hours", color = "#0F6E9E", values = Months.Select(x => (object)x.DetailedHours).ToArray() },
            new { name = "Entries", color = "#C85A22", values = Months.Select(x => (object)x.DetailedEntries).ToArray() },
            new { name = "Projects", color = "#1E8C5A", values = Months.Select(x => (object)x.UniqueProjects).ToArray() }
        });
    }

    private RenderFragment Value(string label, decimal value, bool available = true, string suffix = "", bool signed = false) =>
        @<div class="flex items-center justify-between text-xs"><span class="text-ink-soft">@label</span><b class="font-semibold text-ink">@(available ? (signed && value > 0 ? "+" : "") + Analytics.Format(value) + (suffix == "" ? "" : " " + suffix) : "—")</b></div>;
    private RenderFragment Count(string label, int value) => @<div class="flex items-center justify-between text-xs"><span class="text-ink-soft">@label</span><b class="font-semibold text-ink">@value</b></div>;
    private RenderFragment Metric(string label, decimal value, string suffix, string tone, bool signed = false) =>
        @<div class="@($"rounded-lg p-3 {tone}")">
            <span class="block text-3xs font-medium opacity-80">@label</span>
            <strong class="text-lg font-bold">@(signed && value > 0 ? "+" : "")@Analytics.Format(value)</strong>
            <small class="ml-1 text-xs opacity-80">@suffix</small>
        </div>;

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnChanged;
        foreach (var id in new[] { "employee-current-hours", "employee-current-exceptions", "employee-hours-history", "employee-attendance-history", "employee-exception-history", "employee-delivery-history" })
        {
            try { await JS.InvokeVoidAsync("epaCharts.dispose", id); } catch (JSDisconnectedException) { }
        }
    }
}
