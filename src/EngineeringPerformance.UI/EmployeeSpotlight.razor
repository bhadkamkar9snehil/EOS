@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="fixed inset-0 z-50 flex justify-end bg-ink/40 transition-opacity duration-300 ease-settle" @onclick="Close">
    <aside class="glass flex h-full w-full max-w-2xl flex-col overflow-y-auto !rounded-none transition-transform duration-300 ease-settle" role="dialog" aria-modal="true" aria-label="@($"Spotlight for {Name}")" @onclick:stopPropagation="true">
        <header class="flex items-center gap-3 border-b border-line p-4">
            <span class="well flex h-10 w-10 shrink-0 items-center justify-center !rounded-full font-display text-sm font-semibold text-ink-soft">@Initials(Name)</span>
            <div class="min-w-0 flex-1">
                <div class="panel-eyebrow">Spotlight</div>
                <h2 class="panel-title truncate">@Name</h2>
                <small class="text-2xs tabular-nums text-muted">@(Item?.EmployeeCode ?? "No code on file") — @Month.ToString("MMMM yyyy")</small>
            </div>
            @if (OnOpenProfile.HasDelegate) { <button type="button" class="control whitespace-nowrap px-2.5 py-1.5 text-xs font-semibold text-primary hover:control-hover active:control-pressed" @onclick="() => OnOpenProfile.InvokeAsync(Name)">Full history →</button> }
            <button type="button" class="control flex h-7 w-7 items-center justify-center text-muted hover:control-hover active:control-pressed" @onclick="Close" title="Close" aria-label="Close spotlight">×</button>
        </header>

        <div class="flex flex-col gap-4 p-4">
            @if (Item is null)
            {
                <div class="plate p-6"><strong class="panel-title block">No data · <span class="tabular-nums">@Month.ToString("MMMM yyyy")</span> · @Name</strong></div>
            }
            else
            {
                <div class="plate grid grid-cols-3 gap-2 p-3 sm:grid-cols-5">
                    @Kpi("Operational", Item.OperationalScore)
                    @Kpi("Timesheet", Item.TimesheetCompletionScore, Item.HasSummaryData)
                    @Kpi("Approval", Item.ApprovalScore, Item.HasSummaryData)
                    @Kpi("Attendance", Item.AttendanceDisciplineScore)
                    @Kpi("Utilization", Item.Utilization, Item.HasSummaryData)
                </div>

                <div class="flex flex-col gap-4">
                    <section class="plate p-4">
                        <div class="panel-head"><div><div class="panel-eyebrow">Allocation</div><h3 class="panel-title">Hours allocation</h3></div><span class="label-instrument ml-auto tabular-nums">@Month.ToString("MMM yyyy")</span></div>
                        <div class="well p-2"><div id="spotlight-hours" class="h-[200px]"></div></div>
                    </section>
                    <section class="plate p-4">
                        <div class="panel-head"><div><div class="panel-eyebrow">Attendance</div><h3 class="panel-title">Attendance and reconciliation</h3></div></div>
                        <div class="well p-2"><div id="spotlight-attendance" class="h-[160px]"></div></div>
                    </section>
                    @if (TrendValues.Count >= 2)
                    {
                        <section class="plate p-4">
                            <div class="panel-head"><div><div class="panel-eyebrow">Trajectory</div><h3 class="panel-title">Score trend</h3></div><span class="label-instrument ml-auto tabular-nums">@TrendValues.Count months</span></div>
                            <div class="well p-2"><div id="spotlight-trend" class="h-[200px]"></div></div>
                        </section>
                    }

                    <section class="plate p-4">
                        <div class="panel-head"><div><div class="panel-eyebrow">Readout</div><h3 class="panel-title">Current numerical detail</h3></div></div>
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <div><h4 class="label-instrument">Capacity</h4><div class="mt-1 flex flex-col gap-1">@Row("Compliance", Item.ComplianceHours, Item.HasSummaryData, "h")@Row("Entered", Item.EnteredHours, true, "h")@Row("Approved", Item.ApprovedHours, true, "h")@Row("Office", Item.OfficeHours, true, "h")</div></div>
                            <div><h4 class="label-instrument">Allocation</h4><div class="mt-1 flex flex-col gap-1">@Row("Billable", Item.BillableHours, true, "h")@Row("Non-billable", Item.NonBillableHours, true, "h")@Row("Training", Item.TrainingHours, true, "h")@Row("Detailed", Item.DetailedHours, true, "h")</div></div>
                            <div><h4 class="label-instrument">Attendance</h4><div class="mt-1 flex flex-col gap-1">@Row("Punch", Item.PunchHours, true, "h")@Row("Attendance TS", Item.AttendanceTimesheetHours, true, "h")@Row("Variance", Item.ReconciliationVariance, true, "h", true)@Row("Attendance days", Item.AttendanceDays)</div></div>
                            <div><h4 class="label-instrument">Activity</h4><div class="mt-1 flex flex-col gap-1">@Row("Filled days", Item.TimesheetFilledDays)@Row("Expected days", Item.ExpectedTimesheetDays)@Row("Entries", Item.DetailedEntries)@Row("Projects", Item.UniqueProjects)</div></div>
                            <div><h4 class="label-instrument">Exceptions</h4><div class="mt-1 flex flex-col gap-1">@Row("Missing punch", Item.MissingPunchDays)@Row("Late", Item.LateDays)@Row("Early", Item.EarlyDays)@Row("Less duration", Item.LessDurationDays)</div></div>
                            <div><h4 class="label-instrument">Leave</h4><div class="mt-1 flex flex-col gap-1">@Row("Leave days", Item.LeaveDays)@Row("Reconciliation", Math.Abs(Item.ReconciliationVariance), true, "h")</div></div>
                        </div>
                    </section>

                    <section class="plate p-4">
                        <div class="panel-head"><div><div class="panel-eyebrow">Profile</div><h3 class="panel-title">Category performance</h3></div><span class="label-instrument ml-auto">Against team average</span></div>
                        <div class="well p-2"><div id="spotlight-radar" class="h-[240px]"></div></div>
                    </section>

                    <section class="plate p-4">
                        <div class="panel-head"><div><div class="panel-eyebrow">Peers</div><h3 class="panel-title">Peer feedback</h3></div></div>
                        @if (Peer.ReceivedCount == 0 && Peer.GivenCount == 0)
                        { <p class="text-sm text-muted">No peer feedback involving @Name this month.</p> }
                        else
                        {
                            <div class="grid grid-cols-3 gap-2">
                                <div class="well p-2 text-center"><strong class="metric text-metric-sm block">@Peer.ReceivedCount</strong><span class="label-instrument mt-1 block">Received</span></div>
                                <div class="well p-2 text-center"><strong class="metric text-metric-sm block">@Peer.GivenCount</strong><span class="label-instrument mt-1 block">Given</span></div>
                                <div class="well p-2 text-center"><strong class="metric text-metric-sm block">@(Peer.ReceivedCount == 0 ? "—" : Analytics.Format(Peer.AverageReceived, "0.00"))</strong><span class="label-instrument mt-1 block">Average</span></div>
                            </div>
                        }
                    </section>

                    <section class="plate p-4">
                        <div class="panel-head"><div><div class="panel-eyebrow">Alerts</div><h3 class="panel-title">Alerts</h3></div><span class="label-instrument ml-auto tabular-nums">@Alerts.Count</span></div>
                        @if (Alerts.Count == 0) { <p class="text-sm text-muted">No rule fired against @Name this month.</p> }
                        else
                        {
                            <div class="flex flex-col gap-2">
                                @foreach (var alert in Alerts)
                                {
                                    <div class="group well flex items-start gap-2 p-2.5">
                                        <span class="@($"badge gap-1.5 {LevelBg(alert.Level)}")"><i class="lamp h-1.5 w-1.5" aria-hidden="true"></i>@Level(alert.Level)</span>
                                        <span class="flex flex-col"><strong class="text-sm font-medium text-ink">@alert.Headline</strong><small class="text-2xs text-muted">@alert.Detail</small></span>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                </div>
            }
        </div>
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public DateTime Month { get; set; }
    [Parameter] public MonthlyPerformanceItem? Item { get; set; }
    [Parameter] public IReadOnlyList<RadarAxis> TeamRadar { get; set; } = [];
    [Parameter] public IReadOnlyList<DateTime> TrendMonths { get; set; } = [];
    [Parameter] public IReadOnlyList<decimal> TrendValues { get; set; } = [];
    [Parameter] public Analytics.PeerBreakdown Peer { get; set; } = new(0, 0, 0, 0, 0, 0, 0, []);
    [Parameter] public IReadOnlyList<Anomaly> Alerts { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnOpenProfile { get; set; }

    private bool _rendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_rendered || Item is null) return;
        _rendered = true;

        await JS.InvokeVoidAsync("epaEchartsLoader.ensureLoaded");
        await JS.InvokeVoidAsync("epaCharts.verticalBars", "spotlight-hours", new[] { "Current" }, new object[]
        {
            new { name = "Billable", role = "billable", values = new object[] { Item.BillableHours } },
            new { name = "Non-billable", role = "nonbillable", values = new object[] { Item.NonBillableHours } },
            new { name = "Training", role = "training", values = new object[] { Item.TrainingHours } },
            new { name = "Office", role = "office", values = new object[] { Item.OfficeHours } }
        }, null, " h");

        await JS.InvokeVoidAsync("epaCharts.verticalBars", "spotlight-attendance", new[] { "Hours", "Days" }, new object[]
        {
            new { name = "Punch / attendance", role = "punch", values = new object[] { Item.PunchHours, Item.AttendanceDays } },
            new { name = "Timesheet / leave", role = "timesheet", values = new object[] { Item.AttendanceTimesheetHours, Item.LeaveDays } }
        }, null, string.Empty);

        if (TrendValues.Count >= 2)
            await JS.InvokeVoidAsync("epaCharts.trend", "spotlight-trend", TrendMonths.Select(m => m.ToString("MMM yy")).ToArray(), TrendValues, null);

        var mine = Analytics.RadarValues(Item);
        await JS.InvokeVoidAsync("epaCharts.radar", "spotlight-radar", TeamRadar.Select(a => a.Label).ToArray(), 100,
            new object[]
            {
                new { name = Name, role = "categorical-2", values = mine },
                new { name = "Team average", role = "categorical-1", values = TeamRadar.Select(a => a.TeamAverage).ToArray() }
            });
    }

    private RenderFragment Kpi(string label, decimal value, bool available = true) =>
        @<div class="well p-2 text-center"><strong class="metric text-metric-sm block">@(available ? Analytics.Format(value) : "—")</strong><span class="label-instrument mt-1 block">@label</span></div>;
    private RenderFragment Row(string label, decimal value, bool available = true, string suffix = "", bool signed = false) =>
        @<p class="flex items-center justify-between text-xs"><span class="text-ink-soft">@label</span><b class="font-semibold tabular-nums text-ink">@(available ? (signed && value > 0 ? "+" : "") + Analytics.Format(value) + (suffix == "" ? "" : " " + suffix) : "—")</b></p>;

    private async Task Close()
    {
        await DisposeCharts();
        await OnClose.InvokeAsync();
    }

    private async Task DisposeCharts()
    {
        foreach (var id in new[] { "spotlight-hours", "spotlight-attendance", "spotlight-trend", "spotlight-radar" })
        {
            try { await JS.InvokeVoidAsync("epaCharts.dispose", id); } catch (JSDisconnectedException) { }
        }
    }

    public async ValueTask DisposeAsync() => await DisposeCharts();
    private static string Level(AlertLevel level) => level switch { AlertLevel.Critical => "critical", AlertLevel.Serious => "serious", _ => "warning" };
    private static string LevelBg(AlertLevel level) => level switch { AlertLevel.Critical => "bg-critical-soft text-critical", AlertLevel.Serious => "bg-serious-soft text-serious", _ => "bg-warning-soft text-warning" };
    private static string LevelIcon(AlertLevel level) => level switch { AlertLevel.Critical => "▲", AlertLevel.Serious => "◆", _ => "●" };
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
}
