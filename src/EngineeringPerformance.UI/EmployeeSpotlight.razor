@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="fixed inset-0 z-50 flex justify-end bg-ink/40" @onclick="Close">
    <aside class="flex h-full w-full max-w-2xl flex-col overflow-y-auto bg-surface shadow-2xl" @onclick:stopPropagation="true">
        <header class="flex items-center gap-3 border-b border-line p-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-soft text-sm font-bold text-primary">@Initials(Name)</span>
            <div class="min-w-0 flex-1"><h2 class="truncate text-base font-bold text-ink">@Name</h2><small class="text-2xs text-muted">@(Item?.EmployeeCode ?? "No code on file") — @Month.ToString("MMMM yyyy")</small></div>
            @if (OnOpenProfile.HasDelegate) { <button class="whitespace-nowrap text-xs font-semibold text-primary hover:underline" @onclick="() => OnOpenProfile.InvokeAsync(Name)">Full history →</button> }
            <button class="text-xl text-muted hover:text-ink" @onclick="Close" title="Close">×</button>
        </header>

        <div class="flex flex-col gap-4 p-4">
            @if (Item is null)
            {
                <div class="rounded-xl border border-line bg-surface-inset p-6"><strong class="block text-sm font-semibold text-ink">No @Month.ToString("MMMM yyyy") data for @Name</strong><p class="mt-1 text-sm text-ink-soft">This person has no imported rows for the selected month.</p></div>
            }
            else
            {
                <div class="grid grid-cols-3 gap-2 sm:grid-cols-5">
                    @Kpi("Operational", Item.OperationalScore)
                    @Kpi("Timesheet", Item.TimesheetCompletionScore, Item.HasSummaryData)
                    @Kpi("Approval", Item.ApprovalScore, Item.HasSummaryData)
                    @Kpi("Attendance", Item.AttendanceDisciplineScore)
                    @Kpi("Utilization", Item.Utilization, Item.HasSummaryData)
                </div>

                <div class="flex flex-col gap-4">
                    <section class="card">
                        <div class="panel-head"><h3 class="text-sm font-bold text-ink">Hours allocation</h3><small class="text-2xs text-muted">Current month</small></div>
                        <div id="spotlight-hours" class="h-[200px]"></div>
                    </section>
                    <section class="card">
                        <div class="panel-head"><h3 class="text-sm font-bold text-ink">Attendance and reconciliation</h3><small class="text-2xs text-muted">Current month</small></div>
                        <div id="spotlight-attendance" class="h-[160px]"></div>
                    </section>
                    @if (TrendValues.Count >= 2)
                    {
                        <section class="card"><div class="panel-head"><h3 class="text-sm font-bold text-ink">Score trend</h3><small class="text-2xs text-muted">@TrendValues.Count months</small></div><div id="spotlight-trend" class="h-[200px]"></div></section>
                    }

                    <section class="card">
                        <div class="panel-head"><h3 class="text-sm font-bold text-ink">Current numerical detail</h3><small class="text-2xs text-muted">Imported and calculated</small></div>
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <div><h4 class="text-xs font-semibold uppercase tracking-wide text-muted">Capacity</h4><div class="mt-1 flex flex-col gap-1">@Row("Compliance", Item.ComplianceHours, Item.HasSummaryData, "h")@Row("Entered", Item.EnteredHours, true, "h")@Row("Approved", Item.ApprovedHours, true, "h")@Row("Office", Item.OfficeHours, true, "h")</div></div>
                            <div><h4 class="text-xs font-semibold uppercase tracking-wide text-muted">Allocation</h4><div class="mt-1 flex flex-col gap-1">@Row("Billable", Item.BillableHours, true, "h")@Row("Non-billable", Item.NonBillableHours, true, "h")@Row("Training", Item.TrainingHours, true, "h")@Row("Detailed", Item.DetailedHours, true, "h")</div></div>
                            <div><h4 class="text-xs font-semibold uppercase tracking-wide text-muted">Attendance</h4><div class="mt-1 flex flex-col gap-1">@Row("Punch", Item.PunchHours, true, "h")@Row("Attendance TS", Item.AttendanceTimesheetHours, true, "h")@Row("Variance", Item.ReconciliationVariance, true, "h", true)@Row("Attendance days", Item.AttendanceDays)</div></div>
                            <div><h4 class="text-xs font-semibold uppercase tracking-wide text-muted">Activity</h4><div class="mt-1 flex flex-col gap-1">@Row("Filled days", Item.TimesheetFilledDays)@Row("Expected days", Item.ExpectedTimesheetDays)@Row("Entries", Item.DetailedEntries)@Row("Projects", Item.UniqueProjects)</div></div>
                            <div><h4 class="text-xs font-semibold uppercase tracking-wide text-muted">Exceptions</h4><div class="mt-1 flex flex-col gap-1">@Row("Missing punch", Item.MissingPunchDays)@Row("Late", Item.LateDays)@Row("Early", Item.EarlyDays)@Row("Less duration", Item.LessDurationDays)</div></div>
                            <div><h4 class="text-xs font-semibold uppercase tracking-wide text-muted">Leave</h4><div class="mt-1 flex flex-col gap-1">@Row("Leave days", Item.LeaveDays)@Row("Reconciliation", Math.Abs(Item.ReconciliationVariance), true, "h")</div></div>
                        </div>
                    </section>

                    <section class="card">
                        <div class="panel-head"><h3 class="text-sm font-bold text-ink">Category performance</h3><small class="text-2xs text-muted">Against team average</small></div>
                        <div id="spotlight-radar" class="h-[240px]"></div>
                    </section>

                    <section class="card">
                        <div class="panel-head"><h3 class="text-sm font-bold text-ink">Peer feedback</h3><small class="text-2xs text-muted">@Peer.ReceivedCount received · @Peer.GivenCount given</small></div>
                        @if (Peer.ReceivedCount == 0 && Peer.GivenCount == 0)
                        { <p class="text-sm text-muted">No peer feedback involving @Name this month.</p> }
                        else
                        {
                            <div class="grid grid-cols-3 gap-2">
                                <div class="rounded-lg bg-surface-inset p-2 text-center"><strong class="block text-lg font-bold text-ink">@Peer.ReceivedCount</strong><span class="text-3xs text-muted">Received</span></div>
                                <div class="rounded-lg bg-surface-inset p-2 text-center"><strong class="block text-lg font-bold text-ink">@Peer.GivenCount</strong><span class="text-3xs text-muted">Given</span></div>
                                <div class="rounded-lg bg-surface-inset p-2 text-center"><strong class="block text-lg font-bold text-ink">@(Peer.ReceivedCount == 0 ? "—" : Analytics.Format(Peer.AverageReceived, "0.00"))</strong><span class="text-3xs text-muted">Average</span></div>
                            </div>
                        }
                    </section>

                    <section class="card">
                        <div class="panel-head"><h3 class="text-sm font-bold text-ink">Alerts</h3><small class="text-2xs text-muted">@Alerts.Count</small></div>
                        @if (Alerts.Count == 0) { <p class="text-sm text-muted">No rule fired against @Name this month.</p> }
                        else
                        {
                            <div class="flex flex-col gap-2">
                                @foreach (var alert in Alerts)
                                {
                                    <div class="flex items-start gap-2 rounded-lg bg-surface-inset p-2.5">
                                        <span class="@($"rounded-full px-2 py-0.5 text-3xs font-semibold {LevelBg(alert.Level)}")">@LevelIcon(alert.Level) @Level(alert.Level)</span>
                                        <span class="flex flex-col"><strong class="text-sm font-medium text-ink">@alert.Headline</strong><small class="text-2xs text-muted">@alert.Detail</small></span>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                </div>
            }
        </div>
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public DateTime Month { get; set; }
    [Parameter] public MonthlyPerformanceItem? Item { get; set; }
    [Parameter] public IReadOnlyList<RadarAxis> TeamRadar { get; set; } = [];
    [Parameter] public IReadOnlyList<DateTime> TrendMonths { get; set; } = [];
    [Parameter] public IReadOnlyList<decimal> TrendValues { get; set; } = [];
    [Parameter] public Analytics.PeerBreakdown Peer { get; set; } = new(0, 0, 0, 0, 0, 0, 0, []);
    [Parameter] public IReadOnlyList<Anomaly> Alerts { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnOpenProfile { get; set; }

    private bool _rendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_rendered || Item is null) return;
        _rendered = true;

        await JS.InvokeVoidAsync("epaEchartsLoader.ensureLoaded");
        await JS.InvokeVoidAsync("epaCharts.verticalBars", "spotlight-hours", new[] { "Current" }, new object[]
        {
            new { name = "Billable", role = "billable", values = new object[] { Item.BillableHours } },
            new { name = "Non-billable", role = "nonbillable", values = new object[] { Item.NonBillableHours } },
            new { name = "Training", role = "training", values = new object[] { Item.TrainingHours } },
            new { name = "Office", role = "office", values = new object[] { Item.OfficeHours } }
        }, null, " h");

        await JS.InvokeVoidAsync("epaCharts.verticalBars", "spotlight-attendance", new[] { "Hours", "Days" }, new object[]
        {
            new { name = "Punch / attendance", role = "punch", values = new object[] { Item.PunchHours, Item.AttendanceDays } },
            new { name = "Timesheet / leave", role = "timesheet", values = new object[] { Item.AttendanceTimesheetHours, Item.LeaveDays } }
        }, null, string.Empty);

        if (TrendValues.Count >= 2)
            await JS.InvokeVoidAsync("epaCharts.trend", "spotlight-trend", TrendMonths.Select(m => m.ToString("MMM yy")).ToArray(), TrendValues, null);

        var mine = Analytics.RadarValues(Item);
        await JS.InvokeVoidAsync("epaCharts.radar", "spotlight-radar", TeamRadar.Select(a => a.Label).ToArray(), 100,
            new object[]
            {
                new { name = Name, role = "categorical-2", values = mine },
                new { name = "Team average", role = "categorical-1", values = TeamRadar.Select(a => a.TeamAverage).ToArray() }
            });
    }

    private RenderFragment Kpi(string label, decimal value, bool available = true) =>
        @<div class="rounded-lg bg-surface-inset p-2 text-center"><span class="block text-3xs text-muted">@label</span><strong class="text-base font-bold text-ink">@(available ? Analytics.Format(value) : "—")</strong></div>;
    private RenderFragment Row(string label, decimal value, bool available = true, string suffix = "", bool signed = false) =>
        @<p class="flex items-center justify-between text-xs"><span class="text-ink-soft">@label</span><b class="font-semibold text-ink">@(available ? (signed && value > 0 ? "+" : "") + Analytics.Format(value) + (suffix == "" ? "" : " " + suffix) : "—")</b></p>;

    private async Task Close()
    {
        await DisposeCharts();
        await OnClose.InvokeAsync();
    }

    private async Task DisposeCharts()
    {
        foreach (var id in new[] { "spotlight-hours", "spotlight-attendance", "spotlight-trend", "spotlight-radar" })
        {
            try { await JS.InvokeVoidAsync("epaCharts.dispose", id); } catch (JSDisconnectedException) { }
        }
    }

    public async ValueTask DisposeAsync() => await DisposeCharts();
    private static string Level(AlertLevel level) => level switch { AlertLevel.Critical => "critical", AlertLevel.Serious => "serious", _ => "warning" };
    private static string LevelBg(AlertLevel level) => level switch { AlertLevel.Critical => "bg-critical-soft text-critical", AlertLevel.Serious => "bg-serious-soft text-serious", _ => "bg-warning-soft text-warning" };
    private static string LevelIcon(AlertLevel level) => level switch { AlertLevel.Critical => "▲", AlertLevel.Serious => "◆", _ => "●" };
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
}
