@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="spotlight-backdrop" @onclick="Close">
    <aside class="spotlight-drawer analytics-spotlight" @onclick:stopPropagation="true">
        <header class="spotlight-head">
            <span class="avatar big">@Initials(Name)</span>
            <div class="spotlight-title"><h2>@Name</h2><small>@(Item?.EmployeeCode ?? "No code on file") — @Month.ToString("MMMM yyyy")</small></div>
            @if (OnOpenProfile.HasDelegate) { <button class="link" @onclick="() => OnOpenProfile.InvokeAsync(Name)">Full history →</button> }
            <button class="spotlight-close" @onclick="Close" title="Close">×</button>
        </header>

        <div class="spotlight-body">
            @if (Item is null)
            {
                <div class="locked"><strong>No @Month.ToString("MMMM yyyy") data for @Name</strong><p>This person has no imported rows for the selected month.</p></div>
            }
            else
            {
                <div class="spotlight-kpi-strip">
                    @Kpi("Operational", Item.OperationalScore)
                    @Kpi("Timesheet", Item.TimesheetCompletionScore, Item.HasSummaryData)
                    @Kpi("Approval", Item.ApprovalScore, Item.HasSummaryData)
                    @Kpi("Attendance", Item.AttendanceDisciplineScore)
                    @Kpi("Utilization", Item.Utilization, Item.HasSummaryData)
                </div>

                <div class="spotlight-columns">
                    <div class="spotlight-col">
                        <section class="spotlight-panel">
                            <div class="card-head"><h3>Hours allocation</h3><small>Current month</small></div>
                            <div id="spotlight-hours" class="spotlight-chart"></div>
                        </section>
                        <section class="spotlight-panel">
                            <div class="card-head"><h3>Attendance and reconciliation</h3><small>Current month</small></div>
                            <div id="spotlight-attendance" class="spotlight-chart short"></div>
                        </section>
                        @if (TrendValues.Count >= 2)
                        {
                            <section class="spotlight-panel"><div class="card-head"><h3>Score trend</h3><small>@TrendValues.Count months</small></div><div id="spotlight-trend" class="spotlight-chart"></div></section>
                        }
                    </div>

                    <div class="spotlight-col">
                        <section class="spotlight-panel">
                            <div class="card-head"><h3>Current numerical detail</h3><small>Imported and calculated</small></div>
                            <div class="spotlight-metric-groups">
                                <div><h4>Capacity</h4>@Row("Compliance", Item.ComplianceHours, Item.HasSummaryData, "h")@Row("Entered", Item.EnteredHours, true, "h")@Row("Approved", Item.ApprovedHours, true, "h")@Row("Office", Item.OfficeHours, true, "h")</div>
                                <div><h4>Allocation</h4>@Row("Billable", Item.BillableHours, true, "h")@Row("Non-billable", Item.NonBillableHours, true, "h")@Row("Training", Item.TrainingHours, true, "h")@Row("Detailed", Item.DetailedHours, true, "h")</div>
                                <div><h4>Attendance</h4>@Row("Punch", Item.PunchHours, true, "h")@Row("Attendance TS", Item.AttendanceTimesheetHours, true, "h")@Row("Variance", Item.ReconciliationVariance, true, "h", true)@Row("Attendance days", Item.AttendanceDays)</div>
                                <div><h4>Activity</h4>@Row("Filled days", Item.TimesheetFilledDays)@Row("Expected days", Item.ExpectedTimesheetDays)@Row("Entries", Item.DetailedEntries)@Row("Projects", Item.UniqueProjects)</div>
                                <div><h4>Exceptions</h4>@Row("Missing punch", Item.MissingPunchDays)@Row("Late", Item.LateDays)@Row("Early", Item.EarlyDays)@Row("Less duration", Item.LessDurationDays)</div>
                                <div><h4>Leave</h4>@Row("Leave days", Item.LeaveDays)@Row("Reconciliation", Math.Abs(Item.ReconciliationVariance), true, "h")</div>
                            </div>
                        </section>

                        <section class="spotlight-panel">
                            <div class="card-head"><h3>Category performance</h3><small>Against team average</small></div>
                            <div id="spotlight-radar" class="spotlight-chart"></div>
                        </section>

                        <section class="spotlight-panel">
                            <div class="card-head"><h3>Peer feedback</h3><small>@Peer.ReceivedCount received · @Peer.GivenCount given</small></div>
                            @if (Peer.ReceivedCount == 0 && Peer.GivenCount == 0)
                            { <p class="chart-note">No peer feedback involving @Name this month.</p> }
                            else
                            {
                                <div class="mini-tiles"><div><strong>@Peer.ReceivedCount</strong><span>Received</span></div><div><strong>@Peer.GivenCount</strong><span>Given</span></div><div><strong>@(Peer.ReceivedCount == 0 ? "—" : Analytics.Format(Peer.AverageReceived, "0.00"))</strong><span>Average</span></div></div>
                            }
                        </section>

                        <section class="spotlight-panel">
                            <div class="card-head"><h3>Alerts</h3><small>@Alerts.Count</small></div>
                            @if (Alerts.Count == 0) { <p class="chart-note">No rule fired against @Name this month.</p> }
                            else
                            {
                                <div class="alert-list single">
                                    @foreach (var alert in Alerts)
                                    { <div class="alert @Level(alert.Level)"><span class="alert-chip">@LevelIcon(alert.Level) @Level(alert.Level)</span><span class="alert-body"><strong>@alert.Headline</strong><small>@alert.Detail</small></span></div> }
                                </div>
                            }
                        </section>
                    </div>
                </div>
            }
        </div>
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public DateTime Month { get; set; }
    [Parameter] public MonthlyPerformanceItem? Item { get; set; }
    [Parameter] public IReadOnlyList<RadarAxis> TeamRadar { get; set; } = [];
    [Parameter] public IReadOnlyList<DateTime> TrendMonths { get; set; } = [];
    [Parameter] public IReadOnlyList<decimal> TrendValues { get; set; } = [];
    [Parameter] public Analytics.PeerBreakdown Peer { get; set; } = new(0, 0, 0, 0, 0, 0, 0, []);
    [Parameter] public IReadOnlyList<Anomaly> Alerts { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnOpenProfile { get; set; }

    private bool _rendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_rendered || Item is null) return;
        _rendered = true;

        await JS.InvokeVoidAsync("epaCharts.verticalBars", "spotlight-hours", new[] { "Current" }, new object[]
        {
            new { name = "Billable", color = "#0F6E9E", values = new object[] { Item.BillableHours } },
            new { name = "Non-billable", color = "#C85A22", values = new object[] { Item.NonBillableHours } },
            new { name = "Training", color = "#7A4BB0", values = new object[] { Item.TrainingHours } },
            new { name = "Office", color = "#1E8C5A", values = new object[] { Item.OfficeHours } }
        }, null, " h");

        await JS.InvokeVoidAsync("epaCharts.verticalBars", "spotlight-attendance", new[] { "Hours", "Days" }, new object[]
        {
            new { name = "Punch / attendance", color = "#0F6E9E", values = new object[] { Item.PunchHours, Item.AttendanceDays } },
            new { name = "Timesheet / leave", color = "#1E8C5A", values = new object[] { Item.AttendanceTimesheetHours, Item.LeaveDays } }
        }, null, string.Empty);

        if (TrendValues.Count >= 2)
            await JS.InvokeVoidAsync("epaCharts.trend", "spotlight-trend", TrendMonths.Select(m => m.ToString("MMM yy")).ToArray(), TrendValues, null);

        var mine = Analytics.RadarValues(Item);
        await JS.InvokeVoidAsync("epaCharts.radar", "spotlight-radar", TeamRadar.Select(a => a.Label).ToArray(), 100,
            new object[]
            {
                new { name = Name, color = "#C85A22", values = mine },
                new { name = "Team average", color = "#0F6E9E", values = TeamRadar.Select(a => a.TeamAverage).ToArray() }
            });
    }

    private RenderFragment Kpi(string label, decimal value, bool available = true) => @<div><span>@label</span><strong>@(available ? Analytics.Format(value) : "—")</strong></div>;
    private RenderFragment Row(string label, decimal value, bool available = true, string suffix = "", bool signed = false) => @<p><span>@label</span><b>@(available ? (signed && value > 0 ? "+" : "") + Analytics.Format(value) + (suffix == "" ? "" : " " + suffix) : "—")</b></p>;

    private async Task Close()
    {
        await DisposeCharts();
        await OnClose.InvokeAsync();
    }

    private async Task DisposeCharts()
    {
        foreach (var id in new[] { "spotlight-hours", "spotlight-attendance", "spotlight-trend", "spotlight-radar" })
        {
            try { await JS.InvokeVoidAsync("epaCharts.dispose", id); } catch (JSDisconnectedException) { }
        }
    }

    public async ValueTask DisposeAsync() => await DisposeCharts();
    private static string Level(AlertLevel level) => level switch { AlertLevel.Critical => "critical", AlertLevel.Serious => "serious", _ => "warning" };
    private static string LevelIcon(AlertLevel level) => level switch { AlertLevel.Critical => "▲", AlertLevel.Serious => "◆", _ => "●" };
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
}
