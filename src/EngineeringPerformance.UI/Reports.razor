@page "/reports"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IFileDialogService Dialogs
@inject IWorkbookService Workbooks
@inject AppState State
@implements IDisposable

<div class="workbench-page export-workbench">
    <header class="workbench-header">
        <div>
            <h2>Report output</h2>
            <p>Generated from the same evidence visible in EOS.</p>
        </div>
        <div class="workbench-summary">
            <div><span>Reporting month</span><strong>@State.SelectedMonth.ToString("MMM yy")</strong></div>
            <div><span>Engineers</span><strong>@State.Performance.Count</strong></div>
        </div>
    </header>

    <section class="export-lanes">
        <article class="export-lane primary">
            <span class="atlas-section-label">Team output</span>
            <div class="export-number">@State.Performance.Count</div>
            <h2>Complete team report</h2>
            <p>Team pulse, score distribution, ranked engineers, operational evidence, alerts and peer-review context in one workbook.</p>
            <dl class="export-facts">
                <div><dt>Peer feedback</dt><dd>@State.PeerReviews.Count entries</dd></div>
                <div><dt>Open alert lines</dt><dd>@AlertLines.Count</dd></div>
                <div><dt>Excluded people</dt><dd>@State.ExcludedNames.Count</dd></div>
            </dl>
            <button class="action" @onclick="GenerateTeamAsync" disabled="@(State.Busy || State.Performance.Count == 0)">Generate team workbook</button>
            @if (State.Performance.Count == 0) { <small>Import this month's ERP evidence before generating a report.</small> }
        </article>

        <article class="export-lane">
            <span class="atlas-section-label">Individual output</span>
            <div class="export-number">1</div>
            <h2>Employee evidence report</h2>
            <p>Current score, operating components, loaded history, peer feedback and intervention evidence for one engineer.</p>
            <label class="export-picker">Engineer
                <select @bind="_selectedEmployeeId">
                    <option value="">Select employee</option>
                    @foreach (var e in State.Employees.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@e.Id">@e.Name (@e.EmployeeCode)</option>
                    }
                </select>
            </label>
            <button class="action secondary" @onclick="GenerateEmployeeAsync" disabled="@State.Busy">Generate employee workbook</button>
        </article>
    </section>

    <section class="export-footer-note">
        <span class="atlas-section-label">Output contract</span>
        <span>Excel · print-ready · calculated from local SQLite · @State.SelectedMonth.ToString("MMMM yyyy")</span>
    </section>
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;

    private string _selectedEmployeeId = string.Empty;

    private IReadOnlyList<string> AlertLines
    {
        get
        {
            var previous = State.History
                .Where(x => x.Year == State.SelectedMonth.AddMonths(-1).Year && x.Month == State.SelectedMonth.AddMonths(-1).Month)
                .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(x => x.Key, x => x.First().OperationalScore, StringComparer.OrdinalIgnoreCase);
            return Analytics.Anomalies(State.Performance, previous)
                .Select(a => $"[{a.Level}] {a.EmployeeName} — {a.Headline}: {a.Detail}")
                .ToArray();
        }
    }

    private async Task GenerateTeamAsync()
    {
        var destination = Dialogs.PickSaveWorkbook($"TeamReport_{State.SelectedMonth:yyyy_MM}.xlsx");
        if (destination is null) return;
        await State.RunAsync(async () =>
        {
            var data = new TeamReportData(State.SelectedMonth.Year, State.SelectedMonth.Month, State.Performance, State.PeerReviews, AlertLines, State.ExcludedNames.Count);
            Workbooks.GenerateTeamReport(destination, data);
            await Task.CompletedTask;
            State.ShowMessage($"Team report saved to {destination}.");
        });
    }

    private async Task GenerateEmployeeAsync()
    {
        if (!int.TryParse(_selectedEmployeeId, out var id))
        {
            State.ShowMessage("Select an employee first.", true);
            return;
        }
        var employee = State.Employees.SingleOrDefault(x => x.Id == id);
        if (employee is null) return;

        var destination = Dialogs.PickSaveWorkbook($"{employee.EmployeeCode}_{Sanitize(employee.Name)}_{State.SelectedMonth:yyyy_MM}_Report.xlsx");
        if (destination is null) return;
        await State.RunAsync(async () =>
        {
            var current = State.Performance.FirstOrDefault(x => PersonName.Matches(x.EmployeeName, employee.Name));
            var history = State.History.Where(x => PersonName.Matches(x.EmployeeName, employee.Name)).ToArray();
            var employeeAlerts = AlertLines.Where(x => x.Contains(employee.Name, StringComparison.OrdinalIgnoreCase)).ToArray();
            var data = new EmployeeReportData(employee.Name, employee.EmployeeCode, employee.SeniorityLevel, State.SelectedMonth.Year, State.SelectedMonth.Month,
                current, history, State.PeerReviews, employeeAlerts);
            Workbooks.GenerateEmployeeReport(destination, data);
            await Task.CompletedTask;
            State.ShowMessage($"Report for {employee.Name} saved to {destination}.");
        });
    }

    private static string Sanitize(string value) => string.Concat(value.Trim().Select(c => Path.GetInvalidFileNameChars().Contains(c) || c == ' ' ? '_' : c));
}
