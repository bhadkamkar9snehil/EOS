@page "/reports"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IFileDialogService Dialogs
@inject IWorkbookService Workbooks
@inject AppState State
@implements IDisposable

<div class="flex flex-col gap-6">
    <section class="grid grid-cols-1 gap-4 lg:grid-cols-[1.4fr_1fr]">
        <article class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Team output</div>
                    <h2 class="panel-title">Complete team report</h2>
                </div>
                <span class="label-instrument ml-auto"><span class="tnum">@State.SelectedMonth.ToString("MMM yy")</span></span>
            </div>

            <div class="metric text-metric">@State.Performance.Count</div>
            <div class="metric-delta mt-1 text-ink-soft"><span class="tnum">@State.PeerReviews.Count</span> peer entries · <span class="tnum">@AlertLines.Count</span> alert lines</div>
            <div class="label-instrument mt-1">Engineers in this workbook</div>

            <p class="mt-3 text-sm text-ink-soft">Team pulse, score distribution, ranked engineers, operational evidence, alerts and peer-review context in one workbook.</p>

            <dl class="well mt-3 flex flex-col divide-y divide-line-soft px-3">
                <div class="flex justify-between py-2 text-xs"><dt class="label-instrument">Peer feedback</dt><dd class="metric text-sm">@State.PeerReviews.Count</dd></div>
                <div class="flex justify-between py-2 text-xs"><dt class="label-instrument">Open alert lines</dt><dd class="metric text-sm">@AlertLines.Count</dd></div>
                <div class="flex justify-between py-2 text-xs"><dt class="label-instrument">Excluded people</dt><dd class="metric text-sm">@State.ExcludedNames.Count</dd></div>
            </dl>
            <button class="btn btn-primary mt-4" @onclick="GenerateTeamAsync" disabled="@(State.Busy || State.Performance.Count == 0)">Generate team workbook</button>
            @if (State.Performance.Count == 0) { <small class="mt-2 block text-2xs text-muted">Import this month's ERP evidence before generating a report.</small> }
        </article>

        <article class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Individual output</div>
                    <h2 class="panel-title">Employee evidence report</h2>
                </div>
            </div>

            <div class="metric text-metric">1</div>
            <div class="label-instrument mt-1">Engineer per workbook</div>

            <p class="mt-3 text-sm text-ink-soft">Current score, operating components, loaded history, peer feedback and intervention evidence for one engineer.</p>
            <label class="mt-3 flex flex-col gap-1"><span class="label-instrument">Engineer</span>
                <select class="control px-2 py-1.5 text-sm text-ink hover:control-hover active:control-pressed" @bind="_selectedEmployeeId">
                    <option value="">Select employee</option>
                    @foreach (var e in State.Employees.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@e.Id">@e.Name (@e.EmployeeCode)</option>
                    }
                </select>
            </label>
            <button class="btn btn-secondary mt-4" @onclick="GenerateEmployeeAsync" disabled="@State.Busy">Generate employee workbook</button>
        </article>
    </section>

    <section class="plate flex items-center justify-between gap-4 p-3">
        <span class="label-instrument">Output contract</span>
        <span class="text-xs text-ink-soft">Excel · print-ready · calculated from local SQLite · <span class="tnum">@State.SelectedMonth.ToString("MMMM yyyy")</span></span>
    </section>
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;

    private string _selectedEmployeeId = string.Empty;

    private IReadOnlyList<string> AlertLines
    {
        get
        {
            var previous = State.History
                .Where(x => x.Year == State.SelectedMonth.AddMonths(-1).Year && x.Month == State.SelectedMonth.AddMonths(-1).Month)
                .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(x => x.Key, x => x.First().OperationalScore, StringComparer.OrdinalIgnoreCase);
            return Analytics.Anomalies(State.Performance, previous)
                .Select(a => $"[{a.Level}] {a.EmployeeName} — {a.Headline}: {a.Detail}")
                .ToArray();
        }
    }

    private async Task GenerateTeamAsync()
    {
        var destination = Dialogs.PickSaveWorkbook($"TeamReport_{State.SelectedMonth:yyyy_MM}.xlsx");
        if (destination is null) return;
        await State.RunAsync(async () =>
        {
            var data = new TeamReportData(State.SelectedMonth.Year, State.SelectedMonth.Month, State.Performance, State.PeerReviews, AlertLines, State.ExcludedNames.Count);
            Workbooks.GenerateTeamReport(destination, data);
            await Task.CompletedTask;
            State.ShowMessage($"Team report saved to {destination}.");
        });
    }

    private async Task GenerateEmployeeAsync()
    {
        if (!int.TryParse(_selectedEmployeeId, out var id))
        {
            State.ShowMessage("Select an employee first.", true);
            return;
        }
        var employee = State.Employees.SingleOrDefault(x => x.Id == id);
        if (employee is null) return;

        var destination = Dialogs.PickSaveWorkbook($"{employee.EmployeeCode}_{Sanitize(employee.Name)}_{State.SelectedMonth:yyyy_MM}_Report.xlsx");
        if (destination is null) return;
        await State.RunAsync(async () =>
        {
            var current = State.Performance.FirstOrDefault(x => PersonName.Matches(x.EmployeeName, employee.Name));
            var history = State.History.Where(x => PersonName.Matches(x.EmployeeName, employee.Name)).ToArray();
            var employeeAlerts = AlertLines.Where(x => x.Contains(employee.Name, StringComparison.OrdinalIgnoreCase)).ToArray();
            var data = new EmployeeReportData(employee.Name, employee.EmployeeCode, employee.SeniorityLevel, State.SelectedMonth.Year, State.SelectedMonth.Month,
                current, history, State.PeerReviews, employeeAlerts);
            Workbooks.GenerateEmployeeReport(destination, data);
            await Task.CompletedTask;
            State.ShowMessage($"Report for {employee.Name} saved to {destination}.");
        });
    }

    private static string Sanitize(string value) => string.Concat(value.Trim().Select(c => Path.GetInvalidFileNameChars().Contains(c) || c == ' ' ? '_' : c));
}
