@page "/timesheets"
@using EngineeringPerformance.Application
@inject AppState State
@inject NavigationManager Navigation
@implements IDisposable

<div class="flex flex-col gap-6">
    @if (Rows.Count == 0)
    {
        <div class="flex flex-col items-start gap-3 rounded-xl border border-line bg-surface p-8">
            <h2 class="text-lg font-bold text-ink">No timesheet data for @State.SelectedMonth.ToString("MMMM yyyy")</h2>
            <p class="text-sm text-ink-soft">Import this month's attendance and utilization exports on the Data imports screen.</p>
            <button class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary/90" @onclick='() => Navigation.NavigateTo("/imports")'>Go to data imports</button>
        </div>
    }
    else
    {
        <header class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-xl font-bold text-ink">Timesheet control ledger</h2>
                <p class="mt-1 text-sm text-ink-soft">Exceptions are marked inline, at the row and field.</p>
            </div>
            <div class="flex gap-6">
                <div class="text-right"><span class="block text-3xs uppercase tracking-wide text-muted">Engineers</span><strong class="text-lg font-bold text-ink">@Rows.Count</strong></div>
                <div class="text-right"><span class="block text-3xs uppercase tracking-wide text-muted">Accountable days</span><strong class="text-lg font-bold text-ink">@Analytics.Format(TotalExpected, "0.#")</strong></div>
            </div>
        </header>

        <section class="grid grid-cols-2 gap-4 rounded-xl border border-line bg-surface p-4 sm:grid-cols-3 lg:grid-cols-6" aria-label="Timesheet pulse">
            <div>
                <label class="block text-3xs font-semibold uppercase tracking-wide text-muted">Team fill rate</label>
                <strong class="mt-1 block text-xl font-bold text-ink">@Analytics.Format(FillRate)%</strong>
                <small class="text-2xs text-muted">@TotalFilled of @TotalExpected accountable days filled</small>
            </div>
            <div>
                <label class="block text-3xs font-semibold uppercase tracking-wide text-muted">Missing days</label>
                <strong class="@($"mt-1 block text-xl font-bold {(_missingDays > 0 ? "text-serious" : "text-ink")}")">@Analytics.Format(_missingDays, "0.#")</strong>
                <small class="text-2xs text-muted">@_withGaps engineer(s) with gaps</small>
            </div>
            <div>
                <label class="block text-3xs font-semibold uppercase tracking-wide text-muted">Awaiting approval</label>
                <strong class="mt-1 block text-xl font-bold text-ink">@Analytics.Format(_pendingHours, "0") h</strong>
                <small class="text-2xs text-muted">@_awaitingApproval engineer(s)</small>
            </div>
            <div>
                <label class="block text-3xs font-semibold uppercase tracking-wide text-muted">Billable capacity used</label>
                <strong class="mt-1 block text-xl font-bold text-ink">@Analytics.Format(CapacityUsed)%</strong>
                <small class="text-2xs text-muted">Across billable engineers</small>
            </div>
            <div>
                <label class="block text-3xs font-semibold uppercase tracking-wide text-muted">Probation context</label>
                <strong class="mt-1 block text-xl font-bold text-ink">@Probationers</strong>
                <small class="text-2xs text-muted">Freshers on probation in ERP roster</small>
            </div>
            <div>
                <label class="block text-3xs font-semibold uppercase tracking-wide text-muted">Avg filing delay</label>
                <strong class="@($"mt-1 block text-xl font-bold {(AvgFilingDelay > 1 ? "text-serious" : "text-ink")}")">@Analytics.Format(AvgFilingDelay, "0.0") d</strong>
                <small class="text-2xs text-muted">@FilingDays day(s) filed this month</small>
            </div>
        </section>

        <section class="rounded-xl border border-line bg-surface p-4">
            <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
                <div>
                    <span class="text-sm font-bold text-ink">Compliance ledger</span>
                    <span class="ml-2 text-2xs text-muted">@FilteredRows.Count of @Rows.Count engineers · click any sortable header to rank</span>
                </div>
                <input class="w-64 rounded-lg border border-line bg-surface-inset px-3 py-1.5 text-sm text-ink outline-none placeholder:text-muted focus:border-primary" @bind="_filter" @bind:event="oninput" placeholder="Filter engineer or team…" aria-label="Filter engineer or team" />
            </div>

            <div class="overflow-x-auto">
                <QuickGrid Items="@FilteredRows.AsQueryable()" Class="epa-grid" RowClass="@RowSeverityClass">
                    <TemplateColumn Title="Engineer" Sortable="true" SortBy="@_sortByName">
                        <span class="flex flex-col"><strong class="font-medium text-ink">@context.Name</strong>@if (!string.IsNullOrWhiteSpace(context.TeamName)){<small class="text-2xs text-muted">@context.TeamName</small>}</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Status">
                        @if (context.IsConsultant || context.IsOnProbation || context.IsNonBillable)
                        {
                            <span class="flex flex-wrap gap-1">
                                @if (context.IsConsultant) { <span class="rounded-full bg-info-soft px-2 py-0.5 text-3xs font-semibold text-info">Consultant</span> }
                                @if (context.IsOnProbation) { <span class="rounded-full bg-warning-soft px-2 py-0.5 text-3xs font-semibold text-warning">Probation</span> }
                                @if (context.IsNonBillable) { <span class="rounded-full bg-surface-inset px-2 py-0.5 text-3xs font-semibold text-muted">Non-billable</span> }
                            </span>
                        }
                        else
                        {
                            <span class="text-2xs text-muted">Standard</span>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Filled days" Align="Align.Right" Sortable="true" SortBy="@_sortByFilled">
                        <span class="tabular-nums text-ink">@context.FilledDays / @context.ExpectedDays</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Missing days" Align="Align.Right" Sortable="true" SortBy="@_sortByMissing">
                        <span class="@($"tabular-nums font-semibold {MissingSeverityClass(context.MissingDays)}")">@context.MissingDays</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Fill rate" Align="Align.Right" Sortable="true" SortBy="@_sortByFillRate">
                        <span class="flex items-center justify-end gap-2">
                            <b class="@($"tabular-nums font-semibold {Analytics.BandTextClass(Analytics.ScoreBand(context.FillRate))}")">@Analytics.Format(context.FillRate)%</b>
                            <i class="@($"block h-1.5 rounded-full {Analytics.BandBgClass(Analytics.ScoreBand(context.FillRate))}")" style="@($"width:{Analytics.Svg((double)context.FillRate * 0.42)}px")"></i>
                        </span>
                    </TemplateColumn>
                    <TemplateColumn Title="Entered" Align="Align.Right" Sortable="true" SortBy="@_sortByEntered">
                        <span class="tabular-nums text-ink">@Hours(context.EnteredHours)</span>
                    </TemplateColumn>
                    @if (AnyPendingApproval)
                    {
                        <TemplateColumn Title="Awaiting" Align="Align.Right" Sortable="true" SortBy="@_sortByPending">
                            <span class="@($"tabular-nums {(context.HasPendingApproval ? "text-warning font-semibold" : "text-ink")}")">@Hours(context.PendingApprovalHours)</span>
                        </TemplateColumn>
                    }
                    <TemplateColumn Title="Billable" Align="Align.Right" Sortable="true" SortBy="@_sortByBillable">
                        <span class="tabular-nums text-ink">@Hours(context.BillableHours)</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Capacity" Align="Align.Right" Sortable="true" SortBy="@_sortByCapacity">
                        <span class="tabular-nums text-ink">@(context.IsNonBillable ? "n/a" : context.CapacityUtilization <= 0 ? "—" : Analytics.Format(context.CapacityUtilization) + "%")</span>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            @if (FilteredRows.Count == 0)
            {
                <p class="mt-3 text-sm text-muted">No engineer matches "@_filter".</p>
            }
        </section>

        @if (FilingRows.Count > 0)
        {
            <section class="rounded-xl border border-line bg-surface p-4" aria-label="Timesheet filing delay">
                <div class="panel-head">
                    <div><h2 class="text-sm font-bold text-ink">Timesheet filing</h2><small class="text-2xs text-muted">How late each entry was filed after its work date, worst first</small></div>
                    <span class="ml-auto text-2xs text-muted">@FilingRows.Count of @Rows.Count engineers with filed entries</span>
                </div>
                <ul class="flex flex-col divide-y divide-line">
                    @foreach (var row in FilingRows.Take(15))
                    {
                        <li class="py-1.5">
                            <strong class="@($"text-sm font-semibold {(row.AverageDelayDays > 1 ? "text-serious" : "text-ink")}")">@row.EmployeeName — @Analytics.Format(row.AverageDelayDays, "0.0") day(s) avg delay</strong>
                            <small class="block text-2xs text-muted">Worst @Analytics.Format(row.MaxDelayDays, "0.#") day(s) late, for @row.WorstDay.ToString("dd MMM") · @row.FiledDays entr@(row.FiledDays == 1 ? "y" : "ies") filed</small>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>

@code {
    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        Recompute();
    }

    private void OnStateChanged() => InvokeAsync(() => { Recompute(); StateHasChanged(); });
    public void Dispose() => State.Changed -= OnStateChanged;

    private void Recompute()
    {
        _rows = Analytics.Compliance(State.Performance, State.Employees);
        _withGaps = _rows.Count(x => x.HasGap);
        _awaitingApproval = _rows.Count(x => x.HasPendingApproval);
        _missingDays = _rows.Sum(x => x.MissingDays);
        _pendingHours = _rows.Sum(x => x.PendingApprovalHours);
        _totalExpected = _rows.Sum(x => x.ExpectedDays);
        _totalFilled = _rows.Sum(x => x.FilledDays);
        _probationers = State.Employees.Count(x => x.IsOnProbation);

        var billable = _rows.Where(x => !x.IsNonBillable).ToArray();
        _capacityUsed = billable.Length == 0
            ? 0
            : decimal.Round(billable.Sum(x => x.BillableHours) / (billable.Length * Analytics.MonthlyBillableCapacityHours) * 100m, 1);

        _filterCache = null;
    }

    private static readonly GridSort<Analytics.ComplianceRow> _sortByName = GridSort<Analytics.ComplianceRow>.ByAscending(x => x.Name);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByFilled = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.FilledDays);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByMissing = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.MissingDays);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByFillRate = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.FillRate);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByEntered = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.EnteredHours);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByPending = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.PendingApprovalHours);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByBillable = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.BillableHours);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByCapacity = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.CapacityUtilization);

    private string _filter = string.Empty;
    private IReadOnlyList<Analytics.ComplianceRow> _rows = [];
    private IReadOnlyList<Analytics.ComplianceRow>? _filterCache;
    private string? _filterCacheKey;
    private int _withGaps, _awaitingApproval, _probationers;
    private decimal _missingDays, _totalExpected, _totalFilled;
    private decimal _pendingHours, _capacityUsed;

    private IReadOnlyList<Analytics.ComplianceRow> Rows => _rows;

    private IReadOnlyList<Analytics.ComplianceRow> FilteredRows
    {
        get
        {
            if (_filterCache is not null && _filterCacheKey == _filter) return _filterCache;
            _filterCacheKey = _filter;
            _filterCache = string.IsNullOrWhiteSpace(_filter)
                ? _rows
                : _rows.Where(x => x.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                                || (x.TeamName?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false)).ToArray();
            return _filterCache;
        }
    }

    private bool AnyPendingApproval => _awaitingApproval > 0;

    private static string MissingSeverityClass(decimal missingDays) => missingDays switch
    {
        <= 0 => "text-ink",
        <= 3 => "text-warning",
        _ => "text-critical"
    };

    private static string? RowSeverityClass(Analytics.ComplianceRow row) =>
        row.ExpectedDays > 0 && row.FilledDays == 0 ? "row-flag-critical"
        : row.MissingDays > 0 ? "row-flag"
        : null;

    private static string Hours(decimal value) => value <= 0 ? "—" : Analytics.Format(value) + " h";

    private decimal TotalExpected => _totalExpected;
    private decimal TotalFilled => _totalFilled;
    private decimal FillRate => _totalExpected == 0 ? 0 : decimal.Round(_totalFilled * 100m / _totalExpected, 1);
    private decimal CapacityUsed => _capacityUsed;
    private int Probationers => _probationers;

    private IReadOnlyList<TimesheetFilingRow> FilingRows => State.TimesheetFiling?.Rows ?? [];
    private decimal AvgFilingDelay => State.TimesheetFiling?.AverageDelayDays ?? 0m;
    private int FilingDays => FilingRows.Sum(x => x.FiledDays);
}
