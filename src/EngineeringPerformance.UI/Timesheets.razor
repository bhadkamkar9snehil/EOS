@page "/timesheets"
@using EngineeringPerformance.Application
@inject AppState State
@inject NavigationManager Navigation
@implements IDisposable

@* Timesheet compliance: who has not filled, and what is filled but still awaiting approval. *@

<div class="overview">
    @if (Rows.Count == 0)
    {
        <div class="empty-state">
            <h2>No timesheet data for @State.SelectedMonth.ToString("MMMM yyyy")</h2>
            <p>Import this month's attendance and utilization exports on the Data imports screen.</p>
            <button class="action" @onclick='() => Navigation.NavigateTo("/imports")'>Go to data imports</button>
        </div>
    }
    else
    {
        <div class="kpi-row">
            @Kpi("Fill rate", Analytics.Format(FillRate) + "%", $"{TotalFilled} of {TotalExpected} accountable days")
            @Kpi("Engineers with gaps", _withGaps.ToString(), _withGaps == 0 ? "Everyone up to date" : "Unfilled timesheet days")
            @Kpi("Missing days", _missingDays.ToString(), "Total across the team")
            @Kpi("Awaiting approval", Analytics.Format(_pendingHours, "0") + " h", $"{_awaitingApproval} engineer(s)")
            @Kpi("Billable capacity used", Analytics.Format(CapacityUsed) + "%", $"vs {Analytics.Format(Analytics.MonthlyBillableCapacityHours, "0")} h per billable engineer")
            @Kpi("Freshers on probation", Probationers.ToString(), "From the ERP roster")
        </div>

        <div class="overview-grid">
            <section class="card wide">
                <div class="card-head">
                    <h2>Timesheet compliance</h2>
                    <small>@FilteredRows.Count of @Rows.Count engineer(s) — click a header to sort</small>
                </div>
                <input class="grid-filter" @bind="_filter" @bind:event="oninput" placeholder="Filter by name or team…" />
                <QuickGrid Items="@FilteredRows.AsQueryable()" Class="epa-grid" RowClass="@RowSeverityClass">
                    <TemplateColumn Title="Engineer" Sortable="true" SortBy="@_sortByName">
                        @context.Name
                    </TemplateColumn>
                    <TemplateColumn Title="Status">
                        @if (context.IsConsultant || context.IsOnProbation || context.IsNonBillable)
                        {
                            <span class="tag-row">
                                @if (context.IsConsultant)
                                {
                                    <span class="tag consultant">Consultant</span>
                                }
                                @if (context.IsOnProbation)
                                {
                                    <span class="tag probation">Probation</span>
                                }
                                @if (context.IsNonBillable)
                                {
                                    <span class="tag muted">Non-billable</span>
                                }
                            </span>
                        }
                    </TemplateColumn>
                    <PropertyColumn Title="Team" Property="@(x => x.TeamName)" Sortable="true" />
                    <TemplateColumn Title="Filled (d)" Align="Align.Right" Sortable="true" SortBy="@_sortByFilled">
                        <span class="num">@context.FilledDays / @context.ExpectedDays</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Missing (d)" Align="Align.Right" Sortable="true" SortBy="@_sortByMissing">
                        <span class="num @MissingSeverityClass(context.MissingDays)">@context.MissingDays</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Fill rate (%)" Align="Align.Right" Sortable="true" SortBy="@_sortByFillRate">
                        <span class="score-cell">
                            <b class="@Analytics.ScoreBand(context.FillRate)">@Analytics.Format(context.FillRate)%</b>
                            <i class="score-bar @Analytics.ScoreBand(context.FillRate)" style="width:@Analytics.Svg((double)context.FillRate * 0.42)px"></i>
                        </span>
                    </TemplateColumn>
                    <TemplateColumn Title="Entered (h)" Align="Align.Right" Sortable="true" SortBy="@_sortByEntered">
                        <span class="num">@Hours(context.EnteredHours)</span>
                    </TemplateColumn>
                    @if (AnyPendingApproval)
                    {
                        <TemplateColumn Title="Awaiting (h)" Align="Align.Right" Sortable="true" SortBy="@_sortByPending">
                            <span class="num @(context.HasPendingApproval ? "flag-warning" : null)">@Hours(context.PendingApprovalHours)</span>
                        </TemplateColumn>
                    }
                    <TemplateColumn Title="Billable (h)" Align="Align.Right" Sortable="true" SortBy="@_sortByBillable">
                        <span class="num">@Hours(context.BillableHours)</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Capacity (%)" Align="Align.Right" Sortable="true" SortBy="@_sortByCapacity">
                        <span class="num">@(context.IsNonBillable ? "n/a" : context.CapacityUtilization <= 0 ? "—" : Analytics.Format(context.CapacityUtilization) + "%")</span>
                    </TemplateColumn>
                </QuickGrid>
                @if (FilteredRows.Count == 0)
                {
                    <p class="chart-note">No engineer matches “@_filter”.</p>
                }
            </section>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        Recompute();
    }

    private void OnStateChanged() => InvokeAsync(() => { Recompute(); StateHasChanged(); });
    public void Dispose() => State.Changed -= OnStateChanged;

    // Analytics.Compliance is an O(rows x employees) join with a name normalisation per pair.
    // It used to hang off an expression-bodied property that the markup touched thirteen times
    // per render, so every keystroke in the filter box re-ran the whole join thirteen times.
    // It is now computed once per state change, along with the aggregates derived from it.
    private void Recompute()
    {
        _rows = Analytics.Compliance(State.Performance, State.Employees);
        _withGaps = _rows.Count(x => x.HasGap);
        _awaitingApproval = _rows.Count(x => x.HasPendingApproval);
        _missingDays = _rows.Sum(x => x.MissingDays);
        _pendingHours = _rows.Sum(x => x.PendingApprovalHours);
        _totalExpected = _rows.Sum(x => x.ExpectedDays);
        _totalFilled = _rows.Sum(x => x.FilledDays);
        _probationers = State.Employees.Count(x => x.IsOnProbation);

        var billable = _rows.Where(x => !x.IsNonBillable).ToArray();
        _capacityUsed = billable.Length == 0
            ? 0
            : decimal.Round(billable.Sum(x => x.BillableHours) / (billable.Length * Analytics.MonthlyBillableCapacityHours) * 100m, 1);

        _filterCache = null;
    }

    // QuickGrid's SortBy attribute can't parse an inline generic-method call in Razor markup
    // (the compiler treats "<Analytics.ComplianceRow>" as a markup tag), so each sort order is
    // a plain field the column can reference by name instead.
    private static readonly GridSort<Analytics.ComplianceRow> _sortByName = GridSort<Analytics.ComplianceRow>.ByAscending(x => x.Name);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByFilled = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.FilledDays);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByMissing = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.MissingDays);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByFillRate = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.FillRate);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByEntered = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.EnteredHours);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByPending = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.PendingApprovalHours);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByBillable = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.BillableHours);
    private static readonly GridSort<Analytics.ComplianceRow> _sortByCapacity = GridSort<Analytics.ComplianceRow>.ByDescending(x => x.CapacityUtilization);

    private string _filter = string.Empty;

    private IReadOnlyList<Analytics.ComplianceRow> _rows = [];
    private IReadOnlyList<Analytics.ComplianceRow>? _filterCache;
    private string? _filterCacheKey;
    private int _withGaps, _awaitingApproval, _missingDays, _totalExpected, _totalFilled, _probationers;
    private decimal _pendingHours, _capacityUsed;

    private IReadOnlyList<Analytics.ComplianceRow> Rows => _rows;

    /// <summary>Filtered view, rebuilt only when the filter text actually changes.</summary>
    private IReadOnlyList<Analytics.ComplianceRow> FilteredRows
    {
        get
        {
            if (_filterCache is not null && _filterCacheKey == _filter) return _filterCache;
            _filterCacheKey = _filter;
            _filterCache = string.IsNullOrWhiteSpace(_filter)
                ? _rows
                : _rows.Where(x => x.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                                || (x.TeamName?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false)).ToArray();
            return _filterCache;
        }
    }

    private bool AnyPendingApproval => _awaitingApproval > 0;

    // Graduated severity instead of a flat on/off flag: a couple of missed days reads very
    // differently from a full no-show, and the color should say so at a glance.
    private static string? MissingSeverityClass(int missingDays) => missingDays switch
    {
        <= 0 => null,
        <= 3 => "flag-warning",
        _ => "flag-critical"
    };

    // Row fill is reserved for a genuinely critical state — nothing logged at all for the
    // whole month. Any other gap is carried by an amber marker on the row plus the Missing
    // and Fill rate cells; painting most of the table red made every engineer look equally
    // delinquent and drowned out the handful who actually are.
    private static string? RowSeverityClass(Analytics.ComplianceRow row) =>
        row.ExpectedDays > 0 && row.FilledDays == 0 ? "row-flag-critical"
        : row.MissingDays > 0 ? "row-flag"
        : null;

    // A literal zero hours reads as "nothing here" — an em dash is faster to scan across a
    // column than a wall of repeated "0.0"s, and doesn't compete visually with real values.
    private static string Hours(decimal value) => value <= 0 ? "—" : Analytics.Format(value) + " h";

    private int TotalExpected => _totalExpected;
    private int TotalFilled => _totalFilled;
    private decimal FillRate => _totalExpected == 0 ? 0 : decimal.Round(_totalFilled * 100m / _totalExpected, 1);
    private decimal CapacityUsed => _capacityUsed;
    private int Probationers => _probationers;

    private RenderFragment Kpi(string label, string value, string hint) => @<div class="kpi" title="@hint">
        <span class="kpi-label">@label</span>
        <span class="kpi-value"><strong>@value</strong></span>
    </div>;
}
