@page "/timesheets"
@using EngineeringPerformance.Application
@inject AppState State
@inject NavigationManager Navigation
@implements IDisposable

@* Timesheet compliance: who has not filled, and what is filled but still awaiting approval. *@

<div class="overview">
    @if (Rows.Count == 0)
    {
        <div class="empty-state">
            <h2>No timesheet data for @State.SelectedMonth.ToString("MMMM yyyy")</h2>
            <p>Import this month's attendance and utilization exports on the Data imports screen.</p>
            <button class="action" @onclick='() => Navigation.NavigateTo("/imports")'>Go to data imports</button>
        </div>
    }
    else
    {
        <div class="kpi-row">
            @Kpi("Fill rate", Analytics.Format(FillRate) + "%", $"{TotalFilled} of {TotalExpected} accountable days")
            @Kpi("Engineers with gaps", WithGaps.Count.ToString(), WithGaps.Count == 0 ? "Everyone up to date" : "Unfilled timesheet days")
            @Kpi("Missing days", Rows.Sum(x => x.MissingDays).ToString(), "Total across the team")
            @Kpi("Awaiting approval", Analytics.Format(Rows.Sum(x => x.PendingApprovalHours), "0") + " h", $"{AwaitingApproval.Count} engineer(s)")
            @Kpi("Billable capacity used", Analytics.Format(CapacityUsed) + "%", $"vs {Analytics.Format(Analytics.MonthlyBillableCapacityHours, "0")} h per billable engineer")
            @Kpi("Freshers on probation", Probationers.ToString(), "From the ERP roster")
        </div>

        <div class="overview-grid">
            <section class="card wide">
                <div class="card-head"><h2>Timesheet compliance</h2><small>@Rows.Count engineer(s), highest gap first</small></div>
                <div class="performance-table compliance">
                    <div class="performance-head">
                        <span>Engineer</span><span>Team</span><span>Filled</span><span>Missing</span><span>Fill rate</span>
                        <span>Entered h</span><span>Awaiting approval</span><span>Billable h</span><span>Capacity</span>
                    </div>
                    @foreach (var row in Rows)
                    {
                        <div class="performance-row @(row.HasGap ? "row-flag" : null)">
                            <span class="roster-name">
                                @row.Name
                                <small>
                                    @if (row.IsConsultant)
                                    {
                                        <span class="tag consultant">Consultant</span>
                                    }
                                    @if (row.IsOnProbation)
                                    {
                                        <span class="tag probation">Probation</span>
                                    }
                                    @if (row.IsNonBillable)
                                    {
                                        <span class="tag muted">Non-billable</span>
                                    }
                                </small>
                            </span>
                            <span>@(row.TeamName ?? "—")</span>
                            <span>@row.FilledDays / @row.ExpectedDays</span>
                            <span class="@(row.MissingDays > 0 ? "flag-critical" : null)">@row.MissingDays</span>
                            <span>@Analytics.Format(row.FillRate)%</span>
                            <span>@Analytics.Format(row.EnteredHours)</span>
                            <span class="@(row.HasPendingApproval ? "flag-warning" : null)">@Analytics.Format(row.PendingApprovalHours)</span>
                            <span>@Analytics.Format(row.BillableHours)</span>
                            <span>@(row.IsNonBillable ? "n/a" : Analytics.Format(row.CapacityUtilization) + "%")</span>
                        </div>
                    }
                </div>
            </section>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;

    private IReadOnlyList<Analytics.ComplianceRow> Rows => Analytics.Compliance(State.Performance, State.Employees);
    private IReadOnlyList<Analytics.ComplianceRow> WithGaps => Rows.Where(x => x.HasGap).ToArray();
    private IReadOnlyList<Analytics.ComplianceRow> AwaitingApproval => Rows.Where(x => x.HasPendingApproval).ToArray();

    private int TotalExpected => Rows.Sum(x => x.ExpectedDays);
    private int TotalFilled => Rows.Sum(x => x.FilledDays);
    private decimal FillRate => TotalExpected == 0 ? 0 : decimal.Round(TotalFilled * 100m / TotalExpected, 1);

    private decimal CapacityUsed
    {
        get
        {
            var billable = Rows.Where(x => !x.IsNonBillable).ToArray();
            if (billable.Length == 0) return 0;
            return decimal.Round(billable.Sum(x => x.BillableHours) / (billable.Length * Analytics.MonthlyBillableCapacityHours) * 100m, 1);
        }
    }

    private int Probationers => State.Employees.Count(x => x.IsOnProbation);

    private RenderFragment Kpi(string label, string value, string hint) => @<div class="kpi" title="@hint">
        <span class="kpi-label">@label</span>
        <span class="kpi-value"><strong>@value</strong></span>
    </div>;
}
