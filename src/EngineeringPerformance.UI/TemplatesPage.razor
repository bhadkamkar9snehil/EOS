@page "/templates"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@using Microsoft.Extensions.Logging
@inject IFileDialogService Dialogs
@inject IWorkbookService Workbooks
@inject AppState State
@inject ILogger<TemplatesPage> Logger
@implements IDisposable

<div class="flex flex-col gap-6">
    <header class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <div class="panel-eyebrow">Review workbooks</div>
            <h2 class="panel-title">Review workbook generation</h2>
        </div>
        <div class="flex gap-6">
            <div class="text-right">
                <div class="metric text-metric-sm tabular-nums">@State.Employees.Count</div>
                <div class="label-instrument mt-1">Roster</div>
            </div>
            <div class="text-right">
                <div class="metric text-metric-sm tabular-nums">@State.SelectedMonth.ToString("MMM yy")</div>
                <div class="label-instrument mt-1">Month</div>
            </div>
        </div>
    </header>

    <section class="grid grid-cols-1 items-center gap-4 @@3xl:grid-cols-[1fr_auto_1fr]">
        <article class="plate p-4">
            <div class="panel-eyebrow !text-primary">01 · Team round</div>
            <div class="metric mt-1 text-metric tabular-nums">@State.Employees.Count</div>
            <div class="label-instrument mt-1">Personalized workbooks</div>
            <h2 class="panel-title mt-3">Generate the complete review set</h2>
            <div class="well mt-3 px-3 py-2"><code class="text-xs text-ink-soft">Reviews_@State.SelectedMonth.ToString("yyyy_MM")\&lt;employee&gt;.xlsx</code></div>
            <button class="btn btn-primary mt-4" @onclick="GenerateAllTemplates" disabled="@(State.Busy || State.Employees.Count == 0)">Generate all review workbooks</button>
        </article>

        <div class="hidden text-2xl text-muted @@3xl:block" aria-hidden="true">→</div>

        <article class="plate p-4">
            <div class="panel-eyebrow">02 · Exception / reissue</div>
            <div class="metric mt-1 text-metric tabular-nums">1</div>
            <div class="label-instrument mt-1">Single workbook</div>
            <h2 class="panel-title mt-3">Generate one workbook</h2>
            <label class="mt-3 flex flex-col gap-1 text-xs text-ink-soft">Employee
                <select class="field px-2 py-1.5 text-sm text-ink" @bind="_templateEmployeeId">
                    <option value="">Select employee</option>
                    @foreach (var e in State.Employees.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@e.Id">@e.Name — Level @e.SeniorityLevel</option>
                    }
                </select>
            </label>
            <button class="btn btn-secondary mt-4" @onclick="GenerateTemplate" disabled="@State.Busy">Generate one workbook</button>
        </article>
    </section>

    <section class="plate p-4">
        <div class="panel-head">
            <div>
                <div class="panel-eyebrow">Contract</div>
                <h2 class="panel-title">Round trip</h2>
            </div>
        </div>
        <div class="grid grid-cols-1 gap-px overflow-hidden rounded-lg bg-line-soft @@md:grid-cols-3">
            <div class="bg-surface p-3"><div class="label-instrument">Workbook</div><strong class="mt-1 block text-sm font-semibold text-ink">Self + peer review</strong></div>
            <div class="bg-surface p-3"><div class="label-instrument">Identity</div><strong class="mt-1 block text-sm font-semibold text-ink">ERP roster</strong></div>
            <div class="bg-surface p-3"><div class="label-instrument">Return</div><strong class="mt-1 block text-sm font-semibold text-ink">Data operations</strong></div>
        </div>
    </section>
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;

    private int? _templateEmployeeId;

    private void GenerateTemplate()
    {
        var employee = State.Employees.SingleOrDefault(x => x.Id == _templateEmployeeId);
        if (employee is null) { State.ShowMessage("Select an employee first.", true); return; }
        var destination = Dialogs.PickSaveWorkbook($"{employee.EmployeeCode}_{State.SelectedMonth:yyyy_MM}_Review.xlsx");
        if (destination is null) return;
        try
        {
            Workbooks.GenerateEngineerTemplate(destination, new Employee(employee.EmployeeCode, employee.Name, employee.SeniorityLevel), State.SelectedMonth.Year, State.SelectedMonth.Month);
            State.ShowMessage($"Template generated for {employee.Name}.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate a review template for {EmployeeName} ({Year:D4}-{Month:D2}).", employee.Name, State.SelectedMonth.Year, State.SelectedMonth.Month);
            State.ShowMessage(ex.Message, true);
        }
    }

    private void GenerateAllTemplates()
    {
        if (State.Employees.Count == 0) { State.ShowMessage("Add employees before generating templates.", true); return; }
        var folder = Dialogs.PickFolder($"Choose a folder for the {State.SelectedMonth:MMMM yyyy} review templates");
        if (folder is null) return;
        try
        {
            var target = Path.Combine(folder, $"Reviews_{State.SelectedMonth:yyyy_MM}");
            var employees = State.Employees.Select(x => new Employee(x.EmployeeCode, x.Name, x.SeniorityLevel)).ToArray();
            var generated = Workbooks.GenerateEngineerTemplates(target, employees, State.SelectedMonth.Year, State.SelectedMonth.Month);
            State.ShowMessage($"{generated.Count} review workbook(s) written to {target}.");
            Logger.LogInformation("Generated {Count} review workbook(s) into {Target} for {Year:D4}-{Month:D2}.", generated.Count, target, State.SelectedMonth.Year, State.SelectedMonth.Month);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate review workbooks for {Year:D4}-{Month:D2}.", State.SelectedMonth.Year, State.SelectedMonth.Month);
            State.ShowMessage(ex.Message, true);
        }
    }
}
