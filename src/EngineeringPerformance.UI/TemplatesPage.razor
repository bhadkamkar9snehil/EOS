@page "/templates"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@using Microsoft.Extensions.Logging
@inject IFileDialogService Dialogs
@inject IWorkbookService Workbooks
@inject AppState State
@inject ILogger<TemplatesPage> Logger
@implements IDisposable

<div class="flex flex-col gap-6">
    <header class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h2 class="text-xl font-bold text-ink">Review workbook generation</h2>
            <p class="mt-1 max-w-lg text-sm text-ink-soft">Create the controlled review inputs for @State.SelectedMonth.ToString("MMMM yyyy"). Employee identity and level are pre-filled from the local roster.</p>
        </div>
        <div class="flex gap-6">
            <div class="text-right"><span class="block text-[10px] uppercase tracking-wide text-muted">Roster</span><strong class="text-lg font-bold text-ink">@State.Employees.Count</strong></div>
            <div class="text-right"><span class="block text-[10px] uppercase tracking-wide text-muted">Month</span><strong class="text-lg font-bold text-ink">@State.SelectedMonth.ToString("MMM yy")</strong></div>
        </div>
    </header>

    <section class="grid grid-cols-1 items-center gap-4 lg:grid-cols-[1fr_auto_1fr]">
        <article class="card">
            <span class="text-[10px] font-semibold uppercase tracking-wide text-primary">01 · Team round</span>
            <div class="mt-1 text-4xl font-bold text-ink">@State.Employees.Count</div>
            <h2 class="mt-2 text-base font-bold text-ink">Generate the complete review set</h2>
            <p class="mt-1 text-sm text-ink-soft">One personalized workbook per employee, written into a dated folder. This is the normal monthly review workflow.</p>
            <div class="mt-3 rounded-lg bg-surface-inset px-3 py-2"><code class="text-xs text-ink-soft">Reviews_@State.SelectedMonth.ToString("yyyy_MM")\&lt;employee&gt;.xlsx</code></div>
            <button class="btn btn-primary mt-4" @onclick="GenerateAllTemplates" disabled="@(State.Busy || State.Employees.Count == 0)">Generate all review workbooks</button>
        </article>

        <div class="hidden text-2xl text-muted lg:block" aria-hidden="true">→</div>

        <article class="card">
            <span class="text-[10px] font-semibold uppercase tracking-wide text-muted">02 · Exception / reissue</span>
            <div class="mt-1 text-4xl font-bold text-ink">1</div>
            <h2 class="mt-2 text-base font-bold text-ink">Generate one workbook</h2>
            <p class="mt-1 text-sm text-ink-soft">Use this when a single employee needs a fresh copy without regenerating the complete team set.</p>
            <label class="mt-3 flex flex-col gap-1 text-xs text-ink-soft">Employee
                <select class="rounded-lg border border-line bg-surface-inset px-2 py-1.5 text-sm text-ink" @bind="_templateEmployeeId">
                    <option value="">Select employee</option>
                    @foreach (var e in State.Employees.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@e.Id">@e.Name — Level @e.SeniorityLevel</option>
                    }
                </select>
            </label>
            <button class="btn btn-secondary mt-4" @onclick="GenerateTemplate" disabled="@State.Busy">Generate one workbook</button>
        </article>
    </section>

    <section class="grid grid-cols-1 gap-4 rounded-xl border border-line bg-surface p-4 sm:grid-cols-3">
        <div><span class="block text-[10px] font-semibold uppercase tracking-wide text-muted">Workbook contract</span><strong class="mt-1 block text-sm font-semibold text-ink">Self review + peer review</strong><small class="text-[11px] text-muted">Returned files are recognized by their workbook structure, not by filename alone.</small></div>
        <div><span class="block text-[10px] font-semibold uppercase tracking-wide text-muted">Identity source</span><strong class="mt-1 block text-sm font-semibold text-ink">ERP roster</strong><small class="text-[11px] text-muted">Employee code, name and seniority remain aligned with imported identity.</small></div>
        <div><span class="block text-[10px] font-semibold uppercase tracking-wide text-muted">Return path</span><strong class="mt-1 block text-sm font-semibold text-ink">Data imports</strong><small class="text-[11px] text-muted">Upload completed workbooks individually or as a ZIP package.</small></div>
    </section>
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;

    private int? _templateEmployeeId;

    private void GenerateTemplate()
    {
        var employee = State.Employees.SingleOrDefault(x => x.Id == _templateEmployeeId);
        if (employee is null) { State.ShowMessage("Select an employee first.", true); return; }
        var destination = Dialogs.PickSaveWorkbook($"{employee.EmployeeCode}_{State.SelectedMonth:yyyy_MM}_Review.xlsx");
        if (destination is null) return;
        try
        {
            Workbooks.GenerateEngineerTemplate(destination, new Employee(employee.EmployeeCode, employee.Name, employee.SeniorityLevel), State.SelectedMonth.Year, State.SelectedMonth.Month);
            State.ShowMessage($"Template generated for {employee.Name}.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate a review template for {EmployeeName} ({Year:D4}-{Month:D2}).", employee.Name, State.SelectedMonth.Year, State.SelectedMonth.Month);
            State.ShowMessage(ex.Message, true);
        }
    }

    private void GenerateAllTemplates()
    {
        if (State.Employees.Count == 0) { State.ShowMessage("Add employees before generating templates.", true); return; }
        var folder = Dialogs.PickFolder($"Choose a folder for the {State.SelectedMonth:MMMM yyyy} review templates");
        if (folder is null) return;
        try
        {
            var target = Path.Combine(folder, $"Reviews_{State.SelectedMonth:yyyy_MM}");
            var employees = State.Employees.Select(x => new Employee(x.EmployeeCode, x.Name, x.SeniorityLevel)).ToArray();
            var generated = Workbooks.GenerateEngineerTemplates(target, employees, State.SelectedMonth.Year, State.SelectedMonth.Month);
            State.ShowMessage($"{generated.Count} review workbook(s) written to {target}.");
            Logger.LogInformation("Generated {Count} review workbook(s) into {Target} for {Year:D4}-{Month:D2}.", generated.Count, target, State.SelectedMonth.Year, State.SelectedMonth.Month);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate review workbooks for {Year:D4}-{Month:D2}.", State.SelectedMonth.Year, State.SelectedMonth.Month);
            State.ShowMessage(ex.Message, true);
        }
    }
}
