@page "/templates"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IFileDialogService Dialogs
@inject IWorkbookService Workbooks
@inject AppState State
@implements IDisposable

<div class="workbench-page template-workbench">
    <header class="workbench-header">
        <div>
            <h2>Review workbook generation</h2>
            <p>Create the controlled review inputs for @State.SelectedMonth.ToString("MMMM yyyy"). Employee identity and level are pre-filled from the local roster.</p>
        </div>
        <div class="workbench-summary">
            <div><span>Roster</span><strong>@State.Employees.Count</strong></div>
            <div><span>Month</span><strong>@State.SelectedMonth.ToString("MMM yy")</strong></div>
        </div>
    </header>

    <section class="template-flow">
        <article class="template-lane primary">
            <span class="atlas-section-label">01 · Team round</span>
            <div class="template-number">@State.Employees.Count</div>
            <h2>Generate the complete review set</h2>
            <p>One personalized workbook per employee, written into a dated folder. This is the normal monthly review workflow.</p>
            <div class="template-path"><code>Reviews_@State.SelectedMonth.ToString("yyyy_MM")\&lt;employee&gt;.xlsx</code></div>
            <button class="action" @onclick="GenerateAllTemplates" disabled="@(State.Busy || State.Employees.Count == 0)">Generate all review workbooks</button>
        </article>

        <div class="template-flow-arrow" aria-hidden="true">→</div>

        <article class="template-lane">
            <span class="atlas-section-label">02 · Exception / reissue</span>
            <div class="template-number">1</div>
            <h2>Generate one workbook</h2>
            <p>Use this when a single employee needs a fresh copy without regenerating the complete team set.</p>
            <label class="export-picker">Employee
                <select @bind="_templateEmployeeId">
                    <option value="">Select employee</option>
                    @foreach (var e in State.Employees.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@e.Id">@e.Name — Level @e.SeniorityLevel</option>
                    }
                </select>
            </label>
            <button class="action secondary" @onclick="GenerateTemplate" disabled="@State.Busy">Generate one workbook</button>
        </article>
    </section>

    <section class="template-contract">
        <div><span class="atlas-section-label">Workbook contract</span><strong>Self review + peer review</strong><small>Returned files are recognized by their workbook structure, not by filename alone.</small></div>
        <div><span class="atlas-section-label">Identity source</span><strong>ERP roster</strong><small>Employee code, name and seniority remain aligned with imported identity.</small></div>
        <div><span class="atlas-section-label">Return path</span><strong>Data imports</strong><small>Upload completed workbooks individually or as a ZIP package.</small></div>
    </section>
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;

    private int? _templateEmployeeId;

    private void GenerateTemplate()
    {
        var employee = State.Employees.SingleOrDefault(x => x.Id == _templateEmployeeId);
        if (employee is null) { State.ShowMessage("Select an employee first.", true); return; }
        var destination = Dialogs.PickSaveWorkbook($"{employee.EmployeeCode}_{State.SelectedMonth:yyyy_MM}_Review.xlsx");
        if (destination is null) return;
        try
        {
            Workbooks.GenerateEngineerTemplate(destination, new Employee(employee.EmployeeCode, employee.Name, employee.SeniorityLevel), State.SelectedMonth.Year, State.SelectedMonth.Month);
            State.ShowMessage($"Template generated for {employee.Name}.");
        }
        catch (Exception ex) { State.ShowMessage(ex.Message, true); }
    }

    private void GenerateAllTemplates()
    {
        if (State.Employees.Count == 0) { State.ShowMessage("Add employees before generating templates.", true); return; }
        var folder = Dialogs.PickFolder($"Choose a folder for the {State.SelectedMonth:MMMM yyyy} review templates");
        if (folder is null) return;
        try
        {
            var target = Path.Combine(folder, $"Reviews_{State.SelectedMonth:yyyy_MM}");
            var employees = State.Employees.Select(x => new Employee(x.EmployeeCode, x.Name, x.SeniorityLevel)).ToArray();
            var generated = Workbooks.GenerateEngineerTemplates(target, employees, State.SelectedMonth.Year, State.SelectedMonth.Month);
            State.ShowMessage($"{generated.Count} review workbook(s) written to {target}.");
        }
        catch (Exception ex) { State.ShowMessage(ex.Message, true); }
    }
}
