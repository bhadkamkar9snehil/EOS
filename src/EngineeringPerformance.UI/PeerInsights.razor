@page "/peer-insights"
@using System.Globalization
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IJSRuntime JS
@inject AppState State
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="collaboration-page peer-workbench">
    @if (Summary.TotalFeedback == 0)
    {
        <div class="empty-state">
            <h2>No peer feedback for @State.SelectedMonth.ToString("MMMM yyyy")</h2>
            <p>Generate review workbooks, collect the completed sheets, and upload them through Data imports.</p>
            <button class="action" @onclick='() => Navigation.NavigateTo("/templates")'>Go to review templates</button>
        </div>
    }
    else
    {
        <section class="peer-evidence-grid">
            <div class="peer-confidence-panel">
                <div class="atlas-panel-head peer-confidence-head">
                    <div><h2>Reliable team signal</h2></div>
                    <details class="peer-method">
                        <summary>How this rank works</summary>
                        <div>
                            <strong>Evidence target adapts to this month</strong>
                            <p>An established placement currently requires @Summary.EvidenceCoverageTarget independent reviewers, the median coverage among reviewed employees. Thinner results stay visible as provisional signals after the established ranking.</p>
                            <p>The team mean stabilizes sparse averages, but only actual reviewers narrow the uncertainty range. Model assumptions never count as extra reviews.</p>
                            <span>Team mean <b>@Analytics.Format(Summary.AverageRating, "0.00")</b></span>
                            <span>Data-derived stabilizer <b>@Analytics.Format(Summary.ModelPriorStrength, "0.0")</b></span>
                        </div>
                    </details>
                </div>
                <div class="peer-confidence-columns" aria-hidden="true"><span>Person and evidence</span><span>Rating range</span><span>Raw</span><span>Reliable</span></div>
                <ol class="peer-confidence-list">
                    @for (var i = 0; i < Summary.Standings.Count; i++)
                    {
                        var standing = Summary.Standings[i];
                        if (i > 0 && Summary.Standings[i - 1].IsEstablished && !standing.IsEstablished)
                        {
                            <li class="peer-confidence-tier"><span>Provisional signals</span><small>Fewer than @Summary.EvidenceCoverageTarget independent reviewers</small></li>
                        }
                        <li>
                            <button type="button" class="peer-confidence-row @(!standing.IsEstablished ? "provisional" : null) @(IsFocused(standing.Name) ? "selected" : null)" @onclick="() => SelectPerson(standing.Name)" aria-pressed="@IsFocused(standing.Name)" title="Focus @standing.Name in the relationship network">
                                <span class="peer-confidence-rank">@(i + 1)</span>
                                <span class="peer-confidence-person"><strong>@standing.Name</strong><small>@standing.ReviewsReceived received · @EvidenceLabel(standing)</small></span>
                                <span class="peer-confidence-track" style="@ConfidenceTrackStyle(standing)"><i></i><b></b><em></em></span>
                                <span class="peer-confidence-raw">@Analytics.Format(standing.Average, "0.00")</span>
                                <span class="peer-confidence-floor">@Analytics.Format(standing.ConfidenceLowerBound, "0.00")</span>
                            </button>
                        </li>
                    }
                </ol>
                <div class="peer-confidence-legend"><span class="interval"><i></i>95% uncertainty</span><span class="raw"><i></i>Raw average</span><span class="mean"><i></i>Team mean</span></div>
            </div>

            <div class="peer-landscape-workbench">
                <div class="atlas-panel-head"><div><h2>Aspect landscape</h2><small>Evidence-adjusted aspect estimates · ordered by reliable signal</small></div></div>
                <div id="peer-aspect-landscape" aria-label="Peer aspect comparison heatmap"></div>
            </div>
        </section>

        <PeerRelationshipExplorer Reviews="State.PeerReviews" SelectedMonth="State.SelectedMonth" InitialFocusName="_focusName" />

        <section class="peer-diagnostics peer-diagnostics-wide">
            <div class="atlas-panel-head"><div><h2>Coverage and blind spots</h2></div></div>
            <div class="peer-diagnostics-summary">
                <div class="peer-coverage-callout"><strong>@Analytics.Format(NetworkCompletion, "0")%</strong><span>of possible reviewer-to-colleague links recorded</span><i style="--v:@CssPct(NetworkCompletion)"></i></div>
                <div class="peer-coverage-facts">
                    @Diagnostic("Reciprocal pairs", ReciprocalPairs.ToString(), "Both colleagues rated each other")
                    @Diagnostic("One-way links", OneWayPairs.ToString(), "Only one direction is present")
                </div>
            </div>
            <div class="peer-thin-evidence">
                <h3>Thinnest evidence</h3>
                <ol class="peer-thin-list">
                    @foreach (var person in ThinEvidence)
                    {
                        <li><button type="button" @onclick="() => SelectPerson(person.Name)"><span><strong>@person.Name</strong><small>@person.ReviewsReceived ratings received</small></span><i style="@CoverageBarStyle(person)"></i><b>@person.ReviewsReceived</b></button></li>
                    }
                </ol>
            </div>
        </section>

        <details class="peer-matrix-disclosure">
            <summary><span><strong>Reviewer × colleague matrix</strong><small>Open the complete directed evidence table for @AspectLabel.ToLowerInvariant()</small></span><b>@Summary.TotalFeedback values</b></summary>
            <div class="peer-rating-matrix-wrap">
                <div class="atlas-panel-head"><div><h2>@AspectLabel rating matrix</h2><small>Rows rate columns · direct values out of 5</small></div></div>
                <div class="peer-rating-matrix" style="@PeerMatrixStyle">
                    <span class="pm-label">Reviewer ↓ / colleague →</span>
                    @foreach (var subject in PeerNames) { <span class="pm-label" title="@subject">@Analytics.Initials(subject)</span> }
                    @foreach (var reviewer in PeerNames)
                    {
                        <strong class="pm-label" title="@reviewer">@reviewer</strong>
                        @foreach (var subject in PeerNames)
                        {
                            var review = PairReview(reviewer, subject);
                            if (PersonName.Matches(reviewer, subject))
                            {
                                <span class="pm-cell self" title="Self-review is not part of peer evidence">·</span>
                            }
                            else if (review is null)
                            {
                                <span class="pm-cell missing" title="@reviewer → @subject: no peer feedback">—</span>
                            }
                            else
                            {
                                var rating = AspectValue(review);
                                <button type="button" class="pm-cell rated" style="--v:@CssPct(rating * 20m)" title="@PairTooltip(review)" @onclick="() => OpenPortrait(subject)">@Analytics.Format(rating, "0.0")</button>
                            }
                        }
                    }
                </div>
            </div>
        </details>

        <section class="peer-comments evidence-rich">
            <div class="atlas-panel-head"><div><h2>Written evidence</h2><small>@AllComments.Count comments · reviewer context preserved</small></div></div>
            @if (AllComments.Count == 0)
            {
                <p class="chart-note">No reviewer left a written comment this month.</p>
            }
            else
            {
                <ul class="comment-list grid">
                    @foreach (var c in AllComments)
                    {
                        <li @onclick="() => OpenPortrait(c.SubjectName)" title="Open @c.SubjectName portrait">
                            <strong>@c.ReviewerName → @c.SubjectName</strong>
                            <span>@Analytics.Format(c.Average, "0.00") overall · Collab @Analytics.Format(c.Collaboration, "0.0") · Comms @Analytics.Format(c.Communication, "0.0") · Reliable @Analytics.Format(c.Reliability, "0.0") · Tech @Analytics.Format(c.TechnicalHelp, "0.0")</span>
                            <p>@c.Comment</p>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>

@code {
    private static readonly AspectOption[] Aspects = [new("overall", "Overall"), new("collaboration", "Collaboration"), new("communication", "Communication"), new("reliability", "Reliability"), new("technicalHelp", "Technical help")];
    private string _aspect = "overall";
    private string? _focusName;
    private bool _chartsPending = true;

    private Analytics.PeerSummary Summary => Analytics.Peers(State.PeerReviews);
    private string[] PeerNames => State.PeerReviews.SelectMany(x => new[] { x.ReviewerName, x.SubjectName }).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToArray();
    private string PeerMatrixStyle => $"grid-template-columns:170px repeat({Math.Max(1, PeerNames.Length)},32px)";
    private string AspectLabel => Aspects.First(x => x.Key == _aspect).Label;
    private IReadOnlyList<PeerReviewItem> AllComments => State.PeerReviews.Where(x => !string.IsNullOrWhiteSpace(x.Comment)).OrderBy(x => x.SubjectName, StringComparer.OrdinalIgnoreCase).ThenBy(x => x.ReviewerName, StringComparer.OrdinalIgnoreCase).ToArray();
    private IReadOnlyList<Analytics.PeerStanding> ThinEvidence => Summary.Standings.OrderBy(x => x.ReviewsReceived).ThenBy(x => x.Name).Take(5).ToArray();
    private int MaxReceived => Math.Max(1, Summary.Standings.Max(x => x.ReviewsReceived));
    private int OneWayPairs => State.PeerReviews.Count(review => !State.PeerReviews.Any(other => PersonName.Matches(other.ReviewerName, review.SubjectName) && PersonName.Matches(other.SubjectName, review.ReviewerName)));
    private int ReciprocalPairs => State.PeerReviews.Where(review => State.PeerReviews.Any(other => PersonName.Matches(other.ReviewerName, review.SubjectName) && PersonName.Matches(other.SubjectName, review.ReviewerName))).Select(review => string.Compare(review.ReviewerName, review.SubjectName, StringComparison.OrdinalIgnoreCase) < 0 ? $"{review.ReviewerName}|{review.SubjectName}" : $"{review.SubjectName}|{review.ReviewerName}").Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private decimal NetworkCompletion => PeerNames.Length <= 1 ? 0 : decimal.Round(State.PeerReviews.Count * 100m / (PeerNames.Length * (PeerNames.Length - 1)), 1);

    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() { _focusName = null; _chartsPending = true; InvokeAsync(StateHasChanged); }
    private void SelectAspect(string aspect) { _aspect = aspect; _chartsPending = true; }
    private void SelectPerson(string name) { _focusName = IsFocused(name) ? null : name; _chartsPending = true; }
    private void ClearPerson() { _focusName = null; _chartsPending = true; }
    private bool IsFocused(string name) => _focusName is not null && PersonName.Matches(_focusName, name);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chartsPending || Summary.TotalFeedback == 0) return;
        _chartsPending = false;
        var rows = Summary.Standings.Select(standing =>
        {
            var peer = Analytics.PeerBreakdownFor(State.PeerReviews, standing.Name);
            var raw = new[] { peer.Collaboration, peer.Communication, peer.Reliability, peer.TechnicalHelp };
            var team = new[]
            {
                TeamAspectAverage(x => x.Collaboration),
                TeamAspectAverage(x => x.Communication),
                TeamAspectAverage(x => x.Reliability),
                TeamAspectAverage(x => x.TechnicalHelp)
            };
            return new
            {
                name = standing.Name,
                received = standing.ReviewsReceived,
                established = standing.IsEstablished,
                adjusted = standing.ConfidenceAdjustedAverage,
                confidence = standing.ConfidenceLowerBound,
                rawValues = raw,
                values = raw.Select((value, index) => Analytics.ReliableAspectEstimate(standing, value, team[index], Summary.ModelPriorStrength)).ToArray()
            };
        }).ToArray();
        await JS.InvokeVoidAsync("epaAtlas.peerAspectHeatmap", "peer-aspect-landscape", new[] { "Collaboration", "Communication", "Reliability", "Technical help" }, rows);
    }

    private PeerReviewItem? PairReview(string reviewer, string subject) => State.PeerReviews.FirstOrDefault(x => PersonName.Matches(x.ReviewerName, reviewer) && PersonName.Matches(x.SubjectName, subject));
    private decimal TeamAspectAverage(Func<PeerReviewItem, decimal> selector)
    {
        var values = State.PeerReviews.Select(selector).Where(value => value > 0).ToArray();
        return values.Length == 0 ? 0 : decimal.Round(values.Average(), 2);
    }
    private decimal AspectValue(PeerReviewItem review) => _aspect switch { "collaboration" => review.Collaboration, "communication" => review.Communication, "reliability" => review.Reliability, "technicalHelp" => review.TechnicalHelp, _ => review.Average };
    private string PairTooltip(PeerReviewItem review) => $"{review.ReviewerName} → {review.SubjectName}: overall {Analytics.Format(review.Average, "0.00")}; collaboration {Analytics.Format(review.Collaboration, "0.0")}; communication {Analytics.Format(review.Communication, "0.0")}; reliability {Analytics.Format(review.Reliability, "0.0")}; technical help {Analytics.Format(review.TechnicalHelp, "0.0")}";
    private string EvidenceLabel(Analytics.PeerStanding standing) => standing.IsEstablished
        ? "established signal"
        : $"provisional · {standing.ReviewsReceived}/{Summary.EvidenceCoverageTarget} coverage";
    private string ConfidenceTrackStyle(Analytics.PeerStanding standing) => $"--low:{ScorePct(standing.ConfidenceLowerBound)};--raw:{ScorePct(standing.Average)};--mean:{ScorePct(Summary.AverageRating)}";
    private string CoverageBarStyle(Analytics.PeerStanding standing) => $"--v:{CssPct(standing.ReviewsReceived * 100m / MaxReceived)}";
    private RenderFragment ProfileAspectCell(Analytics.PeerStanding standing, decimal rawValue, decimal teamAverage, string label)
    {
        var adjusted = Analytics.ReliableAspectEstimate(standing, rawValue, teamAverage, Summary.ModelPriorStrength);
        return @<span class="peer-aspect-cell" title="@label: raw @Analytics.Format(rawValue, "0.00"); evidence-adjusted @Analytics.Format(adjusted, "0.00") from @standing.ReviewsReceived review@(standing.ReviewsReceived == 1 ? "" : "s")"><b>@Analytics.Format(adjusted, "0.00")</b><i style="--rating:@CssPct(adjusted * 20m)"></i></span>;
    }
    private static string ScorePct(decimal value) => CssPct((Math.Clamp(value, 1m, 5m) - 1m) * 25m);
    private void OpenPortrait(string name) => Navigation.NavigateTo($"/employee/{Uri.EscapeDataString(name)}");
    private static string CssPct(decimal value) => Math.Clamp(value, 0, 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    private RenderFragment Diagnostic(string label, string value, string detail) => @<div class="peer-diagnostic"><span>@label</span><strong>@value</strong><small>@detail</small></div>;

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        try { await JS.InvokeVoidAsync("epaAtlas.dispose", "peer-aspect-landscape"); } catch (JSDisconnectedException) { }
    }

    private sealed record AspectOption(string Key, string Label);
}
