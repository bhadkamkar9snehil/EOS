@page "/peer-insights"
@using System.Globalization
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IJSRuntime JS
@inject AppState State
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="flex flex-col gap-6">
    @if (Summary.TotalFeedback == 0)
    {
        <div class="plate flex flex-col items-start gap-3 p-8">
            <div class="panel-eyebrow">Peer evidence</div>
            <h2 class="panel-title">No peer feedback for <span class="tabular-nums">@State.SelectedMonth.ToString("MMMM yyyy")</span></h2>
            <p class="text-sm text-ink-soft">Generate review workbooks, collect the completed sheets, and upload them through Data imports.</p>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/templates")'>Go to review templates</button>
        </div>
    }
    else
    {
        <section class="grid grid-cols-1 gap-4 xl:grid-cols-[1fr_1fr]">
            <div class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Standings</div>
                        <h2 class="panel-title">Reliable team signal</h2>
                    </div>
                    <details class="ml-auto">
                        <summary class="cursor-pointer text-2xs font-semibold text-ink-soft hover:text-ink">How this rank works</summary>
                        <div class="well mt-2 max-w-sm p-3 text-xs text-ink-soft">
                            <strong class="block text-ink">Evidence target adapts to this month</strong>
                            <p class="mt-1">An established placement currently requires <span class="tabular-nums">@Summary.EvidenceCoverageTarget</span> independent reviewers, the median coverage among reviewed employees. Thinner results stay visible as provisional signals after the established ranking.</p>
                            <p class="mt-1">The team mean stabilizes sparse averages, but only actual reviewers narrow the uncertainty range. Model assumptions never count as extra reviews.</p>
                            <span class="mt-1 block">Team mean <b class="tabular-nums text-ink">@Analytics.Format(Summary.AverageRating, "0.00")</b></span>
                            <span class="block">Data-derived stabilizer <b class="tabular-nums text-ink">@Analytics.Format(Summary.ModelPriorStrength, "0.0")</b></span>
                        </div>
                    </details>
                </div>
                <div class="grid grid-cols-[1.5rem_1fr_5rem_3rem_3rem] gap-2 border-b border-line pb-1.5" aria-hidden="true">
                    <span></span><span class="label-instrument">Person and evidence</span><span class="label-instrument">Rating range</span><span class="label-instrument text-right">Raw</span><span class="label-instrument text-right">Reliable</span>
                </div>
                <ol class="flex flex-col divide-y divide-line-soft">
                    @for (var i = 0; i < Summary.Standings.Count; i++)
                    {
                        var standing = Summary.Standings[i];
                        if (i > 0 && Summary.Standings[i - 1].IsEstablished && !standing.IsEstablished)
                        {
                            <li class="flex items-baseline gap-2 bg-surface-inset px-1 py-1.5 text-2xs"><span class="label-instrument">Provisional signals</span><small class="text-muted">Fewer than <span class="tabular-nums">@Summary.EvidenceCoverageTarget</span> independent reviewers</small></li>
                        }
                        <li class="group">
                            <button type="button" class="@($"grid w-full grid-cols-[1.5rem_1fr_5rem_3rem_3rem] items-center gap-2 rounded-md px-1 py-2 text-left transition-colors duration-100 ease-press hover:bg-surface-inset {(!standing.IsEstablished ? "opacity-70" : "")} {(IsFocused(standing.Name) ? "bg-primary-soft" : "")}")" @onclick="() => SelectPerson(standing.Name)" aria-pressed="@IsFocused(standing.Name)" title="Focus @standing.Name in the relationship network">
                                <span class="text-xs font-semibold tabular-nums text-muted">@(i + 1)</span>
                                <span class="flex min-w-0 flex-col"><strong class="truncate text-sm font-medium text-ink">@standing.Name</strong><small class="truncate text-2xs tabular-nums text-muted">@standing.ReviewsReceived received · @EvidenceLabel(standing)</small></span>
                                <span class="track relative h-1.5">
                                    <i class="absolute inset-y-0 rounded-full bg-petrol/35" style="@ConfidenceTrackStyle(standing)"></i>
                                    <i class="absolute top-1/2 h-2 w-0.5 -translate-y-1/2 bg-ink-soft" style="@($"left:{ScorePct(Summary.AverageRating)}")"></i>
                                </span>
                                <span class="text-right text-xs tabular-nums text-ink-soft">@Analytics.Format(standing.Average, "0.00")</span>
                                <span class="metric text-right text-xs">@Analytics.Format(standing.ConfidenceLowerBound, "0.00")</span>
                            </button>
                        </li>
                    }
                </ol>
                <div class="mt-3 flex gap-4">
                    <span class="label-instrument flex items-center gap-1"><i class="h-1.5 w-3 rounded-full bg-petrol/35"></i><span class="tabular-nums">95%</span> uncertainty</span>
                    <span class="label-instrument flex items-center gap-1"><i class="h-1.5 w-1.5 rounded-full bg-ink-soft"></i>Raw average</span>
                    <span class="label-instrument flex items-center gap-1"><i class="h-1.5 w-1.5 rounded-full bg-ink-soft"></i>Team mean</span>
                </div>
            </div>

            <div class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Aspects</div>
                        <h2 class="panel-title">Aspect landscape</h2>
                    </div>
                    <span class="label-instrument ml-auto">Evidence-adjusted · ordered by reliable signal</span>
                </div>
                <div class="well p-3">
                    <div id="peer-aspect-landscape" class="h-[420px]" aria-label="Peer aspect comparison heatmap"></div>
                </div>
            </div>
        </section>

        <PeerRelationshipExplorer Reviews="State.PeerReviews" SelectedMonth="State.SelectedMonth" InitialFocusName="_focusName" />

        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Network</div>
                    <h2 class="panel-title">Coverage and blind spots</h2>
                </div>
            </div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-[240px_1fr]">
                <div class="well p-4">
                    <div class="metric text-metric">@Analytics.Format(NetworkCompletion, "0")<span class="text-metric-sm">%</span></div>
                    <div class="track mt-2 h-1.5 overflow-hidden"><i class="block h-full rounded-full bg-petrol" style="@($"width:{CssPct(NetworkCompletion)}")"></i></div>
                    <div class="label-instrument mt-1">Reviewer-to-colleague links recorded</div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    @Diagnostic("Reciprocal pairs", ReciprocalPairs.ToString(), "Both colleagues rated each other")
                    @Diagnostic("One-way links", OneWayPairs.ToString(), "Only one direction is present")
                </div>
            </div>
            <div class="mt-4">
                <h3 class="label-instrument">Thinnest evidence</h3>
                <ol class="mt-2 flex flex-col divide-y divide-line-soft">
                    @foreach (var person in ThinEvidence)
                    {
                        <li class="group">
                            <button type="button" class="flex w-full items-center gap-3 rounded-md px-1 py-1.5 text-left transition-colors duration-100 ease-press hover:bg-surface-inset" title="Focus @person.Name in the relationship network" @onclick="() => SelectPerson(person.Name)">
                                <span class="flex min-w-0 flex-1 flex-col"><strong class="truncate text-sm font-medium text-ink">@person.Name</strong><small class="text-2xs tabular-nums text-muted">@person.ReviewsReceived ratings received</small></span>
                                <i class="track block h-1.5 w-20 shrink-0 overflow-hidden"><i class="block h-full rounded-full bg-petrol" style="@CoverageBarStyle(person)"></i></i>
                                <b class="metric w-6 text-right text-sm">@person.ReviewsReceived</b>
                            </button>
                        </li>
                    }
                </ol>
            </div>
        </section>

        <details class="plate">
            <summary class="flex cursor-pointer items-center justify-between gap-3 p-4">
                <span>
                    <span class="panel-eyebrow block">Evidence table</span>
                    <strong class="panel-title">Reviewer × colleague matrix</strong>
                </span>
                <b class="label-instrument"><span class="tabular-nums">@Summary.TotalFeedback</span> values</b>
            </summary>
            <div class="border-t border-line p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">@AspectLabel</div>
                        <h2 class="panel-title">Rating matrix</h2>
                    </div>
                    <span class="label-instrument ml-auto">Rows rate columns · direct values out of 5</span>
                </div>
                <div class="well overflow-auto p-3">
                    <div class="grid gap-1" style="@PeerMatrixStyle">
                        <span class="label-instrument sticky left-0 bg-well">Reviewer ↓ / colleague →</span>
                        @foreach (var subject in PeerNames) { <span class="label-instrument text-center" title="@subject">@Analytics.Initials(subject)</span> }
                        @foreach (var reviewer in PeerNames)
                        {
                            <strong class="sticky left-0 truncate bg-well text-xs font-medium text-ink" title="@reviewer">@reviewer</strong>
                            @foreach (var subject in PeerNames)
                            {
                                var review = PairReview(reviewer, subject);
                                if (PersonName.Matches(reviewer, subject))
                                {
                                    <span class="flex h-8 items-center justify-center text-muted" title="Self-review is not part of peer evidence">·</span>
                                }
                                else if (review is null)
                                {
                                    <span class="flex h-8 items-center justify-center text-line" title="@reviewer → @subject: no peer feedback">—</span>
                                }
                                else
                                {
                                    var rating = AspectValue(review);
                                    <button type="button" class="@($"flex h-8 items-center justify-center rounded-sm text-2xs font-semibold tabular-nums {(rating >= 3.5m ? "text-white" : "text-ink")}")" style="@($"background-color:color-mix(in srgb, var(--color-heat-5) {CssPct(rating * 20m)}, var(--color-heat-1))")" title="@PairTooltip(review)" @onclick="() => OpenPortrait(subject)">@Analytics.Format(rating, "0.0")</button>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </details>

        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Comments</div>
                    <h2 class="panel-title">Written evidence</h2>
                </div>
                <span class="label-instrument ml-auto"><span class="tabular-nums">@AllComments.Count</span> comments · reviewer context preserved</span>
            </div>
            @if (AllComments.Count == 0)
            {
                <p class="text-sm text-muted">No reviewer left a written comment this month.</p>
            }
            else
            {
                <ul class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
                    @foreach (var c in AllComments)
                    {
                        <li class="group cursor-pointer rounded-lg border border-line-soft bg-surface-inset p-3 transition-colors duration-100 ease-press hover:bg-surface-raised" @onclick="() => OpenPortrait(c.SubjectName)" title="Open @c.SubjectName portrait">
                            <strong class="block text-sm font-medium text-ink">@c.ReviewerName → @c.SubjectName</strong>
                            <span class="mt-1 block text-2xs tabular-nums text-muted">@Analytics.Format(c.Average, "0.00") overall · Collab @Analytics.Format(c.Collaboration, "0.0") · Comms @Analytics.Format(c.Communication, "0.0") · Reliable @Analytics.Format(c.Reliability, "0.0") · Tech @Analytics.Format(c.TechnicalHelp, "0.0")</span>
                            <p class="mt-2 text-xs text-ink-soft">@c.Comment</p>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>

@code {
    private static readonly AspectOption[] Aspects = [new("overall", "Overall"), new("collaboration", "Collaboration"), new("communication", "Communication"), new("reliability", "Reliability"), new("technicalHelp", "Technical help")];
    private string _aspect = "overall";
    private string? _focusName;
    private bool _chartsPending = true;

    private Analytics.PeerSummary Summary => Analytics.Peers(State.PeerReviews);
    private string[] PeerNames => State.PeerReviews.SelectMany(x => new[] { x.ReviewerName, x.SubjectName }).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToArray();
    private string PeerMatrixStyle => $"grid-template-columns:170px repeat({Math.Max(1, PeerNames.Length)},32px)";
    private string AspectLabel => Aspects.First(x => x.Key == _aspect).Label;
    private IReadOnlyList<PeerReviewItem> AllComments => State.PeerReviews.Where(x => !string.IsNullOrWhiteSpace(x.Comment)).OrderBy(x => x.SubjectName, StringComparer.OrdinalIgnoreCase).ThenBy(x => x.ReviewerName, StringComparer.OrdinalIgnoreCase).ToArray();
    private IReadOnlyList<Analytics.PeerStanding> ThinEvidence => Summary.Standings.OrderBy(x => x.ReviewsReceived).ThenBy(x => x.Name).Take(5).ToArray();
    private int MaxReceived => Math.Max(1, Summary.Standings.Max(x => x.ReviewsReceived));
    private int OneWayPairs => State.PeerReviews.Count(review => !State.PeerReviews.Any(other => PersonName.Matches(other.ReviewerName, review.SubjectName) && PersonName.Matches(other.SubjectName, review.ReviewerName)));
    private int ReciprocalPairs => State.PeerReviews.Where(review => State.PeerReviews.Any(other => PersonName.Matches(other.ReviewerName, review.SubjectName) && PersonName.Matches(other.SubjectName, review.ReviewerName))).Select(review => string.Compare(review.ReviewerName, review.SubjectName, StringComparison.OrdinalIgnoreCase) < 0 ? $"{review.ReviewerName}|{review.SubjectName}" : $"{review.SubjectName}|{review.ReviewerName}").Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private decimal NetworkCompletion => PeerNames.Length <= 1 ? 0 : decimal.Round(State.PeerReviews.Count * 100m / (PeerNames.Length * (PeerNames.Length - 1)), 1);

    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() { _focusName = null; _chartsPending = true; InvokeAsync(StateHasChanged); }
    private void SelectAspect(string aspect) { _aspect = aspect; _chartsPending = true; }
    private void SelectPerson(string name) { _focusName = IsFocused(name) ? null : name; _chartsPending = true; }
    private void ClearPerson() { _focusName = null; _chartsPending = true; }
    private bool IsFocused(string name) => _focusName is not null && PersonName.Matches(_focusName, name);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chartsPending || Summary.TotalFeedback == 0) return;
        _chartsPending = false;
        var rows = Summary.Standings.Select(standing =>
        {
            var peer = Analytics.PeerBreakdownFor(State.PeerReviews, standing.Name);
            var raw = new[] { peer.Collaboration, peer.Communication, peer.Reliability, peer.TechnicalHelp };
            var team = new[]
            {
                TeamAspectAverage(x => x.Collaboration),
                TeamAspectAverage(x => x.Communication),
                TeamAspectAverage(x => x.Reliability),
                TeamAspectAverage(x => x.TechnicalHelp)
            };
            return new
            {
                name = standing.Name,
                received = standing.ReviewsReceived,
                established = standing.IsEstablished,
                adjusted = standing.ConfidenceAdjustedAverage,
                confidence = standing.ConfidenceLowerBound,
                rawValues = raw,
                values = raw.Select((value, index) => Analytics.ReliableAspectEstimate(standing, value, team[index], Summary.ModelPriorStrength)).ToArray()
            };
        }).ToArray();
        await JS.InvokeVoidAsync("epaAtlas.peerAspectHeatmap", "peer-aspect-landscape", new[] { "Collaboration", "Communication", "Reliability", "Technical help" }, rows);
    }

    private PeerReviewItem? PairReview(string reviewer, string subject) => State.PeerReviews.FirstOrDefault(x => PersonName.Matches(x.ReviewerName, reviewer) && PersonName.Matches(x.SubjectName, subject));
    private decimal TeamAspectAverage(Func<PeerReviewItem, decimal> selector)
    {
        var values = State.PeerReviews.Select(selector).Where(value => value > 0).ToArray();
        return values.Length == 0 ? 0 : decimal.Round(values.Average(), 2);
    }
    private decimal AspectValue(PeerReviewItem review) => _aspect switch { "collaboration" => review.Collaboration, "communication" => review.Communication, "reliability" => review.Reliability, "technicalHelp" => review.TechnicalHelp, _ => review.Average };
    private string PairTooltip(PeerReviewItem review) => $"{review.ReviewerName} → {review.SubjectName}: overall {Analytics.Format(review.Average, "0.00")}; collaboration {Analytics.Format(review.Collaboration, "0.0")}; communication {Analytics.Format(review.Communication, "0.0")}; reliability {Analytics.Format(review.Reliability, "0.0")}; technical help {Analytics.Format(review.TechnicalHelp, "0.0")}";
    private string EvidenceLabel(Analytics.PeerStanding standing) => standing.IsEstablished
        ? "established signal"
        : $"provisional · {standing.ReviewsReceived}/{Summary.EvidenceCoverageTarget} coverage";
    private string ConfidenceTrackStyle(Analytics.PeerStanding standing) => $"left:{ScorePct(standing.ConfidenceLowerBound)};width:{CssPct(Math.Abs((Math.Clamp(standing.Average,1m,5m)-1m)*25m - (Math.Clamp(standing.ConfidenceLowerBound,1m,5m)-1m)*25m))}";
    private string CoverageBarStyle(Analytics.PeerStanding standing) => $"width:{CssPct(standing.ReviewsReceived * 100m / MaxReceived)}";
    private static string ScorePct(decimal value) => CssPct((Math.Clamp(value, 1m, 5m) - 1m) * 25m);
    private void OpenPortrait(string name) => Navigation.NavigateTo($"/employee/{Uri.EscapeDataString(name)}");
    private static string CssPct(decimal value) => Math.Clamp(value, 0, 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    private RenderFragment Diagnostic(string label, string value, string detail) =>
        @<div class="well p-3"><strong class="metric block text-metric-sm">@value</strong><small class="metric-delta block text-muted">@detail</small><span class="label-instrument mt-1 block">@label</span></div>;

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        try { await JS.InvokeVoidAsync("epaAtlas.dispose", "peer-aspect-landscape"); } catch (JSDisconnectedException) { }
    }

    private sealed record AspectOption(string Key, string Label);
}
