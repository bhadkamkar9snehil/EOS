@using EngineeringPerformance.Application
@inject AppState State
@inject IApplicationDatabase Database
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@if (State.Performance.Count > 0)
{
    <section class="analytics-extension overview-extension">
        <div class="refined-overview-grid">
            <section class="card span-7 score-stack-card">
                <div class="card-head">
                    <div>
                        <h2>Operational score composition</h2>
                        <small>Weighted contribution points from timesheet completion, approval completion and attendance discipline</small>
                    </div>
                </div>
                <div id="overview-score-components" class="echart score-composition-chart"></div>
            </section>

            <section class="card span-5 review-priorities-card">
                <div class="card-head">
                    <div><h2>Review priorities</h2><small>Consolidated people-review signals</small></div>
                    <button class="link" @onclick='() => Navigation.NavigateTo("/data")'>Numerical audit →</button>
                </div>

                <div class="review-summary">
                    <div><span>Missing timesheet days</span><strong>@MissingTimesheetDays</strong></div>
                    <div><span>Attendance exception days</span><strong>@TotalExceptionDays</strong></div>
                    <div><span>Variance ≥ 40 h</span><strong>@HighVarianceCount</strong></div>
                </div>

                <div class="review-dual-grid">
                    <section class="review-section">
                        <h3>Top performers</h3>
                        <ol class="review-list">
                            @foreach (var item in TopPerformers)
                            {
                                <li><span>@item.EmployeeName</span><b class="good">@Analytics.Format(item.OperationalScore)</b></li>
                            }
                        </ol>
                    </section>

                    <section class="review-section">
                        <h3>Needs attention</h3>
                        <ol class="review-list">
                            @foreach (var item in NeedsAttention)
                            {
                                <li><span>@item.EmployeeName</span><b class="@(item.OperationalScore < 55 ? "critical" : "warning")">@Analytics.Format(item.OperationalScore)</b></li>
                            }
                        </ol>
                    </section>
                </div>

                <section class="review-section attendance-review-section">
                    <div class="review-section-title">
                        <div>
                            <h3>Attendance &amp; reconciliation</h3>
                            <small>Punch, timesheet duration and exception types shown independently</small>
                        </div>
                        <span>Largest gaps</span>
                    </div>

                    <div class="attendance-signal-grid">
                        @foreach (var item in AttendanceReview)
                        {
                            <button type="button"
                                    class="attendance-signal"
                                    title="Open @item.EmployeeName analysis"
                                    @onclick="() => OpenEmployee(item)">
                                <span class="attendance-signal-head">
                                    <i class="signal-avatar">@Initials(item.EmployeeName)</i>
                                    <span class="signal-person">
                                        <strong>@item.EmployeeName</strong>
                                        <small>@ExceptionCount(item) attendance exception day(s)</small>
                                    </span>
                                    <span class="signal-score-band @Analytics.ScoreBand(item.OperationalScore)">@Analytics.Format(item.OperationalScore)</span>
                                </span>

                                <span class="duration-grid">
                                    <span class="duration-stat punch-duration"><small>Punch duration</small><b>@Analytics.Format(item.PunchHours) h</b></span>
                                    <span class="duration-stat timesheet-duration"><small>Timesheet duration</small><b>@Analytics.Format(item.AttendanceTimesheetHours) h</b></span>
                                    <span class="duration-stat variance-duration"><small>Variance</small><b>@Signed(item.ReconciliationVariance) h</b></span>
                                </span>

                                <span class="variance-meter" aria-hidden="true"><i style="@($"width:{VarianceWidth(item)}%")"></i></span>

                                <span class="exception-type-grid">
                                    <span class="exception-type missing-punch @(item.MissingPunchDays > 0 ? "active" : null)"><i>MP</i><small>Missing punch</small><b>@item.MissingPunchDays</b></span>
                                    <span class="exception-type late @(item.LateDays > 0 ? "active" : null)"><i>LT</i><small>Late</small><b>@item.LateDays</b></span>
                                    <span class="exception-type early @(item.EarlyDays > 0 ? "active" : null)"><i>ER</i><small>Early</small><b>@item.EarlyDays</b></span>
                                    <span class="exception-type short @(item.LessDurationDays > 0 ? "active" : null)"><i>SH</i><small>Short duration</small><b>@item.LessDurationDays</b></span>
                                    <span class="exception-type missing-ts @(MissingTimesheetDaysFor(item) > 0 ? "active" : null)"><i>TS</i><small>Missing timesheet</small><b>@MissingTimesheetDaysFor(item)</b></span>
                                </span>
                            </button>
                        }
                    </div>
                </section>
            </section>
        </div>
    </section>
}

@code {
    private bool _pending = true;
    private string? _signature;
    private OperationalScoringSettings _settings = OperationalScoringSettings.Default;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        _settings = await Database.GetOperationalScoringSettingsAsync();
    }

    private void OnChanged()
    {
        _pending = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var signature = $"{State.SelectedMonth:yyyyMM}|{State.Performance.Count}|{State.Performance.Sum(x => x.OperationalScore):0.0}|{_settings.TimesheetCompletionWeight:0.###}|{_settings.ApprovalCompletionWeight:0.###}|{_settings.AttendanceDisciplineWeight:0.###}";
        if (!_pending && signature == _signature) return;
        _pending = false;
        _signature = signature;
        if (State.Performance.Count == 0) return;

        var rows = State.Performance.OrderByDescending(x => x.OperationalScore).ToArray();
        var labels = rows.Select(x => x.EmployeeName).ToArray();

        await JS.InvokeVoidAsync("epaAnalyticsCharts.weightedStack", "overview-score-components", labels, new object[]
        {
            new
            {
                name = $"Timesheet ({Analytics.Format(_settings.TimesheetCompletionWeight, "0.#")}%)",
                color = "#0F6E9E",
                values = rows.Select(x => x.HasSummaryData ? (object)Contribution(x, x.TimesheetCompletionScore, _settings.TimesheetCompletionWeight) : null).ToArray()
            },
            new
            {
                name = $"Approval ({Analytics.Format(_settings.ApprovalCompletionWeight, "0.#")}%)",
                color = "#A9762A",
                values = rows.Select(x => x.HasSummaryData ? (object)Contribution(x, x.ApprovalScore, _settings.ApprovalCompletionWeight) : null).ToArray()
            },
            new
            {
                name = $"Attendance ({Analytics.Format(_settings.AttendanceDisciplineWeight, "0.#")}%)",
                color = "#3F7D55",
                values = rows.Select(x => (object)Contribution(x, x.AttendanceDisciplineScore, _settings.AttendanceDisciplineWeight)).ToArray()
            }
        }, rows.Select(x => x.OperationalScore).ToArray(), " pts");
    }

    private decimal Contribution(MonthlyPerformanceItem item, decimal componentScore, decimal componentWeight)
    {
        var availableWeight = item.HasSummaryData ? _settings.Total : _settings.AttendanceDisciplineWeight;
        if (availableWeight <= 0 || componentWeight <= 0) return 0;
        return decimal.Round(componentScore * componentWeight / availableWeight, 1);
    }

    private int MissingTimesheetDays => State.Performance.Sum(MissingTimesheetDaysFor);
    private int TotalExceptionDays => State.Performance.Sum(ExceptionCount);
    private int HighVarianceCount => State.Performance.Count(x => Math.Abs(x.ReconciliationVariance) >= 40m);

    private IReadOnlyList<MonthlyPerformanceItem> TopPerformers => State.Performance.OrderByDescending(x => x.OperationalScore).Take(4).ToArray();
    private IReadOnlyList<MonthlyPerformanceItem> NeedsAttention => State.Performance.OrderBy(x => x.OperationalScore).Take(4).ToArray();
    private IReadOnlyList<MonthlyPerformanceItem> AttendanceReview => State.Performance
        .OrderByDescending(x => Math.Abs(x.ReconciliationVariance))
        .ThenByDescending(ExceptionCount)
        .Take(4)
        .ToArray();

    private decimal MaxAttendanceVariance => Math.Max(1m, AttendanceReview.Select(x => Math.Abs(x.ReconciliationVariance)).DefaultIfEmpty(1m).Max());
    private decimal VarianceWidth(MonthlyPerformanceItem item) => decimal.Round(Math.Min(100m, Math.Abs(item.ReconciliationVariance) / MaxAttendanceVariance * 100m), 1);
    private static int MissingTimesheetDaysFor(MonthlyPerformanceItem item) => Math.Max(0, item.ExpectedTimesheetDays - item.TimesheetFilledDays);
    private static int ExceptionCount(MonthlyPerformanceItem item) => item.MissingPunchDays + item.LateDays + item.EarlyDays + item.LessDurationDays;
    private static string Signed(decimal value) => value > 0 ? $"+{Analytics.Format(value)}" : Analytics.Format(value);
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private void OpenEmployee(MonthlyPerformanceItem item) => Navigation.NavigateTo($"/employee/{Uri.EscapeDataString(item.EmployeeName)}");

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnChanged;
        try { await JS.InvokeVoidAsync("epaCharts.dispose", "overview-score-components"); } catch (JSDisconnectedException) { }
    }
}
