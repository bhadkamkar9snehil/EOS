@using EngineeringPerformance.Application
@inject AppState State
@inject IApplicationDatabase Database
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@if (State.Performance.Count > 0)
{
    <section class="analytics-extension overview-extension">
        <div class="kpi-row analytics-kpi-row">
            @Kpi("Entered hours", State.Performance.Sum(x => x.EnteredHours), "h")
            @Kpi("Approved hours", State.Performance.Sum(x => x.ApprovedHours), "h", "good")
            @Kpi("Billable share", BillableShare, "%")
            @Kpi("Timesheet coverage", TimesheetCoverage, "%", TimesheetCoverage >= 90 ? "good" : "warning")
            @Kpi("Missing timesheet days", MissingTimesheetDays, "", MissingTimesheetDays > 0 ? "warning" : "good")
            @Kpi("Absolute reconciliation gap", AbsoluteVariance, "h", AbsoluteVariance >= 100 ? "critical" : "warning")
        </div>

        <div class="refined-overview-grid">
            <section class="card span-8 score-stack-card">
                <div class="card-head">
                    <div>
                        <h2>Operational score composition</h2>
                        <small>Weighted contribution points from timesheet completion, approval completion and attendance discipline</small>
                    </div>
                </div>
                <div id="overview-score-components"
                     class="echart"
                     style="height:@ScoreChartHeightPx}px"></div>
            </section>

            <section class="card span-4 review-priorities-card">
                <div class="card-head">
                    <div><h2>Review priorities</h2><small>Consolidated people-review signals</small></div>
                    <button class="link" @onclick='() => Navigation.NavigateTo("/data")'>Numerical audit →</button>
                </div>

                <div class="review-summary">
                    <div><span>Missing timesheet days</span><strong>@MissingTimesheetDays</strong></div>
                    <div><span>Attendance exception days</span><strong>@TotalExceptionDays</strong></div>
                    <div><span>Variance ≥ 40 h</span><strong>@HighVarianceCount</strong></div>
                </div>

                <div class="review-dual-grid">
                    <section class="review-section">
                        <h3>Top performers</h3>
                        <ol class="review-list">
                            @foreach (var item in TopPerformers)
                            {
                                <li><span>@item.EmployeeName</span><b class="good">@Analytics.Format(item.OperationalScore)</b></li>
                            }
                        </ol>
                    </section>

                    <section class="review-section">
                        <h3>Needs attention</h3>
                        <ol class="review-list">
                            @foreach (var item in NeedsAttention)
                            {
                                <li><span>@item.EmployeeName</span><b class="@(item.OperationalScore < 55 ? "critical" : "warning")">@Analytics.Format(item.OperationalScore)</b></li>
                            }
                        </ol>
                    </section>
                </div>

                <section class="review-section attendance-review-section">
                    <div class="review-section-title">
                        <h3>Attendance &amp; reconciliation</h3>
                        <small>Largest absolute hour gaps</small>
                    </div>
                    <div class="attendance-signal-grid">
                        @foreach (var item in AttendanceReview)
                        {
                            <button type="button"
                                    class="attendance-signal"
                                    title="Open @item.EmployeeName analysis"
                                    @onclick="() => OpenEmployee(item)">
                                <span class="attendance-signal-head">
                                    <i class="signal-avatar">@Initials(item.EmployeeName)</i>
                                    <span class="signal-person">
                                        <strong>@item.EmployeeName</strong>
                                        <small>@ExceptionCount(item) exception day(s)</small>
                                    </span>
                                    <b class="@(Math.Abs(item.ReconciliationVariance) >= 40 ? "critical" : "warning")">@Signed(item.ReconciliationVariance) h</b>
                                </span>
                                <span class="variance-meter" aria-hidden="true">
                                    <i style="@($"width:{VarianceWidth(item)}%")"></i>
                                </span>
                                <span class="signal-chips">
                                    <i class="@(item.MissingPunchDays > 0 ? "active" : null)">Punch @item.MissingPunchDays</i>
                                    <i class="@(item.LateDays > 0 ? "active" : null)">Late @item.LateDays</i>
                                    <i class="@(item.EarlyDays > 0 ? "active" : null)">Early @item.EarlyDays</i>
                                    <i class="@(item.LessDurationDays > 0 ? "active" : null)">Short @item.LessDurationDays</i>
                                </span>
                            </button>
                        }
                    </div>
                </section>
            </section>

            <section class="card wide hours-allocation-card">
                <div class="card-head">
                    <div>
                        <h2>Hours allocation by engineer</h2>
                        <small>Billable, non-billable, training and office presence; these are quantities, not performance judgements</small>
                    </div>
                </div>
                <div id="overview-hours-allocation" class="echart tall"></div>
            </section>
        </div>
    </section>
}

@code {
    private bool _pending = true;
    private string? _signature;
    private OperationalScoringSettings _settings = OperationalScoringSettings.Default;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        _settings = await Database.GetOperationalScoringSettingsAsync();
    }

    private void OnChanged()
    {
        _pending = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var signature = $"{State.SelectedMonth:yyyyMM}|{State.Performance.Count}|{State.Performance.Sum(x => x.OperationalScore):0.0}|{_settings.TimesheetCompletionWeight:0.###}|{_settings.ApprovalCompletionWeight:0.###}|{_settings.AttendanceDisciplineWeight:0.###}";
        if (!_pending && signature == _signature) return;
        _pending = false;
        _signature = signature;
        if (State.Performance.Count == 0) return;

        var rows = State.Performance.OrderByDescending(x => x.OperationalScore).ToArray();
        var labels = rows.Select(x => x.EmployeeName).ToArray();

        await JS.InvokeVoidAsync("epaAnalyticsCharts.weightedStack", "overview-score-components", labels, new object[]
        {
            new
            {
                name = $"Timesheet ({Analytics.Format(_settings.TimesheetCompletionWeight, "0.#")}%)",
                color = "#C85A22",
                values = rows.Select(x => x.HasSummaryData ? (object)Contribution(x, x.TimesheetCompletionScore, _settings.TimesheetCompletionWeight) : null).ToArray()
            },
            new
            {
                name = $"Approval ({Analytics.Format(_settings.ApprovalCompletionWeight, "0.#")}%)",
                color = "#7A4BB0",
                values = rows.Select(x => x.HasSummaryData ? (object)Contribution(x, x.ApprovalScore, _settings.ApprovalCompletionWeight) : null).ToArray()
            },
            new
            {
                name = $"Attendance ({Analytics.Format(_settings.AttendanceDisciplineWeight, "0.#")}%)",
                color = "#1E8C5A",
                values = rows.Select(x => (object)Contribution(x, x.AttendanceDisciplineScore, _settings.AttendanceDisciplineWeight)).ToArray()
            }
        }, rows.Select(x => x.OperationalScore).ToArray(), " pts");

        await JS.InvokeVoidAsync("epaCharts.verticalBars", "overview-hours-allocation", labels, new object[]
        {
            new { name = "Billable", color = "#0F6E9E", values = rows.Select(x => (object)x.BillableHours).ToArray() },
            new { name = "Non-billable", color = "#C85A22", values = rows.Select(x => (object)x.NonBillableHours).ToArray() },
            new { name = "Training", color = "#7A4BB0", values = rows.Select(x => (object)x.TrainingHours).ToArray() },
            new { name = "Office", color = "#1E8C5A", values = rows.Select(x => (object)x.OfficeHours).ToArray() }
        }, null, " h");
    }

    private decimal Contribution(MonthlyPerformanceItem item, decimal componentScore, decimal componentWeight)
    {
        var availableWeight = item.HasSummaryData
            ? _settings.Total
            : _settings.AttendanceDisciplineWeight;

        if (availableWeight <= 0 || componentWeight <= 0) return 0;
        return decimal.Round(componentScore * componentWeight / availableWeight, 1);
    }

    private int ScoreChartHeightPx => Math.Max(390, State.Performance.Count * 29 + 70);

    private decimal BillableShare
    {
        get
        {
            var entered = State.Performance.Sum(x => x.EnteredHours);
            return entered <= 0 ? 0 : decimal.Round(State.Performance.Sum(x => x.BillableHours) * 100m / entered, 1);
        }
    }

    private decimal TimesheetCoverage
    {
        get
        {
            var expected = State.Performance.Sum(x => x.ExpectedTimesheetDays);
            return expected <= 0 ? 0 : decimal.Round(State.Performance.Sum(x => x.TimesheetFilledDays) * 100m / expected, 1);
        }
    }

    private decimal AbsoluteVariance => State.Performance.Sum(x => Math.Abs(x.ReconciliationVariance));
    private int MissingTimesheetDays => State.Performance.Sum(x => Math.Max(0, x.ExpectedTimesheetDays - x.TimesheetFilledDays));
    private int TotalExceptionDays => State.Performance.Sum(ExceptionCount);
    private int HighVarianceCount => State.Performance.Count(x => Math.Abs(x.ReconciliationVariance) >= 40m);

    private IReadOnlyList<MonthlyPerformanceItem> TopPerformers => State.Performance
        .OrderByDescending(x => x.OperationalScore).Take(4).ToArray();

    private IReadOnlyList<MonthlyPerformanceItem> NeedsAttention => State.Performance
        .OrderBy(x => x.OperationalScore).Take(4).ToArray();

    private IReadOnlyList<MonthlyPerformanceItem> AttendanceReview => State.Performance
        .OrderByDescending(x => Math.Abs(x.ReconciliationVariance))
        .ThenByDescending(ExceptionCount)
        .Take(4)
        .ToArray();

    private decimal MaxAttendanceVariance => Math.Max(1m, AttendanceReview.Select(x => Math.Abs(x.ReconciliationVariance)).DefaultIfEmpty(1m).Max());

    private decimal VarianceWidth(MonthlyPerformanceItem item) =>
        decimal.Round(Math.Min(100m, Math.Abs(item.ReconciliationVariance) / MaxAttendanceVariance * 100m), 1);

    private static int ExceptionCount(MonthlyPerformanceItem x) => x.MissingPunchDays + x.LateDays + x.EarlyDays + x.LessDurationDays;
    private static string Signed(decimal value) => value > 0 ? $"+{Analytics.Format(value)}" : Analytics.Format(value);

    private static string Initials(string name) => string.Concat(name
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(x => char.ToUpperInvariant(x[0])));

    private void OpenEmployee(MonthlyPerformanceItem item) =>
        Navigation.NavigateTo($"/employee/{Uri.EscapeDataString(item.EmployeeName)}");

    private RenderFragment Kpi(string label, decimal value, string unit, string? tone = null) => @<div class="kpi @tone">
        <span class="kpi-label">@label</span>
        <span class="kpi-value"><strong>@Analytics.Format(value, unit == "" ? "0" : "0.0")</strong>@if (!string.IsNullOrEmpty(unit)) { <b>@unit</b> }</span>
    </div>;

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnChanged;
        foreach (var id in new[] { "overview-score-components", "overview-hours-allocation" })
        {
            try { await JS.InvokeVoidAsync("epaCharts.dispose", id); } catch (JSDisconnectedException) { }
        }
    }
}
