@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IApplicationDatabase Database
@inject IFileDialogService Dialogs
@inject IWorkbookService Workbooks

<PageTitle>Engineering Performance Analyzer</PageTitle>

<div class="app-shell">
    <aside class="nav-rail">
        <div class="brand"><img src="_content/EngineeringPerformance.UI/app-icon.png" alt="" /><span>Engineering<br />Performance</span></div>
        <nav>
            <span class="nav-group-label">Analyze</span>
            @NavButton("overview", "Overview", Icon.Overview)
            @NavButton("timesheets", "Timesheets", Icon.Timesheets)
            @NavButton("peer-insights", "Peer Insights", Icon.PeerInsights)
            @NavButton("reports", "Reports", Icon.Reports)

            <span class="nav-group-label">Manage</span>
            @NavButton("imports", "Data imports", Icon.Imports)
            @NavButton("employees", "Employees", Icon.Employees)
            @NavButton("templates", "Templates", Icon.Templates)

            <span class="nav-group-label">Configure</span>
            @NavButton("scoring", "Scoring", Icon.Scoring)
        </nav>
        <div class="nav-footer"><button class="@(_page == "settings" ? "selected" : null)" @onclick='() => Navigate("settings")'><b>@((MarkupString)Icon.Settings)</b><span>Settings</span></button><small>Local database</small></div>
    </aside>

    <section class="workspace">
        <header class="topbar">
            <div class="page-heading"><h1>@PageTitleText</h1><p>@PageSubtitleText</p></div>
            <div class="month-control">
                <span>Reporting month</span><button title="Previous month" @onclick="PreviousMonth">‹</button><strong>@_selectedMonth.ToString("MMMM yyyy")</strong><button title="Next month" @onclick="NextMonth">›</button>
            </div>
            <div class="readiness"><span>Readiness</span><strong>@ReadyCount / 4 inputs</strong></div>
        </header>

        @* This slot always renders so the workspace grid rows stay aligned. *@
        <div class="toast-slot">
            @if (!string.IsNullOrEmpty(_message))
            { <div class="toast @(_isError ? "error" : "success")">@_message<button @onclick="ClearMessage">×</button></div> }
        </div>

        <main class="content">
            @if (_page == "overview") { <Overview Items="_performance" History="_history" Month="_selectedMonth" PeerReviews="_peerReviews" ExcludedCount="_excluded.Count" OnNavigate="Navigate" /> }
            else if (_page == "imports") { @ImportWorkspace() }
            else if (_page == "timesheets") { <Timesheets Items="_performance" Employees="_employees" Month="_selectedMonth" OnNavigate="Navigate" /> }
            else if (_page == "employees") { <PeopleWorkspace Employees="_employees" Teams="_teams" Items="_performance" Database="Database" OnResult="HandleReportResult" OnChanged="RefreshAsync" OnNavigate="Navigate" /> }
            else if (_page == "peer-insights") { <PeerInsights Items="_performance" PeerReviews="_peerReviews" Month="_selectedMonth" OnNavigate="Navigate" /> }
            else if (_page == "employee-detail" && _employeeDetailName is not null) { <EmployeeDetail Name="@_employeeDetailName" Items="_performance" History="_history" PeerReviews="_peerReviews" Employees="_employees" Month="_selectedMonth" OnNavigate="Navigate" /> }
            else if (_page == "templates") { @TemplateWorkspace() }
            else if (_page == "reports") { <Reports Items="_performance" History="_history" PeerReviews="_peerReviews" Employees="_employees" Month="_selectedMonth" ExcludedCount="_excluded.Count" OnResult="HandleReportResult" /> }
            else if (_page == "scoring") { @ScoringWorkspace() }
            else { @SettingsWorkspace() }
        </main>
        <footer><span>Data stored locally in SQLite</span><span>Last refreshed @_lastRefresh.ToString("h:mm tt")</span></footer>
    </section>
</div>

@code {
    private DashboardSnapshot? _snapshot;
    private IReadOnlyList<EmployeeListItem> _employees = [];
    private IReadOnlyList<MonthlyPerformanceItem> _performance = [];
    private IReadOnlyList<MonthlyPerformanceItem> _history = [];
    private IReadOnlyList<string> _excluded = [];
    private IReadOnlyList<PeerReviewItem> _peerReviews = [];
    private IReadOnlyList<TeamItem> _teams = [];
    private DateTime _selectedMonth = DefaultReportingMonth();
    private string _page = "overview";
    private string _message = string.Empty;
    private bool _isError;
    private bool _busy;
    private DateTime _lastRefresh = DateTime.Now;
    private int? _templateEmployeeId;
    private decimal _execution = 25, _ownership = 15, _collaboration = 15, _discipline = 15, _excellence = 10, _improvement = 10, _growth = 10;

    private static DateTime DefaultReportingMonth()
    {
        var lastCompleted = DateTime.Today.AddMonths(-1);
        return new DateTime(lastCompleted.Year, lastCompleted.Month, 1);
    }

    private string PageTitleText => _page switch
    {
        "imports" => "Data imports", "timesheets" => "Timesheets & approvals", "employees" => "Employees & teams",
        "peer-insights" => "Peer Insights",
        "templates" => "Review templates", "reports" => "Reports", "scoring" => "Scoring", "settings" => "Settings",
        "employee-detail" => _employeeDetailName ?? "Employee",
        _ => "Overview"
    };
    private string PageSubtitleText => _page switch
    {
        "imports" => "Load the three ERP exports and the completed engineer reviews for this month.",
        "timesheets" => "Who has not filled and what is still awaiting approval.",
        "employees" => "Identity, seniority, team assignment, and billable/consultant/probation status.",
        "peer-insights" => "Every reviewer, every rating, the whole network — for this month.",
        "employee-detail" => "Performance across every month currently loaded.",
        "templates" => "Create personalized review workbooks for one engineer or the whole team.",
        "reports" => "Export a formatted, printable performance report.",
        "scoring" => "Category weights used when review ratings are combined.",
        "settings" => "Where this application stores its data.",
        _ => $"Team performance for {_selectedMonth:MMMM yyyy}."
    };
    private int ReadyCount => _snapshot?.SourceSlots.Count(x => x.Status == SourceStatus.Uploaded) ?? 0;
    private int SystemReadyCount => _snapshot?.SourceSlots.Count(x => x.Status == SourceStatus.Uploaded && x.ReportType != ReportType.EngineerReviewWorkbook) ?? 0;
    private bool ReviewsUploaded => _snapshot?.SourceSlots.Any(x => x.ReportType == ReportType.EngineerReviewWorkbook && x.Status == SourceStatus.Uploaded) ?? false;

    protected override async Task OnInitializedAsync() => await RefreshAsync();
    protected override Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { var p = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "EngineeringPerformance"); Directory.CreateDirectory(p); File.WriteAllText(Path.Combine(p, "ui-ready.marker"), DateTime.UtcNow.ToString("O")); } return Task.CompletedTask; }

    private RenderFragment NavButton(string page, string label, string icon) => @<button class="@(_page == page ? "selected" : null)" @onclick="() => Navigate(page)"><b>@((MarkupString)icon)</b><span>@label</span></button>;

    /// <summary>Stroke-only 20x20 glyphs (currentColor) so hover/selected states recolor via CSS alone, no per-icon overrides.</summary>
    private static class Icon
    {
        private const string Wrap = "<svg viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">{0}</svg>";
        private static string Svg(string paths) => string.Format(Wrap, paths);
        private const string Stroke = "stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"";

        public static readonly string Overview = Svg($"<path d=\"M3 10.5 10 4l7 6.5\" {Stroke}/><path d=\"M5 9v7h10V9\" {Stroke}/><path d=\"M8 16v-4h4v4\" {Stroke}/>");
        public static readonly string Imports = Svg($"<path d=\"M10 13V4\" {Stroke}/><path d=\"M6.5 7.5 10 4l3.5 3.5\" {Stroke}/><path d=\"M4 13v3h12v-3\" {Stroke}/>");
        public static readonly string Timesheets = Svg($"<rect x=\"4\" y=\"4\" width=\"12\" height=\"12\" rx=\"2.5\" {Stroke}/><path d=\"M7 10.2 9 12l4-4.2\" {Stroke}/>");
        public static readonly string Employees = Svg($"<circle cx=\"7.5\" cy=\"7\" r=\"2.4\" {Stroke}/><path d=\"M3.2 16c.5-2.7 2.2-4.2 4.3-4.2s3.8 1.5 4.3 4.2\" {Stroke}/><circle cx=\"14.2\" cy=\"7.6\" r=\"1.9\" {Stroke}/><path d=\"M13 11.9c1.9.2 3.1 1.5 3.6 3.9\" {Stroke}/>");
        public static readonly string PeerInsights = Svg($"<path d=\"M4 6h9l-2.2-2.2\" {Stroke}/><path d=\"M16 14H7l2.2 2.2\" {Stroke}/>");
        public static readonly string Templates = Svg($"<rect x=\"4.5\" y=\"3.5\" width=\"11\" height=\"13\" rx=\"1.6\" {Stroke}/><path d=\"M7 7.5h6M7 10.5h6M7 13.5h3.5\" {Stroke}/>");
        public static readonly string Reports = Svg($"<path d=\"M4.5 16V9.5M10 16V4M15.5 16v-6\" {Stroke}/>");
        public static readonly string Scoring = Svg($"<circle cx=\"10\" cy=\"10\" r=\"6.2\" {Stroke}/><circle cx=\"10\" cy=\"10\" r=\"2.6\" {Stroke}/>");
        public static readonly string Settings = Svg($"<circle cx=\"10\" cy=\"10\" r=\"2.6\" {Stroke}/><path d=\"M10 3.6v1.8M10 14.6v1.8M16.4 10h-1.8M5.4 10H3.6M14.6 5.4l-1.3 1.3M6.7 13.3l-1.3 1.3M14.6 14.6l-1.3-1.3M6.7 6.7 5.4 5.4\" {Stroke}/>");
    }
    private string? _employeeDetailName;
    private void Navigate(string page)
    {
        if (page.StartsWith("employee:", StringComparison.Ordinal)) { _employeeDetailName = page["employee:".Length..]; _page = "employee-detail"; }
        else { _page = page; }
        _message = string.Empty;
    }
    private async Task PreviousMonth() { _selectedMonth = _selectedMonth.AddMonths(-1); await RefreshAsync(); }
    private async Task NextMonth() { _selectedMonth = _selectedMonth.AddMonths(1); await RefreshAsync(); }

    private async Task RefreshAsync()
    {
        _snapshot = await Database.GetDashboardAsync(_selectedMonth.Year, _selectedMonth.Month);
        _employees = await Database.GetEmployeesAsync();
        _performance = await Database.GetMonthlyPerformanceAsync(_selectedMonth.Year, _selectedMonth.Month);
        _history = await Database.GetPerformanceHistoryAsync(_selectedMonth.Year, _selectedMonth.Month, 6);
        _excluded = await Database.GetExcludedNamesAsync();
        _peerReviews = await Database.GetPeerReviewsAsync(_selectedMonth.Year, _selectedMonth.Month);
        _teams = await Database.GetTeamsAsync();
        _lastRefresh = DateTime.Now;
    }

    private void ClearMessage() => _message = string.Empty;
    private void HandleReportResult((string Message, bool IsError) result) { _message = result.Message; _isError = result.IsError; }

    private async Task UploadAsync(ReportType type)
    {
        // Engineer reviews arrive as one workbook per engineer, so that slot also takes a ZIP.
        var path = type == ReportType.EngineerReviewWorkbook ? Dialogs.PickWorkbookOrZip() : Dialogs.PickWorkbook();
        if (path is null) return;
        await RunAsync(async () =>
        {
            if (type == ReportType.EngineerReviewWorkbook)
            {
                var count = await Database.ImportEngineerReviewsAsync(_selectedMonth.Year, _selectedMonth.Month, path);
                await RefreshAsync();
                _message = $"Peer feedback read from {count} review workbook(s).";
            }
            else
            {
                await Database.ImportSourceAsync(type, _selectedMonth.Year, _selectedMonth.Month, path);
                await RefreshAsync();
                _message = $"{Path.GetFileName(path)} imported into “{Label(type)}”.";
            }
        });
    }

    private async Task UploadZipAsync()
    {
        var path = Dialogs.PickWorkbookOrZip(); if (path is null) return;
        if (!path.EndsWith(".zip", StringComparison.OrdinalIgnoreCase)) { _message = "Select a ZIP package for combined import."; _isError = true; return; }
        await RunAsync(async () => { var count = await Database.ImportPackageAsync(_selectedMonth.Year, _selectedMonth.Month, path); await RefreshAsync(); _message = count == 0 ? "No recognizable workbooks were found in the ZIP." : $"{count} workbook(s) imported from the package."; _isError = count == 0; });
    }

    private void GenerateTemplate()
    {
        var employee = _employees.SingleOrDefault(x => x.Id == _templateEmployeeId);
        if (employee is null) { _message = "Select an employee first."; _isError = true; return; }
        var destination = Dialogs.PickSaveWorkbook($"{employee.EmployeeCode}_{_selectedMonth:yyyy_MM}_Review.xlsx");
        if (destination is null) return;
        try
        {
            Workbooks.GenerateEngineerTemplate(destination, new Employee(employee.EmployeeCode, employee.Name, employee.SeniorityLevel), _selectedMonth.Year, _selectedMonth.Month);
            _message = $"Template generated for {employee.Name}."; _isError = false;
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }

    private void GenerateAllTemplates()
    {
        if (_employees.Count == 0) { _message = "Add employees before generating templates."; _isError = true; return; }
        var folder = Dialogs.PickFolder($"Choose a folder for the {_selectedMonth:MMMM yyyy} review templates");
        if (folder is null) return;
        try
        {
            var target = Path.Combine(folder, $"Reviews_{_selectedMonth:yyyy_MM}");
            var employees = _employees.Select(x => new Employee(x.EmployeeCode, x.Name, x.SeniorityLevel)).ToArray();
            var generated = Workbooks.GenerateEngineerTemplates(target, employees, _selectedMonth.Year, _selectedMonth.Month);
            _message = $"{generated.Count} review workbook(s) written to {target}."; _isError = false;
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }

    private async Task RunAsync(Func<Task> action) { if (_busy) return; _busy = true; _isError = false; try { await action(); } catch (Exception ex) { _message = ex.Message; _isError = true; } finally { _busy = false; StateHasChanged(); } }

    // ---------- Data imports ----------

    private RenderFragment ImportWorkspace() => @<div class="page-grid">
        <section class="primary-pane">
            <div class="section-title">
                <div><h2>Data inputs</h2><p>The ERP exports keep their system-generated names. Match each row using the expected export below — detection uses workbook columns, so a renamed file still lands in the right slot.</p></div>
                <button class="action" @onclick="UploadZipAsync" disabled="@_busy">Upload ZIP</button>
            </div>
            <div class="import-table">
                <div class="table-head"><span>Input</span><span>Expected ERP export</span><span>Loaded file</span><span>Status</span><span></span></div>
                @foreach (var slot in _snapshot?.SourceSlots ?? [])
                {
                    <div class="import-row">
                        <div class="input-name"><i>@Initial(slot.ReportType)</i><span><strong>@Label(slot.ReportType)</strong><small>@Description(slot.ReportType)</small></span></div>
                        <span class="expected"><code title="@ExpectedFileName(slot.ReportType)">@ExpectedFileName(slot.ReportType)</code><small title="@ErpSource(slot.ReportType)">@ErpSource(slot.ReportType)</small></span>
                        <span class="filename" title="@slot.FileName">@(slot.FileName ?? "—")</span>
                        <span class="status @(slot.Status == SourceStatus.Uploaded ? "ok" : null)">@(slot.Status == SourceStatus.Uploaded ? "Ready" : "Not uploaded")</span>
                        <button @onclick="() => UploadAsync(slot.ReportType)" disabled="@_busy">@(slot.Status == SourceStatus.Uploaded ? "Replace" : "Upload")</button>
                    </div>
                }
            </div>
            <div class="callout">
                <strong>Which month does an export belong to?</strong>
                <p>ERP exports are generated after month end, so the file name carries the export date, not the reporting month. The utilization export named <code>…04-Aug-2026…</code> contains July 2026 data. Select the reporting month at the top of the window before uploading — this application opens on the last completed month by default.</p>
            </div>
        </section>
        <aside class="activity-pane">
            <h2>Validation</h2>
            @Activity("Database", "SQLite is available and writable.", true)
            @Activity("Employees", _employees.Count == 0 ? "No employees configured." : $"{_employees.Count} employees in scope.", _employees.Count > 0)
            @Activity("System inputs", $"{SystemReadyCount} of 3 ERP exports uploaded.", SystemReadyCount >= 3)
            @Activity("Engineer reviews", ReviewsUploaded ? "Review workbook loaded." : "Review workbook not uploaded.", ReviewsUploaded)
            @Activity("Calculated scores", _performance.Count == 0 ? "No scores for this month yet." : $"{_performance.Count} engineers scored.", _performance.Count > 0)
            @if (_performance.Count > 0)
            {
                <button class="link wide-link" @onclick='() => Navigate("overview")'>View overview →</button>
            }
        </aside>
    </div>;

    // ---------- Templates ----------

    private RenderFragment TemplateWorkspace() => @<section class="single-pane">
        <div class="section-title"><div><h2>Generate review templates</h2><p>Personalized numeric review workbooks for @_selectedMonth.ToString("MMMM yyyy").</p></div></div>
        <div class="template-cards">
            <div class="template-card featured">
                <h3>All employees</h3>
                <p>Writes one workbook per employee into a <code>Reviews_@_selectedMonth.ToString("yyyy_MM")</code> folder at the location you pick. Each workbook is pre-filled with the employee code, name and seniority level.</p>
                <div class="template-meta"><strong>@_employees.Count</strong><span>workbooks will be generated</span></div>
                <button class="action" @onclick="GenerateAllTemplates" disabled="@(_busy || _employees.Count == 0)">Generate for all employees</button>
            </div>
            <div class="template-card">
                <h3>Single employee</h3>
                <p>Generate one workbook and choose exactly where it is saved.</p>
                <label>Employee<select @bind="_templateEmployeeId"><option value="">Select employee</option>@foreach (var e in _employees) { <option value="@e.Id">@e.Name — Level @e.SeniorityLevel</option> }</select></label>
                <button class="action secondary" @onclick="GenerateTemplate" disabled="@_busy">Generate workbook</button>
            </div>
        </div>
    </section>;

    // ---------- Scoring & settings ----------

    private RenderFragment ScoringWorkspace() => @<section class="single-pane"><div class="section-title"><div><h2>Category weights</h2><p>Configure the contribution of each category. The total must equal 100.</p></div><strong class="weight-total @(WeightTotal == 100 ? "valid" : "invalid")">@WeightTotal%</strong></div><div class="weight-list">@Weight("Assignment execution", () => _execution, v => _execution = v)@Weight("Ownership & accountability", () => _ownership, v => _ownership = v)@Weight("Collaboration", () => _collaboration, v => _collaboration = v)@Weight("Operational discipline", () => _discipline, v => _discipline = v)@Weight("Professional excellence", () => _excellence, v => _excellence = v)@Weight("Continuous improvement", () => _improvement, v => _improvement = v)@Weight("Growth & learning", () => _growth, v => _growth = v)</div></section>;
    private decimal WeightTotal => _execution + _ownership + _collaboration + _discipline + _excellence + _improvement + _growth;
    private RenderFragment Weight(string label, Func<decimal> get, Action<decimal> set) => @<label class="weight-row"><span>@label</span><input type="number" min="0" max="100" value="@get()" @onchange="e => set(decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0)" /><b>%</b></label>;
    private RenderFragment SettingsWorkspace() => @<section class="single-pane narrow"><div class="section-title"><div><h2>Local application</h2><p>All performance data and imported files remain on this computer.</p></div></div><dl class="settings-list"><div><dt>Database</dt><dd>%LOCALAPPDATA%\EngineeringPerformance</dd></div><div><dt>Imported files</dt><dd>%LOCALAPPDATA%\EngineeringPerformance\Imports</dd></div><div><dt>Storage mode</dt><dd>SQLite with WAL</dd></div><div><dt>Calculation</dt><dd>Immediate, in process</dd></div></dl></section>;
    private RenderFragment Activity(string title, string detail, bool good) => @<div class="activity"><i class="@(good ? "good" : "warn")">@(good ? "✓" : "!")</i><span><strong>@title</strong><small>@detail</small></span></div>;

    private static string Initial(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "MS", ReportType.DetailedTimesheetTransactions => "DT", ReportType.AttendanceLeaveUaaTimesheet => "AT", _ => "ER" };
    private static string Label(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "Monthly utilization summary", ReportType.DetailedTimesheetTransactions => "Detailed timesheet", ReportType.AttendanceLeaveUaaTimesheet => "Attendance and leave", _ => "Engineer reviews" };
    private static string Description(ReportType type) => type switch { ReportType.MonthlyTimesheetSummary => "Monthly capacity and utilization", ReportType.DetailedTimesheetTransactions => "Daily project and effort entries", ReportType.AttendanceLeaveUaaTimesheet => "Punch, leave, UAA and compliance", _ => "Self and peer ratings" };
    private static string ExpectedFileName(ReportType type) => type switch
    {
        ReportType.MonthlyTimesheetSummary => "RPwiseTimesheetUtilazationReport<dd-MMM-yyyy>_<hh_mm_ss>.xlsx",
        ReportType.DetailedTimesheetTransactions => "LV_Timesheet_ManagerHead_Rpt.xlsx",
        ReportType.AttendanceLeaveUaaTimesheet => "LV_LeaveSummaryforRP.xlsx",
        _ => "<Code>_<Name>_<yyyy_MM>_Review.xlsx"
    };
    private static string ErpSource(ReportType type) => type switch
    {
        ReportType.MonthlyTimesheetSummary => "ERP → RP-wise Timesheet Utilization Report",
        ReportType.DetailedTimesheetTransactions => "ERP → Timesheet Manager/Head Report",
        ReportType.AttendanceLeaveUaaTimesheet => "ERP → Leave Summary for RP",
        _ => "Produced on the Templates screen, returned by engineers"
    };
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
}
