    private static RenderFragment TrendChange(IReadOnlyList<decimal?> values)
    {
        var observed = values.Where(x => x is not null).Select(x => x!.Value).ToArray();
        if (observed.Length < 2) return @<small class="text-muted">Baseline</small>;
        var delta = decimal.Round(observed[^1] - observed[^2], 0);
        if (delta == 0) return @<small class="text-muted">→ steady</small>;
        return @<small class="@(delta > 0 ? "text-good" : "text-critical")">@(delta > 0 ? "↑" : "↓") @Analytics.Format(Math.Abs(delta), "0") pts</small>;
    }
