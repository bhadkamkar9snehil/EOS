@page "/"
@page "/overview"
@using System.Globalization
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IJSRuntime JS
@inject IApplicationDatabase Database
@inject AppState State
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="flex flex-col gap-6">
    @if (State.Performance.Count == 0)
    {
        <div class="flex flex-col items-start gap-3 rounded-xl border border-line bg-surface p-8">
            <h2 class="text-lg font-bold text-ink">No performance data for @State.SelectedMonth.ToString("MMMM yyyy")</h2>
            <p class="text-sm text-ink-soft">Import the ERP exports for this reporting month. The Atlas is generated directly from the imported evidence.</p>
            <button class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary/90" @onclick='() => Navigation.NavigateTo("/imports")'>Go to data imports</button>
        </div>
    }
    else
    {
        <section class="flex flex-wrap divide-y divide-line rounded-xl border border-line bg-surface lg:flex-nowrap lg:divide-x lg:divide-y-0" aria-label="Team pulse">
            <div class="w-full shrink-0 p-4 lg:w-36">
                <span class="text-3xs font-semibold uppercase tracking-wider text-muted">Team pulse</span>
                <div class="mt-2 flex items-baseline gap-2">
                    <strong class="text-3xl font-bold tabular-nums text-ink">@Analytics.Format(TeamScore, "0")</strong>
                    <span class="text-lg font-medium tabular-nums text-muted" title="Previous month team average">@(PreviousTeamScore is null ? "—" : Analytics.Format(PreviousTeamScore.Value, "0"))</span>
                </div>
                <div class="mt-1 flex justify-between text-3xs text-muted"><span>Overall score</span><span>@Previous.ToString("MMM yyyy")</span></div>
            </div>

            <div class="w-full p-4 lg:flex-[2]">
                <h2 class="text-2xs font-semibold uppercase tracking-wide text-ink-soft">Score distribution · people</h2>
                <div class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4" role="img" aria-label="@DistributionSummary">
                    @foreach (var band in ScoreBands)
                    {
                        var members = BandMembers(band);
                        <section>
                            <div class="@($"flex items-baseline gap-1 {Analytics.BandTextClass(band.CssClass)}")">
                                <span class="text-2xs font-medium">@band.Label</span>
                                <strong class="text-sm font-bold">@members.Count</strong>
                                <small class="text-3xs font-normal text-muted">@BandShare(members.Count)% of team</small>
                            </div>
                            <div class="@($"relative mt-1.5 h-7 rounded {Analytics.BandSoftClass(band.CssClass).Split(' ')[0]}")" aria-label="@members.Count people scoring @band.Label">
                                @for (var i = 0; i < members.Count; i++)
                                {
                                    var member = members[i];
                                    <button type="button"
                                            class="@($"absolute top-1 h-2.5 w-2.5 -translate-x-1/2 rounded-full border border-surface {Analytics.BandBgClass(band.CssClass)} {(IsFocused(member.EmployeeName) ? "ring-2 ring-offset-1 ring-primary" : "")}")"
                                            style="@BandDotStyle(members, band, i)"
                                            title="@member.EmployeeName · @Analytics.Format(member.OperationalScore)"
                                            aria-label="@member.EmployeeName score @Analytics.Format(member.OperationalScore)"
                                            @onclick="() => Focus(member.EmployeeName)"></button>
                                }
                            </div>
                        </section>
                    }
                </div>
            </div>

            <div class="w-full p-4 lg:flex-[2]">
                <h2 class="text-2xs font-semibold uppercase tracking-wide text-ink-soft">Key trends · 30 days</h2>
                <div class="mt-2 grid grid-cols-3 gap-2.5">
                    <div class="rounded-lg bg-surface-inset p-2.5">
                        <div class="flex items-center justify-between text-3xs text-muted"><label>Attendance</label><span>@TrendCoverage(AttendanceTrend, "weeks")</span></div>
                        <div class="mt-1 flex items-baseline gap-1.5"><strong class="text-base font-bold text-ink">@Analytics.Format(Average(x => x.AttendanceDisciplineScore), "0")%</strong>@TrendChange(AttendanceTrend)</div>
                        <div id="pulse-attendance" class="h-8"></div>
                    </div>
                    <div class="rounded-lg bg-surface-inset p-2.5">
                        <div class="flex items-center justify-between text-3xs text-muted"><label>Completion</label><span>@TrendCoverage(CompletionTrend, "weeks")</span></div>
                        <div class="mt-1 flex items-baseline gap-1.5"><strong class="text-base font-bold text-ink">@Analytics.Format(Average(x => x.TimesheetCompletionScore, true), "0")%</strong>@TrendChange(CompletionTrend)</div>
                        <div id="pulse-completion" class="h-8"></div>
                    </div>
                    <div class="rounded-lg bg-surface-inset p-2.5">
                        <div class="flex items-center justify-between text-3xs text-muted"><label>Utilization</label><span>Monthly source</span></div>
                        <div class="mt-1 flex items-baseline gap-1.5"><strong class="text-base font-bold text-ink">@Analytics.Format(Average(x => x.Utilization, true), "0")%</strong><small class="text-muted">Current period</small></div>
                        <div id="pulse-utilization" class="h-8"></div>
                    </div>
                </div>
            </div>

            <div class="w-full shrink-0 p-4 lg:w-32">
                <h2 class="text-2xs font-semibold uppercase tracking-wide text-ink-soft">Data readiness</h2>
                <div class="mt-2 flex flex-col gap-1.5">
                    @ReadinessLight("Timesheets", IsReady(ReportType.MonthlyTimesheetSummary))
                    @ReadinessLight("Imports", IsReady(ReportType.DetailedTimesheetTransactions))
                    @ReadinessLight("Mappings", IsReady(ReportType.AttendanceLeaveUaaTimesheet))
                    @ReadinessLight("Coverage", State.ReviewsUploaded, true)
                </div>
            </div>

            <div class="w-full shrink-0 p-4 lg:w-40">
                <h2 class="text-2xs font-semibold uppercase tracking-wide text-ink-soft">Alert pressure</h2>
                <div title="Alert pressure increases with the number of open analytical alerts; critical alerts carry additional weight.">
                    <strong class="@($"mt-1 block text-sm font-bold {(AlertPressureLabel == "High" ? "text-critical" : AlertPressureLabel == "Elevated" ? "text-serious" : AlertPressureLabel == "Watch" ? "text-warning" : "text-good")}")">@AlertPressureLabel</strong>
                    <div class="mt-1.5 flex gap-0.5" aria-label="@Alerts.Count open analytical alerts">
                        @for (var i = 0; i < 12; i++) { <i class="@($"h-4 w-1.5 rounded-sm {(i < AlertPressureBars ? "bg-critical" : "bg-line")}")"></i> }
                    </div>
                    <small class="mt-1 block text-3xs text-muted">@Alerts.Count open · @Alerts.Count(x => x.Level == AlertLevel.Critical) critical</small>
                </div>
            </div>
        </section>

        <section class="grid grid-cols-1 gap-4 xl:grid-cols-[1fr_360px]">
            <div class="rounded-xl border border-line bg-surface p-4">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <h2 class="text-sm font-bold text-ink">Workforce performance field</h2>
                        <small class="block text-2xs leading-relaxed text-muted">X: accountable hours (30 days)<br />Y: utilization (%)</small>
                    </div>
                    <div class="flex items-center gap-2">
                        @if (FocusedMovement is not null)
                        {
                            <span class="flex items-center gap-2 rounded-full border border-line bg-surface-inset px-3 py-1.5 text-xs" title="@FocusedMovement.Tooltip">
                                <span class="flex flex-col leading-tight"><small class="text-3xs text-muted">Movement</small><b class="text-ink">@Previous.ToString("MMM") → @State.SelectedMonth.ToString("MMM")</b></span>
                                <strong class="@(FocusedMovement.DirectionClass == "movement-up" ? "text-good" : FocusedMovement.DirectionClass == "movement-down" ? "text-critical" : "text-muted")">@FocusedMovement.DeltaLabel</strong>
                            </span>
                        }
                        @if (FocusItem is not null)
                        {
                            <span class="flex items-center gap-2 rounded-full border border-primary-soft bg-primary-soft px-3 py-1.5 text-xs" aria-label="Focused engineer controls">
                                <button type="button" class="font-medium text-ink-soft underline-offset-2 hover:underline" title="Return to the whole-team view" @onclick="ClearFocus">Team view</button>
                                <b class="text-primary">@FocusItem.EmployeeName</b>
                                <button type="button" class="font-medium text-primary hover:underline" title="Open @FocusItem.EmployeeName performance portrait" @onclick="OpenFocusedPortrait">Open portrait <span aria-hidden="true">↗</span></button>
                            </span>
                        }
                        else
                        {
                            <span class="rounded-full border border-line bg-surface-inset px-3 py-1.5 text-xs"><b class="text-ink">Team view</b> <small class="text-muted">Select a person to focus</small></span>
                        }
                    </div>
                </div>
                <div id="atlas-field" class="mt-2 h-[420px]" aria-label="Workforce performance field"></div>
            </div>

            <aside class="rounded-xl border border-line bg-surface p-4">
                <div class="panel-head"><h2 class="text-sm font-bold text-ink">Attention lens</h2><small class="text-2xs text-muted">Ranked by intervention priority</small></div>
                <div class="mt-3 grid grid-cols-[1.25rem_1.75rem_1fr_2.5rem_5.5rem_3.5rem_1.25rem] items-center gap-2 border-b border-line pb-1.5 text-3xs font-semibold uppercase tracking-wide text-muted">
                    <span></span>
                    <span></span>
                    <span>Person</span>
                    <span class="text-right" title="Current operational score out of 100">Score</span>
                    <span class="flex justify-between" title="Completion / Approval / Attendance / Utilization diagnostic fingerprint">
                        <abbr class="no-underline" title="Completion: expected timesheet days with an entry">Comp</abbr>
                        <abbr class="no-underline" title="Approval: submitted timesheets approved on time">App</abbr>
                        <abbr class="no-underline" title="Attendance: punctuality and attendance discipline">Att</abbr>
                        <abbr class="no-underline" title="Utilization: accountable hours compared with available capacity">Util</abbr>
                    </span>
                    <span title="Recent weekly attendance-discipline pattern">Rhythm</span>
                    <span></span>
                </div>
                <ol class="flex flex-col divide-y divide-line">
                    @for (var i = 0; i < AttentionRows.Count; i++)
                    {
                        var row = AttentionRows[i];
                        <li class="@($"group grid grid-cols-[1.25rem_1.75rem_1fr_2.5rem_5.5rem_3.5rem_1.25rem] items-center gap-2 py-2 cursor-pointer rounded-lg px-1 hover:bg-surface-inset {(IsFocused(row.Name) ? "bg-primary-soft" : "")}")" role="button" tabindex="0" aria-label="Focus @row.Name in the Atlas" @onclick="() => Focus(row.Name)" @onkeydown="args => HandleAttentionKey(args, row.Name)">
                            <span class="text-xs font-semibold text-muted">@(i + 1)</span>
                            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-surface-inset text-3xs font-semibold text-ink-soft">@Initials(row.Name)</span>
                            <span class="flex min-w-0 flex-col">
                                <strong class="truncate text-sm font-medium text-ink">@row.Name</strong>
                                <small class="truncate text-2xs text-muted">@EmployeeContext(row.Name)</small>
                            </span>
                            <span class="flex flex-col items-end" title="Operational score; arrow shows change from the previous loaded month">
                                <strong class="text-sm font-bold text-ink">@Analytics.Format(row.Score, "0")</strong>
                                @if (row.Delta is not null && row.Delta != 0)
                                {
                                    <small class="@(row.Delta > 0 ? "text-good" : "text-critical")">@(row.Delta > 0 ? "↑" : "↓") @Analytics.Format(Math.Abs(row.Delta.Value), "0")</small>
                                }
                            </span>
                            <span class="flex items-end justify-between" aria-label="Completion, approval, attendance and utilization diagnostic fingerprint">
                                @MiniFingerprint("Completion", row.Item.TimesheetCompletionScore, row.Item.HasSummaryData)
                                @MiniFingerprint("Approval", row.Item.ApprovalScore, row.Item.HasSummaryData)
                                @MiniFingerprint("Attendance", row.Item.AttendanceDisciplineScore, true)
                                @MiniFingerprint("Utilization", row.Item.Utilization, row.Item.HasSummaryData)
                            </span>
                            <span class="flex h-4 items-end gap-0.5" title="Weekly attendance discipline">
                                @foreach (var value in WeeklyRhythm(row.Name))
                                {
                                    <i class="@($"block w-1 rounded-sm {(value < 65 ? "bg-critical" : "bg-petrol")}")" style="@($"height:{CssPct(value)}")"></i>
                                }
                            </span>
                            <button type="button" class="text-sm text-muted opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100 hover:text-primary" title="Open @row.Name portrait" @onclick:stopPropagation="true" @onclick="() => OpenPortrait(row.Name)">↗</button>
                        </li>
                    }
                </ol>
            </aside>
        </section>

        <section class="grid grid-cols-1 gap-4 xl:grid-cols-2">
            <div class="rounded-xl border border-line bg-surface p-4">
                <div class="panel-head">
                    <h2 class="text-sm font-bold text-ink">Movement river</h2><small class="text-2xs text-muted">Operational score · recent loaded months</small>
                    <div class="ml-auto flex items-center gap-3 text-2xs text-ink-soft" aria-label="Movement river legend">
                        <span class="flex items-center gap-1"><i class="h-1.5 w-3 rounded-full bg-info"></i>Every engineer</span>
                        <span class="flex items-center gap-1"><i class="h-1.5 w-3 rounded-full bg-primary"></i>Attention lens</span>
                        <span class="flex items-center gap-1"><i class="h-1.5 w-3 rounded-full bg-muted"></i>Team median</span>
                    </div>
                </div>
                <div id="atlas-river" class="mt-2 h-[300px]" aria-label="Employee score movement over time"></div>
            </div>

            <div class="rounded-xl border border-line bg-surface p-4">
                <div class="panel-head">
                    <h2 class="text-sm font-bold text-ink">Operational fingerprint</h2><small class="text-2xs text-muted">@FingerprintLabel</small>
                    <div class="ml-auto flex items-center gap-3 text-2xs text-ink-soft">
                        <span class="flex items-center gap-1"><i class="h-1.5 w-1.5 rounded-full bg-ink-soft"></i>Median</span>
                        <span class="flex items-center gap-1"><i class="h-1.5 w-3 rounded-full bg-line"></i>Middle 50%</span>
                        <span class="flex items-center gap-1"><i class="h-1.5 w-1.5 rounded-full bg-primary"></i>@(FocusItem is null ? "Team" : FocusItem.EmployeeName)</span>
                    </div>
                </div>
                <div class="mt-3 flex flex-col gap-3">
                    <div class="grid grid-cols-[6rem_1fr_4rem] gap-2 text-3xs font-semibold uppercase tracking-wide text-muted"><span>Dimension</span><span>Distribution / target</span><span class="text-right">Current</span></div>
                    @foreach (var metric in FingerprintMetrics)
                    {
                        <div class="grid grid-cols-[6rem_1fr_4rem] items-center gap-2">
                            <label class="text-xs font-medium text-ink-soft">@metric.Label</label>
                            <span class="relative block h-4" title="@metric.Tooltip">
                                <i class="absolute inset-y-1.5 rounded-full bg-line" style="@QuartileStyle(metric)"></i>
                                <i class="absolute inset-y-0 w-0.5 bg-ink-soft" style="@($"left:{CssPct(metric.Median)}")"></i>
                                <i class="absolute inset-y-0 w-0.5 border-l-2 border-dashed border-muted" style="@($"left:{CssPct(metric.Target)}")"></i>
                                <i class="absolute top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-surface bg-primary" style="@($"left:{CssPct(metric.Value)}")"></i>
                            </span>
                            <strong class="text-right text-xs font-semibold text-ink" title="Target: @metric.TargetLabel">@metric.Display</strong>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section aria-label="Peer rating relationships">
            @if (Peers.TotalFeedback == 0)
            {
                <div class="flex items-center justify-between gap-4 rounded-xl border border-line bg-surface p-5">
                    <div><strong class="text-sm font-semibold text-ink">No peer feedback for @State.SelectedMonth.ToString("MMMM yyyy")</strong><p class="mt-1 text-sm text-ink-soft">Upload completed review workbooks to reveal who rated whom and how the team experiences each colleague.</p></div>
                    <button type="button" class="shrink-0 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary/90" @onclick='() => Navigation.NavigateTo("/imports")'>Import peer reviews</button>
                </div>
            }
            else
            {
                <PeerRelationshipExplorer Reviews="State.PeerReviews" SelectedMonth="State.SelectedMonth" InitialFocusName="_focusName" ShowAtlasButton="true" />
            }
        </section>

        @if (Alerts.Count > 0)
        {
            <section class="rounded-xl border border-line bg-surface p-4" aria-label="Trend alerts">
                <div class="panel-head">
                    <h2 class="text-sm font-bold text-ink">Trend alerts</h2><small class="text-2xs text-muted">Score drops and missing evidence vs. last month</small>
                    <span class="ml-auto text-2xs text-muted">@Alerts.Count open · @Alerts.Count(x => x.Level == AlertLevel.Critical) critical</span>
                </div>
                <ul class="mt-3 flex flex-col divide-y divide-line">
                    @foreach (var alert in Alerts.Take(20))
                    {
                        <li class="py-1.5"><strong class="@($"text-sm font-semibold {Level(alert.Level)}")">@alert.EmployeeName — @alert.Headline</strong><small class="block text-2xs text-muted">@alert.Detail</small></li>
                    }
                </ul>
            </section>
        }
    }
</div>

@code {
    private static readonly string[] AtlasChartIds = ["pulse-attendance", "pulse-completion", "pulse-utilization", "atlas-field", "atlas-river"];
    private string? _focusName;
    private string? _renderedSignature;
    private bool _chartsPending;
    private bool _layoutLogged;
    private DotNetObjectReference<Overview>? _selfRef;
    private OperationalScoringSettings _settings = OperationalScoringSettings.Default;
    private IReadOnlyList<Anomaly> _alerts = [];
    private Analytics.PeerSummary? _peers;
    private Dictionary<string, decimal> _previousScores = new(StringComparer.OrdinalIgnoreCase);
    private List<DateTime> _heatmapMonths = [];
    private decimal _teamScore;
    private IReadOnlyList<AttentionRow> _attentionRows = [];

    [JSInvokable]
    public void DrilldownTo(string name) { Focus(name); StateHasChanged(); }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        _settings = await Database.GetOperationalScoringSettingsAsync();
        RecomputeDerived();
        CheckChartsPending();
    }

    private void OnStateChanged()
    {
        RecomputeDerived();
        CheckChartsPending();
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet() { RecomputeDerived(); CheckChartsPending(); }

    private void RecomputeDerived()
    {
        _previousScores = State.History
            .Where(x => x.Year == Previous.Year && x.Month == Previous.Month)
            .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(x => x.Key, x => x.First().OperationalScore, StringComparer.OrdinalIgnoreCase);
        _alerts = Analytics.Anomalies(State.Performance, _previousScores);
        _peers = Analytics.Peers(State.PeerReviews);
        _heatmapMonths = State.History.Select(x => new DateTime(x.Year, x.Month, 1)).Distinct().OrderBy(x => x).ToList();
        _teamScore = State.Performance.Count == 0 ? 0 : decimal.Round(State.Performance.Average(x => x.OperationalScore), 1);

        _attentionRows = State.Performance.Select(item =>
        {
            var delta = PreviousScores.TryGetValue(item.EmployeeName, out var prev) ? item.OperationalScore - prev : (decimal?)null;
            var employeeAlerts = Alerts.Where(x => PersonName.Matches(x.EmployeeName, item.EmployeeName)).ToArray();
            var alertWeight = employeeAlerts.Sum(x => x.Level == AlertLevel.Critical ? 14m : x.Level == AlertLevel.Serious ? 7m : 3m);
            var risk = (100m - item.OperationalScore) * .55m
                     + (delta is < 0 ? Math.Abs(delta.Value) * 1.6m : 0)
                     + ExceptionCount(item) * 2.2m
                     + Math.Min(50m, Math.Abs(item.ReconciliationVariance)) * .32m
                     + (!item.HasSummaryData ? 12m : 0)
                     + alertWeight;
            return new AttentionRow(item.EmployeeName, item.OperationalScore, delta, risk, item);
        }).OrderByDescending(x => x.Risk).ThenBy(x => x.Score).Take(5).ToArray();

        if (_focusName is not null && !State.Performance.Any(x => PersonName.Matches(x.EmployeeName, _focusName)))
            _focusName = null;
    }

    private void CheckChartsPending()
    {
        var signature = $"{State.Performance.Count}|{State.Performance.Sum(x => x.OperationalScore):0.0}|{State.History.Count}|{State.WeeklyPerformance.Count}|{State.PeerReviews.Count}|{State.PeerReviews.Sum(x => x.Average):0.00}|{State.SelectedMonth:yyyyMM}|{_focusName}|{_settings.Total:0.###}";
        if (signature != _renderedSignature) { _renderedSignature = signature; _chartsPending = true; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chartsPending || State.Performance.Count == 0) return;
        _chartsPending = false;
        _selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("epaEchartsLoader.ensureLoaded");
        await JS.InvokeVoidAsync("epaAtlas.registerDrilldown", _selfRef);
        await JS.InvokeVoidAsync("epaAtlas.sparkline", "pulse-attendance", AttendanceTrend, "attendance");
        await JS.InvokeVoidAsync("epaAtlas.sparkline", "pulse-completion", CompletionTrend, "timesheet");
        await JS.InvokeVoidAsync("epaAtlas.sparkline", "pulse-utilization", UtilizationCurrent, "operational");

        var previousRows = State.History
            .Where(x => x.Year == Previous.Year && x.Month == Previous.Month)
            .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);
        var fieldPoints = State.Performance.Select(x =>
        {
            previousRows.TryGetValue(x.EmployeeName, out var prev);
            var hasPrevious = prev is not null && prev.HasSummaryData && x.HasSummaryData;
            var showMovement = hasPrevious
                && (Math.Abs(x.PunchHours - prev!.PunchHours) >= 0.5m || Math.Abs(x.Utilization - prev.Utilization) >= 1m);
            return new
            {
                name = x.EmployeeName, x = (double)x.PunchHours, y = (double)x.Utilization,
                prevX = prev is null ? (double?)null : (double)prev.PunchHours,
                prevY = prev is null ? (double?)null : (double)prev.Utilization,
                hasPrevious,
                showMovement,
                score = (double)x.OperationalScore, exceptions = ExceptionCount(x), band = Analytics.ScoreBand(x.OperationalScore), missing = !x.HasSummaryData
            };
        }).ToArray();
        var focusedPreviousHours = FocusedMovement?.PreviousHours ?? 0m;
        // Fixed across the loaded fiscal-year-to-date rather than recomputed from just the current
        // month: a person's horizontal position then means the same thing when you switch reporting
        // months, so movement across months actually reads as movement instead of the ruler itself
        // stretching or shrinking. It only grows if a later month's hours exceed everything seen so
        // far — it never shrinks back down as you page through history.
        var historyMaxHours = State.History.Count > 0 ? State.History.Max(x => x.PunchHours)
            : State.Performance.Count > 0 ? State.Performance.Max(x => x.PunchHours) : 0m;
        var fieldMax = Math.Max(60m, Math.Max(historyMaxHours, focusedPreviousHours) * 1.14m);
        // Same reasoning as fieldMax: the BALANCED/INCONSISTENT divider line must also be fixed
        // across months, not recomputed from the current month's median alone — otherwise the
        // quadrant boundary itself moves under a person from month to month, and a shift from one
        // zone to another stops meaning their behavior actually changed.
        var fieldMedian = State.History.Count > 0 ? Median(State.History.Select(x => x.PunchHours)) : Median(State.Performance.Select(x => x.PunchHours));
        await JS.InvokeVoidAsync("epaAtlas.performanceField", "atlas-field", fieldPoints, (double)fieldMax, (double)Analytics.UtilizationTarget, (double)fieldMedian, _focusName);

        var attentionNames = AttentionRows.Select(x => x.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var riverSeries = State.Performance.Select((item, index) => new
        {
            name = item.EmployeeName, attention = attentionNames.Contains(item.EmployeeName),
            role = (index % 4) switch { 0 => "operational", 1 => "attendance", 2 => "timesheet", _ => "approval" },
            values = HeatmapMonths.Select(month => ScoreFor(item.EmployeeName, month)).ToArray()
        }).ToArray();
        var riverMedian = HeatmapMonths.Select(month => Median(State.History.Where(x => x.Year == month.Year && x.Month == month.Month).Select(x => x.OperationalScore))).ToArray();
        await JS.InvokeVoidAsync("epaAtlas.movementRiver", "atlas-river", HeatmapMonths.Select(x => x.ToString("MMM yy")).ToArray(), riverSeries, riverMedian, _focusName);

        if (!_layoutLogged)
        {
            _layoutLogged = true;
            var layout = await JS.InvokeAsync<string>("epaAtlas.measureOverview");
            InteractionLog.Write("overview.layout", layout);
        }
    }

