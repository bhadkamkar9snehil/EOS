@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Analytics dashboard. Every figure is derived from imported ERP rows; nothing is illustrative.
   Charts render through ECharts (wwwroot/charts.js) via JS interop; this component owns the
   container ids and re-invokes JS whenever the underlying data changes. *@

<div class="overview">
    @if (Items.Count == 0)
    {
        <div class="empty-state">
            <h2>No performance data for @Month.ToString("MMMM yyyy")</h2>
            <p>Import the three ERP exports for this month and every panel below is calculated immediately. Exports are generated after month end, so check the reporting month above before importing.</p>
            <button class="action" @onclick='() => OnNavigate.InvokeAsync("imports")'>Go to data imports</button>
        </div>
    }
    else
    {
        <div class="spotlight-search">
            <span class="spotlight-icon">◎</span>
            <input @bind="_query" @bind:event="oninput" @onkeydown="OnSearchKeyDown" placeholder="Spotlight an engineer — type a name…" />
            @if (!string.IsNullOrWhiteSpace(_query) && SearchMatches.Count > 0)
            {
                <ul class="spotlight-suggestions">
                    @foreach (var match in SearchMatches)
                    {
                        <li @onclick="() => Spotlight(match.EmployeeName)"><b class="@Analytics.ScoreBand(match.OperationalScore)">@Analytics.Format(match.OperationalScore)</b> @match.EmployeeName</li>
                    }
                </ul>
            }
        </div>

        <div class="kpi-row">
            @Kpi("Team operational score", Analytics.Format(TeamScore), "accent", TeamScoreDelta, "vs " + Previous.ToString("MMM"))
            @Kpi("Timesheet completion", Analytics.Format(Average(x => x.TimesheetCompletionScore, true)) + "%", "blue", null, MeasuredLabel)
            @Kpi("Attendance discipline", Analytics.Format(Average(x => x.AttendanceDisciplineScore)) + "%", "aqua", null, "Fill, punches, duration, punctuality")
            @Kpi("Average utilization", Analytics.Format(Average(x => x.Utilization, true)) + "%", "violet", null, "Entered vs compliance hours")
            @Kpi("Engineers in analysis", Items.Count.ToString(), "slate", null, ExcludedLabel)
            @Kpi("Open alerts", Alerts.Count.ToString(), Alerts.Any(x => x.Level == AlertLevel.Critical) ? "critical" : "warning", null, CriticalLabel)
        </div>

        <div class="overview-grid">

            <section class="card">
                <div class="card-head"><h2>Score distribution</h2><small>@Items.Count engineers</small></div>
                <div class="distribution">
                    @foreach (var band in Bands)
                    {
                        var count = BandCount(band);
                        @if (count > 0)
                        {
                            <div class="band @band" style="flex:@count" title="@Analytics.ScoreBandLabel(band): @count"><span>@count</span></div>
                        }
                    }
                </div>
                <ul class="legend">
                    @foreach (var band in Bands)
                    {
                        <li><i class="@band"></i>@Analytics.ScoreBandLabel(band)<b>@BandCount(band)</b></li>
                    }
                </ul>
                <h3 class="sub-head">Attendance exceptions</h3>
                <div class="exception-row">
                    @Exception("Missing punch", Items.Sum(x => x.MissingPunchDays))
                    @Exception("Late arrival", Items.Sum(x => x.LateDays))
                    @Exception("Early going", Items.Sum(x => x.EarlyDays))
                    @Exception("Short duration", Items.Sum(x => x.LessDurationDays))
                </div>
            </section>

            <section class="card">
                <div class="card-head"><h2>Workload &amp; utilization</h2><small>Daily punch hours vs capacity used</small></div>
                <div id="chart-scatter" class="echart tall"></div>
            </section>

            <section class="card">
                <div class="card-head"><h2>Category performance</h2><small>Operational dimensions</small></div>
                <div id="chart-radar" class="echart"></div>
                <ul class="chart-legend">
                    <li><i style="background:#2a78d6"></i>Team average</li>
                    <li><i style="background:#eb6834"></i>Top quartile</li>
                    <li><i style="background:#1baf7a"></i>Bottom quartile</li>
                </ul>
            </section>

            <section class="card">
                <div class="card-head"><h2>Top quartile</h2><small>Operational score</small></div>
                @QuartileList(Analytics.Quartile(Items, PreviousScores, true))
            </section>

            <section class="card">
                <div class="card-head"><h2>Needs attention</h2><small>Lowest operational score</small></div>
                @QuartileList(Analytics.Quartile(Items, PreviousScores, false))
            </section>

            <section class="card">
                <div class="card-head"><h2>Peer review</h2><small>@(Peers.TotalFeedback > 0 ? $"{Month:MMMM yyyy}" : "Not yet collected")</small></div>
                @if (Peers.TotalFeedback == 0)
                {
                    <div class="locked">
                        <strong>No peer feedback for this month</strong>
                        <p>Generate review workbooks on the Templates screen. Each one carries a <em>Peer Review</em> sheet listing the whole team, where the engineer rates the colleagues they worked with on collaboration, communication, reliability and technical help.</p>
                        <p>Upload the completed workbooks — or a ZIP of them — into the <em>Engineer reviews</em> input on Data imports, and this card fills in.</p>
                        <button class="action secondary" @onclick='() => OnNavigate.InvokeAsync("templates")'>Generate templates</button>
                    </div>
                }
                else
                {
                    <div class="mini-tiles">
                        <div><strong>@Peers.TotalFeedback</strong><span>Feedback entries</span></div>
                        <div><strong>@Peers.UniqueReviewers</strong><span>Reviewers</span></div>
                        <div><strong>@Analytics.Format(Peers.AverageRating, "0.00")</strong><span>Average rating</span></div>
                    </div>
                    <p class="chart-note">@Analytics.Format(Peers.FeedbackPerReviewer) entries per reviewer across @Peers.PeopleReviewed people.</p>
                    <ol class="rank-list">
                        @foreach (var standing in Peers.Standings.Take(5))
                        {
                            <li @onclick="() => Spotlight(standing.Name)" class="clickable" title="View profile">
                                <span class="avatar">@Initials(standing.Name)</span>
                                <span class="rank-name">@standing.Name<small>@standing.ReviewsReceived received · @standing.ReviewsGiven given</small></span>
                                <b class="@(standing.Average >= 4 ? "good" : standing.Average >= 3 ? "warning" : "serious")">@Analytics.Format(standing.Average, "0.00")</b>
                            </li>
                        }
                    </ol>
                }
            </section>

            @if (Peers.TotalFeedback > 0)
            {
                <section class="card wide">
                    <div class="card-head"><h2>Peer review network</h2><button class="link" @onclick='() => OnNavigate.InvokeAsync("peer-insights")'>Open Peer Insights →</button></div>
                    <div class="network-layout">
                        <div id="chart-network" class="echart network-small"></div>
                        <div class="network-stats">
                            @NetworkStat("◆", "Total feedback", Peers.TotalFeedback.ToString(), null)
                            @NetworkStat("◎", "Unique reviewers", Peers.UniqueReviewers.ToString(), null)
                            @NetworkStat("▤", "Avg feedback / person", Analytics.Format(Peers.FeedbackPerReviewer), null)
                            @NetworkStat("⚙", "Engagement", Analytics.Format(Peers.EngagementScore) + " / 10", "warn")
                            @if (Peers.MostLiked is not null)
                            {
                                <div class="network-highlight"><small>Most liked</small><strong>@Peers.MostLiked.Name — @Analytics.Format(Peers.MostLiked.Average, "0.00")</strong></div>
                            }
                            @if (Peers.MostCollaborative is not null)
                            {
                                <div class="network-highlight"><small>Most collaborative</small><strong>@Peers.MostCollaborative.Name — @Peers.MostCollaborative.ReviewsGiven given</strong></div>
                            }
                        </div>
                    </div>
                    <p class="chart-note">Drag nodes to untangle. Node size reflects total feedback given plus received; the largest node is this month's most exchanged-with engineer. Click a node to open that engineer's profile. Engagement is actual feedback links against a full round-robin ceiling (everyone rating everyone), scaled to 10.</p>
                </section>
            }

            <section class="card">
                <div class="card-head"><h2>Attendance vs timesheet</h2><small>Reconciliation</small></div>
                <div class="mini-tiles">
                    <div><strong>@Analytics.Format(TimesheetFillRate)%</strong><span>Days with a timesheet</span></div>
                    <div><strong>@Analytics.Format(TotalPunchHours, "0")</strong><span>Punch hours</span></div>
                    <div><strong>@Analytics.Format(TotalBookedHours, "0")</strong><span>Booked hours</span></div>
                </div>
                <p class="chart-note">Largest gaps between hours at the gate and hours on the timesheet. Click a bar to open that engineer's profile.</p>
                @if (VarianceRows.Count == 0)
                {
                    <p class="chart-note">Punch and timesheet hours agree within an hour for everyone.</p>
                }
                else
                {
                    <div id="chart-variance" class="echart short"></div>
                }
            </section>

            @if (HeatmapMonths.Count >= 2)
            {
                <section class="card wide">
                    <div class="card-head"><h2>Performance score heatmap</h2><small>@HeatmapMonths.Count months</small></div>
                    <div id="chart-heatmap" class="echart heatmap-chart" style="height:@(40 + HeatmapNames.Length * 30)px"></div>
                    <p class="chart-note">Click a cell to open that engineer's profile.</p>
                </section>

                <section class="card wide">
                    <div class="card-head"><h2>Team score trend &amp; forecast</h2><small>Monthly average with next-month projection</small></div>
                    <div id="chart-trend" class="echart"></div>
                </section>
            }
            else
            {
                <section class="card wide subtle">
                    <div class="card-head"><h2>Heatmap, trend &amp; forecast</h2><small>Needs two months</small></div>
                    <p class="chart-note">Only @Month.ToString("MMMM yyyy") has been imported. Import another month's exports and the month-over-month heatmap, trend line and forecast appear here automatically.</p>
                </section>
            }

            <section class="card wide">
                <div class="card-head"><h2>Alerts</h2><small>@Alerts.Count derived from this month's exports</small></div>
                @if (Alerts.Count == 0)
                {
                    <p class="chart-note">No rule fired against this month's figures.</p>
                }
                else
                {
                    <div class="alert-list">
                        @foreach (var alert in Alerts.Take(12))
                        {
                            <div class="alert @Level(alert.Level) clickable" @onclick="() => Spotlight(alert.EmployeeName)">
                                <span class="alert-chip">@LevelIcon(alert.Level) @Level(alert.Level)</span>
                                <span class="alert-body"><strong>@alert.EmployeeName — @alert.Headline</strong><small>@alert.Detail</small></span>
                            </div>
                        }
                    </div>
                    @if (Alerts.Count > 12)
                    {
                        <p class="chart-note">@(Alerts.Count - 12) more not shown.</p>
                    }
                }
            </section>

            <section class="card wide">
                <div class="card-head"><h2>Engineer performance</h2><button class="link" @onclick='() => OnNavigate.InvokeAsync("employees")'>Manage employees</button></div>
                <div class="performance-table">
                    <div class="performance-head">
                        <span>Engineer</span><span>Score</span><span>Timesheet</span><span>Approval</span>
                        <span>Attendance</span><span>Workload</span><span>Billable</span><span>Entries</span><span>Projects</span>
                    </div>
                    @foreach (var item in Items.OrderByDescending(x => x.OperationalScore))
                    {
                        <div class="performance-row clickable" @onclick="() => Spotlight(item.EmployeeName)" title="View profile">
                            <strong>@item.EmployeeName</strong>
                            <span class="score-cell">
                                <b class="@Analytics.ScoreBand(item.OperationalScore)">@Analytics.Format(item.OperationalScore)</b>
                                <i class="score-bar @Analytics.ScoreBand(item.OperationalScore)" style="width:@Analytics.Svg((double)item.OperationalScore * 0.42)px"></i>
                            </span>
                            <span>@(item.HasSummaryData ? Analytics.Format(item.TimesheetCompletionScore, "0") + "%" : NoData)</span>
                            <span>@(item.HasSummaryData ? Analytics.Format(item.ApprovalScore, "0") + "%" : NoData)</span>
                            <span>@Analytics.Format(item.AttendanceDisciplineScore, "0")%</span>
                            <span>@Analytics.Format(item.Workload(), "0.0") h/d</span>
                            <span>@Analytics.Format(item.BillableHours, "0.0") h</span>
                            <span>@item.DetailedEntries</span>
                            <span>@item.UniqueProjects</span>
                        </div>
                    }
                </div>
                @if (Items.Any(x => !x.HasSummaryData))
                {
                    <p class="chart-note">@NoData means the engineer is not in the monthly utilization export, so timesheet and approval have no source. Their score is weighted on attendance alone rather than counted as zero.</p>
                }
            </section>
        </div>
    }
</div>

@if (_spotlightName is not null)
{
    <EmployeeSpotlight @key="_spotlightName" Name="@_spotlightName" Month="Month"
                        Item="SpotlightItem" TeamRadar="Analytics.Radar(Items)"
                        TrendMonths="HeatmapMonths" TrendValues="SpotlightTrend"
                        Peer="Analytics.PeerBreakdownFor(PeerReviews, _spotlightName)"
                        Alerts="Alerts.Where(x => PersonName.Matches(x.EmployeeName, _spotlightName)).ToArray()"
                        OnClose="() => _spotlightName = null" />
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MonthlyPerformanceItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<MonthlyPerformanceItem> History { get; set; } = [];
    [Parameter, EditorRequired] public DateTime Month { get; set; }
    [Parameter] public IReadOnlyList<PeerReviewItem> PeerReviews { get; set; } = [];
    [Parameter] public int ExcludedCount { get; set; }
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    private const string NoData = "—";
    private static readonly string[] Bands = ["good", "warning", "serious", "critical"];
    private static readonly string[] ChartIds = ["chart-scatter", "chart-radar", "chart-trend", "chart-heatmap", "chart-variance", "chart-network"];

    private string? _spotlightName;
    private string _query = string.Empty;
    private string? _renderedSignature;
    private DotNetObjectReference<Overview>? _selfRef;

    /// <summary>Called from charts.js when a chart point that names an employee is clicked.</summary>
    [JSInvokable]
    public void DrilldownTo(string name) => Spotlight(name);

    private DateTime Previous => Month.AddMonths(-1);
    private IReadOnlyList<Anomaly> Alerts => Analytics.Anomalies(Items, PreviousScores);
    private Analytics.PeerSummary Peers => Analytics.Peers(PeerReviews);

    private Dictionary<string, decimal> PreviousScores => History
        .Where(x => x.Year == Previous.Year && x.Month == Previous.Month)
        .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(x => x.Key, x => x.First().OperationalScore, StringComparer.OrdinalIgnoreCase);

    private List<DateTime> HeatmapMonths => History
        .Select(x => new DateTime(x.Year, x.Month, 1)).Distinct().OrderBy(x => x).TakeLast(6).ToList();

    private string[] HeatmapNames => History.Select(x => x.EmployeeName).Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToArray();

    private decimal TeamScore => Items.Count == 0 ? 0 : decimal.Round(Items.Average(x => x.OperationalScore), 1);

    private IReadOnlyList<decimal> TrendSeries => HeatmapMonths
        .Select(m => History.Where(x => x.Year == m.Year && x.Month == m.Month)
            .Select(x => x.OperationalScore).DefaultIfEmpty(0).Average())
        .ToArray();

    private decimal? TeamScoreDelta
    {
        get
        {
            var previous = PreviousScores.Values;
            if (previous.Count == 0) return null;
            return decimal.Round(TeamScore - previous.Average(), 1);
        }
    }

    private MonthlyPerformanceItem? SpotlightItem => _spotlightName is null
        ? null : Items.FirstOrDefault(x => PersonName.Matches(x.EmployeeName, _spotlightName));

    private IReadOnlyList<decimal> SpotlightTrend => _spotlightName is null
        ? []
        : HeatmapMonths.Select(m => History
            .Where(x => x.Year == m.Year && x.Month == m.Month && PersonName.Matches(x.EmployeeName, _spotlightName))
            .Select(x => x.OperationalScore).DefaultIfEmpty(0).First()).ToArray();

    private IReadOnlyList<MonthlyPerformanceItem> SearchMatches => string.IsNullOrWhiteSpace(_query)
        ? []
        : Items.Where(x => x.EmployeeName.Contains(_query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.OperationalScore).Take(6).ToArray();

    private decimal Average(Func<MonthlyPerformanceItem, decimal> selector, bool summaryOnly = false)
    {
        var scope = summaryOnly ? Items.Where(x => x.HasSummaryData).ToArray() : Items.ToArray();
        return scope.Length == 0 ? 0 : decimal.Round(scope.Average(selector), 1);
    }

    private string MeasuredLabel => Items.Count(x => x.HasSummaryData) == Items.Count
        ? "Entered vs compliance hours"
        : $"{Items.Count(x => x.HasSummaryData)} of {Items.Count} in the utilization export";
    private string ExcludedLabel => ExcludedCount == 0 ? "All imported engineers" : $"{ExcludedCount} excluded by configuration";
    private string CriticalLabel => Alerts.Count(x => x.Level == AlertLevel.Critical) is var c && c > 0 ? $"{c} critical" : "None critical";

    private decimal TimesheetFillRate => Items.Sum(x => x.ExpectedTimesheetDays) == 0
        ? 0 : decimal.Round(Items.Sum(x => x.TimesheetFilledDays) * 100m / Items.Sum(x => x.ExpectedTimesheetDays), 1);
    private decimal TotalPunchHours => Items.Sum(x => x.PunchHours);
    private decimal TotalBookedHours => Items.Sum(x => x.AttendanceTimesheetHours);

    private IReadOnlyList<MonthlyPerformanceItem> VarianceRows => Items
        .Where(x => Math.Abs(x.ReconciliationVariance) >= 1)
        .OrderByDescending(x => Math.Abs(x.ReconciliationVariance)).Take(5).ToArray();

    private int BandCount(string band) => Items.Count(x => Analytics.ScoreBand(x.OperationalScore) == band);
    private static string Level(AlertLevel level) => level switch { AlertLevel.Critical => "critical", AlertLevel.Serious => "serious", _ => "warning" };
    private static string LevelIcon(AlertLevel level) => level switch { AlertLevel.Critical => "▲", AlertLevel.Serious => "◆", _ => "●" };

    private void Spotlight(string name) { _spotlightName = PersonName.Normalize(name); _query = string.Empty; }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && SearchMatches.Count > 0) Spotlight(SearchMatches[0].EmployeeName);
        else if (e.Key == "Escape") _query = string.Empty;
    }

    protected override void OnParametersSet()
    {
        var signature = $"{Items.Count}|{Items.Sum(x => x.OperationalScore):0.0}|{History.Count}|{PeerReviews.Count}|{Month:yyyyMM}";
        if (signature != _renderedSignature) { _renderedSignature = signature; _chartsPending = true; }
    }

    private bool _chartsPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chartsPending || Items.Count == 0) return;
        _chartsPending = false;
        await RenderChartsAsync();
    }

    private async Task RenderChartsAsync()
    {
        if (_selfRef is null)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("epaCharts.registerDrilldown", _selfRef);
        }

        var points = Items.Select(x => new
        {
            x = (double)x.Workload(),
            y = (double)x.Utilization,
            band = x.WorkloadBand(),
            name = x.EmployeeName,
            tooltip = $"{x.EmployeeName} — {Analytics.Format(x.Utilization)}% utilization, {Analytics.Format(x.Workload())} h/day"
        }).ToArray();
        await JS.InvokeVoidAsync("epaCharts.scatter", "chart-scatter", points, (double)Analytics.WorkloadCeiling, (double)Analytics.UtilizationTarget);

        var axes = Analytics.Radar(Items);
        await JS.InvokeVoidAsync("epaCharts.radar", "chart-radar", axes.Select(a => a.Label).ToArray(), 100,
            new object[]
            {
                new { name = "Team average", color = "#2a78d6", values = axes.Select(a => a.TeamAverage).ToArray() },
                new { name = "Top quartile", color = "#eb6834", values = axes.Select(a => a.TopQuartile).ToArray() },
                new { name = "Bottom quartile", color = "#1baf7a", values = axes.Select(a => a.BottomQuartile).ToArray() }
            });

        if (VarianceRows.Count > 0)
        {
            var names = VarianceRows.Select(x => x.EmployeeName).ToArray();
            var values = VarianceRows.Select(x => (double)Math.Abs(x.ReconciliationVariance)).ToArray();
            var colors = VarianceRows.Select(x => x.ReconciliationVariance > 0 ? "#eb6834" : "#2a78d6").ToArray();
            await JS.InvokeVoidAsync("epaCharts.bars", "chart-variance", names, values, colors, (object?)null, " h", true);
        }

        if (HeatmapMonths.Count >= 2)
        {
            var months = HeatmapMonths;
            var names = HeatmapNames;
            var lookup = History.ToLookup(x => (x.EmployeeName.ToLowerInvariant(), x.Year, x.Month));
            var cells = new List<object>();
            for (var yi = 0; yi < names.Length; yi++)
                for (var xi = 0; xi < months.Count; xi++)
                {
                    var cell = lookup[(names[yi].ToLowerInvariant(), months[xi].Year, months[xi].Month)].FirstOrDefault();
                    var tooltip = cell is null
                        ? $"{names[yi]} — no data for {months[xi]:MMMM yyyy}"
                        : $"{names[yi]} — {months[xi]:MMMM yyyy}: {Analytics.Format(cell.OperationalScore)}";
                    cells.Add(new { x = xi, y = yi, value = cell?.OperationalScore ?? 0m, tooltip });
                }
            await JS.InvokeVoidAsync("epaCharts.heatmap", "chart-heatmap", months.Select(m => m.ToString("MMM yy")).ToArray(), names, cells, true);

            var forecast = Analytics.Forecast(TrendSeries);
            await JS.InvokeVoidAsync("epaCharts.trend", "chart-trend", months.Select(m => m.ToString("MMM yy")).ToArray(), TrendSeries, forecast);
        }

        if (Peers.TotalFeedback > 0)
        {
            var graph = Analytics.Network(PeerReviews);
            await JS.InvokeVoidAsync("epaCharts.network", "chart-network",
                graph.Nodes.Select(n => new { name = n.Name, received = n.Received, given = n.Given, tooltip = n.Tooltip, initials = Analytics.Initials(n.Name) }).ToArray(),
                graph.Links.Select(l => new { source = l.Source, target = l.Target, value = l.Value, tooltip = l.Tooltip }).ToArray(),
                graph.HubName);
        }
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var id in ChartIds)
        {
            try { await JS.InvokeVoidAsync("epaCharts.dispose", id); } catch (JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }

    private RenderFragment Kpi(string label, string value, string tone, decimal? delta, string hint) => @<div class="kpi @tone">
        <span class="kpi-label">@label</span>
        <strong>@value</strong>
        <small>
            @if (delta is not null && delta != 0)
            {
                <b class="@(delta > 0 ? "up" : "down")">@(delta > 0 ? "▲" : "▼") @Analytics.Format(Math.Abs(delta.Value))</b>
            }
            @hint
        </small>
    </div>;

    private RenderFragment NetworkStat(string icon, string label, string value, string? tone) => @<div class="network-stat @(tone is null ? null : $"tone-{tone}")">
        <i>@icon</i>
        <div><strong>@value</strong><span>@label</span></div>
    </div>;

    private RenderFragment Exception(string label, int count) => @<div class="exception @(count > 0 ? "hot" : null)"><strong>@count</strong><span>@label</span></div>;

    private RenderFragment QuartileList(IReadOnlyList<QuartileRow> rows) => @<ol class="rank-list">
        @foreach (var row in rows)
        {
            <li @onclick="() => Spotlight(row.EmployeeName)" class="clickable" title="View profile">
                <span class="avatar">@Initials(row.EmployeeName)</span>
                <span class="rank-name">@row.EmployeeName
                    @if (row.Delta is not null)
                    {
                        <small><b class="@(row.Delta > 0 ? "up" : row.Delta < 0 ? "down" : null)">@(row.Delta > 0 ? "▲" : row.Delta < 0 ? "▼" : "•") @Analytics.Format(Math.Abs(row.Delta.Value)) vs @Previous.ToString("MMM")</b></small>
                    }
                </span>
                <b class="@Analytics.ScoreBand(row.Score)">@Analytics.Format(row.Score)</b>
            </li>
        }
    </ol>;

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
}
