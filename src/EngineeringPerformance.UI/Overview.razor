@page "/"
@page "/overview"
@using System.Globalization
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@using Microsoft.Extensions.Logging
@inject IJSRuntime JS
@inject IApplicationDatabase Database
@inject AppState State
@inject NavigationManager Navigation
@inject ILogger<Overview> Logger
@implements IAsyncDisposable

<div class="flex flex-col gap-6">
    @if (State.Performance.Count == 0)
    {
        @* An empty state is literally an empty slot in the instrument — a machined
           bay with nothing seated in it. *@
        <div class="plate empty-bay">
            <div class="panel-eyebrow">No evidence loaded</div>
            <h2 class="panel-title">No performance data for @State.SelectedMonth.ToString("MMMM yyyy")</h2>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/imports")'>Go to data imports</button>
        </div>
    }
    else
    {
        @* One plate carrying several instruments separated by hairlines, rather than
           four independent cards floating side by side. *@
        <div class="adaptive-strip-shell">
        <section class="plate adaptive-strip" aria-label="Team pulse">
            <article class="adaptive-module pulse-module">
                <div class="panel-eyebrow">Team pulse</div>
                @* Number first, then its delta, then the descriptor — the metric is the
                   object being read, not a footnote to a label. *@
                <div class="pulse-reading">
                    <strong class="metric text-metric engraved">@Analytics.Format(TeamScore, "0")</strong>
                    @if (PreviousTeamScore is not null)
                    {
                        var pulseDelta = decimal.Round(TeamScore - PreviousTeamScore.Value, 0);
                        <span class="@($"pulse-delta metric-delta {(pulseDelta > 0 ? "text-good" : pulseDelta < 0 ? "text-critical" : "text-muted")}")" title="Change from @Previous.ToString("MMMM yyyy")">
                            @(pulseDelta > 0 ? "↑" : pulseDelta < 0 ? "↓" : "→") @Analytics.Format(Math.Abs(pulseDelta), "0")
                        </span>
                    }
                </div>
                <div class="label-instrument pulse-label">Overall score</div>
                <div class="adaptive-secondary pulse-comparison">vs @Previous.ToString("MMM yyyy") · @(PreviousTeamScore is null ? "—" : Analytics.Format(PreviousTeamScore.Value, "0"))</div>
            </article>

            <article class="adaptive-module distribution-module">
                <h2 class="label-instrument">Score distribution · people</h2>
                <div class="distribution-detail" role="group" aria-label="@DistributionSummary">
                    @foreach (var band in ScoreBands)
                    {
                        var members = BandMembers(band);
                        @* Each band is a calibrated channel with the people seated in it as
                           lamps. The channel is recessed; the lamps sit proud of it. *@
                        <section class="distribution-band">
                            <div class="distribution-band-heading">
                                <strong class="@($"metric text-metric-sm {Analytics.BandTextClass(band.CssClass)}")">@members.Count</strong>
                                <span class="@($"distribution-range {Analytics.BandTextClass(band.CssClass)}")">@band.Label</span>
                                <span class="adaptive-secondary distribution-share"><span class="tabular-nums">@BandShare(members.Count)%</span> of team</span>
                            </div>
                            <div class="track distribution-track" aria-label="@members.Count people scoring @band.Label">
                                @for (var i = 0; i < members.Count; i++)
                                {
                                    var member = members[i];
                                    <button type="button"
                                            class="@($"lamp distribution-dot {Analytics.BandTextClass(band.CssClass)} {(IsFocused(member.EmployeeName) ? "ring-2 ring-primary ring-offset-1 ring-offset-well scale-125" : "")}")"
                                            style="@BandDotStyle(members, band, i)"
                                            title="@member.EmployeeName · @Analytics.Format(member.OperationalScore)"
                                            aria-label="@member.EmployeeName score @Analytics.Format(member.OperationalScore)"
                                            @onclick="() => Focus(member.EmployeeName)"></button>
                                }
                            </div>
                        </section>
                    }
                </div>
                <div class="distribution-summary" role="img" aria-label="@DistributionSummary">
                    <div class="distribution-stack" aria-hidden="true">
                        @foreach (var band in ScoreBands)
                        {
                            var count = BandMembers(band).Count;
                            <i class="@($"distribution-segment distribution-segment-{band.CssClass}")" style="@BandWidthStyle(count)"></i>
                        }
                    </div>
                    <div class="distribution-legend">
                        @foreach (var band in ScoreBands)
                        {
                            var count = BandMembers(band).Count;
                            <span><i class="@($"lamp {Analytics.BandTextClass(band.CssClass)}")"></i><b class="metric">@count</b><small>@band.Label</small></span>
                        }
                    </div>
                </div>
            </article>

            <article class="adaptive-module trends-module">
                <h2 class="label-instrument">Key trends · 30 days</h2>
                <div class="trend-grid">
                    <div class="well trend-card">
                        <div class="trend-heading"><label class="label-instrument">Attendance</label><span class="trend-period">@TrendCoverage(AttendanceTrend, "weeks")</span></div>
                        <div class="trend-reading"><strong class="metric text-metric-sm">@Analytics.Format(Average(x => x.AttendanceDisciplineScore), "0")%</strong><span class="trend-context">@TrendChange(AttendanceTrend)</span></div>
                        <div id="pulse-attendance" class="trend-spark"></div>
                    </div>
                    <div class="well trend-card">
                        <div class="trend-heading"><label class="label-instrument">Completion</label><span class="trend-period">@TrendCoverage(CompletionTrend, "weeks")</span></div>
                        <div class="trend-reading"><strong class="metric text-metric-sm">@Analytics.Format(Average(x => x.TimesheetCompletionScore, true), "0")%</strong><span class="trend-context">@TrendChange(CompletionTrend)</span></div>
                        <div id="pulse-completion" class="trend-spark"></div>
                    </div>
                    <div class="well trend-card">
                        <div class="trend-heading"><label class="label-instrument">Utilization</label><span class="trend-period">Monthly</span></div>
                        <div class="trend-reading"><strong class="metric text-metric-sm">@Analytics.Format(Average(x => x.Utilization, true), "0")%</strong><small class="trend-context">Current</small></div>
                        <div class="track utilization-meter" aria-label="Utilization @Analytics.Format(Average(x => x.Utilization, true), "0") percent; target @Analytics.Format(Analytics.UtilizationTarget, "0") percent">
                            <i class="utilization-value" style="@UtilizationWidthStyle"></i>
                            <i class="utilization-target" style="@UtilizationTargetStyle"></i>
                        </div>
                    </div>
                </div>
            </article>

            <article class="adaptive-module readiness-module">
                <h2 class="label-instrument">Data readiness</h2>
                <div class="readiness-detail">
                    @ReadinessLight("Timesheets", IsReady(ReportType.MonthlyTimesheetSummary))
                    @ReadinessLight("Imports", IsReady(ReportType.DetailedTimesheetTransactions))
                    @ReadinessLight("Mappings", IsReady(ReportType.AttendanceLeaveUaaTimesheet))
                    @ReadinessLight("Coverage", State.ReviewsUploaded, true)
                </div>
                <div class="readiness-summary" aria-label="@ReadinessSummary">
                    <strong class="metric text-metric-sm">@ReadinessReadyCount<span class="text-muted">/4</span></strong>
                    <span class="adaptive-secondary">ready</span>
                    <span class="readiness-lamps" aria-hidden="true">@foreach (var ready in ReadinessStates) { <i class="@(ready ? "lamp text-good" : "lamp-off")"></i> }</span>
                </div>
            </article>

            <article class="adaptive-module alerts-module">
                <h2 class="label-instrument">Alert pressure</h2>
                <div class="alert-reading">
                    <strong class="@($"metric text-metric-sm {AlertPressureTextClass}")">@AlertPressureLabel</strong>
                    <span class="alert-critical"><b class="metric">@CriticalAlertCount</b> critical</span>
                    <div class="track alert-meter" role="img" aria-label="@Alerts.Count open alerts, @CriticalAlertCount critical">
                        <i class="alert-open-segment" style="@NonCriticalAlertWidthStyle"></i>
                        <i class="alert-critical-segment" style="@CriticalAlertWidthStyle"></i>
                    </div>
                    <small class="adaptive-secondary alert-open-count">@Alerts.Count open</small>
                </div>
            </article>
        </section>
        </div>

        @* The aside is widened to 400px: the Attention Lens carries a per-person
           fingerprint and rhythm strip, and at 360px the name column was being
           squeezed to a couple of characters. *@
        <section class="grid grid-cols-1 gap-4 @@4xl:grid-cols-[minmax(0,1fr)_minmax(22rem,34rem)]">
            @* flex flex-col + the well below as flex-1: the grid row stretches this card to
               match Attention Lens's height (5 rows of people), and a fixed chart-bay height
               left that extra height as dead space under the chart instead of the chart
               actually using it - same fix already applied to Operational Fingerprint. *@
            <div class="plate p-4 flex flex-col">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <div class="panel-eyebrow">Distribution</div>
                        <h2 class="panel-title">Workforce performance field</h2>
                    </div>
                    <div class="flex items-center gap-2">
                        @if (FocusedMovement is not null)
                        {
                            <span class="flex items-center gap-2 rounded-full border border-line bg-surface-inset px-3 py-1.5 text-xs" title="@FocusedMovement.Tooltip">
                                <span class="flex flex-col leading-tight"><small class="text-3xs text-muted">Movement</small><b class="text-ink">@Previous.ToString("MMM") → @State.SelectedMonth.ToString("MMM")</b></span>
                                <strong class="@(FocusedMovement.DirectionClass == "movement-up" ? "text-good" : FocusedMovement.DirectionClass == "movement-down" ? "text-critical" : "text-muted")">@FocusedMovement.DeltaLabel</strong>
                            </span>
                        }
                        @if (FocusItem is not null)
                        {
                            <span class="flex items-center gap-2 rounded-full border border-primary-soft bg-primary-soft px-3 py-1.5 text-xs" aria-label="Focused engineer controls">
                                <button type="button" class="font-medium text-ink-soft underline-offset-2 hover:underline" title="Return to the whole-team view" @onclick="ClearFocus">Team view</button>
                                <b class="text-primary">@FocusItem.EmployeeName</b>
                                <button type="button" class="font-medium text-primary hover:underline" title="Open @FocusItem.EmployeeName performance portrait" @onclick="OpenFocusedPortrait">Open portrait <span aria-hidden="true">↗</span></button>
                            </span>
                        }
                        else
                        {
                            <span class="rounded-full border border-line bg-surface-inset px-3 py-1.5 text-xs"><b class="text-ink">Team view</b></span>
                        }
                    </div>
                </div>
                @* The chart is a cavity machined into the plate, not another card on it.
                   The axis legend moves here, out of the title block. *@
                <div class="label-instrument mt-2 flex gap-4">
                    <span>X · accountable hours (30d)</span><span>Y · utilization (%)</span>
                </div>
                <div class="well mt-1.5 flex-1 p-2">
                    <div id="atlas-field" class="chart-bay h-full min-h-[20rem]" aria-label="Workforce performance field"></div>
                </div>
            </div>

            @* Just the matrix - a separate name list above it was showing the same five people
               twice for no reason once Score joined the other four columns here. Row labels
               carry the rank; click any cell to focus that person (same as the old row click). *@
            <aside class="plate attention-lens flex flex-col p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Priority</div>
                        <h2 class="panel-title">Attention lens</h2>
                    </div>
                </div>
                <div class="well mt-2 flex-1 p-2">
                    <div id="attention-heatmap" class="chart-bay h-full min-h-[16rem]" aria-label="Completion, approval, attendance, utilization and overall score for each flagged engineer"></div>
                </div>
            </aside>
        </section>

        @* Same column template as the Workforce-field/Attention-lens row above, so Operational
           Fingerprint lines up at exactly the same width as Attention Lens instead of the two
           right-hand rails drifting to different widths. *@
        <section class="grid grid-cols-1 gap-4 @@4xl:grid-cols-[minmax(0,1fr)_minmax(22rem,34rem)]">
            <div class="plate p-4">
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Trajectory</div>
                        <h2 class="panel-title">Movement river</h2>
                    </div>
                    <div class="ml-auto flex items-center gap-3 text-2xs text-ink-soft" aria-label="Movement river legend">
                        <span class="flex items-center gap-1"><i class="h-1.5 w-3 rounded-full bg-info"></i>Every engineer</span>
                        <span class="flex items-center gap-1"><i class="h-1.5 w-3 rounded-full bg-primary"></i>Attention lens</span>
                        <span class="flex items-center gap-1"><i class="h-1.5 w-3 rounded-full bg-muted"></i>Team median</span>
                    </div>
                </div>
                <div class="well mt-2 p-2">
                    <div id="atlas-river" class="chart-bay chart-bay-lg" aria-label="Employee score movement over time"></div>
                </div>
            </div>

            @* The plate is a flex column so the well below can flex-1 and actually fill the
               height the grid gives this panel (matched to Movement River's h-[300px] well)
               instead of five thin rows sitting at the top with a slab of dead space under
               them. Rows are spaced with justify-around rather than a fixed gap, so they
               always occupy the full bay regardless of exactly how tall it ends up. *@
            <div class="plate flex flex-col p-4">
                @* The context label ("whole team" vs "X vs team") used to float between the
                   eyebrow and the legend, where it visually paired with "Profile" into a
                   confusing "PROFILE ... TEAM PROFILE" - now it lives with the rest of the
                   contextual info on the right, same place Workforce Field puts its "Team
                   view"/focused-person state. *@
                <div class="panel-head">
                    <div>
                        <div class="panel-eyebrow">Profile</div>
                        <h2 class="panel-title">Operational fingerprint</h2>
                    </div>
                    <div class="ml-auto flex flex-wrap items-center gap-x-3 gap-y-1 text-2xs text-ink-soft">
                        <span class="label-instrument text-muted">@FingerprintLabel</span>
                        <span class="flex items-center gap-1"><i class="h-1.5 w-3 rounded-full" style="background:var(--color-chart-1)"></i>Team median</span>
                        <span class="flex items-center gap-1"><i class="h-0 w-3 border-t-2 border-dashed" style="border-color:var(--color-chart-3)"></i>Target</span>
                        <span class="flex items-center gap-1"><i class="h-1.5 w-1.5 rounded-full" style="background:var(--color-chart-2)"></i>@(FocusItem is null ? "Team" : FocusItem.EmployeeName)</span>
                    </div>
                </div>
                @* A radar reads as an actual "fingerprint" (the panel's own name) - the person's or
                   team's shape laid directly over the median shape and the target ring - which a
                   row of independent bullet bars never did despite the name. *@
                <div class="well mt-2 flex flex-1 flex-col p-2">
                    <div id="fingerprint-radar" class="chart-bay h-full min-h-[16rem]"></div>
                </div>
                <div class="mt-2 flex flex-wrap justify-center gap-x-4 gap-y-0.5 px-1 text-2xs tabular-nums text-muted">
                    @foreach (var metric in FingerprintMetrics)
                    {
                        <span title="@metric.Tooltip"><b class="font-semibold text-ink-soft">@metric.Label</b> @metric.Display</span>
                    }
                </div>
            </div>
        </section>

        <section aria-label="Peer rating relationships">
            @if (Peers.TotalFeedback == 0)
            {
                <div class="plate flex items-center justify-between gap-4 p-4">
                    <strong class="text-sm font-semibold text-ink">No peer feedback · @State.SelectedMonth.ToString("MMMM yyyy")</strong>
                    <button type="button" class="shrink-0 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary/90" @onclick='() => Navigation.NavigateTo("/imports")'>Import peer reviews</button>
                </div>
            }
            else
            {
                <PeerRelationshipExplorer Reviews="State.PeerReviews" SelectedMonth="State.SelectedMonth" InitialFocusName="_focusName" ShowAtlasButton="true" />
            }
        </section>

        @if (Alerts.Count > 0)
        {
            <section class="plate p-4" aria-label="Trend alerts">
                <div class="panel-head">
                    <h2 class="panel-title">Trend alerts</h2>
                    <span class="ml-auto text-2xs text-muted">@Alerts.Count open · @Alerts.Count(x => x.Level == AlertLevel.Critical) critical</span>
                </div>
                <ul class="mt-3 grid grid-cols-1 gap-2 @@2xl:grid-cols-2 @@5xl:grid-cols-3">
                    @foreach (var alert in VisibleAlerts)
                    {
                        <li class="@($"rounded-md border p-3 shadow-well {AlertSurface(alert.Level)}")">
                            <div class="flex items-start gap-2">
                                <div class="min-w-0 flex-1">
                                    <strong class="block text-sm font-semibold leading-tight text-ink">@alert.EmployeeName</strong>
                                    <span class="mt-1 block text-xs font-semibold leading-tight @Level(alert.Level)">@alert.Headline</span>
                                </div>
                                <span class="@($"badge shrink-0 {AlertBadge(alert.Level)}")">@AlertLabel(alert.Level)</span>
                            </div>
                            <small class="mt-1.5 block text-2xs leading-snug text-muted">@alert.Detail</small>
                        </li>
                    }
                </ul>
                @if (Alerts.Count > 9)
                {
                    <div class="mt-3 flex justify-center">
                        <button type="button" class="control px-3 py-1.5 text-xs font-semibold text-ink" @onclick="() => _showAllAlerts = !_showAllAlerts">
                            @(_showAllAlerts ? "Show fewer alerts" : $"Show all {Alerts.Count} alerts")
                        </button>
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private static readonly string[] AtlasChartIds = ["pulse-attendance", "pulse-completion", "atlas-field", "atlas-river"];
    private string? _focusName;
    private string? _renderedSignature;
    private bool _chartsPending;
    private bool _layoutLogged;
    private DotNetObjectReference<Overview>? _selfRef;
    private OperationalScoringSettings _settings = OperationalScoringSettings.Default;
    private IReadOnlyList<Anomaly> _alerts = [];
    private bool _showAllAlerts;
    private Analytics.PeerSummary? _peers;
    private Dictionary<string, decimal> _previousScores = new(StringComparer.OrdinalIgnoreCase);
    private List<DateTime> _heatmapMonths = [];
    private decimal _teamScore;
    private IReadOnlyList<AttentionRow> _attentionRows = [];

    [JSInvokable]
    public void DrilldownTo(string name) { Focus(name); StateHasChanged(); }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        _settings = await Database.GetOperationalScoringSettingsAsync();
        RecomputeDerived();
        CheckChartsPending();
    }

    private void OnStateChanged()
    {
        RecomputeDerived();
        CheckChartsPending();
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet() { RecomputeDerived(); CheckChartsPending(); }

    private void RecomputeDerived()
    {
        _previousScores = State.History
            .Where(x => x.Year == Previous.Year && x.Month == Previous.Month)
            .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(x => x.Key, x => x.First().OperationalScore, StringComparer.OrdinalIgnoreCase);
        _alerts = Analytics.Anomalies(State.Performance, _previousScores);
        _peers = Analytics.Peers(State.PeerReviews);
        _heatmapMonths = State.History.Select(x => new DateTime(x.Year, x.Month, 1)).Distinct().OrderBy(x => x).ToList();
        _teamScore = State.Performance.Count == 0 ? 0 : decimal.Round(State.Performance.Average(x => x.OperationalScore), 1);

        _attentionRows = State.Performance.Select(item =>
        {
            var delta = PreviousScores.TryGetValue(item.EmployeeName, out var prev) ? item.OperationalScore - prev : (decimal?)null;
            var employeeAlerts = Alerts.Where(x => PersonName.Matches(x.EmployeeName, item.EmployeeName)).ToArray();
            var alertWeight = employeeAlerts.Sum(x => x.Level == AlertLevel.Critical ? 14m : x.Level == AlertLevel.Serious ? 7m : 3m);
            var risk = (100m - item.OperationalScore) * .55m
                     + (delta is < 0 ? Math.Abs(delta.Value) * 1.6m : 0)
                     + ExceptionCount(item) * 2.2m
                     + Math.Min(50m, Math.Abs(item.ReconciliationVariance)) * .32m
                     + (!item.HasSummaryData ? 12m : 0)
                     + alertWeight;
            return new AttentionRow(item.EmployeeName, item.OperationalScore, delta, risk, item);
        }).OrderByDescending(x => x.Risk).ThenBy(x => x.Score).Take(5).ToArray();

        if (_focusName is not null && !State.Performance.Any(x => PersonName.Matches(x.EmployeeName, _focusName)))
            _focusName = null;
    }

    private void CheckChartsPending()
    {
        var signature = $"{State.Performance.Count}|{State.Performance.Sum(x => x.OperationalScore):0.0}|{State.History.Count}|{State.WeeklyPerformance.Count}|{State.PeerReviews.Count}|{State.PeerReviews.Sum(x => x.Average):0.00}|{State.SelectedMonth:yyyyMM}|{_focusName}|{_settings.Total:0.###}";
        if (signature != _renderedSignature) { _renderedSignature = signature; _chartsPending = true; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chartsPending || State.Performance.Count == 0) return;
        _chartsPending = false;
        _selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("epaEchartsLoader.ensureLoaded");
        await JS.InvokeVoidAsync("epaAtlas.registerDrilldown", _selfRef);
        await JS.InvokeVoidAsync("epaAtlas.sparkline", "pulse-attendance", AttendanceTrend, "attendance");
        await JS.InvokeVoidAsync("epaAtlas.sparkline", "pulse-completion", CompletionTrend, "timesheet");

        var fingerprint = FingerprintMetrics;
        await JS.InvokeVoidAsync("epaCharts.radar", "fingerprint-radar", fingerprint.Select(x => x.Label).ToArray(), 100.0,
            new object[]
            {
                new { name = "Team median", role = "categorical-1", values = fingerprint.Select(x => (double)x.Median).ToArray() },
                new { name = "Target", role = "categorical-3", dashed = true, values = fingerprint.Select(x => (double)x.Target).ToArray() },
                new { name = FocusItem is null ? "Team" : FocusItem.EmployeeName, role = "categorical-2", values = fingerprint.Select(x => (double)x.Value).ToArray() }
            });

        var previousRows = State.History
            .Where(x => x.Year == Previous.Year && x.Month == Previous.Month)
            .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);
        var fieldPoints = State.Performance.Select(x =>
        {
            previousRows.TryGetValue(x.EmployeeName, out var prev);
            var hasPrevious = prev is not null && prev.HasSummaryData && x.HasSummaryData;
            var showMovement = hasPrevious
                && (Math.Abs(x.PunchHours - prev!.PunchHours) >= 0.5m || Math.Abs(x.Utilization - prev.Utilization) >= 1m);
            return new
            {
                name = x.EmployeeName, x = (double)x.PunchHours, y = (double)x.Utilization,
                prevX = prev is null ? (double?)null : (double)prev.PunchHours,
                prevY = prev is null ? (double?)null : (double)prev.Utilization,
                hasPrevious,
                showMovement,
                score = (double)x.OperationalScore, exceptions = ExceptionCount(x), band = Analytics.ScoreBand(x.OperationalScore), missing = !x.HasSummaryData
            };
        }).ToArray();
        var focusedPreviousHours = FocusedMovement?.PreviousHours ?? 0m;
        // Fixed across the loaded fiscal-year-to-date rather than recomputed from just the current
        // month: a person's horizontal position then means the same thing when you switch reporting
        // months, so movement across months actually reads as movement instead of the ruler itself
        // stretching or shrinking. It only grows if a later month's hours exceed everything seen so
        // far — it never shrinks back down as you page through history.
        var historyMaxHours = State.History.Count > 0 ? State.History.Max(x => x.PunchHours)
            : State.Performance.Count > 0 ? State.Performance.Max(x => x.PunchHours) : 0m;
        var fieldMax = Math.Max(60m, Math.Max(historyMaxHours, focusedPreviousHours) * 1.14m);
        // Same reasoning as fieldMax: the BALANCED/INCONSISTENT divider line must also be fixed
        // across months, not recomputed from the current month's median alone — otherwise the
        // quadrant boundary itself moves under a person from month to month, and a shift from one
        // zone to another stops meaning their behavior actually changed.
        var fieldMedian = State.History.Count > 0 ? Median(State.History.Select(x => x.PunchHours)) : Median(State.Performance.Select(x => x.PunchHours));
        await JS.InvokeVoidAsync("epaAtlas.performanceField", "atlas-field", fieldPoints, (double)fieldMax, (double)Analytics.UtilizationTarget, (double)fieldMedian, _focusName);

        // Reversed so rank #1 (top of the list) lands at the top row of the heatmap too -
        // ECharts' category axis renders index 0 at the bottom, like a normal chart axis.
        var attentionCategories = new[] { "Completion", "Approval", "Attendance", "Utilization", "Score" };
        var attentionRanked = AttentionRows.Reverse().ToArray();
        var attentionCells = attentionRanked.SelectMany((row, y) => new object[]
        {
            HeatCell(0, y, row.Name, "Completion", row.Item.TimesheetCompletionScore, row.Item.HasSummaryData),
            HeatCell(1, y, row.Name, "Approval", row.Item.ApprovalScore, row.Item.HasSummaryData),
            HeatCell(2, y, row.Name, "Attendance", row.Item.AttendanceDisciplineScore, true),
            HeatCell(3, y, row.Name, "Utilization", row.Item.Utilization, row.Item.HasSummaryData),
            HeatCell(4, y, row.Name, "Overall score", row.Score, true)
        }).ToArray();
        await JS.InvokeVoidAsync("epaCharts.registerDrilldown", _selfRef);
        await JS.InvokeVoidAsync("epaCharts.heatmap", "attention-heatmap", attentionCategories, attentionRanked.Select(x => x.Name).ToArray(), attentionCells, true);

        var attentionNames = AttentionRows.Select(x => x.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var riverSeries = State.Performance.Select((item, index) => new
        {
            name = item.EmployeeName, attention = attentionNames.Contains(item.EmployeeName),
            role = (index % 4) switch { 0 => "operational", 1 => "attendance", 2 => "timesheet", _ => "approval" },
            values = HeatmapMonths.Select(month => ScoreFor(item.EmployeeName, month)).ToArray()
        }).ToArray();
        var riverMedian = HeatmapMonths.Select(month => Median(State.History.Where(x => x.Year == month.Year && x.Month == month.Month).Select(x => x.OperationalScore))).ToArray();
        await JS.InvokeVoidAsync("epaAtlas.movementRiver", "atlas-river", HeatmapMonths.Select(x => x.ToString("MMM yy")).ToArray(), riverSeries, riverMedian, _focusName);

        if (!_layoutLogged)
        {
            _layoutLogged = true;
            var layout = await JS.InvokeAsync<string>("epaAtlas.measureOverview");
            Logger.LogDebug("Overview layout measured. Layout={Layout}", layout);
        }
    }

