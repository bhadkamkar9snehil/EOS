@page "/"
@page "/overview"
@using System.Globalization
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject IJSRuntime JS
@inject IApplicationDatabase Database
@inject AppState State
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="atlas-page">
    @if (State.Performance.Count == 0)
    {
        <div class="empty-state">
            <h2>No performance data for @State.SelectedMonth.ToString("MMMM yyyy")</h2>
            <p>Import the ERP exports for this reporting month. The Atlas is generated directly from the imported evidence.</p>
            <button class="action" @onclick='() => Navigation.NavigateTo("/imports")'>Go to data imports</button>
        </div>
    }
    else
    {
        <section class="atlas-pulse" aria-label="Team pulse">
            <div class="pulse-score">
                <span class="atlas-section-label">Team pulse</span>
                <div class="pulse-score-main">
                    <strong class="atlas-num">@Analytics.Format(TeamScore, "0")</strong>
                    <span class="atlas-num" title="Previous month team average">@(PreviousTeamScore is null ? "—" : Analytics.Format(PreviousTeamScore.Value, "0"))</span>
                </div>
                <div class="pulse-score-meta"><span>Overall score</span><span>@Previous.ToString("MMM yyyy")</span></div>
            </div>

            <div class="pulse-distribution">
                <h2 class="pulse-heading">Score distribution · people</h2>
                <div class="score-band-grid" role="img" aria-label="@DistributionSummary">
                    @foreach (var band in ScoreBands)
                    {
                        var members = BandMembers(band);
                        <section class="score-band @band.CssClass">
                            <div class="score-band-head"><span>@band.Label</span><strong>@members.Count</strong><small>@BandShare(members.Count)% of team</small></div>
                            <div class="score-band-plot" aria-label="@members.Count people scoring @band.Label">
                                @for (var i = 0; i < members.Count; i++)
                                {
                                    var member = members[i];
                                    <button type="button"
                                            class="score-band-dot @(IsFocused(member.EmployeeName) ? "focused" : null)"
                                            style="@BandDotStyle(members, band, i)"
                                            title="@member.EmployeeName · @Analytics.Format(member.OperationalScore)"
                                            aria-label="@member.EmployeeName score @Analytics.Format(member.OperationalScore)"
                                            @onclick="() => Focus(member.EmployeeName)"></button>
                                }
                            </div>
                        </section>
                    }
                </div>
            </div>

            <div class="pulse-trends">
                <h2 class="pulse-heading">Key trends · 30 days</h2>
                <div class="trend-triplet">
                    <div class="trend-mini">
                        <div class="trend-mini-head"><label>Attendance</label><span>@TrendCoverage(AttendanceTrend, "weeks")</span></div>
                        <div class="trend-value"><strong>@Analytics.Format(Average(x => x.AttendanceDisciplineScore), "0")%</strong>@TrendChange(AttendanceTrend)</div>
                        <div id="pulse-attendance" class="atlas-spark"></div>
                    </div>
                    <div class="trend-mini">
                        <div class="trend-mini-head"><label>Completion</label><span>@TrendCoverage(CompletionTrend, "weeks")</span></div>
                        <div class="trend-value"><strong>@Analytics.Format(Average(x => x.TimesheetCompletionScore, true), "0")%</strong>@TrendChange(CompletionTrend)</div>
                        <div id="pulse-completion" class="atlas-spark"></div>
                    </div>
                    <div class="trend-mini current-only">
                        <div class="trend-mini-head"><label>Utilization</label><span>Monthly source</span></div>
                        <div class="trend-value"><strong>@Analytics.Format(Average(x => x.Utilization, true), "0")%</strong><small>Current period</small></div>
                        <div id="pulse-utilization" class="atlas-spark"></div>
                    </div>
                </div>
            </div>

            <div class="pulse-readiness">
                <h2 class="pulse-heading">Data readiness</h2>
                <div class="readiness-lights">
                    @ReadinessLight("Timesheets", IsReady(ReportType.MonthlyTimesheetSummary))
                    @ReadinessLight("Imports", IsReady(ReportType.DetailedTimesheetTransactions))
                    @ReadinessLight("Mappings", IsReady(ReportType.AttendanceLeaveUaaTimesheet))
                    @ReadinessLight("Coverage", State.ReviewsUploaded, true)
                </div>
            </div>

            <div class="pulse-pressure">
                <h2 class="pulse-heading">Alert pressure</h2>
                <div class="pressure-body" title="Alert pressure increases with the number of open analytical alerts; critical alerts carry additional weight.">
                    <strong>@AlertPressureLabel</strong>
                    <div class="pressure-bars" aria-label="@Alerts.Count open analytical alerts">
                        @for (var i = 0; i < 12; i++) { <i class="@(i < AlertPressureBars ? "on" : null)"></i> }
                    </div>
                    <small>@Alerts.Count open · @Alerts.Count(x => x.Level == AlertLevel.Critical) critical</small>
                </div>
            </div>
        </section>

        <section class="atlas-primary">
            <div class="performance-field">
                <div class="atlas-panel-head">
                    <div><h2>Workforce performance field</h2><small>X: accountable hours (30 days)<br />Y: utilization (%)</small></div>
                    <div class="field-panel-actions">
                        @if (FocusedMovement is not null)
                        {
                            <span class="field-movement-key" title="@FocusedMovement.Tooltip">
                                <i></i>
                                <span class="field-movement-period"><small>Movement</small><b>@Previous.ToString("MMM") → @State.SelectedMonth.ToString("MMM")</b></span>
                                <strong class="@(FocusedMovement.DirectionClass)">@FocusedMovement.DeltaLabel</strong>
                            </span>
                        }
                        @if (FocusItem is not null)
                        {
                            <span class="focus-chip" aria-label="Focused engineer controls">
                                <button type="button" class="focus-team" title="Return to the whole-team view" @onclick="ClearFocus">Team view</button>
                                <b>@FocusItem.EmployeeName</b>
                                <button type="button" class="focus-open" title="Open @FocusItem.EmployeeName performance portrait" @onclick="OpenFocusedPortrait">Open portrait <span aria-hidden="true">↗</span></button>
                            </span>
                        }
                        else
                        {
                            <span class="team-mode-chip"><b>Team view</b><small>Select a person to focus</small></span>
                        }
                    </div>
                </div>
                <div id="atlas-field" aria-label="Workforce performance field"></div>
            </div>

            <aside class="attention-lens">
                <div class="atlas-panel-head"><div><h2>Attention lens</h2><small>Ranked by intervention priority</small></div></div>
                <div class="attention-columns">
                    <span class="attention-columns-id">Person</span>
                    <span title="Current operational score out of 100">Score</span>
                    <span class="attention-columns-fingerprint">
                        <abbr tabindex="0" aria-label="Completion: expected timesheet days with an entry" title="Completion: expected timesheet days with an entry">Comp</abbr>
                        <abbr tabindex="0" aria-label="Approval: submitted timesheets approved on time" title="Approval: submitted timesheets approved on time">App</abbr>
                        <abbr tabindex="0" aria-label="Attendance: punctuality and attendance discipline" title="Attendance: punctuality and attendance discipline">Att</abbr>
                        <abbr tabindex="0" aria-label="Utilization: accountable hours compared with available capacity" title="Utilization: accountable hours compared with available capacity">Util</abbr>
                    </span>
                    <span title="Recent weekly attendance-discipline pattern">30-day rhythm</span>
                </div>
                <ol class="attention-list">
                    @for (var i = 0; i < AttentionRows.Count; i++)
                    {
                        var row = AttentionRows[i];
                        <li class="attention-row @(IsFocused(row.Name) ? "selected" : null)" role="button" tabindex="0" aria-label="Focus @row.Name in the Atlas" @onclick="() => Focus(row.Name)" @onkeydown="args => HandleAttentionKey(args, row.Name)">
                            <span class="attention-rank">@(i + 1)</span>
                            <span class="attention-avatar">@Initials(row.Name)</span>
                            <span class="attention-person"><strong>@row.Name</strong><small>@EmployeeContext(row.Name)</small></span>
                            <span class="attention-score" title="Operational score; arrow shows change from the previous loaded month"><strong>@Analytics.Format(row.Score, "0")</strong>@if (row.Delta is not null && row.Delta != 0){<small class="@(row.Delta > 0 ? "up" : null)">@(row.Delta > 0 ? "↑" : "↓") @Analytics.Format(Math.Abs(row.Delta.Value), "0")</small>}</span>
                            <span class="fingerprint-mini" aria-label="Completion, approval, attendance and utilization diagnostic fingerprint">
                                @MiniFingerprint("Completion", row.Item.TimesheetCompletionScore, row.Item.HasSummaryData)
                                @MiniFingerprint("Approval", row.Item.ApprovalScore, row.Item.HasSummaryData)
                                @MiniFingerprint("Attendance", row.Item.AttendanceDisciplineScore, true)
                                @MiniFingerprint("Utilization", row.Item.Utilization, row.Item.HasSummaryData)
                            </span>
                            <span class="rhythm-mini" title="Weekly attendance discipline">
                                @foreach (var value in WeeklyRhythm(row.Name)) { <i style="--v:@CssPct(value)"></i> }
                            </span>
                            <button class="attention-open" title="Open @row.Name portrait" @onclick:stopPropagation="true" @onclick="() => OpenPortrait(row.Name)">↗</button>
                        </li>
                    }
                </ol>
            </aside>
        </section>

        <section class="atlas-secondary">
            <div class="movement-river">
                <div class="atlas-panel-head">
                    <div><h2>Movement river</h2><small>Operational score · recent loaded months</small></div>
                    <div class="movement-legend" aria-label="Movement river legend">
                        <span class="team"><i></i>Every engineer</span>
                        <span class="attention"><i></i>Attention lens</span>
                        <span class="median"><i></i>Team median</span>
                    </div>
                </div>
                <div id="atlas-river" aria-label="Employee score movement over time"></div>
            </div>

            <div class="operational-fingerprint">
                <div class="atlas-panel-head">
                    <div><h2>Operational fingerprint</h2><small>@FingerprintLabel</small></div>
                    <div class="fingerprint-legend"><span class="median"><i></i>Median</span><span class="quartile"><i></i>Middle 50%</span><span><i></i>@(FocusItem is null ? "Team" : FocusItem.EmployeeName)</span></div>
                </div>
                <div class="fingerprint-table">
                    <div class="fingerprint-head"><span>Dimension</span><span>Distribution / target</span><span>Current</span></div>
                    @foreach (var metric in FingerprintMetrics)
                    {
                        <div class="fingerprint-row">
                            <label>@metric.Label</label>
                            <span class="fingerprint-track" title="@metric.Tooltip">
                                <i class="fingerprint-quartile" style="--q1:@CssPct(metric.Q1);--qw:@CssPct(metric.Q3 - metric.Q1)"></i>
                                <i class="fingerprint-median" style="--median:@CssPct(metric.Median)"></i>
                                <i class="fingerprint-target" style="--target:@CssPct(metric.Target)"></i>
                                <i class="fingerprint-value" style="--value:@CssPct(metric.Value)"></i>
                            </span>
                            <strong title="Target: @metric.TargetLabel">@metric.Display</strong>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="atlas-peer-review" aria-label="Peer rating relationships">
            @if (Peers.TotalFeedback == 0)
            {
                <div class="peer-review-empty">
                    <div><strong>No peer feedback for @State.SelectedMonth.ToString("MMMM yyyy")</strong><p>Upload completed review workbooks to reveal who rated whom and how the team experiences each colleague.</p></div>
                    <button type="button" @onclick='() => Navigation.NavigateTo("/imports")'>Import peer reviews</button>
                </div>
            }
            else
            {
                <PeerRelationshipExplorer Reviews="State.PeerReviews" SelectedMonth="State.SelectedMonth" InitialFocusName="_focusName" ShowAtlasButton="true" />
            }
        </section>

        @if (Alerts.Count > 0)
        {
            <section class="trend-alerts-section" aria-label="Trend alerts">
                <div class="atlas-panel-head">
                    <div><h2>Trend alerts</h2><small>Score drops and missing evidence vs. last month</small></div>
                    <span class="atlas-caption">@Alerts.Count open · @Alerts.Count(x => x.Level == AlertLevel.Critical) critical</span>
                </div>
                <ul class="portrait-evidence-list">
                    @foreach (var alert in Alerts.Take(20))
                    {
                        <li><strong class="@Level(alert.Level)">@alert.EmployeeName — @alert.Headline</strong><small>@alert.Detail</small></li>
                    }
                </ul>
            </section>
        }
    }
</div>

@code {
    private static readonly string[] AtlasChartIds = ["pulse-attendance", "pulse-completion", "pulse-utilization", "atlas-field", "atlas-river"];
    private string? _focusName;
    private string? _renderedSignature;
    private bool _chartsPending;
    private bool _layoutLogged;
    private DotNetObjectReference<Overview>? _selfRef;
    private OperationalScoringSettings _settings = OperationalScoringSettings.Default;
    private IReadOnlyList<Anomaly> _alerts = [];
    private Analytics.PeerSummary? _peers;
    private Dictionary<string, decimal> _previousScores = new(StringComparer.OrdinalIgnoreCase);
    private List<DateTime> _heatmapMonths = [];
    private decimal _teamScore;
    private IReadOnlyList<AttentionRow> _attentionRows = [];

    [JSInvokable]
    public void DrilldownTo(string name) { Focus(name); StateHasChanged(); }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        _settings = await Database.GetOperationalScoringSettingsAsync();
        RecomputeDerived();
        CheckChartsPending();
    }

    private void OnStateChanged()
    {
        RecomputeDerived();
        CheckChartsPending();
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet() { RecomputeDerived(); CheckChartsPending(); }

    private void RecomputeDerived()
    {
        _previousScores = State.History
            .Where(x => x.Year == Previous.Year && x.Month == Previous.Month)
            .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(x => x.Key, x => x.First().OperationalScore, StringComparer.OrdinalIgnoreCase);
        _alerts = Analytics.Anomalies(State.Performance, _previousScores);
        _peers = Analytics.Peers(State.PeerReviews);
        _heatmapMonths = State.History.Select(x => new DateTime(x.Year, x.Month, 1)).Distinct().OrderBy(x => x).ToList();
        _teamScore = State.Performance.Count == 0 ? 0 : decimal.Round(State.Performance.Average(x => x.OperationalScore), 1);

        _attentionRows = State.Performance.Select(item =>
        {
            var delta = PreviousScores.TryGetValue(item.EmployeeName, out var prev) ? item.OperationalScore - prev : (decimal?)null;
            var employeeAlerts = Alerts.Where(x => PersonName.Matches(x.EmployeeName, item.EmployeeName)).ToArray();
            var alertWeight = employeeAlerts.Sum(x => x.Level == AlertLevel.Critical ? 14m : x.Level == AlertLevel.Serious ? 7m : 3m);
            var risk = (100m - item.OperationalScore) * .55m
                     + (delta is < 0 ? Math.Abs(delta.Value) * 1.6m : 0)
                     + ExceptionCount(item) * 2.2m
                     + Math.Min(50m, Math.Abs(item.ReconciliationVariance)) * .32m
                     + (!item.HasSummaryData ? 12m : 0)
                     + alertWeight;
            return new AttentionRow(item.EmployeeName, item.OperationalScore, delta, risk, item);
        }).OrderByDescending(x => x.Risk).ThenBy(x => x.Score).Take(5).ToArray();

        if (_focusName is not null && !State.Performance.Any(x => PersonName.Matches(x.EmployeeName, _focusName)))
            _focusName = null;
    }

    private void CheckChartsPending()
    {
        var signature = $"{State.Performance.Count}|{State.Performance.Sum(x => x.OperationalScore):0.0}|{State.History.Count}|{State.WeeklyPerformance.Count}|{State.PeerReviews.Count}|{State.PeerReviews.Sum(x => x.Average):0.00}|{State.SelectedMonth:yyyyMM}|{_focusName}|{_settings.Total:0.###}";
        if (signature != _renderedSignature) { _renderedSignature = signature; _chartsPending = true; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chartsPending || State.Performance.Count == 0) return;
        _chartsPending = false;
        _selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("epaEchartsLoader.ensureLoaded");
        await JS.InvokeVoidAsync("epaAtlas.registerDrilldown", _selfRef);
        await JS.InvokeVoidAsync("epaAtlas.sparkline", "pulse-attendance", AttendanceTrend, "attendance");
        await JS.InvokeVoidAsync("epaAtlas.sparkline", "pulse-completion", CompletionTrend, "timesheet");
        await JS.InvokeVoidAsync("epaAtlas.sparkline", "pulse-utilization", UtilizationCurrent, "operational");

        var previousRows = State.History
            .Where(x => x.Year == Previous.Year && x.Month == Previous.Month)
            .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);
        var fieldPoints = State.Performance.Select(x =>
        {
            previousRows.TryGetValue(x.EmployeeName, out var prev);
            var hasPrevious = prev is not null && prev.HasSummaryData && x.HasSummaryData;
            var showMovement = hasPrevious
                && (Math.Abs(x.PunchHours - prev!.PunchHours) >= 0.5m || Math.Abs(x.Utilization - prev.Utilization) >= 1m);
            return new
            {
                name = x.EmployeeName, x = (double)x.PunchHours, y = (double)x.Utilization,
                prevX = prev is null ? (double?)null : (double)prev.PunchHours,
                prevY = prev is null ? (double?)null : (double)prev.Utilization,
                hasPrevious,
                showMovement,
                score = (double)x.OperationalScore, exceptions = ExceptionCount(x), band = Analytics.ScoreBand(x.OperationalScore), missing = !x.HasSummaryData
            };
        }).ToArray();
        var focusedPreviousHours = FocusedMovement?.PreviousHours ?? 0m;
        // Fixed across the loaded fiscal-year-to-date rather than recomputed from just the current
        // month: a person's horizontal position then means the same thing when you switch reporting
        // months, so movement across months actually reads as movement instead of the ruler itself
        // stretching or shrinking. It only grows if a later month's hours exceed everything seen so
        // far — it never shrinks back down as you page through history.
        var historyMaxHours = State.History.Count > 0 ? State.History.Max(x => x.PunchHours)
            : State.Performance.Count > 0 ? State.Performance.Max(x => x.PunchHours) : 0m;
        var fieldMax = Math.Max(60m, Math.Max(historyMaxHours, focusedPreviousHours) * 1.14m);
        // Same reasoning as fieldMax: the BALANCED/INCONSISTENT divider line must also be fixed
        // across months, not recomputed from the current month's median alone — otherwise the
        // quadrant boundary itself moves under a person from month to month, and a shift from one
        // zone to another stops meaning their behavior actually changed.
        var fieldMedian = State.History.Count > 0 ? Median(State.History.Select(x => x.PunchHours)) : Median(State.Performance.Select(x => x.PunchHours));
        await JS.InvokeVoidAsync("epaAtlas.performanceField", "atlas-field", fieldPoints, (double)fieldMax, (double)Analytics.UtilizationTarget, (double)fieldMedian, _focusName);

        var attentionNames = AttentionRows.Select(x => x.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var riverSeries = State.Performance.Select((item, index) => new
        {
            name = item.EmployeeName, attention = attentionNames.Contains(item.EmployeeName),
            role = (index % 4) switch { 0 => "operational", 1 => "attendance", 2 => "timesheet", _ => "approval" },
            values = HeatmapMonths.Select(month => ScoreFor(item.EmployeeName, month)).ToArray()
        }).ToArray();
        var riverMedian = HeatmapMonths.Select(month => Median(State.History.Where(x => x.Year == month.Year && x.Month == month.Month).Select(x => x.OperationalScore))).ToArray();
        await JS.InvokeVoidAsync("epaAtlas.movementRiver", "atlas-river", HeatmapMonths.Select(x => x.ToString("MMM yy")).ToArray(), riverSeries, riverMedian, _focusName);

        if (!_layoutLogged)
        {
            _layoutLogged = true;
            var layout = await JS.InvokeAsync<string>("epaAtlas.measureOverview");
            InteractionLog.Write("overview.layout", layout);
        }
    }

    private DateTime Previous => State.SelectedMonth.AddMonths(-1);
    private IReadOnlyList<Anomaly> Alerts => _alerts;
    private static string Level(AlertLevel level) => level switch { AlertLevel.Critical => "critical", AlertLevel.Serious => "serious", _ => "warning" };
    private Analytics.PeerSummary Peers => _peers ??= Analytics.Peers(State.PeerReviews);
    private Dictionary<string, decimal> PreviousScores => _previousScores;
    private List<DateTime> HeatmapMonths => _heatmapMonths;
    private decimal TeamScore => _teamScore;
    private IReadOnlyList<AttentionRow> AttentionRows => _attentionRows;
    private decimal? PreviousTeamScore => PreviousScores.Count == 0 ? null : decimal.Round(PreviousScores.Values.Average(), 1);
    private MonthlyPerformanceItem? FocusItem => _focusName is null ? null : State.Performance.FirstOrDefault(x => PersonName.Matches(x.EmployeeName, _focusName));
    private FieldMovement? FocusedMovement
    {
        get
        {
            var current = FocusItem;
            if (current is null || !current.HasSummaryData) return null;
            var previous = State.History.FirstOrDefault(x => x.Year == Previous.Year && x.Month == Previous.Month && PersonName.Matches(x.EmployeeName, current.EmployeeName));
            if (previous is null || !previous.HasSummaryData) return null;
            var hoursDelta = current.PunchHours - previous.PunchHours;
            var utilizationDelta = current.Utilization - previous.Utilization;
            if (Math.Abs(hoursDelta) < 0.5m && Math.Abs(utilizationDelta) < 1m) return null;
            return new FieldMovement(previous.PunchHours, previous.Utilization, current.PunchHours, current.Utilization, hoursDelta, utilizationDelta);
        }
    }
    private string FingerprintLabel => FocusItem is null ? "Team profile" : $"{FocusItem.EmployeeName} vs team distribution";

    private decimal Average(Func<MonthlyPerformanceItem, decimal> selector, bool summaryOnly = false)
    {
        var scope = summaryOnly ? State.Performance.Where(x => x.HasSummaryData).ToArray() : State.Performance.ToArray();
        return scope.Length == 0 ? 0 : decimal.Round(scope.Average(selector), 1);
    }

    private decimal?[] MetricTrend(Func<MonthlyPerformanceItem, decimal> selector, bool summaryOnly) => HeatmapMonths.Select(month =>
    {
        var rows = State.History.Where(x => x.Year == month.Year && x.Month == month.Month && (!summaryOnly || x.HasSummaryData)).ToArray();
        return rows.Length == 0 ? (decimal?)null : decimal.Round(rows.Average(selector), 1);
    }).ToArray();

    private decimal?[] AttendanceTrend => State.WeeklyPerformance
        .Where(x => x.ExpectedDays > 0)
        .GroupBy(x => x.WeekStart.Date)
        .OrderBy(x => x.Key)
        .Select(week => (decimal?)decimal.Round(week.Average(x => x.AttendanceDisciplineScore), 1))
        .TakeLast(5)
        .ToArray();

    private decimal?[] CompletionTrend => State.WeeklyPerformance
        .Where(x => x.ExpectedDays > 0)
        .GroupBy(x => x.WeekStart.Date)
        .OrderBy(x => x.Key)
        .Select(week =>
        {
            var expected = week.Sum(x => x.ExpectedDays);
            return expected <= 0 ? (decimal?)null : decimal.Round(week.Sum(x => x.FilledDays) * 100m / expected, 1);
        })
        .TakeLast(5)
        .ToArray();

    private decimal?[] UtilizationCurrent => [Average(x => x.Utilization, true)];

    private decimal? ScoreFor(string name, DateTime month) => State.History
        .Where(x => x.Year == month.Year && x.Month == month.Month && PersonName.Matches(x.EmployeeName, name))
        .Select(x => (decimal?)x.OperationalScore).FirstOrDefault();

    private decimal TimesheetFillRate => State.Performance.Sum(x => x.ExpectedTimesheetDays) == 0 ? 0 : decimal.Round(State.Performance.Sum(x => x.TimesheetFilledDays) * 100m / State.Performance.Sum(x => x.ExpectedTimesheetDays), 1);
    private int BinCount(decimal fromInclusive, decimal toExclusive) => State.Performance.Count(x => x.OperationalScore >= fromInclusive && x.OperationalScore < toExclusive);
    private string DistributionSummary => $"0–49: {BinCount(0,50)}, 50–64: {BinCount(50,65)}, 65–79: {BinCount(65,80)}, 80–100: {BinCount(80,101)}";
    private IReadOnlyList<MonthlyPerformanceItem> BandMembers(ScoreBand band) => State.Performance
        .Where(x => x.OperationalScore >= band.FromInclusive && x.OperationalScore < band.ToExclusive)
        .OrderBy(x => x.OperationalScore)
        .ThenBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    private decimal BandShare(int count) => State.Performance.Count == 0 ? 0 : decimal.Round(count * 100m / State.Performance.Count, 0);
    private static string BandDotStyle(IReadOnlyList<MonthlyPerformanceItem> members, ScoreBand band, int index)
    {
        const decimal collisionDistance = 7m;
        const int laneCount = 3;
        var positions = members.Take(index + 1).Select(item => BandPosition(item, band)).ToArray();
        var lanes = new int[index + 1];

        for (var current = 0; current <= index; current++)
        {
            var selectedLane = 0;
            var bestClearance = -1m;
            for (var candidate = 0; candidate < laneCount; candidate++)
            {
                var clearance = decimal.MaxValue;
                for (var previous = 0; previous < current; previous++)
                {
                    if (lanes[previous] == candidate)
                    {
                        clearance = Math.Min(clearance, Math.Abs(positions[current] - positions[previous]));
                    }
                }

                if (clearance >= collisionDistance)
                {
                    selectedLane = candidate;
                    break;
                }

                if (clearance > bestClearance)
                {
                    bestClearance = clearance;
                    selectedLane = candidate;
                }
            }

            lanes[current] = selectedLane;
        }

        var lane = lanes[index];
        return $"left:{CssPct(positions[index])};--dot-lift:{lane * 9}px;--dot-lift-compact:{lane * 7}px;--dot-lift-large:{lane * 10}px";
    }
    private static decimal BandPosition(MonthlyPerformanceItem item, ScoreBand band)
    {
        var span = Math.Max(1m, band.ToExclusive - band.FromInclusive - 1m);
        return Math.Clamp((item.OperationalScore - band.FromInclusive) * 100m / span, 4m, 96m);
    }
    private static string TrendCoverage(IReadOnlyList<decimal?> values, string unit)
    {
        var count = values.Count(x => x is not null);
        return count >= 2 ? $"{count} {unit}" : count == 1 ? "Current only" : "No dated evidence";
    }
    private static RenderFragment TrendChange(IReadOnlyList<decimal?> values)
    {
        var observed = values.Where(x => x is not null).Select(x => x!.Value).ToArray();
        if (observed.Length < 2) return @<small>Baseline</small>;
        var delta = decimal.Round(observed[^1] - observed[^2], 0);
        if (delta == 0) return @<small>→ steady</small>;
        return @<small class="@(delta > 0 ? "up" : "down")">@(delta > 0 ? "↑" : "↓") @Analytics.Format(Math.Abs(delta), "0") pts</small>;
    }
    private static int ExceptionCount(MonthlyPerformanceItem item) => item.MissingPunchDays + item.LateDays + item.EarlyDays + item.LessDurationDays;

    private string EmployeeContext(string name)
    {
        var employee = State.Employees.FirstOrDefault(x => PersonName.Matches(x.Name, name));
        if (employee is null) return "Engineer";
        return !string.IsNullOrWhiteSpace(employee.TeamName) ? employee.TeamName! : $"Level {employee.SeniorityLevel}";
    }

    private IReadOnlyList<decimal> WeeklyRhythm(string name)
    {
        var values = State.WeeklyPerformance.Where(x => x.ExpectedDays > 0 && PersonName.Matches(x.EmployeeName, name)).OrderBy(x => x.WeekStart).Select(x => x.AttendanceDisciplineScore).ToArray();
        if (values.Length > 0) return values;
        var item = State.Performance.FirstOrDefault(x => PersonName.Matches(x.EmployeeName, name));
        return item is null ? new[] { 0m } : new[] { item.AttendanceDisciplineScore };
    }

    private bool IsReady(ReportType type) => State.Snapshot?.SourceSlots.Any(x => x.ReportType == type && x.Status == SourceStatus.Uploaded) == true;
    private int AlertPressureBars => Math.Clamp((int)Math.Ceiling((Alerts.Count + Alerts.Count(x => x.Level == AlertLevel.Critical) * 2) / 2.0), 0, 12);
    private string AlertPressureLabel => Alerts.Count >= 14 || Alerts.Any(x => x.Level == AlertLevel.Critical) ? "High" : Alerts.Count >= 7 ? "Elevated" : Alerts.Count > 0 ? "Watch" : "Low";

    private IReadOnlyList<FingerprintMetric> FingerprintMetrics
    {
        get
        {
            var summary = State.Performance.Where(x => x.HasSummaryData).ToArray();
            var selected = FocusItem;
            var workloadHours = State.Performance.Select(x => x.Workload()).ToArray();
            var workloadIndex = State.Performance.Select(WorkloadIndex).ToArray();
            return new[]
            {
                BuildFingerprint("Completion", summary.Select(x=>x.TimesheetCompletionScore).ToArray(), selected is { HasSummaryData:true } ? selected.TimesheetCompletionScore : Average(x=>x.TimesheetCompletionScore,true), 95m, v=>$"{Analytics.Format(v,"0")}%", "95%"),
                BuildFingerprint("Approval", summary.Select(x=>x.ApprovalScore).ToArray(), selected is { HasSummaryData:true } ? selected.ApprovalScore : Average(x=>x.ApprovalScore,true), 90m, v=>$"{Analytics.Format(v,"0")}%", "90%"),
                BuildFingerprint("Attendance", State.Performance.Select(x=>x.AttendanceDisciplineScore).ToArray(), selected?.AttendanceDisciplineScore ?? Average(x=>x.AttendanceDisciplineScore), 95m, v=>$"{Analytics.Format(v,"0")}%", "95%"),
                BuildFingerprint("Utilization", summary.Select(x=>x.Utilization).ToArray(), selected is { HasSummaryData:true } ? selected.Utilization : Average(x=>x.Utilization,true), Analytics.UtilizationTarget, v=>$"{Analytics.Format(v,"0")}%", $"{Analytics.Format(Analytics.UtilizationTarget,"0")}%"),
                new FingerprintMetric("Workload", selected is null ? Median(workloadIndex) : WorkloadIndex(selected), Median(workloadIndex), Percentile(workloadIndex,.25m), Percentile(workloadIndex,.75m), selected is null ? $"{Analytics.Format(Median(workloadHours),"0.0")} h/d" : $"{Analytics.Format(selected.Workload(),"0.0")} h/d", 100m, $"≤ {Analytics.Format(Analytics.WorkloadCeiling,"0")} h/d", "Workload index is relative to the accountable-hours ceiling")
            };
        }
    }

    private static FingerprintMetric BuildFingerprint(string label, IReadOnlyCollection<decimal> values, decimal value, decimal target, Func<decimal,string> display, string targetLabel)
    {
        var safe = values.Count == 0 ? new[] { 0m } : values.ToArray();
        return new FingerprintMetric(label, Math.Clamp(value,0,100), Percentile(safe,.5m), Percentile(safe,.25m), Percentile(safe,.75m), display(value), Math.Clamp(target,0,100), targetLabel, $"{label}: {display(value)} · target {targetLabel}");
    }

    private static decimal WorkloadIndex(MonthlyPerformanceItem item) => Analytics.WorkloadCeiling <= 0 ? 0 : Math.Clamp(item.Workload() * 100m / Analytics.WorkloadCeiling, 0, 100);
    private static decimal Median(IEnumerable<decimal> source) => Percentile(source.ToArray(), .5m);
    private static decimal Percentile(IReadOnlyList<decimal> source, decimal percentile)
    {
        if (source.Count == 0) return 0;
        var ordered = source.OrderBy(x => x).ToArray();
        if (ordered.Length == 1) return ordered[0];
        var position = (ordered.Length - 1) * percentile;
        var lower = (int)Math.Floor(position); var upper = (int)Math.Ceiling(position);
        if (lower == upper) return ordered[lower];
        var fraction = position - lower;
        return ordered[lower] + (ordered[upper] - ordered[lower]) * fraction;
    }

    private void Focus(string name)
    {
        var normalized = PersonName.Normalize(name);
        _focusName = _focusName is not null && PersonName.Matches(_focusName, normalized) ? null : normalized;
        _chartsPending = true;
    }
    private bool IsFocused(string name) => _focusName is not null && PersonName.Matches(name, _focusName);
    private void ClearFocus() { _focusName = null; _chartsPending = true; }
    private void OpenPortrait(string name) => Navigation.NavigateTo($"/employee/{Uri.EscapeDataString(name)}");
    private void OpenFocusedPortrait() { if (FocusItem is not null) OpenPortrait(FocusItem.EmployeeName); }
    private void HandleAttentionKey(KeyboardEventArgs args, string name)
    {
        if (args.Key is "Enter" or " ") Focus(name);
    }
    private static string CssPct(decimal value) => Math.Clamp(value, 0, 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private RenderFragment ReadinessLight(string label, bool ready, bool optional = false) => @<div class="readiness-light @(ready ? "ready" : optional ? "warn" : null)" title="@label: @(ready ? "ready" : optional ? "optional evidence missing" : "required evidence missing")"><span>@label</span><i></i></div>;
    private RenderFragment MiniFingerprint(string label, decimal value, bool available) => @<i class="@(!available || value < 65 ? "low" : null)" style="--v:@CssPct(available ? value : 0)" title="@label: @(available ? Analytics.Format(value,"0") + "%" : "No source")"></i>;

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        foreach (var id in AtlasChartIds) { try { await JS.InvokeVoidAsync("epaAtlas.dispose", id); } catch (JSDisconnectedException) { } }
        _selfRef?.Dispose();
    }

