    private sealed record ScoreBand(string Label, decimal FromInclusive, decimal ToExclusive, string CssClass);
    private static readonly ScoreBand[] ScoreBands =
    [
        new("0–49", 0m, 50m, "critical"),
        new("50–64", 50m, 65m, "serious"),
        new("65–79", 65m, 80m, "warning"),
        new("80–100", 80m, 101m, "good")
    ];
    private sealed record FingerprintMetric(string Label, decimal Value, decimal Median, decimal Q1, decimal Q3, string Display, decimal Target, string TargetLabel, string Tooltip);
    private sealed record FieldMovement(decimal PreviousHours, decimal PreviousUtilization, decimal CurrentHours, decimal CurrentUtilization, decimal HoursDelta, decimal UtilizationDelta)
    {
        public string DirectionClass => UtilizationDelta > 0 ? "movement-up" : UtilizationDelta < 0 ? "movement-down" : "movement-flat";
        public string DeltaLabel => $"{Signed(HoursDelta, "0.0")} h · {Signed(UtilizationDelta, "0")} pp";
        public string Tooltip => $"Previous: {Analytics.Format(PreviousHours, "0.0")} h · {Analytics.Format(PreviousUtilization, "0.0")}% | Current: {Analytics.Format(CurrentHours, "0.0")} h · {Analytics.Format(CurrentUtilization, "0.0")}%";
        private static string Signed(decimal value, string format) => value > 0 ? $"+{value.ToString(format)}" : value.ToString(format);
    }
