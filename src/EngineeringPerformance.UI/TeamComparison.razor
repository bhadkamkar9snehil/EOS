@page "/team-comparison"
@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@inject AppState State
@inject NavigationManager Navigation
@implements IDisposable

<section class="flex flex-col gap-6">
    <div>
        <h2 class="text-xl font-bold text-ink">Team comparison</h2>
        <p class="mt-1 text-sm text-ink-soft">Scorecards for @State.SelectedMonth.ToString("MMMM yyyy").</p>
    </div>

    @if (Scorecards.Count == 0)
    {
        <div class="flex flex-col items-start gap-3 rounded-xl border border-line bg-surface p-8">
            <h2 class="text-lg font-bold text-ink">No teams with scored people yet</h2>
            <p class="text-sm text-ink-soft">Assign employees to teams on the Employees &amp; Teams page, then come back here once performance data is imported.</p>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/employees")'>Go to Employees &amp; Teams</button>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-line bg-surface">
            <div class="grid grid-cols-[1.2fr_5rem_8rem_8rem_8rem_8rem_8rem_6rem] gap-2 border-b border-line bg-surface-dark px-3 py-2 text-[10px] font-semibold uppercase tracking-wide text-on-dark">
                <span>Team</span><span>People</span><span>Avg. operational score</span><span>Avg. timesheet completion</span><span>Avg. approval completion</span><span>Avg. attendance discipline</span><span>Timesheet fill rate</span><span>Open alerts</span>
            </div>
            @foreach (var card in Scorecards)
            {
                <div class="grid grid-cols-[1.2fr_5rem_8rem_8rem_8rem_8rem_8rem_6rem] items-center gap-2 border-b border-line px-3 py-2.5 text-sm">
                    <span><strong class="font-medium text-ink">@card.TeamName</strong></span>
                    <span class="text-ink-soft">@card.MemberCount</span>
                    <span><b class="@Analytics.BandTextClass(Analytics.ScoreBand(card.AverageScore))">@Analytics.Format(card.AverageScore)</b></span>
                    <span class="text-ink-soft">@Analytics.Format(card.AverageTimesheet, "0.#")%</span>
                    <span class="text-ink-soft">@Analytics.Format(card.AverageApproval, "0.#")%</span>
                    <span class="text-ink-soft">@Analytics.Format(card.AverageAttendance, "0.#")%</span>
                    <span class="text-ink-soft">@Analytics.Format(card.TimesheetFillRate, "0.#")%</span>
                    <span class="text-ink-soft">@card.OpenAlerts</span>
                </div>
            }
        </div>
        @if (UnassignedCount > 0)
        {
            <p class="text-[11px] text-muted">@UnassignedCount employee(s) have no team assigned and are not included in the scorecards above.</p>
        }
    }
</section>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;

    private sealed record TeamScorecard(
        string TeamName, int MemberCount, decimal AverageScore,
        decimal AverageTimesheet, decimal AverageApproval, decimal AverageAttendance,
        decimal TimesheetFillRate, int OpenAlerts);

    private int UnassignedCount => State.Employees.Count(x => x.TeamId is null && !x.IsExcluded);

    private IReadOnlyList<TeamScorecard> Scorecards
    {
        get
        {
            var previous = State.History
                .Where(x => x.Year == State.SelectedMonth.AddMonths(-1).Year && x.Month == State.SelectedMonth.AddMonths(-1).Month)
                .GroupBy(x => x.EmployeeName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(x => x.Key, x => x.First().OperationalScore, StringComparer.OrdinalIgnoreCase);
            var alerts = Analytics.Anomalies(State.Performance, previous);

            var employeesByName = State.Employees
                .Where(x => !x.IsExcluded)
                .GroupBy(x => PersonName.Normalize(x.Name), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);

            return State.Teams
                .Select(team =>
                {
                    var members = State.Performance
                        .Where(p => employeesByName.TryGetValue(PersonName.Normalize(p.EmployeeName), out var e) && e.TeamId == team.Id)
                        .ToArray();
                    if (members.Length == 0) return null;

                    var memberNames = new HashSet<string>(members.Select(x => PersonName.Normalize(x.EmployeeName)), StringComparer.OrdinalIgnoreCase);
                    var openAlerts = alerts.Count(a => memberNames.Contains(PersonName.Normalize(a.EmployeeName)));
                    var expectedDays = members.Sum(x => x.ExpectedTimesheetDays);
                    var filledDays = members.Sum(x => x.TimesheetFilledDays);

                    return new TeamScorecard(
                        team.Name, members.Length,
                        decimal.Round(members.Average(x => x.OperationalScore), 1),
                        decimal.Round(members.Average(x => x.TimesheetCompletionScore), 1),
                        decimal.Round(members.Average(x => x.ApprovalScore), 1),
                        decimal.Round(members.Average(x => x.AttendanceDisciplineScore), 1),
                        expectedDays == 0 ? 0 : decimal.Round(filledDays * 100m / expectedDays, 1),
                        openAlerts);
                })
                .Where(x => x is not null)
                .Select(x => x!)
                .OrderByDescending(x => x.AverageScore)
                .ToArray();
        }
    }
}
