@page "/diagnostics"
@using System.IO.Compression
@using System.Reflection
@inject AppState State

<section class="flex flex-col gap-6">
    <div>
        <h2 class="text-xl font-bold text-ink">Diagnostics</h2>
        <p class="mt-1 text-sm text-ink-soft">App version, database and log locations, and a recent log tail — useful information to include when reporting a problem.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <section class="card">
            <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-surface-inset text-base text-ink-soft">◫</span>
                <div><h3 class="text-sm font-bold text-ink">Application</h3><p class="text-xs text-ink-soft">Build and storage details.</p></div>
            </div>
            <dl class="mt-3 flex flex-col divide-y divide-line">
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="shrink-0 text-ink-soft">Version</dt><dd class="truncate text-right text-ink">@_appVersion</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="shrink-0 text-ink-soft">Database file</dt><dd class="truncate text-right text-ink">@_dbPath</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="shrink-0 text-ink-soft">Database size</dt><dd class="truncate text-right text-ink">@_dbSize</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="shrink-0 text-ink-soft">Log directory</dt><dd class="truncate text-right text-ink">@_logDirectory</dd></div>
            </dl>
        </section>

        <section class="card">
            <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-surface-inset text-base text-ink-soft">◎</span>
                <div><h3 class="text-sm font-bold text-ink">Bug report bundle</h3><p class="text-xs text-ink-soft">Zips the last few days of logs plus a small info.txt for attaching to a bug report.</p></div>
            </div>
            <button type="button" class="btn btn-secondary mt-3" @onclick="CreateBundleAsync" disabled="@_bundling">
                @(_bundling ? "Building bundle..." : "Copy diagnostics bundle")
            </button>
            @if (!string.IsNullOrEmpty(_bundlePath))
            {
                <p class="mt-2 text-xs text-ink-soft">Bundle saved to: <code class="text-2xs">@_bundlePath</code></p>
            }
        </section>
    </div>

    <div class="card">
        <div class="flex items-start gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-surface-inset text-base text-ink-soft">▤</span>
            <div><h3 class="text-sm font-bold text-ink">Today's log (last @MaxTailLines lines)</h3><p class="text-xs text-ink-soft">@_todayLogPath</p></div>
        </div>
        <pre class="mt-3 max-h-96 overflow-auto whitespace-pre-wrap rounded-lg bg-surface-inset p-3 text-2xs text-ink-soft">@_logTail</pre>
        <button type="button" class="btn btn-secondary mt-3" @onclick="RefreshTailAsync">Refresh</button>
    </div>
</section>

@code {
    private const int MaxTailLines = 200;

    private string _appVersion = string.Empty;
    private string _dbPath = string.Empty;
    private string _dbSize = string.Empty;
    private string _logDirectory = string.Empty;
    private string _todayLogPath = string.Empty;
    private string _logTail = string.Empty;
    private string? _bundlePath;
    private bool _bundling;

    protected override async Task OnInitializedAsync()
    {
        var dataDirectory = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "EngineeringPerformance");
        var dbPath = Path.Combine(dataDirectory, "engineering-performance.db");
        _dbPath = dbPath;
        _dbSize = File.Exists(dbPath) ? FormatSize(new FileInfo(dbPath).Length) : "(not found)";
        _logDirectory = Path.Combine(dataDirectory, "logs");
        _appVersion = (Assembly.GetEntryAssembly() ?? Assembly.GetExecutingAssembly())
            .GetName().Version?.ToString() ?? "unknown";

        await RefreshTailAsync();
    }

    private Task RefreshTailAsync()
    {
        _todayLogPath = Path.Combine(_logDirectory, $"eos-{DateTime.Now:yyyyMMdd}.log");
        if (!File.Exists(_todayLogPath))
        {
            _logTail = "(no log file for today yet)";
            return Task.CompletedTask;
        }

        try
        {
            using var stream = new FileStream(_todayLogPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
            using var reader = new StreamReader(stream);
            var lines = new List<string>();
            string? line;
            while ((line = reader.ReadLine()) is not null) lines.Add(line);
            _logTail = string.Join(Environment.NewLine, lines.TakeLast(MaxTailLines));
        }
        catch (IOException ex)
        {
            _logTail = $"(could not read log file: {ex.Message})";
        }

        return Task.CompletedTask;
    }

    private async Task CreateBundleAsync()
    {
        _bundling = true;
        _bundlePath = null;
        StateHasChanged();
        try
        {
            await Task.Run(() =>
            {
                var outputDirectory = Path.Combine(Path.GetTempPath(), "EngineeringPerformance-Diagnostics");
                Directory.CreateDirectory(outputDirectory);
                var zipPath = Path.Combine(outputDirectory, $"eos-diagnostics-{DateTime.Now:yyyyMMdd-HHmmss}.zip");

                using var archive = ZipFile.Open(zipPath, ZipArchiveMode.Create);

                if (Directory.Exists(_logDirectory))
                {
                    var cutoff = DateTime.Now.AddDays(-5);
                    foreach (var file in Directory.EnumerateFiles(_logDirectory, "*.log")
                        .Where(f => File.GetLastWriteTime(f) >= cutoff))
                    {
                        archive.CreateEntryFromFile(file, Path.GetFileName(file));
                    }
                }

                var infoEntry = archive.CreateEntry("info.txt");
                using (var writer = new StreamWriter(infoEntry.Open()))
                {
                    writer.WriteLine($"EOS diagnostics bundle");
                    writer.WriteLine($"Generated: {DateTime.Now:O}");
                    writer.WriteLine($"App version: {_appVersion}");
                    writer.WriteLine($"Database path: {_dbPath}");
                    writer.WriteLine($"Database size: {_dbSize}");
                }

                _bundlePath = zipPath;
            });

            State.ShowMessage($"Diagnostics bundle saved to {_bundlePath}");
        }
        catch (Exception ex)
        {
            State.ShowMessage($"Could not build diagnostics bundle: {ex.Message}", true);
        }
        finally
        {
            _bundling = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        double size = bytes;
        string[] units = ["B", "KB", "MB", "GB"];
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.##} {units[unit]}";
    }
}
