@page "/diagnostics"
@using EngineeringPerformance.Application
@inject AppState State
@inject IApplicationDiagnostics ApplicationDiagnostics

<section class="flex flex-col gap-6">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Build</div>
                    <h2 class="panel-title">Application</h2>
                </div>
                <span class="ml-auto flex items-center gap-1.5">
                    <i class="@($"h-2 w-2 {(_dbSize == "(not found)" ? "lamp-off" : "lamp text-good")}")" aria-hidden="true"></i>
                    <span class="label-instrument">@(_dbSize == "(not found)" ? "Database missing" : "Database present")</span>
                </span>
            </div>
            <dl class="flex flex-col divide-y divide-line-soft">
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument shrink-0">Version</dt><dd class="truncate text-right tabular-nums text-ink">@_appVersion</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument shrink-0">Database file</dt><dd class="truncate text-right font-mono text-2xs text-ink" title="@_dbPath">@_dbPath</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument shrink-0">Database size</dt><dd class="truncate text-right tabular-nums text-ink">@_dbSize</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument shrink-0">Log directory</dt><dd class="truncate text-right font-mono text-2xs text-ink" title="@_logDirectory">@_logDirectory</dd></div>
            </dl>
        </section>

        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Support</div>
                    <h2 class="panel-title">Bug report bundle</h2>
                </div>
                <span class="ml-auto flex items-center gap-1.5">
                    <i class="@($"h-2 w-2 {(_bundling ? "lamp text-warning" : _bundlePath is not null ? "lamp text-good" : "lamp-off")}")" aria-hidden="true"></i>
                    <span class="label-instrument">@(_bundling ? "Building" : _bundlePath is not null ? "Ready" : "Idle")</span>
                </span>
            </div>
            <p class="text-xs text-ink-soft">Zips recent EOS logs and runtime information for attaching to a bug report.</p>
            <button type="button" class="btn btn-secondary mt-3" @onclick="CreateBundleAsync" disabled="@_bundling">
                @(_bundling ? "Building bundle..." : "Create diagnostics bundle")
            </button>
            @if (!string.IsNullOrEmpty(_bundlePath))
            {
                <p class="mt-2 text-xs text-ink-soft">Bundle saved to: <code class="font-mono text-2xs">@_bundlePath</code></p>
            }
        </section>
    </div>

    <div class="plate p-4">
        <div class="panel-head">
            <div>
                <div class="panel-eyebrow">Readout</div>
                <h2 class="panel-title">Today's log</h2>
            </div>
            <span class="label-instrument ml-auto">last <span class="tnum">@MaxTailLines</span> lines · <span class="font-mono normal-case tracking-normal">@_todayLogPath</span></span>
        </div>
        <pre class="well max-h-96 overflow-auto whitespace-pre-wrap p-3 font-mono text-2xs tabular-nums text-ink-soft" role="log" aria-label="Recent log output">@_logTail</pre>
        <button type="button" class="btn btn-secondary mt-3" @onclick="RefreshTailAsync">Refresh</button>
    </div>
</section>

@code {
    private const int MaxTailLines = 200;

    private string _appVersion = string.Empty;
    private string _dbPath = string.Empty;
    private string _dbSize = string.Empty;
    private string _logDirectory = string.Empty;
    private string _todayLogPath = string.Empty;
    private string _logTail = string.Empty;
    private string? _bundlePath;
    private bool _bundling;

    protected override async Task OnInitializedAsync()
    {
        LoadInfo();
        await RefreshTailAsync();
    }

    private void LoadInfo()
    {
        var info = ApplicationDiagnostics.GetInfo();
        _appVersion = info.ApplicationVersion;
        _dbPath = info.DatabasePath;
        _dbSize = info.DatabaseSize;
        _logDirectory = info.LogDirectory;
        _todayLogPath = info.CurrentLogPath;
    }

    private async Task RefreshTailAsync()
    {
        LoadInfo();
        _logTail = await ApplicationDiagnostics.ReadRecentLogAsync(MaxTailLines);
    }

    private async Task CreateBundleAsync()
    {
        _bundling = true;
        _bundlePath = null;
        StateHasChanged();

        try
        {
            _bundlePath = await ApplicationDiagnostics.CreateBundleAsync();
            State.ShowMessage($"Diagnostics bundle saved to {_bundlePath}");
        }
        catch (Exception ex)
        {
            State.ShowMessage($"Could not build diagnostics bundle: {ex.Message}", true);
        }
        finally
        {
            _bundling = false;
        }
    }
}
