@page "/diagnostics"
@using EngineeringPerformance.Application
@inject AppState State
@inject IApplicationDiagnostics ApplicationDiagnostics
@inject IUpdateService Updates

<section class="flex flex-col gap-6">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Build</div>
                    <h2 class="panel-title">Application</h2>
                </div>
                <span class="ml-auto flex items-center gap-1.5">
                    <i class="@($"h-2 w-2 {(_dbSize == "(not found)" ? "lamp-off" : "lamp text-good")}")" aria-hidden="true"></i>
                    <span class="label-instrument">@(_dbSize == "(not found)" ? "Database missing" : "Database present")</span>
                </span>
            </div>
            <dl class="flex flex-col divide-y divide-line-soft">
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument shrink-0">Version</dt><dd class="truncate text-right tabular-nums text-ink">@_appVersion</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument shrink-0">Update state</dt><dd class="truncate text-right text-ink">@Updates.Status.Phase</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument shrink-0">Last update check</dt><dd class="truncate text-right tabular-nums text-ink">@(Updates.Status.LastSuccessfulCheckAt?.ToString("g") ?? "Never")</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument shrink-0">Database file</dt><dd class="truncate text-right font-mono text-2xs text-ink" title="@_dbPath">@_dbPath</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument shrink-0">Database size</dt><dd class="truncate text-right tabular-nums text-ink">@_dbSize</dd></div>
                <div class="flex justify-between gap-4 py-1.5 text-xs"><dt class="label-instrument shrink-0">Log directory</dt><dd class="truncate text-right font-mono text-2xs text-ink" title="@_logDirectory">@_logDirectory</dd></div>
            </dl>
        </section>

        <section class="plate p-4">
            <div class="panel-head">
                <div>
                    <div class="panel-eyebrow">Support</div>
                    <h2 class="panel-title">Bug report bundle</h2>
                </div>
                <span class="ml-auto flex items-center gap-1.5">
                    <i class="@($"h-2 w-2 {(_bundling ? "lamp text-warning" : _bundlePath is not null ? "lamp text-good" : "lamp-off")}")" aria-hidden="true"></i>
                    <span class="label-instrument">@(_bundling ? "Building" : _bundlePath is not null ? "Ready" : "Idle")</span>
                </span>
            </div>
            <button type="button" class="btn btn-secondary mt-3" @onclick="CreateBundleAsync" disabled="@_bundling">
                @(_bundling ? "Building bundle..." : "Create diagnostics bundle")
            </button>
            @if (!string.IsNullOrEmpty(_bundlePath))
            {
                <div class="mt-2"><span class="label-instrument">Bundle</span> <code class="font-mono text-2xs">@_bundlePath</code></div>
            }
        </section>
    </div>

    <div class="plate p-4">
        <div class="panel-head">
            <div>
                <div class="panel-eyebrow">Readout</div>
                <h2 class="panel-title">Today's log</h2>
            </div>
            <span class="label-instrument ml-auto">last <span class="tnum">@MaxTailLines</span> lines · <span class="font-mono normal-case tracking-normal">@_todayLogPath</span></span>
        </div>
        <div class="mb-3 flex flex-wrap items-center gap-2">
            <div class="grid grid-cols-5 gap-1.5" role="group" aria-label="Log level filter">
                @foreach (var level in LogLevels)
                {
                    <button type="button" class="@LogFilterClass(level)" aria-pressed="@(_levelFilter == level)" @onclick="() => _levelFilter = level">
                        <span class="flex items-center gap-1.5"><i class="@LogFilterDotClass(level)"></i>@level</span>
                        <strong class="tabular-nums text-ink">@LevelCount(level)</strong>
                    </button>
                }
            </div>
            <input class="field ml-auto w-72 px-3 py-1.5 text-sm text-ink outline-none placeholder:text-muted" @bind="_logSearch" @bind:event="oninput" placeholder="Search source or message…" aria-label="Search today's log" />
            <button type="button" class="btn btn-secondary" @onclick="RefreshTailAsync">Refresh</button>
        </div>

        <div class="well max-h-[32rem] overflow-auto p-1" role="log" aria-label="Recent log output">
            <div class="sticky top-0 z-10 grid grid-cols-[5.5rem_3.5rem_15rem_minmax(24rem,1fr)] gap-3 rounded-sm bg-chassis px-3 py-2 font-display text-3xs font-semibold uppercase tracking-wide text-on-chassis-soft">
                <span>Time</span><span>Level</span><span>Source</span><span>Message</span>
            </div>
            @if (FilteredLogRows.Count == 0)
            {
                <p class="p-6 text-center text-sm text-muted">No log entries match the current filters.</p>
            }
            else
            {
                @foreach (var row in FilteredLogRows)
                {
                    <details class="group border-b border-line-soft last:border-0">
                        <summary class="grid cursor-pointer list-none grid-cols-[5.5rem_3.5rem_15rem_minmax(24rem,1fr)] items-start gap-3 px-3 py-2 text-xs hover:bg-surface-inset">
                            <time class="font-mono text-2xs tabular-nums text-muted" title="@row.Timestamp">@row.Time</time>
                            <span class="@($"badge w-fit {LevelClass(row.Level)}")">@row.Level</span>
                            <span class="truncate font-mono text-2xs text-ink-soft" title="@row.Source">@ShortSource(row.Source)</span>
                            <span class="min-w-0 break-words leading-relaxed text-ink">@row.Message</span>
                        </summary>
                        <pre class="mx-3 mb-2 overflow-x-auto whitespace-pre-wrap rounded-sm bg-well-deep p-3 font-mono text-2xs leading-relaxed text-ink-soft">@row.Raw</pre>
                    </details>
                }
            }
        </div>
    </div>
</section>

@code {
    private const int MaxTailLines = 200;

    private string _appVersion = string.Empty;
    private string _dbPath = string.Empty;
    private string _dbSize = string.Empty;
    private string _logDirectory = string.Empty;
    private string _todayLogPath = string.Empty;
    private string _logTail = string.Empty;
    private IReadOnlyList<LogRow> _logRows = [];
    private string _levelFilter = "All";
    private string _logSearch = string.Empty;
    private string? _bundlePath;
    private bool _bundling;

    protected override async Task OnInitializedAsync()
    {
        LoadInfo();
        await RefreshTailAsync();
    }

    private void LoadInfo()
    {
        var info = ApplicationDiagnostics.GetInfo();
        _appVersion = info.ApplicationVersion;
        _dbPath = info.DatabasePath;
        _dbSize = info.DatabaseSize;
        _logDirectory = info.LogDirectory;
        _todayLogPath = info.CurrentLogPath;
    }

    private async Task RefreshTailAsync()
    {
        LoadInfo();
        _logTail = await ApplicationDiagnostics.ReadRecentLogAsync(MaxTailLines);
        _logRows = ParseLog(_logTail);
    }

    private static readonly string[] LogLevels = ["All", "ERR", "WRN", "INF", "DBG"];
    private IReadOnlyList<LogRow> FilteredLogRows => _logRows
        .Where(x => _levelFilter == "All" || x.Level == _levelFilter)
        .Where(x => string.IsNullOrWhiteSpace(_logSearch) || x.Source.Contains(_logSearch, StringComparison.OrdinalIgnoreCase) || x.Message.Contains(_logSearch, StringComparison.OrdinalIgnoreCase) || x.Raw.Contains(_logSearch, StringComparison.OrdinalIgnoreCase))
        .Reverse()
        .ToArray();

    private int LevelCount(string level) => level == "All" ? _logRows.Count : _logRows.Count(x => x.Level == level);
    private string LogFilterClass(string level) => $"flex min-w-[4.75rem] items-center justify-between gap-2 rounded-md border px-2.5 py-1.5 text-xs font-semibold transition-colors {(_levelFilter == level ? "border-primary bg-primary-soft text-primary shadow-control" : "border-line bg-surface text-ink-soft hover:border-line-strong hover:bg-surface-inset")}";
    private static string LogFilterDotClass(string level) => $"h-1.5 w-1.5 rounded-full {level switch { "ERR" => "bg-critical", "WRN" => "bg-warning", "INF" => "bg-info", "DBG" => "bg-muted", _ => "bg-primary" }}";
    private static string ShortSource(string source) => source.StartsWith("EngineeringPerformance.", StringComparison.Ordinal) ? source[23..] : source;
    private static string LevelClass(string level) => level switch
    {
        "ERR" or "FTL" => "bg-critical-soft text-critical",
        "WRN" => "bg-warning-soft text-warning",
        "INF" => "bg-info-soft text-info",
        _ => "bg-surface-inset text-muted"
    };

    private static IReadOnlyList<LogRow> ParseLog(string text)
    {
        var rows = new List<LogRow>();
        var pattern = new System.Text.RegularExpressions.Regex(
            @"^(?<timestamp>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3} [+-]\d{2}:\d{2}) \[(?<level>[A-Z]{3})\] (?<source>[^:]+): (?<message>.*)$",
            System.Text.RegularExpressions.RegexOptions.Compiled);

        foreach (var line in text.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries))
        {
            var match = pattern.Match(line);
            if (match.Success)
            {
                var timestamp = match.Groups["timestamp"].Value;
                rows.Add(new LogRow(timestamp, timestamp.Substring(11, 12), match.Groups["level"].Value, match.Groups["source"].Value, match.Groups["message"].Value, line));
            }
            else if (rows.Count > 0)
            {
                var previous = rows[^1];
                rows[^1] = previous with { Raw = previous.Raw + Environment.NewLine + line };
            }
        }

        return rows;
    }

    private sealed record LogRow(string Timestamp, string Time, string Level, string Source, string Message, string Raw);

    private async Task CreateBundleAsync()
    {
        _bundling = true;
        _bundlePath = null;
        StateHasChanged();

        try
        {
            _bundlePath = await ApplicationDiagnostics.CreateBundleAsync();
            State.ShowMessage($"Diagnostics bundle saved to {_bundlePath}");
        }
        catch (Exception ex)
        {
            State.ShowMessage($"Could not build diagnostics bundle: {ex.Message}", true);
        }
        finally
        {
            _bundling = false;
        }
    }
}
