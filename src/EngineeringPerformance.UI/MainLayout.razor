@using EngineeringPerformance.Application
@using EngineeringPerformance.Domain
@using Microsoft.Extensions.Logging
@inherits LayoutComponentBase
@inject AppState State
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<MainLayout> Logger
@implements IDisposable

<PageTitle>EOS — Engineering Performance</PageTitle>

<div class="flex h-screen min-w-[900px] bg-canvas font-sans text-ink">
    <aside class="chassis flex w-60 shrink-0 flex-col border-r border-chassis-deep">
        <div class="flex flex-col gap-1 px-5 pb-5 pt-6" aria-label="EOS Engineering Performance Analyzer">
            <strong class="flex items-center gap-2 font-display text-lg font-semibold tracking-wide text-primary">
                <i aria-hidden="true" class="not-italic drop-shadow-[0_0_6px_var(--color-primary-glow)]">✦</i><span>EOS</span>
            </strong>
            <small class="label-instrument !text-on-chassis-muted">Engineering performance analyzer</small>
        </div>
        <nav class="flex flex-1 flex-col gap-0.5 overflow-y-auto px-3 pb-4">
            <span class="label-instrument mb-1 mt-3 px-2 !text-on-chassis-muted">Analyze</span>
            @NavButton("overview", "Overview", Icon.Overview)
            @NavButton("timesheets", "Timesheets", Icon.Timesheets)
            @NavButton("peer-insights", "Peer Insights", Icon.PeerInsights)
            @NavButton("reports", "Reports", Icon.Reports)
            @NavButton("team-comparison", "Team Comparison", Icon.Employees)

            <span class="label-instrument mb-1 mt-3 px-2 !text-on-chassis-muted">Manage</span>
            @NavButton("imports", "Data Imports", Icon.Imports)
            @NavButton("data", "Imported Data", Icon.DataBrowser)
            @NavButton("employees", "Employees & Teams", Icon.Employees)
            @NavButton("templates", "Review Templates", Icon.Templates)

            <span class="label-instrument mb-1 mt-3 px-2 !text-on-chassis-muted">Configure</span>
            @NavButton("scoring", "Scoring", Icon.Scoring)
            @NavButton("diagnostics", "Diagnostics", Icon.Settings)
            @NavButton("backup", "Backup & Restore", Icon.Settings)
        </nav>
        <div class="border-t border-chassis-deep px-3 py-3">
            <button class="@NavButtonClass("settings")" @onclick='() => Navigation.NavigateTo("/settings")'>
                <b class="flex h-[18px] w-[18px] items-center justify-center">@((MarkupString)Icon.Settings)</b><span>Settings</span>
            </button>
            <small class="mt-2 block px-2 text-3xs text-on-chassis-muted">Local analysis · SQLite</small>
        </div>
    </aside>

    <section class="flex min-w-0 flex-1 flex-col">
        <header class="chassis flex items-center justify-between gap-4 border-b border-chassis-deep px-6 py-3">
            <h1 class="font-display text-xl font-semibold tracking-tight text-on-chassis">@PageTitleText</h1>

            <div class="flex items-center gap-2.5">
                <div class="track flex items-center gap-1 px-1.5 py-1 text-xs">
                    <button class="rounded-sm px-1.5 text-on-chassis-soft transition-colors duration-100 hover:bg-chassis/70 hover:text-on-chassis disabled:opacity-25" title="Previous month" aria-label="Previous month" disabled="@(!State.CanGoPrevious)" @onclick="PreviousMonthAsync">‹</button>
                    <strong class="font-display text-sm font-semibold tabular-nums text-on-chassis">@State.SelectedMonth.ToString("MMM yyyy")</strong>
                    <button class="rounded-sm px-1.5 text-on-chassis-soft transition-colors duration-100 hover:bg-chassis/70 hover:text-on-chassis disabled:opacity-25" title="Next month" aria-label="Next month" disabled="@(!State.CanGoNext)" @onclick="NextMonthAsync">›</button>
                </div>

                <button type="button"
                        class="control flex h-8 w-8 items-center justify-center !rounded-md text-ink-soft hover:control-hover active:control-pressed"
                        title="@ThemeTooltip"
                        aria-label="@ThemeTooltip"
                        @onclick="CycleThemeAsync">
                    @((MarkupString)ThemeIcon)
                </button>

                <div class="relative">
                    <button type="button"
                            class="@($"control flex h-8 w-8 items-center justify-center !rounded-md hover:control-hover active:control-pressed {(_searchOpen ? "!bg-primary-soft text-primary" : "text-ink-soft")}")"
                            title="Search engineers"
                            aria-label="Search engineers"
                            aria-expanded="@_searchOpen"
                            @onclick="ToggleSearch">
                        @((MarkupString)Icon.Search)
                    </button>
                    @if (_searchOpen)
                    {
                        <div class="glass absolute right-0 top-11 z-20 w-80 p-2">
                            <div class="well flex items-center gap-2 px-2.5 py-1.5">
                                <span class="text-muted">@((MarkupString)Icon.Search)</span>
                                <input autofocus
                                       class="flex-1 bg-transparent text-sm text-ink outline-none placeholder:text-muted"
                                       value="@_searchQuery"
                                       @oninput="OnSearchInput"
                                       @onkeydown="OnSearchKeyDown"
                                       placeholder="Search engineer or employee code" />
                                <button type="button" class="text-muted hover:text-ink" title="Close search" @onclick="CloseSearch">×</button>
                            </div>
                            <div class="mt-1 max-h-80 overflow-y-auto">
                                @if (SearchResults.Count == 0)
                                {
                                    <p class="px-2.5 py-3 text-xs text-muted">@(string.IsNullOrWhiteSpace(_searchQuery) ? "Type a name or employee code." : "No matching engineer.")</p>
                                }
                                else
                                {
                                    @foreach (var result in SearchResults)
                                    {
                                        <button type="button" class="flex w-full items-center gap-2.5 rounded-md px-2.5 py-2 text-left transition-colors duration-100 hover:bg-surface-inset" @onclick="() => OpenEmployee(result.Name)">
                                            <span class="well flex h-7 w-7 shrink-0 items-center justify-center !rounded-full font-display text-xs font-semibold text-ink-soft">@Analytics.Initials(result.Name)</span>
                                            <span class="flex min-w-0 flex-1 flex-col"><strong class="truncate text-sm font-medium text-ink">@result.Name</strong><small class="text-xs tabular-nums text-muted">@result.EmployeeCode</small></span>
                                            @if (result.Score is not null)
                                            {
                                                <b class="@($"metric text-sm {Analytics.BandTextClass(Analytics.ScoreBand(result.Score.Value))}")">@Analytics.Format(result.Score.Value)</b>
                                            }
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="track flex items-center gap-2 px-2.5 py-1.5" title="System and review inputs available for the selected month">
                    <span class="label-instrument !text-on-chassis-muted">Ready</span>
                    <span class="flex items-center gap-1" aria-label="@State.ReadyCount of 4 inputs available">
                        @for (var i = 0; i < 4; i++)
                        {
                            <i class="@($"h-2 w-2 {(i < State.ReadyCount ? "lamp text-good" : "lamp-off")}")"></i>
                        }
                    </span>
                    <strong class="font-display text-xs font-semibold tabular-nums text-on-chassis">@State.ReadyCount/4</strong>
                </div>
            </div>
        </header>

        @if (!string.IsNullOrEmpty(State.Message))
        {
            <div class="px-6 pt-3">
                <div class="@($"flex items-center justify-between rounded-lg border px-4 py-2.5 text-sm {(State.IsError ? "border-critical-soft bg-critical-soft text-critical" : "border-good-soft bg-good-soft text-good")}")">
                    <span>@State.Message</span>
                    <button class="ml-3 text-lg leading-none opacity-70 hover:opacity-100" @onclick="State.ClearMessage">×</button>
                </div>
            </div>
        }

        <main class="@($"route-{CurrentRoute} min-w-0 flex-1 overflow-y-auto p-6")">
            @Body
        </main>
        <footer class="chassis flex justify-between border-t border-chassis-deep px-6 py-2">
            <span class="label-instrument !text-on-chassis-muted">Data freshness · refreshed <span class="tabular-nums">@State.LastRefresh.ToString("h:mm tt")</span></span>
            <span class="label-instrument !text-on-chassis-muted">Local SQLite · @State.SelectedMonth.ToString("MMMM yyyy")</span>
            <span class="label-instrument !text-on-chassis-muted">v@AppVersion</span>
        </footer>
    </section>
</div>

@code {
    private bool _searchOpen;
    private string _searchQuery = string.Empty;

    private static readonly string AppVersion =
        System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "1.1.0";

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Logger.LogDebug("Shell initialized. Uri={Uri}", Navigation.Uri);
        await State.RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var p = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "EngineeringPerformance");
            Directory.CreateDirectory(p);
            File.WriteAllText(Path.Combine(p, "ui-ready.marker"), DateTime.UtcNow.ToString("O"));
            await State.LoadThemeAsync(JS);
        }
    }

    private Task CycleThemeAsync() => State.SetThemeAsync(JS, State.ThemeMode switch
    {
        "light" => "dark",
        "dark" => "system",
        _ => "light"
    });

    private string ThemeTooltip => State.ThemeMode switch
    {
        "light" => "Theme: Light — click for Dark",
        "dark" => "Theme: Dark — click for System",
        _ => "Theme: System — click for Light"
    };

    private string ThemeIcon => State.ThemeMode switch
    {
        "light" => Icon.Sun,
        "dark" => Icon.Moon,
        _ => Icon.System
    };

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Logger.LogDebug(
            "Navigation changed. Location={Location} Intercepted={IsNavigationIntercepted}",
            e.Location,
            e.IsNavigationIntercepted);
        State.ClearMessage();
        _searchOpen = false;
        _searchQuery = string.Empty;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private string CurrentRoute
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
            var slash = relative.IndexOf('/');
            var first = slash < 0 ? relative : relative[..slash];
            return string.IsNullOrEmpty(first) ? "overview" : first;
        }
    }

    private string? CurrentEmployeeName
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
            if (!relative.StartsWith("employee/", StringComparison.OrdinalIgnoreCase)) return null;
            return Uri.UnescapeDataString(relative["employee/".Length..]);
        }
    }

    private string PageTitleText => CurrentRoute switch
    {
        "imports" => "Data imports",
        "data" => "Imported data",
        "timesheets" => "Timesheets",
        "employees" => "Employees & teams",
        "peer-insights" => "Peer insights",
        "templates" => "Review templates",
        "reports" => "Reports",
        "team-comparison" => "Team comparison",
        "scoring" => "Scoring",
        "backup" => "Backup & restore",
        "settings" => "Settings",
        "diagnostics" => "Diagnostics",
        "employee" => State.SpotlightName ?? CurrentEmployeeName ?? "Employee portrait",
        _ => "Team performance"
    };

    private IReadOnlyList<SearchResult> SearchResults
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchQuery)) return [];
            var query = _searchQuery.Trim();
            var performance = State.Performance.ToDictionary(x => PersonName.Normalize(x.EmployeeName), StringComparer.OrdinalIgnoreCase);
            return State.Employees
                .Where(x => x.Name.Contains(query, StringComparison.OrdinalIgnoreCase) || x.EmployeeCode.Contains(query, StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Name.StartsWith(query, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(x => x.Name)
                .Take(10)
                .Select(x => new SearchResult(
                    x.Name,
                    x.EmployeeCode,
                    performance.TryGetValue(PersonName.Normalize(x.Name), out var row) ? row.OperationalScore : null))
                .ToArray();
        }
    }

    private void ToggleSearch()
    {
        _searchOpen = !_searchOpen;
        if (!_searchOpen) _searchQuery = string.Empty;
    }

    private void CloseSearch()
    {
        _searchOpen = false;
        _searchQuery = string.Empty;
    }

    private void OnSearchInput(ChangeEventArgs args) => _searchQuery = args.Value?.ToString() ?? string.Empty;

    private void OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseSearch();
        else if (args.Key == "Enter" && SearchResults.FirstOrDefault() is { } first) OpenEmployee(first.Name);
    }

    private void OpenEmployee(string name)
    {
        CloseSearch();
        Navigation.NavigateTo($"/employee/{Uri.EscapeDataString(name)}");
    }

    private async Task PreviousMonthAsync()
    {
        CloseSearch();
        var before = State.SelectedMonth;
        Logger.LogDebug("Previous month requested. FromMonth={FromMonth:yyyy-MM}", before);
        try
        {
            await State.PreviousMonthAsync();
            Logger.LogDebug(
                "Previous month completed. FromMonth={FromMonth:yyyy-MM} ToMonth={ToMonth:yyyy-MM}",
                before,
                State.SelectedMonth);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Previous month navigation failed. FromMonth={FromMonth:yyyy-MM}", before);
            throw;
        }
    }

    private async Task NextMonthAsync()
    {
        CloseSearch();
        var before = State.SelectedMonth;
        Logger.LogDebug("Next month requested. FromMonth={FromMonth:yyyy-MM}", before);
        try
        {
            await State.NextMonthAsync();
            Logger.LogDebug(
                "Next month completed. FromMonth={FromMonth:yyyy-MM} ToMonth={ToMonth:yyyy-MM}",
                before,
                State.SelectedMonth);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Next month navigation failed. FromMonth={FromMonth:yyyy-MM}", before);
            throw;
        }
    }

    private RenderFragment NavButton(string route, string label, string icon) =>
        @<button class="@NavButtonClass(route)" @onclick="() => GoTo(route)">
            <b class="flex h-[18px] w-[18px] items-center justify-center">@((MarkupString)icon)</b><span>@label</span>
        </button>;

    private string NavButtonClass(string route) => CurrentRoute == route
        ? "relative flex items-center gap-3 rounded-md bg-chassis-deep px-3 py-2 font-display text-sm font-semibold text-on-chassis inset-shadow-track before:absolute before:left-0 before:top-1/2 before:h-4 before:w-[3px] before:-translate-y-1/2 before:rounded-full before:bg-primary before:shadow-[0_0_8px_0_var(--color-primary-glow)]"
        : "flex items-center gap-3 rounded-md px-3 py-2 font-display text-sm font-medium text-on-chassis-soft transition-colors duration-100 ease-press hover:bg-chassis-deep/60 hover:text-on-chassis";

    private void GoTo(string route)
    {
        Logger.LogDebug("Navigation requested. FromRoute={FromRoute} ToRoute={ToRoute}", CurrentRoute, route);
        Navigation.NavigateTo($"/{route}");
    }

    private sealed record SearchResult(string Name, string EmployeeCode, decimal? Score);

    private static class Icon
    {
        private const string Wrap = "<svg viewBox=\"0 0 20 20\" width=\"18\" height=\"18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">{0}</svg>";
        private static string Svg(string paths) => string.Format(Wrap, paths);
        private const string Stroke = "stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"";

        public static readonly string Search = Svg($"<circle cx=\"8.7\" cy=\"8.7\" r=\"4.7\" {Stroke}/><path d=\"m12.2 12.2 3.7 3.7\" {Stroke}/>");
        public static readonly string Overview = Svg($"<path d=\"M3 10.5 10 4l7 6.5\" {Stroke}/><path d=\"M5 9v7h10V9\" {Stroke}/><path d=\"M8 16v-4h4v4\" {Stroke}/>");
        public static readonly string Imports = Svg($"<path d=\"M10 13V4\" {Stroke}/><path d=\"M6.5 7.5 10 4l3.5 3.5\" {Stroke}/><path d=\"M4 13v3h12v-3\" {Stroke}/>");
        public static readonly string DataBrowser = Svg($"<rect x=\"3.5\" y=\"4.5\" width=\"13\" height=\"11\" rx=\"1.6\" {Stroke}/><path d=\"M3.5 8.2h13M8.2 8.2V15.5M12.6 8.2V15.5\" {Stroke}/>");
        public static readonly string Timesheets = Svg($"<rect x=\"4\" y=\"4\" width=\"12\" height=\"12\" rx=\"2.5\" {Stroke}/><path d=\"M7 10.2 9 12l4-4.2\" {Stroke}/>");
        public static readonly string Employees = Svg($"<circle cx=\"7.5\" cy=\"7\" r=\"2.4\" {Stroke}/><path d=\"M3.2 16c.5-2.7 2.2-4.2 4.3-4.2s3.8 1.5 4.3 4.2\" {Stroke}/><circle cx=\"14.2\" cy=\"7.6\" r=\"1.9\" {Stroke}/><path d=\"M13 11.9c1.9.2 3.1 1.5 3.6 3.9\" {Stroke}/>");
        public static readonly string PeerInsights = Svg($"<path d=\"M4 6h9l-2.2-2.2\" {Stroke}/><path d=\"M16 14H7l2.2 2.2\" {Stroke}/>");
        public static readonly string Templates = Svg($"<rect x=\"4.5\" y=\"3.5\" width=\"11\" height=\"13\" rx=\"1.6\" {Stroke}/><path d=\"M7 7.5h6M7 10.5h6M7 13.5h3.5\" {Stroke}/>");
        public static readonly string Reports = Svg($"<path d=\"M4.5 16V9.5M10 16V4M15.5 16v-6\" {Stroke}/>");
        public static readonly string Scoring = Svg($"<circle cx=\"10\" cy=\"10\" r=\"6.2\" {Stroke}/><circle cx=\"10\" cy=\"10\" r=\"2.6\" {Stroke}/>");
        public static readonly string Settings = Svg($"<circle cx=\"10\" cy=\"10\" r=\"2.6\" {Stroke}/><path d=\"M10 3.6v1.8M10 14.6v1.8M16.4 10h-1.8M5.4 10H3.6M14.6 5.4l-1.3 1.3M6.7 13.3l-1.3 1.3M14.6 14.6l-1.3-1.3M6.7 6.7 5.4 5.4\" {Stroke}/>");
        public static readonly string Sun = Svg($"<circle cx=\"10\" cy=\"10\" r=\"3.3\" {Stroke}/><path d=\"M10 2.8v1.7M10 15.5v1.7M17.2 10h-1.7M4.5 10H2.8M15.1 4.9l-1.2 1.2M6.1 13.9l-1.2 1.2M15.1 15.1l-1.2-1.2M6.1 6.1l-1.2-1.2\" {Stroke}/>");
        public static readonly string Moon = Svg($"<path d=\"M16.2 12.6A6.4 6.4 0 1 1 7.4 3.8a7.2 7.2 0 0 0 8.8 8.8Z\" {Stroke}/>");
        public static readonly string System = Svg($"<rect x=\"3.4\" y=\"4.4\" width=\"13.2\" height=\"9.2\" rx=\"1.5\" {Stroke}/><path d=\"M7.3 16.4h5.4M10 13.6v2.8\" {Stroke}/>");
    }
}
