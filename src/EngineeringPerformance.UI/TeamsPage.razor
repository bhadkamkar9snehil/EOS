@using EngineeringPerformance.Application

@* Team definitions and membership. Purely organizational — teams group people for
   reporting and mail routing; they do not change how anyone is scored. *@

<section class="single-pane">
    <div class="section-title">
        <div>
            <h2>Teams</h2>
            <p>Create teams and assign engineers. Consultant status comes from the ERP roster and consultants are always non-billable. Probation defaults from the roster's completion date but can be corrected per person; non-billable is otherwise a local classification you control.</p>
        </div>
    </div>

    <div class="form-row">
        <label class="grow">New team name<input @bind="_newTeamName" placeholder="e.g. X-Force Execution" @onkeydown="OnNewTeamKeyDown" /></label>
        <button class="action" @onclick="AddTeamAsync" disabled="@_busy">Create team</button>
    </div>

    <div class="team-grid">
        @foreach (var team in Teams)
        {
            <div class="team-card">
                <div class="team-card-head">
                    <input class="cell-input team-name" value="@(_editNames.TryGetValue(team.Id, out var n) ? n : team.Name)"
                           @onchange="e => _editNames[team.Id] = e.Value?.ToString() ?? string.Empty" />
                    <span class="team-count">@team.MemberCount</span>
                </div>
                <div class="team-card-actions">
                    <button class="action small" @onclick="() => RenameTeamAsync(team)" disabled="@(_busy || !IsRenamed(team))">Rename</button>
                    <button class="danger" @onclick="() => DeleteTeamAsync(team)" disabled="@_busy">Delete</button>
                </div>
            </div>
        }
        @if (Teams.Count == 0)
        {
            <p class="chart-note">No teams yet. Create one above, then assign engineers below.</p>
        }
    </div>

    <h3 class="sub-head">Membership &amp; classification</h3>
    <div class="data-table">
        <div class="table-head roster">
            <span>Code</span><span>Engineer</span><span>Team</span><span>Billable</span><span>Employment</span>
        </div>
        @foreach (var employee in Employees)
        {
            <div class="data-row roster">
                <code>@employee.EmployeeCode</code>
                <span class="roster-name">
                    @employee.Name
                    @if (!string.IsNullOrWhiteSpace(employee.Email))
                    {
                        <small>@employee.Email</small>
                    }
                </span>
                <select class="team-select" value="@(employee.TeamId?.ToString() ?? "")"
                        @onchange="e => AssignTeamAsync(employee, e.Value?.ToString())">
                    <option value="">— Unassigned —</option>
                    @foreach (var team in Teams)
                    {
                        <option value="@team.Id">@team.Name</option>
                    }
                </select>
                <label class="switch" title="@(employee.IsConsultant ? "Consultants are always non-billable" : "Non-billable engineers are excluded from billable-capacity tracking")">
                    <input type="checkbox" checked="@(!employee.IsNonBillable)" disabled="@employee.IsConsultant"
                           @onchange="e => SetNonBillableAsync(employee, !(bool)(e.Value ?? false))" />
                    <span>@(employee.IsNonBillable ? "Non-billable" : "Billable")</span>
                </label>
                <span class="tag-row">
                    @if (employee.IsConsultant)
                    {
                        <span class="tag consultant">Consultant</span>
                    }
                    <select class="team-select probation-select" value="@(employee.ProbationOverride is null ? "auto" : employee.ProbationOverride.Value ? "on" : "off")"
                            title="Probation status — Auto follows the ERP roster's completion date"
                            @onchange="e => SetProbationAsync(employee, e.Value?.ToString())">
                        <option value="auto">Probation: Auto (@(employee.IsOnProbation ? "on" : "off"))</option>
                        <option value="on">Probation: On</option>
                        <option value="off">Probation: Off</option>
                    </select>
                    @if (!employee.IsConsultant && !employee.IsOnProbation)
                    {
                        <span class="tag muted">Permanent</span>
                    }
                </span>
            </div>
        }
        @if (Employees.Count == 0)
        {
            <div class="table-empty">No employees yet. Import the ERP roster on the Employees screen.</div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EmployeeListItem> Employees { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<TeamItem> Teams { get; set; } = [];
    [Parameter] public EventCallback<(string Message, bool IsError)> OnResult { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public IApplicationDatabase Database { get; set; } = default!;

    private string _newTeamName = string.Empty;
    private bool _busy;
    private readonly Dictionary<int, string> _editNames = [];

    private bool IsRenamed(TeamItem team) =>
        _editNames.TryGetValue(team.Id, out var name) && !string.IsNullOrWhiteSpace(name) && name.Trim() != team.Name;

    private async Task OnNewTeamKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTeamAsync();
    }

    private async Task AddTeamAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTeamName))
        {
            await OnResult.InvokeAsync(("Enter a team name first.", true));
            return;
        }
        await RunAsync(async () =>
        {
            await Database.AddTeamAsync(_newTeamName);
            var created = _newTeamName.Trim();
            _newTeamName = string.Empty;
            await OnResult.InvokeAsync(($"Team “{created}” created.", false));
        });
    }

    private async Task RenameTeamAsync(TeamItem team)
    {
        var name = _editNames[team.Id];
        await RunAsync(async () =>
        {
            await Database.RenameTeamAsync(team.Id, name);
            _editNames.Remove(team.Id);
            await OnResult.InvokeAsync(($"Team renamed to “{name.Trim()}”.", false));
        });
    }

    private async Task DeleteTeamAsync(TeamItem team) =>
        await RunAsync(async () =>
        {
            await Database.DeleteTeamAsync(team.Id);
            await OnResult.InvokeAsync(($"Team “{team.Name}” deleted; {team.MemberCount} member(s) unassigned.", false));
        });

    private async Task AssignTeamAsync(EmployeeListItem employee, string? teamId) =>
        await RunAsync(async () =>
        {
            int? id = int.TryParse(teamId, out var parsed) ? parsed : null;
            await Database.AssignTeamAsync(employee.Id, id);
            await OnResult.InvokeAsync(($"{employee.Name} {(id is null ? "unassigned" : "assigned")}.", false));
        });

    private async Task SetNonBillableAsync(EmployeeListItem employee, bool nonBillable) =>
        await RunAsync(async () =>
        {
            await Database.SetNonBillableAsync(employee.Id, nonBillable);
            await OnResult.InvokeAsync(($"{employee.Name} marked {(nonBillable ? "non-billable" : "billable")}.", false));
        });

    private async Task SetProbationAsync(EmployeeListItem employee, string? mode) =>
        await RunAsync(async () =>
        {
            bool? value = mode switch { "on" => true, "off" => false, _ => null };
            await Database.SetProbationAsync(employee.Id, value);
            await OnResult.InvokeAsync(($"{employee.Name} probation set to {(value is null ? "auto (roster)" : value.Value ? "on" : "off")}.", false));
        });

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        try { await action(); await OnChanged.InvokeAsync(); }
        catch (Exception ex) { await OnResult.InvokeAsync((ex.Message, true)); }
        finally { _busy = false; }
    }
}
