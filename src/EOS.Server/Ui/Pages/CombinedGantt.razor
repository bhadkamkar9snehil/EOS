@page "/gantt"
@inherits EosPage
@using EOS.Infrastructure.Projects
<PageTitle>Gantt · EOS</PageTitle>

<div class="page">
    <div class="page-head">
        <h1>Gantt</h1>
        <div class="actions">
            <span class="seg" role="group" aria-label="Group by">
                <button class="@(_view == "project" ? "on" : "")" @onclick='() => SetView("project")'>By project</button>
                <button class="@(_view == "engineer" ? "on" : "")" @onclick='() => SetView("engineer")'>By engineer</button>
            </span>
            <label class="inline"><input type="checkbox" @bind="_hideDone" @bind:after="Build" /> Hide completed</label>
        </div>
    </div>

    @if (Loading && _plans is null) { <p class="muted">Loading…</p> }
    else if (LoadError is not null) { <div class="plate error">@LoadError</div> }
    else
    {
        <GanttChart Rows="@_rows" Links="@_links" Today="@AsOf" ExpandToLevel="1" LabelWidth="360" MaxHeight="74vh" />
    }
</div>

@code {
    private List<PlanView>? _plans;
    private Dictionary<int, string> _health = [];
    private List<GanttChart.Row> _rows = [];
    private List<GanttChart.Link> _links = [];
    private string _view = "project";
    private bool _hideDone;

    protected override async Task LoadAsync()
    {
        var asOf = AsOf;
        var projects = await Q(sp => sp.GetRequiredService<ProjectService>().ListAsync(withPlanOnly: true));
        _plans = [];
        foreach (var p in projects.Where(p => p.HasPlan))
            _plans.Add(await Q(sp => sp.GetRequiredService<PlanService>().GetPlanAsync(p.Id)));
        _health = (await Q(sp => sp.GetRequiredService<HealthService>().GetAllAsync(asOf))).ToDictionary(h => h.ProjectId, h => h.Health);
        Build();
    }

    private void SetView(string v) { _view = v; Build(); }

    private void Build()
    {
        _rows = []; _links = [];
        if (_view == "engineer") { BuildByEngineer(); return; }
        foreach (var p in (_plans ?? []).Where(p => p.Start is not null).OrderBy(p => p.Start))
        {
            if (_hideDone && p.Progress >= 1m) continue;
            var h = _health.GetValueOrDefault(p.ProjectId);
            _rows.Add(new GanttChart.Row($"{p.ProjectNo}  {Names.Short(p.ProjectName)}", 0, p.Start, p.Finish, p.Progress, h == "At Risk", true,
                Tooltip: $"{p.ProjectNo} {p.ProjectName} · {h}", Href: "/projects/" + p.ProjectId, Key: "p" + p.ProjectId));
            foreach (var t in p.Tasks.Where(t => t.Start is not null))
                _rows.Add(new GanttChart.Row(t.Name, t.Level + 1, t.Start, t.Finish, t.PercentComplete, t.IsCritical, t.IsSummary, t.Kind == "milestone",
                    t.Wbs + " " + t.Name, null, t.Status, Key: "t" + t.Id));
            foreach (var l in p.Links) _links.Add(new GanttChart.Link("t" + l.PredecessorId, "t" + l.SuccessorId, l.Type));
        }
    }

    private void BuildByEngineer()
    {
        var items = (_plans ?? []).SelectMany(p => p.Tasks.Where(t => !t.IsSummary && t.Start is not null && !(_hideDone && t.PercentComplete >= 1m))
            .SelectMany(t => t.Assignments.Where(a => a.PersonName is not null).Select(a => (Person: a.PersonName!, Plan: p, Task: t)))).ToList();
        foreach (var g in items.GroupBy(x => x.Person).OrderBy(g => g.Key))
        {
            _rows.Add(new GanttChart.Row(g.Key, 0, g.Min(x => x.Task.Start), g.Max(x => x.Task.Finish), 0, false, true, Tooltip: $"{g.Count()} assigned tasks", Key: "e" + g.Key));
            foreach (var x in g.OrderBy(x => x.Task.Start))
                _rows.Add(new GanttChart.Row($"{x.Plan.ProjectNo} · {x.Task.Name}", 1, x.Task.Start, x.Task.Finish, x.Task.PercentComplete, x.Task.IsCritical, false, false,
                    x.Task.Wbs + " " + x.Task.Name, "/projects/" + x.Plan.ProjectId));
        }
    }
}
