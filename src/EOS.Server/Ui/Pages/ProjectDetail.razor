@page "/projects/{Id:int}"
@inherits EosPage
@using EOS.Infrastructure.Hosting
@using EOS.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
<PageTitle>@(_plan?.ProjectNo ?? "Project") · EOS</PageTitle>

<div class="page">
    @if (Loading && _plan is null) { <p class="muted">Loading…</p> }
    else if (LoadError is not null) { <div class="plate error">@LoadError</div> }
    else if (_plan is not null)
    {
        <div class="page-head">
            <div>
                <h1>@_plan.ProjectNo <span class="muted" style="font-weight:400">@_plan.ProjectName</span></h1>
                <p class="muted">
                    @(_plan.Start?.ToString("dd MMM yyyy") ?? "unscheduled") → @(_plan.Finish?.ToString("dd MMM yyyy") ?? "–") ·
                    @((_plan.Progress * 100).ToString("0"))% complete · @_plan.Tasks.Count tasks
                    @if (_health is not null) { <text> · </text><HealthBadge Health="@_health.Health" Title="@string.Join("; ", _health.Reasons)" /> }
                </p>
            </div>
            <div class="actions">
                <button class="secondary" @onclick="Recompute">Recompute schedule</button>
                <button class="secondary" @onclick="SaveBaseline">Save baseline</button>
                <a class="btn secondary" href="/projects/@Id/status">Status report</a>
                <a class="btn secondary" href="/projects">All projects</a>
            </div>
        </div>

        @foreach (var w in _plan.Warnings) { <div class="plate warn">@w</div> }

        <div class="tabs">
            @foreach (var t in new[] { "plan", "gantt", "team", "actuals", "environments", "baseline", "details" })
            {
                <button class="tab @(_tab == t ? "on" : "")" @onclick="() => _tab = t">@(char.ToUpper(t[0]) + t[1..])</button>
            }
        </div>

        @if (_tab == "plan")
        {
            <div class="plate planplate">
                <div class="addtask">
                    <input @bind="_newTask" placeholder="New task name" aria-label="New task name" />
                    <input type="number" @bind="_newWork" aria-label="Work hours" title="Work hours" />
                    <span class="muted small">h</span>
                    <button @onclick="AddTask">Add task</button>
                    @if (_plan.Tasks.Any(t => t.Origin != "eos")) { <span class="spacer"></span><span class="muted small">Tasks imported from the @(_plan.Tasks.First(t => t.Origin != "eos").Origin) are marked ⟵</span> }
                </div>
            @if (_plan.Tasks.Count == 0) { <div class="empty">No tasks. Add one above, or import this project's plan from the ERP/tracker under Imports.</div> }
            else
            {
                    <div class="rowtools" role="toolbar" aria-label="Selected task actions">
                        @if (Sel() is { } cur)
                        {
                            <span class="rowtools-name"><b>@cur.Wbs</b> @Short(cur.Name, 60)</span>
                            <button class="secondary" @onclick="() => Move(cur.Id, MoveDirection.Up)">Move up</button>
                            <button class="secondary" @onclick="() => Move(cur.Id, MoveDirection.Down)">Move down</button>
                            <button class="secondary" @onclick="() => Move(cur.Id, MoveDirection.Indent)">Indent</button>
                            <button class="secondary" @onclick="() => Move(cur.Id, MoveDirection.Outdent)">Outdent</button>
                            <span class="spacer"></span>
                            <button class="danger" @onclick="() => Delete(cur.Id)">Delete task</button>
                        }
                        else { <span class="muted">Select a row (click, or Tab and arrow keys). Alt+arrows move and indent, Enter renames, Delete removes.</span> }
                    </div>
                    <div class="tablewrap" style="max-height:70vh;overflow:auto">
                    <table class="grid freeze">
                        <thead><tr><th>WBS</th><th>Task</th><th class="num">Work h</th><th class="num">%</th><th>Start</th><th>Finish</th><th class="num">Float</th><th>Status</th><th>Assigned</th></tr></thead>
                        <tbody>
                        @foreach (var t in _plan.Tasks)
                        {
                            <tr class="@(_selected == t.Id ? "sel" : "") @(t.IsCritical ? "crit" : "")" tabindex="0" data-row="@t.Id" aria-selected="@(_selected == t.Id)" @onclick="() => _selected = t.Id" @onkeydown="e => RowKey(t, e)">
                                <td class="muted">@t.Wbs</td>
                                <td style="padding-left:@(6 + t.Level * 14)px;@(t.IsSummary ? "font-weight:650" : "")">
                                    @if (_editing == t.Id)
                                    {
                                        <input @bind="_editName" style="width:280px" />
                                        <button class="secondary" @onclick="() => SaveName(t.Id)">OK</button>
                                    }
                                    else { <span @ondblclick="() => StartEdit(t)">@t.Name</span> }
                                    @if (t.Origin != "eos") { <span class="origin" title="Imported from @t.Origin" aria-label="Imported from @t.Origin">⟵</span> }
                                </td>
                                <td class="num">@if (!t.IsSummary) { <input type="number" class="cell" aria-label="Work hours, @t.Wbs" value="@t.WorkHours" @onchange="e => SetWork(t.Id, e.Value)" /> } else { @t.WorkHours.ToString("0.#") }</td>
                                <td class="num">@if (!t.IsSummary) { <input type="number" class="cell" aria-label="Percent complete, @t.Wbs" min="0" max="100" value="@((t.PercentComplete * 100).ToString("0"))" @onchange="e => SetPct(t.Id, e.Value)" /> } else { @((t.PercentComplete * 100).ToString("0")) }</td>
                                <td>@t.Start?.ToString("dd MMM yy")</td>
                                <td>@t.Finish?.ToString("dd MMM yy")</td>
                                <td class="num">@t.TotalFloatDays</td>
                                <td><span class="badge @StatusCls(t.Status)">@t.Status</span></td>
                                <td>@string.Join(", ", t.Assignments.Select(a => (a.PersonName ?? "◌ " + a.PlaceholderSkill) + (a.Units == 1 ? "" : $" {a.Units * 100:0}%")))</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            </div>

                @if (_plan.Tasks.Count > 0 && Sel() is { } s)
                {
                    <div class="grid-2">
                        <div class="plate">
                            <h2>Assign engineer to “@s.Name”</h2>
                            <div class="form-row">
                                <div class="field"><label>Engineer</label>
                                    <select @bind="_assignPerson"><option value="0">–</option>@foreach (var p in _people) { <option value="@p.Id">@p.Name</option>}</select></div>
                                <div class="field"><label>Units %</label><input type="number" @bind="_assignUnits" style="width:80px" /></div>
                                <button @onclick="() => Assign(s.Id)">Assign</button>
                            </div>
                            @foreach (var a in s.Assignments)
                            {
                                <div>@(a.PersonName ?? "◌ " + a.PlaceholderSkill) @(a.Units * 100)% <button class="icon" @onclick="() => Unassign(a.Id)">Remove</button></div>
                            }
                        </div>
                        <div class="plate">
                            <h2>Dependencies of “@s.Name”</h2>
                            @foreach (var l in _plan.Links.Where(l => l.SuccessorId == s.Id || l.PredecessorId == s.Id))
                            {
                                <div>@LinkText(l, s.Id) <button class="icon" @onclick="() => RemoveLink(l.Id)">Remove</button></div>
                            }
                            <div class="form-row">
                                <div class="field"><label>Predecessor</label>
                                    <select @bind="_linkPred"><option value="0">–</option>@foreach (var t in _plan.Tasks.Where(t => t.Id != s.Id)) { <option value="@t.Id">@t.Wbs @Short(t.Name, 40)</option>}</select></div>
                                <div class="field"><label>Type</label><select @bind="_linkType"><option value="0">FS</option><option value="1">SS</option><option value="2">FF</option><option value="3">SF</option></select></div>
                                <div class="field"><label>Lag (d)</label><input type="number" @bind="_linkLag" style="width:70px" /></div>
                                <button @onclick="() => AddLink(s.Id)">Link</button>
                            </div>
                        </div>
                    </div>
                }
        }
        else if (_tab == "gantt")
        {
            <GanttChart Rows="@_ganttRows" Links="@_ganttLinks" Today="@AsOf" ExpandToLevel="3" OnSelect="OnGanttSelect" />
        }
        else if (_tab == "team")
        {
            <div class="plate">
                <h2>Engineers on this project</h2>
                @if (_team.Count == 0) { <div class="empty">Nobody is assigned yet. Select a task in the Plan tab and assign an engineer.</div> }
                else
                {
                    <table class="grid"><thead><tr><th>Engineer</th><th class="num">Tasks</th><th class="num">Planned h</th></tr></thead><tbody>
                    @foreach (var m in _team) { <tr><td>@m.Name</td><td class="num">@m.Tasks</td><td class="num">@m.Hours.ToString("N0")</td></tr> }
                    </tbody></table>
                }
            </div>
        }
        else if (_tab == "actuals")
        {
            @if (_actuals is null || _actuals.TotalHours == 0) { <div class="empty">No timesheet hours are recorded against @_plan.ProjectNo.</div> }
            else
            {
                var planned = _plan.Tasks.Where(t => !t.IsSummary).Sum(t => t.WorkHours);
                <div class="kpis" style="grid-template-columns:repeat(3,minmax(0,1fr))">
                    <div class="kpi"><div class="v">@_actuals.TotalHours.ToString("N0")</div><div class="l">Hours booked</div></div>
                    <div class="kpi"><div class="v">@planned.ToString("N0")</div><div class="l">Hours in the plan</div></div>
                    <div class="kpi @(_actuals.TotalHours > planned && planned > 0 ? "bad" : "")"><div class="v">@(planned == 0 ? "–" : ((_actuals.TotalHours / planned) * 100).ToString("0") + "%")</div><div class="l">Booked against plan</div></div>
                </div>
                <div class="grid-3">
                    <div class="plate"><h2>By engineer</h2>@foreach (var b in _actuals.ByPerson.Take(12)) { <div class="packrow"><span>@b.Label</span><span class="muted">@b.Hours.ToString("N0") h</span></div> }</div>
                    <div class="plate"><h2>By phase</h2>@foreach (var b in _actuals.ByPhase.Take(12)) { <div class="packrow"><span>@b.Label</span><span class="muted">@b.Hours.ToString("N0") h</span></div> }</div>
                    <div class="plate"><h2>By month</h2>@foreach (var m in _actuals.ByMonth.TakeLast(12)) { <div class="packrow"><span>@m.Month.ToString("MMM yyyy")</span><span class="muted">@m.Hours.ToString("N0") h</span></div> }</div>
                </div>
            }
        }
        else if (_tab == "environments")
        {
            <div class="plate">
                <h2>Hosts and virtual machines</h2>
                @if (_hosts.Count == 0) { <div class="empty">No host is linked to this project. Link machines under Infrastructure.</div> }
                else
                {
                    <table class="grid"><thead><tr><th>Name</th><th>IP</th><th>Kind</th><th>State</th><th>Purpose</th><th>Role</th></tr></thead><tbody>
                    @foreach (var h in _hosts) { <tr><td>@h.Name</td><td>@h.Ip</td><td>@h.Kind</td><td>@h.State</td><td>@h.Purpose</td><td>@h.Projects.FirstOrDefault(p => p.ProjectId == Id).Role</td></tr> }
                    </tbody></table>
                }
            </div>
        }
        else if (_tab == "details" && _proj is not null)
        {
            <div class="plate"><h2>Project details</h2>
                <div class="form-row">
                    <div class="field"><label>Name</label><input @bind="_proj.Name" style="width:420px" /></div>
                    <div class="field"><label>Customer</label><input @bind="_proj.Customer" /></div>
                    <div class="field"><label>Product line</label><input @bind="_proj.ProductLine" /></div>
                    <div class="field"><label>Site</label><input @bind="_proj.SiteLocation" /></div>
                </div>
                <div class="form-row">
                    <div class="field"><label>ERP status</label><input @bind="_proj.ErpStatus" /></div>
                    <div class="field"><label>Tracker status</label><input @bind="_proj.TrackerStatus" /></div>
                    <div class="field"><label>Project manager</label><input @bind="_proj.ProjectManager" /></div>
                    <div class="field"><label>Technical manager</label><input @bind="_proj.TechnicalManager" /></div>
                </div>
                <div class="form-row">
                    <div class="field"><label>PO start</label><input type="date" @bind="_proj.PoStart" /></div>
                    <div class="field"><label>PO end</label><input type="date" @bind="_proj.PoEnd" /></div>
                    <div class="field"><label>Contractual end</label><input type="date" @bind="_proj.ContractualEnd" /></div>
                    <div class="field"><label>Planned end</label><input type="date" @bind="_proj.PlannedEnd" /></div>
                </div>
                <div class="form-row">
                    <div class="field"><label>Health override</label>
                        <select @bind="_proj.HealthOverride"><option value="">(computed)</option><option>On Track</option><option>Moderate Risk</option><option>At Risk</option></select></div>
                    <div class="field"><label>Override reason</label><input @bind="_proj.HealthOverrideReason" style="width:320px" /></div>
                    <div class="field"><label>Notes</label><input @bind="_proj.Notes" style="width:320px" /></div>
                </div>
                <button @onclick="SaveProject">Save details</button>
            </div>
        }
        else if (_tab == "baseline")
        {
            <div class="plate">
                <h2>Baseline variance</h2>
                @if (_variance is null) { <div class="empty">No baseline saved. Use “Save baseline” once the schedule is agreed.</div> }
                else
                {
                    <p>@_variance.BaselineName · baseline finish @_variance.BaselineFinish?.ToString("dd MMM yyyy") · now @_variance.CurrentFinish?.ToString("dd MMM yyyy") · <b>@(_variance.FinishVarianceDays?.ToString("+0;-0;0") ?? "–") d</b></p>
                    <div class="tablewrap" style="max-height:60vh;overflow:auto"><table class="grid"><thead><tr><th>WBS</th><th>Task</th><th>Baseline finish</th><th>Current finish</th><th class="num">Δ days</th><th class="num">Δ work h</th></tr></thead><tbody>
                    @foreach (var r in _variance.Rows.Where(r => r.FinishVarianceDays is not (null or 0) || r.WorkVarianceHours != 0))
                    { <tr><td>@r.Wbs</td><td>@Short(r.Name, 60)</td><td>@r.BaselineFinish?.ToString("dd MMM yy")</td><td>@r.CurrentFinish?.ToString("dd MMM yy")</td><td class="num">@r.FinishVarianceDays</td><td class="num">@r.WorkVarianceHours.ToString("+0.#;-0.#;0")</td></tr> }
                    </tbody></table></div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private EOS.Domain.Projects.Project? _proj;
    private EOS.Infrastructure.People.ProjectActuals? _actuals;
    private PlanView? _plan;
    private ProjectHealthView? _health;
    private BaselineVariance? _variance;
    private List<GanttChart.Row> _ganttRows = [];
    private List<GanttChart.Link> _ganttLinks = [];

    private void OnGanttSelect(string? key)
    {
        if (key is not null && key.StartsWith('t') && int.TryParse(key[1..], out var id)) _selected = id;
    }
    private List<(int Id, string Name)> _people = [];
    private List<(string Name, int Tasks, decimal Hours)> _team = [];
    private IReadOnlyList<HostRow> _hosts = [];
    private string _tab = "plan";
    private int? _selected, _editing;
    private string _newTask = "", _editName = "";
    private decimal _newWork;
    private int _assignPerson; private decimal _assignUnits = 100;
    private int _linkPred, _linkType, _linkLag;

    protected override async Task LoadAsync()
    {
        var asOf = AsOf;
        _plan = await Q(sp => sp.GetRequiredService<PlanService>().GetPlanAsync(Id));
        _health = await Q(async sp => _plan.Tasks.Count == 0 ? null : await sp.GetRequiredService<HealthService>().GetAsync(Id, asOf));
        _hosts = await Q(sp => sp.GetRequiredService<HostService>().ListAsync(Id));
        _proj = await Q(sp => sp.GetRequiredService<EosDbContext>().Projects.AsNoTracking().SingleAsync(p => p.Id == Id));
        _actuals = await Q(sp => sp.GetRequiredService<EOS.Infrastructure.People.TimesheetService>().ProjectAsync(_plan!.ProjectNo));
        _people = await Q(sp => sp.GetRequiredService<EosDbContext>().People.AsNoTracking().OrderBy(p => p.FullName).Select(p => new { p.Id, Name = p.FullName }).ToListAsync())
            is { } list ? list.Select(p => (p.Id, p.Name)).ToList() : [];
        try { _variance = await Q(sp => sp.GetRequiredService<PlanService>().GetBaselineVarianceAsync(Id)); } catch (PlanException) { _variance = null; }

        _ganttRows = _plan.Tasks.Select(t => new GanttChart.Row(t.Name, t.Level, t.Start, t.Finish, t.PercentComplete, t.IsCritical, t.IsSummary,
            t.Kind == "milestone", t.Wbs + " " + t.Name, null, t.Status, Key: "t" + t.Id)).ToList();
        _ganttLinks = _plan.Links.Select(l => new GanttChart.Link("t" + l.PredecessorId, "t" + l.SuccessorId, l.Type)).ToList();
        _team = _plan.Tasks.Where(t => !t.IsSummary).SelectMany(t => t.Assignments.Where(a => a.PersonName is not null).Select(a => (a.PersonName!, t.Id, Hours: t.WorkHours * a.Units)))
            .GroupBy(x => x.Item1).Select(g => (g.Key, g.Count(), g.Sum(x => x.Hours))).OrderByDescending(x => x.Item3).ToList();
    }

    private PlanTaskView? Sel() => _selected is { } id ? _plan?.Tasks.FirstOrDefault(t => t.Id == id) : null;
    private static string StatusCls(object? status) => status?.ToString()?.Replace(" ", "").ToLowerInvariant() switch
    {
        "completed" or "done" => "good",
        "inprogress" => "info",
        "onhold" or "blocked" => "warn",
        _ => "",
    };
    private static string Short(string s, int n) => s.Length <= n ? s : s[..(n - 1)] + "…";
    private string LinkText(LinkView l, int self)
    {
        string N(int id) => _plan!.Tasks.FirstOrDefault(t => t.Id == id) is { } t ? $"{t.Wbs} {Short(t.Name, 30)}" : "?";
        var type = new[] { "FS", "SS", "FF", "SF" }[l.Type];
        return l.SuccessorId == self ? $"after {N(l.PredecessorId)} ({type}{(l.LagDays != 0 ? l.LagDays.ToString("+0;-0") : "")})" : $"before {N(l.SuccessorId)} ({type})";
    }

    private Task SaveProject()
    {
        var p = _proj!;
        if (string.IsNullOrWhiteSpace(p.HealthOverride)) { p.HealthOverride = null; p.HealthOverrideReason = null; }
        else if (string.IsNullOrWhiteSpace(p.HealthOverrideReason)) { State.ShowToast("A health override needs a reason.", error: true); return Task.CompletedTask; }
        return Act((sp, a) => sp.GetRequiredService<EOS.Infrastructure.Projects.ProjectService>().UpdateAsync(p, a), "Project saved.");
    }

    private Task Recompute() => Act((sp, _) => sp.GetRequiredService<PlanService>().RecomputeAsync(Id, AsOf), "Schedule recomputed.");
    private Task SaveBaseline() => Act((sp, a) => sp.GetRequiredService<PlanService>().CreateBaselineAsync(Id, "Baseline " + AsOf.ToString("yyyy-MM-dd"), a), "Baseline saved.");

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(_newTask)) return;
        var after = _selected; var name = _newTask.Trim(); var work = _newWork;
        var parent = Sel()?.ParentId;
        await Act(async (sp, a) =>
        {
            var plans = sp.GetRequiredService<PlanService>();
            await plans.AddTaskAsync(Id, name, a, parent, after, work);
            await plans.RecomputeAsync(Id, AsOf);
        }, "Task added.");
        _newTask = ""; _newWork = 0;
    }

    private void StartEdit(PlanTaskView t) { _editing = t.Id; _editName = t.Name; }
    private async Task SaveName(int id)
    {
        var name = _editName; _editing = null;
        await Patch(id, new TaskPatch { Name = name });
    }
    private Task SetWork(int id, object? v) => decimal.TryParse(v?.ToString(), out var h) ? Patch(id, new TaskPatch { WorkHours = h }) : Task.CompletedTask;
    private Task SetPct(int id, object? v) => decimal.TryParse(v?.ToString(), out var p) ? Patch(id, new TaskPatch { PercentComplete = Math.Clamp(p, 0, 100) / 100m }) : Task.CompletedTask;

    private Task Patch(int id, TaskPatch patch) => Act(async (sp, a) =>
    {
        var plans = sp.GetRequiredService<PlanService>();
        await plans.UpdateTaskAsync(id, patch, a);
        await plans.RecomputeAsync(Id, AsOf);
    });

    private Task Move(int id, MoveDirection d) => Act(async (sp, a) =>
    {
        var plans = sp.GetRequiredService<PlanService>();
        await plans.MoveTaskAsync(id, d, a);
        await plans.RecomputeAsync(Id, AsOf);
    });

    private async Task Delete(int id)
    {
        var task = _plan?.Tasks.FirstOrDefault(t => t.Id == id);
        var extra = task is { IsSummary: true } ? " and everything under it" : "";
        if (!await Confirm($"Delete task {task?.Wbs} “{task?.Name}”{extra}? This cannot be undone.")) return;
        await Act(async (sp, a) =>
        {
            var plans = sp.GetRequiredService<PlanService>();
            await plans.DeleteTaskAsync(id, a);
            if (_selected == id) _selected = null;
            await plans.RecomputeAsync(Id, AsOf);
        }, "Task deleted.");
    }

    private async Task RowKey(PlanTaskView t, KeyboardEventArgs e)
    {
        var tasks = _plan!.Tasks;
        var i = tasks.ToList().FindIndex(x => x.Id == t.Id);
        if (e.AltKey && e.Key is "ArrowUp" or "ArrowDown" or "ArrowRight" or "ArrowLeft")
        {
            var dir = e.Key switch { "ArrowUp" => MoveDirection.Up, "ArrowDown" => MoveDirection.Down, "ArrowRight" => MoveDirection.Indent, _ => MoveDirection.Outdent };
            await Move(t.Id, dir);
            return;
        }
        switch (e.Key)
        {
            case "ArrowDown" when i < tasks.Count - 1: _selected = tasks[i + 1].Id; await JS.InvokeVoidAsync("eosFocusRow", tasks[i + 1].Id.ToString()); break;
            case "ArrowUp" when i > 0: _selected = tasks[i - 1].Id; await JS.InvokeVoidAsync("eosFocusRow", tasks[i - 1].Id.ToString()); break;
            case "Enter": _selected = t.Id; StartEdit(t); break;
            case "Escape": _editing = null; break;
            case "Delete": _selected = t.Id; await Delete(t.Id); break;
        }
    }

    private Task Assign(int taskId)
    {
        if (_assignPerson == 0) { State.ShowToast("Pick an engineer.", error: true); return Task.CompletedTask; }
        var person = _assignPerson; var units = _assignUnits / 100m;
        return Act(async (sp, a) =>
        {
            var plans = sp.GetRequiredService<PlanService>();
            await plans.AssignAsync(taskId, person, units, a);
            await plans.RecomputeAsync(Id, AsOf);
        }, "Assigned.");
    }

    private Task Unassign(int assignmentId) => Act(async (sp, a) =>
    {
        var plans = sp.GetRequiredService<PlanService>();
        await plans.UnassignAsync(assignmentId, a);
        await plans.RecomputeAsync(Id, AsOf);
    });

    private Task AddLink(int succ)
    {
        if (_linkPred == 0) return Task.CompletedTask;
        var pred = _linkPred; var type = _linkType; var lag = _linkLag;
        return Act(async (sp, a) =>
        {
            var plans = sp.GetRequiredService<PlanService>();
            await plans.AddLinkAsync(pred, succ, type, lag, a);
            await plans.RecomputeAsync(Id, AsOf);
        }, "Linked.");
    }

    private Task RemoveLink(int id) => Act(async (sp, a) =>
    {
        var plans = sp.GetRequiredService<PlanService>();
        await plans.RemoveLinkAsync(id, a);
        await plans.RecomputeAsync(Id, AsOf);
    });
}
