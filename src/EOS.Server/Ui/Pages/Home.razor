@page "/"
@inherits EosPage
<PageTitle>Command Center · EOS</PageTitle>

<div class="page">
    <div class="page-head">
        <h1>Command Center</h1>
        <div class="actions">
            <a class="btn secondary" href="/whatif">What-if</a>
            <a class="btn secondary" href="/gantt">Gantt</a>
            <a class="btn secondary" href="/calendar">Calendar</a>
        </div>
    </div>

    @if (Loading && _cc is null) { <p class="muted">Loading…</p> }
    else if (LoadError is not null) { <div class="plate error">@LoadError</div> }
    else if (_cc is not null)
    {
        var k = _cc.Kpis;
        <div class="plate">
            <h2>Projects by slip</h2>
            @if (_cc.Projects.Count == 0) { <div class="empty">No project has a plan yet.</div> }
            else
            {
                <div class="tablewrap"><table class="grid">
                    <thead><tr><th>Project</th><th>Health</th><th class="num">Slip (days)</th><th class="num">Late / open</th><th class="num">Progress</th></tr></thead>
                    <tbody>
                    @foreach (var h in _cc.Projects.OrderByDescending(h => h.ScheduleVarianceDays ?? int.MinValue))
                    {
                        <tr class="clickable" @onclick="() => Open(h.ProjectId)">
                            <td><b>@h.ProjectNo</b> <span class="muted" title="@h.Name">@Names.Short(h.Name)</span></td>
                            <td><HealthBadge Health="@h.Health" Title="@string.Join("; ", h.Reasons)" /></td>
                            <td class="num @(h.ScheduleVarianceDays > 0 ? "slip-pos" : "")">@(h.ScheduleVarianceDays?.ToString("+0;-0;0") ?? "–")</td>
                            <td class="num">@h.DelayedTasks / @h.OpenTasks</td>
                            <td class="num">@((h.ProgressActual * 100).ToString("0"))%</td>
                        </tr>
                    }
                    </tbody></table></div>
            }
        </div>

        <div class="kpis">
            <a class="kpi @(k.AtRiskProjects > 0 ? "bad" : "")" href="/projects"><div class="v">@k.AtRiskProjects</div><div class="l">At-risk projects</div></a>
            <div class="kpi @(k.DelayedTasks > 0 ? "warn" : "")"><div class="v">@k.DelayedTasks</div><div class="l">Delayed tasks</div></div>
            <a class="kpi @(k.OverAllocatedEngineers > 0 ? "bad" : "")" href="/capacity"><div class="v">@k.OverAllocatedEngineers</div><div class="l">Over-allocated engineers</div></a>
            <a class="kpi" href="/capacity"><div class="v">@k.FreePlannedHoursNext4Weeks.ToString("N0")</div><div class="l">Free hours, next 4 weeks</div></a>
            <a class="kpi @(k.OpenGaps > 0 ? "warn" : "")" href="/demand"><div class="v">@k.OpenGaps</div><div class="l">Open gaps</div></a>
            <a class="kpi @(k.PendingApprovals > 0 ? "warn" : "")" href="/whatif"><div class="v">@k.PendingApprovals</div><div class="l">Pending approvals</div></a>
            <a class="kpi" href="/training"><div class="v">@k.OpenDoubts</div><div class="l">Open doubts</div></a>
            <a class="kpi" href="/infrastructure"><div class="v">@k.VmsRunning<span class="muted" style="font-size:14px"> / @(k.VmsRunning + k.VmsOff)</span></div><div class="l">VMs running</div></a>
            <a class="kpi @(k.HostsLowOnDisk > 0 ? "bad" : "")" href="/infrastructure"><div class="v">@k.HostsLowOnDisk</div><div class="l">Hosts low on disk</div></a>
            <a class="kpi" href="/projects"><div class="v">@k.ActiveProjects</div><div class="l">Active projects</div></a>
        </div>

        <div class="grid-2">
            <div class="plate">
                <h2>Alerts <a href="/alerts" class="muted">(@_cc.Alerts.Count)</a></h2>
                @if (_alerts.Count == 0) { <div class="empty">Nothing flagged.</div> }
                else
                {
                    <table class="grid"><tbody>
                    @foreach (var g in _alerts.Take(10))
                    {
                        <tr><td class="sev-@g.Worst" style="white-space:nowrap">@string.Join(" ", g.Rules)</td><td><b>@Names.Short(g.Subject)</b><div class="muted">@g.First@(g.Count > 1 ? $" (+{g.Count - 1} more)" : "")</div></td></tr>
                    }
                    </tbody></table>
                    @if (_alerts.Count > 10) { <p><a href="/alerts">All @_alerts.Count subjects</a></p> }
                }
            </div>
            <div class="plate">
                <h2>Milestones, next 30 days</h2>
                @if (_cc.Milestones.Count == 0) { <div class="empty">None.</div> }
                else
                {
                    <table class="grid"><tbody>
                    @foreach (var m in _cc.Milestones) { <tr><td class="num" style="white-space:nowrap">@m.Date?.ToString("dd MMM")</td><td><b>@m.ProjectNo</b> @m.Name</td></tr> }
                    </tbody></table>
                }
            </div>
        </div>

        <div class="plate">
            <h2>Engineer load, next 8 weeks</h2>
            @if (_people.Count == 0) { <div class="empty">No engineers yet.</div> }
            else
            {
                <div class="tablewrap"><table class="grid freeze">
                    <thead><tr><th>Engineer</th>@foreach (var w in _weeks) { <th class="num">@w.ToString("dd MMM")</th> }</tr></thead>
                    <tbody>
                    @foreach (var p in _people)
                    {
                        <tr><td><a href="/people/@p.Id">@p.Name</a></td>
                        @foreach (var w in _weeks)
                        {
                            var cell = _cc.LoadNext8Weeks.FirstOrDefault(x => x.PersonId == p.Id && x.WeekStart == w);
                            <td class="num">@if (cell is null || cell.AllocatedHours == 0) { <span class="heat none">–</span> } else { <span class="heat @cell.Band" title="@cell.AllocatedHours.ToString("0.#") h of @cell.CapacityHours.ToString("0.#") h">@cell.AllocatedHours.ToString("0")</span> }</td>
                        }</tr>
                    }
                    </tbody></table></div>
            }
        </div>

        @if (_gaps.Count > 0)
        {
            <div class="plate">
                <h2>Supply against demand, gap hours</h2>
                <div class="tablewrap"><table class="grid">
                    <thead><tr><th>Skill</th>@foreach (var m in _months) { <th class="num">@m.ToString("MMM")</th> }<th class="num">Deployable</th></tr></thead>
                    <tbody>
                    @foreach (var s in _gaps.GroupBy(r => r.SkillName))
                    {
                        <tr><td>@s.Key</td>
                        @foreach (var m in _months)
                        {
                            var r = s.FirstOrDefault(x => x.Month == m);
                            <td class="num">@if (r is null) { <span class="muted">–</span> } else { <span class="@(r.GapHours > 0 ? "slip-pos" : "slip-neg")" title="demand @(r.ProjectDemandHours + r.PipelineHours) h, supply @r.SupplyHours h">@r.GapHours.ToString("+0;-0;0")</span> }</td>
                        }
                        <td class="num">@s.First().DeployableCount</td></tr>
                    }
                    </tbody></table></div>
            </div>
        }
    }
</div>

@code {
    private sealed record AlertGroup(string Subject, string Worst, List<string> Rules, string First, int Count);

    private CommandCenter? _cc;
    private List<(int Id, string Name)> _people = [];
    private List<DateOnly> _weeks = [];
    private List<DateOnly> _months = [];
    private List<SupplyDemandRow> _gaps = [];
    private List<AlertGroup> _alerts = [];

    protected override async Task LoadAsync()
    {
        var asOf = AsOf;
        _cc = await Q(sp => sp.GetRequiredService<DashboardService>().GetAsync(asOf));
        _people = _cc.LoadNext8Weeks.GroupBy(r => r.PersonId).Select(g => (g.Key, g.First().PersonName)).OrderBy(p => p.Item2).ToList();
        _weeks = _cc.LoadNext8Weeks.Select(r => r.WeekStart).Distinct().OrderBy(d => d).ToList();
        _months = _cc.SupplyDemand.Select(r => r.Month).Distinct().OrderBy(d => d).ToList();
        var demandSkills = _cc.SupplyDemand.Where(r => r.ProjectDemandHours + r.PipelineHours > 0).Select(r => r.SkillId).ToHashSet();
        _gaps = _cc.SupplyDemand.Where(r => demandSkills.Contains(r.SkillId)).ToList();
        _alerts = _cc.Alerts.GroupBy(a => a.Subject)
            .Select(g => new AlertGroup(g.Key, g.OrderByDescending(a => a.Severity).First().Severity.ToString(), g.Select(a => a.Rule).Distinct().ToList(), g.First().Message, g.Count()))
            .OrderByDescending(g => g.Worst == "Critical" || g.Worst == "Serious").ThenByDescending(g => g.Count).ToList();
    }

    private void Open(int projectId) => Nav.NavigateTo("/projects/" + projectId);
}
