@page "/"
@inherits EosPage
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using EOS.Infrastructure.Persistence
@using EOS.Infrastructure.Projects
@using EOS.Infrastructure.Hosting
@using EOS.Infrastructure.People
@using EOS.Infrastructure.Training
<PageTitle>Command Center &middot; EOS</PageTitle>

<style>
    .ov {
        --a1: color-mix(in srgb, var(--accent) 12%, var(--panel)); --a2: color-mix(in srgb, var(--accent) 22%, var(--panel)); --a3: color-mix(in srgb, var(--accent) 33%, var(--panel));
        --a4: color-mix(in srgb, var(--accent) 45%, var(--panel)); --a5: color-mix(in srgb, var(--accent) 58%, var(--panel));
        --tg: color-mix(in srgb, var(--green) 32%, var(--panel)); --ty: color-mix(in srgb, var(--amber) 34%, var(--panel)); --tr: color-mix(in srgb, var(--red) 34%, var(--panel));
        --empty: color-mix(in srgb, var(--ink) 7%, var(--panel));
        display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px;
    }
    .pn { grid-column: span 3; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; min-width: 0; display: flex; flex-direction: column; }
    .pn.w4 { grid-column: span 4; } .pn.w6 { grid-column: span 6; } .pn.w8 { grid-column: span 8; } .pn.w12 { grid-column: span 12; } .pn.r2 { grid-row: span 2; }
    .pn > header { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 12px; }
    .pn h2 { font-size: 15px; font-weight: 650; }
    .pn header a, .pn header span { font-size: 12.5px; color: var(--ink-2); }
    .none { color: var(--ink-2); font-size: 13px; }
    .a1 { background: var(--a1); } .a2 { background: var(--a2); } .a3 { background: var(--a3); } .a4 { background: var(--a4); } .a5 { background: var(--a5); }
    .tg { background: var(--tg); } .ty { background: var(--ty); } .tr { background: var(--tr); } .e0 { background: var(--empty); }
    .ok { background: var(--green); } .mid { background: var(--amber); } .low { background: var(--red); }
    .c-b { background: var(--accent); } .c-n { background: var(--p2); } .c-t { background: var(--p3); }
    .key { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 10px; font-size: 12px; color: var(--ink-2); }
    .key i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 5px; vertical-align: -1px; }
    .key i + i { margin-left: -3px; }

    .hm { overflow-x: auto; }
    .hm-grid { display: grid; gap: 2px; min-width: max-content; font-size: 11.5px; font-variant-numeric: tabular-nums; }
    .hm-grid > b { font-weight: 600; color: var(--ink-2); font-size: 12px; display: flex; align-items: center; padding-right: 10px; white-space: nowrap; position: sticky; left: 0; background: var(--panel); z-index: 1; }
    .hm-grid > a { display: grid; place-items: end center; height: 28px; padding-bottom: 4px; color: var(--ink); font-weight: 650; font-size: 11.5px; border-radius: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .hm-grid > a:hover { background: var(--hover); color: var(--accent-ink); }
    .hm-grid > span { display: grid; place-items: center; height: 24px; border-radius: 4px; color: var(--ink); }
    .hm-grid > span.e0 { color: var(--ink-2); }

    .trend { display: flex; align-items: flex-end; gap: 16px; flex: 1; min-height: 200px; padding: 0 4%; }
    .trend > div { max-width: 120px; }
    .trend-x { padding: 0 4%; gap: 16px !important; } .trend-x span { max-width: 120px; }
    .trend > div { flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; min-width: 0; position: relative; }
    .trend .st { display: flex; flex-direction: column-reverse; border-radius: 6px 6px 0 0; overflow: hidden; }
    .trend .st i { display: block; }
    .trend .u { position: absolute; left: 50%; width: 10px; height: 10px; margin: 0 0 -5px -5px; border-radius: 50%; background: var(--ink); border: 2px solid var(--panel); z-index: 2; }
    .trend-x { display: flex; gap: 6px; margin-top: 6px; } .trend-x span { flex: 1; text-align: center; font-size: 11.5px; color: var(--ink-2); white-space: nowrap; overflow: hidden; }

    .pm { display: grid; gap: 2px; font-size: 10px; color: var(--ink-2); justify-content: start; }
    .pm i { aspect-ratio: 1; border-radius: 3px; display: block; }
    .pm span { display: grid; place-items: center; overflow: hidden; white-space: nowrap; }

    .tl { position: relative; flex: 1; }
    .tl-axis { position: relative; height: 18px; margin-left: 120px; font-size: 12px; color: var(--ink-2); }
    .tl-axis span { position: absolute; transform: translateX(-50%); white-space: nowrap; }
    .tl-grid { position: absolute; top: 18px; bottom: 0; left: 120px; right: 0; pointer-events: none; }
    .tl-grid i { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--line-soft); }
    .tl-grid b { position: absolute; top: -4px; bottom: 0; width: 2px; margin-left: -1px; background: var(--accent); }
    .tl-row { display: grid; grid-template-columns: 120px minmax(0, 1fr); align-items: center; height: 34px; color: var(--ink); }
    .tl-row:hover { background: var(--hover); }
    .tl-row > b { font-size: 12.5px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 10px; }
    .tl-lane { position: relative; height: 12px; }
    .tl-lane .plan { position: absolute; top: 0; bottom: 0; border-radius: 6px; background: var(--empty); overflow: hidden; }
    .tl-lane .plan i { position: absolute; inset: 0 auto 0 0; }
    .tl-lane .late { position: absolute; top: 2px; bottom: 2px; border-radius: 0 6px 6px 0; background: repeating-linear-gradient(-45deg, var(--red) 0 2px, transparent 2px 5px); }
    .h-r { background: var(--red); } .h-a { background: var(--amber); } .h-g { background: var(--green); } .h-n { background: var(--task-prog); }

    .mx { display: grid; grid-template-columns: minmax(64px, auto) repeat(4, minmax(0, 1fr)); grid-template-rows: auto; grid-auto-rows: minmax(30px, 1fr); gap: 4px; font-size: 12px; flex: 1; }
    .mx > span { color: var(--ink-2); text-align: center; align-self: end; font-size: 11.5px; }
    .mx > span.l { text-align: left; align-self: center; }
    .mx a { display: grid; place-items: center; border-radius: 6px; color: var(--ink); font-weight: 650; }
    .mx a.e0 { color: transparent; }

    .hb { display: grid; grid-template-columns: minmax(70px, 40%) minmax(0, 1fr) 36px; gap: 7px 10px; align-items: center; align-content: space-around; flex: 1; font-size: 12.5px; }
    .hb .n { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink-2); }
    .hb .bar { height: 10px; border-radius: 6px; background: var(--empty); overflow: hidden; }
    .hb .bar i { display: block; height: 100%; border-radius: 6px; }
    .hb .v { text-align: right; color: var(--ink); font-variant-numeric: tabular-nums; }

    @@media (max-width: 1400px) { .pn { grid-column: span 6; } .pn.w4 { grid-column: span 6; } .pn.w8 { grid-column: span 12; } .pn.w6 { grid-column: span 12; } .pn.r2 { grid-row: auto; } }
    @@media (max-width: 760px) { .pn, .pn.w4 { grid-column: span 12; } .tl-axis { margin-left: 90px; } .tl-grid { left: 90px; } .tl-row { grid-template-columns: 90px minmax(0, 1fr); } .trend { min-height: 150px; } }
</style>

<div class="page">
    @if (Loading && _cc is null) { <p class="muted">Loading&hellip;</p> }
    else if (LoadError is not null) { <div class="plate error">@LoadError</div> }
    else if (_cc is not null)
    {
        <div class="ov">
            <section class="pn w12">
                <header><h2>Team</h2><span>@_month0.ToString("MMMM yyyy", Inv)</span></header>
                @if (_team.Count == 0) { <p class="none">No engineers.</p> }
                else
                {
                    <div class="hm">
                        <div class="hm-grid" style="grid-template-columns: max-content repeat(@_team.Count, minmax(52px, 1fr))">
                            <b></b>
                            @foreach (var p in _team) { <a href="/people/@p.Id" title="@p.Name">@p.Short</a> }
                            @foreach (var m in _metrics)
                            {
                                <b>@m.Label</b>
                                @foreach (var p in _team)
                                {
                                    var c = m.Cell(p);
                                    <span class="@c.Cls" title="@p.Name &middot; @m.Label: @c.Tip">@c.Text</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="key">
                        <span><i class="a1"></i><i class="a2"></i><i class="a3"></i><i class="a4"></i><i class="a5"></i>Low &rarr; high</span>
                        <span><i class="tg"></i>Good</span><span><i class="ty"></i>Watch</span><span><i class="tr"></i>Poor</span><span><i class="e0"></i>None</span>
                    </div>
                }
            </section>

            <section class="pn w6">
                <header><h2>Team hours</h2><span>@(_trend.Count > 0 ? $"{_trend[0].Month:MMM yyyy} – {_trend[^1].Month:MMM yyyy}" : "")</span></header>
                @if (_trend.Count == 0) { <p class="none">No monthly data.</p> }
                else
                {
                    var tmax = _trend.Max(t => t.B + t.N + t.T);
                    <div class="trend">
                        @foreach (var t in _trend)
                        {
                            var tot = t.B + t.N + t.T;
                            <div title="@t.Month.ToString("MMM yyyy", Inv): billable @t.B.ToString("N0", Inv) h, non-billable @t.N.ToString("N0", Inv) h, training @t.T.ToString("N0", Inv) h, utilisation @t.Util.ToString("0", Inv)%">
                                <span class="st" style="height:@P(tmax == 0 ? 0 : tot / tmax)">
                                    @if (t.B > 0) { <i class="c-b" style="height:@P(t.B / tot)"></i> }
                                    @if (t.N > 0) { <i class="c-n" style="height:@P(t.N / tot)"></i> }
                                    @if (t.T > 0) { <i class="c-t" style="height:@P(t.T / tot)"></i> }
                                </span>
                            </div>
                        }
                    </div>
                    <div class="trend-x">@foreach (var t in _trend) { <span>@t.Month.ToString(t.Month.Month == 1 ? "MMM yy" : "MMM", Inv)</span> }</div>
                    <div class="key"><span><i class="c-b"></i>Billable</span><span><i class="c-n"></i>Non-billable</span><span><i class="c-t"></i>Training</span></div>
                }
            </section>

            <section class="pn">
                <header><h2>Peer reviews</h2><span>@_peerLabel</span></header>
                @if (_pmPeople.Count == 0) { <p class="none">No peer reviews.</p> }
                else
                {
                    <div class="pm" style="grid-template-columns: 22px repeat(@_pmPeople.Count, minmax(0, 1fr)); max-width: @(22 + _pmPeople.Count * 18)px">
                        <span></span>@foreach (var s in _pmPeople) { <span title="@s.Name">@s.Initials[0]</span> }
                        @foreach (var rv in _pmPeople)
                        {
                            <span title="@rv.Name">@rv.Initials</span>
                            @foreach (var s in _pmPeople)
                            {
                                var v = _pm.GetValueOrDefault((rv.Id, s.Id), -1m);
                                <i class="@(v < 0 ? "e0" : v < 3 ? "tr" : v < 4 ? "ty" : v < 4.5m ? "a3" : "a5")" title="@(v < 0 ? "" : $"{rv.Name} → {s.Name}: {v:0.0}")"></i>
                            }
                        }
                    </div>
                    <div class="key"><span>Reviewer &darr; reviewed &rarr;</span><span><i class="tr"></i>&lt;3</span><span><i class="ty"></i>3&ndash;4</span><span><i class="a3"></i><i class="a5"></i>4&ndash;5</span></div>
                }
            </section>

            <section class="pn">
                <header><h2>Alerts</h2><a href="/alerts">All</a></header>
                <div class="mx">
                    <span></span><span>Crit</span><span>Serious</span><span>Warn</span><span>Info</span>
                    @foreach (var area in _areas)
                    {
                        <span class="l">@area.Name</span>
                        @for (var sev = 3; sev >= 0; sev--)
                        {
                            var n = _matrix.GetValueOrDefault((area.Name, sev));
                            <a class="@(n == 0 ? "e0" : sev >= 2 ? "tr" : sev == 1 ? "ty" : "a2")" href="@area.Href" aria-label="@area.Name @n">@(n > 0 ? n : "")</a>
                        }
                    }
                </div>
            </section>

            <section class="pn w6">
                <header><h2>Projects</h2><a href="/gantt">Gantt</a></header>
                @if (_tl.Count == 0) { <p class="none">No planned projects.</p> }
                else
                {
                    <div class="tl">
                        <div class="tl-axis">@foreach (var m in _ticks) { <span style="left:@P(m.X)">@m.Label</span> }</div>
                        <div class="tl-grid">@foreach (var m in _ticks) { <i style="left:@P(m.X)"></i> }<b style="left:@P(Pos(AsOf))"></b></div>
                        @foreach (var r in _tl)
                        {
                            var s = Pos(r.Start); var e = Pos(r.End); var f = r.Forecast is { } fd ? Pos(fd) : e;
                            <a class="tl-row" href="/projects/@r.Id" title="@r.Tip">
                                <b>@r.No</b>
                                <span class="tl-lane">
                                    <span class="plan" style="left:@P(s);width:@P(Math.Max(0.004m, e - s))"><i class="@r.Cls" style="width:@P(r.Progress)"></i></span>
                                    @if (f > e) { <span class="late" style="left:@P(e);width:@P(Math.Min(1, f) - e)"></span> }
                                </span>
                            </a>
                        }
                    </div>
                    <div class="key"><span><i class="h-r"></i>At risk</span><span><i class="h-a"></i>Moderate</span><span><i class="h-g"></i>On track</span><span><i style="background:repeating-linear-gradient(-45deg,var(--red) 0 2px,transparent 2px 5px)"></i>Overrun</span><span><i style="background:var(--accent);width:2px"></i>Today</span></div>
                }
            </section>

            <section class="pn">
                <header><h2>Drives</h2><a href="/infrastructure">Servers</a></header>
                @if (_drives.Count == 0) { <p class="none">No readings.</p> }
                else
                {
                    <div class="hb">
                        @foreach (var d in _drives)
                        {
                            <span class="n" title="@d.Host @d.Drive">@d.Host @d.Drive</span>
                            <span class="bar"><i class="@(d.Free < 0.1m ? "low" : d.Free < 0.2m ? "mid" : "c-b")" style="width:@P(1 - d.Free)"></i></span>
                            <span class="v">@((d.Free * 100).ToString("0", Inv))%</span>
                        }
                    </div>
                }
            </section>

            <section class="pn">
                <header><h2>Risks and tickets</h2><a href="/register">Register</a></header>
                <div class="hb">@foreach (var r in _register) { <span class="n">@r.Label</span><span class="bar"><i class="@r.Cls" style="width:@P(_registerMax == 0 ? 0 : (decimal)r.N / _registerMax)"></i></span><span class="v">@r.N</span> }</div>
            </section>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private sealed record Eng(int Id, string Name, string Short, decimal? Util, decimal? Billable, decimal? Training, decimal? Timesheet, decimal? Attendance,
        int? Late, int? Projects, decimal? Peer, decimal? Know, decimal? Load);
    private sealed record HCell(string Cls, string Text, string Tip);
    private sealed record Metric(string Label, Func<Eng, HCell> Cell);
    private sealed record TrendM(DateOnly Month, decimal B, decimal N, decimal T, decimal Util);
    private sealed record Who(int Id, string Name, string Initials);
    private sealed record TlRow(int Id, string No, DateOnly Start, DateOnly End, DateOnly? Forecast, decimal Progress, string Cls, string Tip);
    private sealed record Area(string Name, string Href);
    private sealed record DriveRow(string Host, string Drive, decimal Free);
    private sealed record Part(string Label, int N, string Cls);

    private CommandCenter? _cc;
    private DateOnly _month0, _t0, _t1;
    private List<Eng> _team = [];
    private List<TrendM> _trend = [];
    private List<Who> _pmPeople = [];
    private Dictionary<(int, int), decimal> _pm = [];
    private string _peerLabel = "";
    private List<TlRow> _tl = [];
    private List<(decimal X, string Label)> _ticks = [];
    private readonly List<Area> _areas = [new("Delivery", "/projects"), new("People", "/capacity"), new("Servers", "/infrastructure"), new("Decisions", "/whatif"), new("Training", "/training")];
    private Dictionary<(string, int), int> _matrix = [];
    private List<DriveRow> _drives = [];
    private List<Part> _cover = [], _register = [];
    private int _registerMax;

    private static readonly HCell None = new("e0", "", "no data");
    private static HCell Ramp(decimal? v, decimal max, string fmt, string unit = "") =>
        v is not { } x ? None : x <= 0 ? new("e0", "0", "0" + unit)
        : new("a" + Math.Clamp((int)Math.Ceiling(x / max * 5), 1, 5), x.ToString(fmt, Inv), x.ToString(fmt, Inv) + unit);
    private static HCell Rag(decimal? v, decimal good, decimal watch, string fmt) =>
        v is not { } x ? None : new(x >= good ? "tg" : x >= watch ? "ty" : "tr", x.ToString(fmt, Inv), x.ToString(fmt, Inv));
    private static HCell Bad(int? v, int watch, int poor) =>
        v is not { } x ? None : x == 0 ? new("e0", "0", "0") : new(x >= poor ? "tr" : x >= watch ? "ty" : "a1", x.ToString(Inv), x.ToString(Inv));

    private readonly List<Metric> _metrics =
    [
        new("Utilisation %", e => Ramp(e.Util, 100, "0", "%")),
        new("Billable %", e => Ramp(e.Billable, 100, "0", "%")),
        new("Training h", e => Ramp(e.Training, 40, "0", " h")),
        new("Timesheet", e => Rag(e.Timesheet, 85, 60, "0")),
        new("Attendance", e => Rag(e.Attendance, 85, 60, "0")),
        new("Late days", e => Bad(e.Late, 2, 5)),
        new("Peer rating", e => Rag(e.Peer, 4, 3, "0.0")),
        new("Knowledge %", e => Rag(e.Know, 70, 40, "0")),
        new("Load, 4 wks %", e => e.Load is not { } l ? None : l <= 0 ? new("e0", "0", "nothing planned") : new(l > 100 ? "tr" : l > 85 ? "ty" : "a" + Math.Clamp((int)Math.Ceiling(l / 20), 1, 5), l.ToString("0", Inv), l.ToString("0", Inv) + "%")),
    ];

    private static string P(decimal v) => (Math.Clamp(v, 0m, 1m) * 100).ToString("0.##", Inv) + "%";
    private decimal Pos(DateOnly d) => (decimal)(d.DayNumber - _t0.DayNumber) / Math.Max(1, _t1.DayNumber - _t0.DayNumber);
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    private static string ShortName(string full, IEnumerable<string> all)
    {
        static string Cap(string w) => w.Length == 0 ? w : char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant();
        var parts = full.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var first = Cap(parts[0]);
        var clash = all.Count(n => string.Equals(n.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0], parts[0], StringComparison.OrdinalIgnoreCase)) > 1;
        return clash && parts.Length > 1 ? $"{first[0]}. {Cap(parts[^1])}" : first;
    }
    private static string AreaOf(string kind) => kind switch
    {
        "project" or "task" => "Delivery", "person" or "demand" or "skill" => "People", "host" => "Servers",
        "scenario" or "movement" => "Decisions", "doubt" => "Training", _ => "Delivery",
    };

    protected override async Task LoadAsync()
    {
        var asOf = AsOf;
        _cc = await Q(sp => sp.GetRequiredService<DashboardService>().GetAsync(asOf));
        var people = (await Q(sp => sp.GetRequiredService<PeopleService>().ListAsync())).Where(p => p.IsActive && !p.IsConsultant).OrderBy(p => p.FullName).ToList();
        var ym = asOf.Year * 100 + asOf.Month;
        var perf = await Q(sp => sp.GetRequiredService<EosDbContext>().MonthlyPerformance.AsNoTracking().Where(m => m.Year * 100 + m.Month <= ym).ToListAsync());
        var reviews = await Q(sp => sp.GetRequiredService<EosDbContext>().PeerReviews.AsNoTracking().Where(r => r.Year * 100 + r.Month <= ym).ToListAsync());
        var knowledge = await Q(sp => sp.GetRequiredService<TrainingService>().SummaryAsync(asOf));
        var coverage = await Q(sp => sp.GetRequiredService<TrainingService>().CoverageAsync(10000));
        var hosts = await Q(sp => sp.GetRequiredService<HostService>().ListAsync());
        var risks = await Q(sp => sp.GetRequiredService<RegisterService>().RisksAsync(openOnly: true));
        var tickets = await Q(sp => sp.GetRequiredService<RegisterService>().TicketsAsync(openOnly: true));
        var starts = await Q(sp => sp.GetRequiredService<EosDbContext>().Tasks.AsNoTracking().Where(t => t.PlannedStart != null)
            .GroupBy(t => t.ProjectId).Select(g => new { g.Key, S = g.Min(t => t.PlannedStart), E = g.Max(t => t.PlannedFinish) }).ToDictionaryAsync(x => x.Key, x => (S: x.S!.Value, E: x.E)));

        static DateOnly M(int y, int m) => new(y, m, 1);
        var active = people.Select(p => p.Id).ToHashSet();
        var latest = perf.Count == 0 ? M(asOf.Year, asOf.Month) : perf.Where(p => active.Contains(p.PersonId)).Select(p => M(p.Year, p.Month)).DefaultIfEmpty(M(asOf.Year, asOf.Month)).Max();
        _month0 = latest;
        var cur = perf.Where(p => p.Year == latest.Year && p.Month == latest.Month).GroupBy(p => p.PersonId).ToDictionary(g => g.Key, g => g.First());

        var peerBy = reviews.Where(r => r.Collaboration + r.Communication + r.Reliability + r.TechnicalHelp > 0).GroupBy(r => r.SubjectPersonId)
            .ToDictionary(g => g.Key, g => { var last = g.Max(r => r.Year * 100 + r.Month); return g.Where(r => r.Year * 100 + r.Month == last).Average(r => (r.Collaboration + r.Communication + r.Reliability + r.TechnicalHelp) / 4); });
        var know = knowledge.ToDictionary(k => k.PersonId, k => k.KnowFraction * 100);
        var weeks = _cc.LoadNext8Weeks.Select(r => r.WeekStart).Distinct().OrderBy(d => d).Take(4).ToHashSet();
        var load = _cc.LoadNext8Weeks.Where(r => weeks.Contains(r.WeekStart)).GroupBy(r => r.PersonId)
            .ToDictionary(g => g.Key, g => g.Sum(r => r.CapacityHours) == 0 ? 0 : g.Sum(r => r.AllocatedHours) / g.Sum(r => r.CapacityHours) * 100);

        _team = people.Select(p =>
        {
            cur.TryGetValue(p.Id, out var m);
            return new Eng(p.Id, p.FullName, ShortName(p.FullName, people.Select(x => x.FullName)), m?.Utilization,
                m is null || m.ComplianceHours <= 0 ? null : m.BillableHours / m.ComplianceHours * 100, m?.TrainingHours,
                m?.TimesheetCompletionScore, m?.AttendanceDisciplineScore, m?.LateDays, m?.UniqueProjects,
                peerBy.TryGetValue(p.Id, out var pr) ? pr : null, know.TryGetValue(p.Id, out var k) ? k : null, load.TryGetValue(p.Id, out var l) ? l : null);
        }).OrderByDescending(e => e.Util ?? -1).ThenBy(e => e.Name).ToList();

        _trend = perf.Where(p => active.Contains(p.PersonId)).GroupBy(p => M(p.Year, p.Month)).OrderBy(g => g.Key)
            .Where(g => g.Sum(x => x.BillableHours + x.NonBillableHours + x.TrainingHours) > 0).TakeLast(12)
            .Select(g => new TrendM(g.Key, g.Sum(x => x.BillableHours), g.Sum(x => x.NonBillableHours), g.Sum(x => x.TrainingHours),
                g.Where(x => x.ComplianceHours > 0).Select(x => x.Utilization).DefaultIfEmpty(0).Average())).ToList();

        var recent = reviews.Select(r => r.Year * 100 + r.Month).Distinct().OrderByDescending(x => x).Take(3).ToHashSet();
        var rs = reviews.Where(r => recent.Contains(r.Year * 100 + r.Month) && r.ReviewerPersonId is not null && active.Contains(r.SubjectPersonId) && active.Contains(r.ReviewerPersonId.Value)
            && r.Collaboration + r.Communication + r.Reliability + r.TechnicalHelp > 0).ToList();
        _pm = rs.GroupBy(r => (r.ReviewerPersonId!.Value, r.SubjectPersonId)).ToDictionary(g => g.Key, g => g.Average(r => (r.Collaboration + r.Communication + r.Reliability + r.TechnicalHelp) / 4));
        var inPm = rs.SelectMany(r => new[] { r.ReviewerPersonId!.Value, r.SubjectPersonId }).ToHashSet();
        _pmPeople = people.Where(p => inPm.Contains(p.Id)).Select(p => new Who(p.Id, p.FullName, Initials(p.FullName))).ToList();
        if (recent.Count > 0) { var lo = recent.Min(); var hi = recent.Max(); _peerLabel = $"{M(lo / 100, lo % 100):MMM} – {M(hi / 100, hi % 100):MMM yyyy}"; }

        _tl = _cc.Projects.Where(p => p.PlannedEnd is not null || p.ForecastEnd is not null || starts.ContainsKey(p.ProjectId)).Select(p =>
        {
            var end = p.PlannedEnd ?? (starts.TryGetValue(p.ProjectId, out var se) ? se.E : null) ?? p.ForecastEnd!.Value;
            var start = starts.TryGetValue(p.ProjectId, out var s) && s.S < end ? s.S : end.AddDays(-30);
            var cls = p.Health switch { "At Risk" => "h-r", "Moderate Risk" => "h-a", "On Track" => "h-g", _ => "h-n" };
            var tip = $"{p.ProjectNo} {p.Name}: {p.ProgressActual * 100:0}% done, plan {p.ProgressExpected * 100:0}%, end {end:dd MMM yyyy}" + (p.ForecastEnd is { } f ? $", forecast {f:dd MMM yyyy}" : "");
            return new TlRow(p.ProjectId, p.ProjectNo, start, end, p.ForecastEnd, Math.Clamp(p.ProgressActual, 0, 1), cls, tip);
        }).OrderByDescending(r => r.Cls == "h-r").ThenByDescending(r => r.Cls == "h-a").ThenBy(r => r.End).ToList();
        if (_tl.Count > 0)
        {
            var first = _tl.Min(r => r.Start); var d0 = first < asOf.AddDays(-30) ? first : asOf.AddDays(-30);
            _t0 = new DateOnly(d0.Year, d0.Month, 1);
            var lastPlan = _tl.Max(r => r.End); var lastFc = _tl.Max(r => r.Forecast ?? r.End); var cap = asOf.AddDays(180);
            _t1 = (lastFc > cap ? (lastPlan > cap ? lastPlan : cap) : lastFc).AddDays(10);
            var span = (_t1.Year - _t0.Year) * 12 + _t1.Month - _t0.Month;
            var step = span > 14 ? 3 : span > 7 ? 2 : 1;
            _ticks = [];
            for (var m = _t0.AddMonths(1); m < _t1; m = m.AddMonths(step)) _ticks.Add((Pos(m), m.ToString(m.Month == 1 || _ticks.Count == 0 ? "MMM yy" : "MMM", Inv)));
        }

        var subjects = _cc.Alerts.GroupBy(a => (a.SubjectKind, a.Subject)).Select(g => (Area: AreaOf(g.Key.SubjectKind), Sev: Math.Clamp((int)g.Max(a => a.Severity), 0, 3))).ToList();
        _matrix = subjects.GroupBy(s => (s.Area, s.Sev)).ToDictionary(g => g.Key, g => g.Count());

        _drives = hosts.SelectMany(h => h.Disks.Where(d => d.TotalGb > 0).Select(d => new DriveRow(h.Ip ?? h.Name, d.Drive, d.FreeFraction))).OrderBy(d => d.Free).Take(6).ToList();

        _cover =
        [
            new("Nobody", coverage.Count(c => c.KnownBy == 0), "low"), new("1 person", coverage.Count(c => c.KnownBy == 1), "mid"),
            new("2 people", coverage.Count(c => c.KnownBy == 2), "c-n"), new("3–5", coverage.Count(c => c.KnownBy is >= 3 and <= 5), "c-b"), new("6+", coverage.Count(c => c.KnownBy >= 6), "ok"),
        ];

        int Age(DateOnly? d) => d is null ? 999 : asOf.DayNumber - d.Value.DayNumber;
        _register =
        [
            new("Risks high", risks.Count(r => r.Severity is "High" or "Critical"), "low"), new("Risks other", risks.Count(r => r.Severity is not ("High" or "Critical")), "mid"),
            new("Tickets < 30 d", tickets.Count(t => Age(t.RaisedOn) <= 30), "c-b"), new("Tickets 30–90 d", tickets.Count(t => Age(t.RaisedOn) is > 30 and <= 90), "mid"), new("Tickets > 90 d", tickets.Count(t => Age(t.RaisedOn) > 90), "low"),
        ];
        _registerMax = _register.Max(r => r.N);
    }
}
