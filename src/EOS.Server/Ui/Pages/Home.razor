@page "/"
@inherits EosPage
<PageTitle>Command Center Â· EOS</PageTitle>

<style>
    .cc { max-width: 1480px; }
    .cc-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; margin-bottom: 20px; }
    .cc-head h1 { font-size: 24px; font-weight: 650; letter-spacing: -0.01em; text-wrap: balance; }
    .cc-head p { color: var(--ink-2); margin-top: 6px; max-width: 80ch; }
    .cc-sec { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; margin-bottom: 16px; }
    .cc-sec > header { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 12px; }
    .cc-sec h2 { font-size: 15px; font-weight: 650; color: var(--ink); }
    .cc-sec header span, .cc-sec header a { font-size: 12.5px; color: var(--ink-2); }
    .cc-sec header a { color: var(--accent-ink); }
    .cc-cols { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 16px; align-items: start; }
    .cc-cols > .cc-sec { margin-bottom: 0; }

    .cc-list { display: grid; grid-template-columns: 92px minmax(180px, 280px) minmax(0, 1fr); column-gap: 16px; }
    .cc-list > a { display: contents; color: var(--ink); }
    .cc-list > a > * { padding: 8px 0; border-top: 1px solid var(--line-soft); }
    .cc-list > a:first-child > * { border-top: 0; }
    .cc-list > a:hover > * { background: var(--hover); }
    .cc-list > a:focus-visible > * { background: var(--accent-soft); }
    .cc-area { font-size: 12.5px; color: var(--ink-2); padding-left: 8px !important; }
    .cc-subj { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cc-msg { color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sev { display: inline-flex; align-items: center; gap: 6px; }
    .sev::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--amber); }
    .sev.hi::before { background: var(--red); }

    .cc-proj { display: grid; grid-template-columns: minmax(150px, 230px) minmax(0, 1fr) 64px 72px; column-gap: 16px; align-items: center; }
    .cc-proj > a { display: contents; color: var(--ink); }
    .cc-proj > a > * { padding: 7px 0; border-top: 1px solid var(--line-soft); }
    .cc-proj > a:first-of-type > * { border-top: 0; }
    .cc-proj > a:hover > * { background: var(--hover); }
    .cc-proj .hd { font-size: 12px; color: var(--ink-3); padding-bottom: 6px; }
    .cc-pn b { display: block; font-weight: 600; }
    .cc-pn small { display: block; color: var(--ink-2); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bar { position: relative; height: 10px; border-radius: 6px; background: var(--track); }
    .bar i { position: absolute; inset: 0 auto 0 0; border-radius: 6px; background: var(--task-prog); }
    .bar i.r { background: var(--red); } .bar i.a { background: var(--amber); } .bar i.g { background: var(--green); }
    .bar b { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: var(--ink); }
    .bar u { position: absolute; top: 0; bottom: 0; border-radius: 0 6px 6px 0; opacity: .45; transition: opacity .2s ease-out;
        background: repeating-linear-gradient(-45deg, var(--red) 0 2px, transparent 2px 5px); }
    .bar u.a { background: repeating-linear-gradient(-45deg, var(--amber) 0 2px, transparent 2px 5px); }
    .cc-proj > a:hover .bar u, .cc-proj > a:focus-visible .bar u { opacity: 1; }
    .cc-pn .why { display: none; color: var(--red); }
    .cc-proj > a:hover .cc-pn .name, .cc-proj > a:focus-visible .cc-pn .name { display: none; }
    .cc-proj > a:hover .cc-pn .why, .cc-proj > a:focus-visible .cc-pn .why { display: block; }
    @@media (prefers-reduced-motion: no-preference) {
        .bar i, .cc-week .col i { animation: cc-grow .7s cubic-bezier(.16, 1, .3, 1) both; }
        .bar u { animation: cc-fade .5s .45s ease-out both; }
        .cc-week .col i { transform-origin: bottom; animation-name: cc-rise; }
        .cc-proj > a:nth-of-type(2) .bar i { animation-delay: 40ms; } .cc-proj > a:nth-of-type(3) .bar i { animation-delay: 80ms; }
        .cc-proj > a:nth-of-type(4) .bar i { animation-delay: 120ms; } .cc-proj > a:nth-of-type(n+5) .bar i { animation-delay: 160ms; }
    }
    @@keyframes cc-grow { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
    @@keyframes cc-rise { from { transform: scaleY(0); } to { transform: scaleY(1); } }
    @@keyframes cc-fade { from { opacity: 0; } }
    .num { text-align: right; font-variant-numeric: tabular-nums; }
    .bad { color: var(--red); font-weight: 600; }
    .cc-key { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 12px; font-size: 12px; color: var(--ink-2); }
    .cc-key i { display: inline-block; width: 10px; height: 10px; border-radius: 6px; margin-right: 6px; vertical-align: -1px; }

    .cc-weeks { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 8px; align-items: end; height: 132px; }
    .cc-week { display: flex; flex-direction: column; justify-content: flex-end; height: 100%; gap: 4px; text-align: center; font-size: 12px; color: var(--ink-2); }
    .cc-week .col { position: relative; flex: 1; background: var(--track); border-radius: 6px; overflow: hidden; }
    .cc-week .col i { position: absolute; left: 0; right: 0; bottom: 0; background: var(--accent); }
    .cc-week .col i.over { background: var(--red); }
    .cc-week b { color: var(--ink); font-weight: 600; }
    .cc-note { color: var(--ink-2); max-width: 60ch; }
    .cc-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
    .cc-chips a { font-size: 12px; padding: 3px 10px; border-radius: 999px; background: var(--amber-soft); color: var(--amber); }
    .cc-chips a.over { background: var(--red-soft); color: var(--red); }

    .cc-gap { display: grid; grid-template-columns: minmax(120px, 200px) minmax(0, 1fr) 80px; column-gap: 12px; align-items: center; row-gap: 8px; }
    .cc-gap .bar i { background: var(--red); } .cc-gap .bar i.spare { background: var(--green); }
    .cc-ms { display: grid; grid-template-columns: 64px 1fr; row-gap: 6px; column-gap: 12px; }
    .cc-ms span { color: var(--ink-2); }
    .cc-calm { color: var(--ink-2); }

    @@media (max-width: 1100px) { .cc-cols { grid-template-columns: 1fr; } .cc-cols > .cc-sec { margin-bottom: 16px; } }
    @@media (max-width: 720px) {
        .cc-head { flex-direction: column; }
        .cc-list { grid-template-columns: 1fr; } .cc-area { display: none; } .cc-msg { white-space: normal; padding-top: 0 !important; border-top: 0 !important; }
        .cc-proj { grid-template-columns: minmax(0, 1fr) 56px 64px; } .cc-proj .bar, .cc-proj .hd.b { display: none; }
        .cc-weeks { grid-template-columns: repeat(4, minmax(0, 1fr)); height: auto; } .cc-week .col { height: 64px; flex: none; }
    }
</style>

<div class="page cc">
    @if (Loading && _cc is null) { <p class="muted">Loadingâ€¦</p> }
    else if (LoadError is not null) { <div class="plate error">@LoadError</div> }
    else if (_cc is not null)
    {
        <div class="cc-head">
            <div><h1>@_headline</h1>@if (_subline is not null) { <p>@_subline</p> }</div>
            <div class="actions">
                <a class="btn secondary" href="/whatif">What-if</a>
                <a class="btn secondary" href="/gantt">Gantt</a>
            </div>
        </div>

        <section class="cc-sec" aria-labelledby="cc-needs">
            <header><h2 id="cc-needs">Needs you</h2><a href="/alerts">@(_minor > 0 ? $"{_minor} minor notes not shown Â· " : "")All alerts</a></header>
            @if (_needs.Count == 0) { <p class="cc-calm">Nothing needs you. No project is badly behind plan, nobody is over capacity, and every server has room.</p> }
            else
            {
                <div class="cc-list">
                    @foreach (var n in _needs)
                    {
                        <a href="@n.Href">
                            <span class="cc-area"><span class="sev @(n.High ? "hi" : "")">@n.Area</span></span>
                            <span class="cc-subj" title="@n.Subject">@n.Subject</span>
                            <span class="cc-msg" title="@n.Message">@n.Message</span>
                        </a>
                    }
                </div>
            }
        </section>

        <div class="cc-cols">
            <section class="cc-sec" aria-labelledby="cc-proj">
                <header><h2 id="cc-proj">Projects against plan</h2><a href="/projects">@_cc.Kpis.ActiveProjects active</a></header>
                @if (_projects.Count == 0) { <p class="cc-calm">No project has a plan yet.</p> }
                else
                {
                    <div class="cc-proj">
                        <span class="hd">Project</span><span class="hd b">Done, and where the plan says it should be</span><span class="hd num">Behind</span><span class="hd num">Finish slip</span>
                        @foreach (var p in _projects)
                        {
                            var gap = p.ProgressGapPoints;
                            <a href="/projects/@p.ProjectId" title="@string.Join("; ", p.Reasons)">
                                <span class="cc-pn"><b>@p.ProjectNo</b><small class="name">@Names.Short(p.Name)</small><small class="why">@(p.Reasons.FirstOrDefault() ?? Names.Short(p.Name))</small></span>
                                <span class="bar" role="img" aria-label="@Pct(p.ProgressActual) done, plan says @Pct(p.ProgressExpected)"><i class="@HClass(p.Health)" style="width:@Pct(p.ProgressActual)"></i>@if (p.ProgressExpected > p.ProgressActual && HClass(p.Health) is "r" or "a") { <u class="@HClass(p.Health)" style="left:@Pct(p.ProgressActual);width:@Pct(p.ProgressExpected - p.ProgressActual)"></u> }<b style="left:@Pct(p.ProgressExpected)"></b></span>
                                <span class="num @(gap >= 10 ? "bad" : "")">@(gap > 0.5m ? $"{gap:0} pts" : "â€“")</span>
                                <span class="num @(p.ScheduleVarianceDays > 0 ? "bad" : "")">@Slip(p.ScheduleVarianceDays)</span>
                            </a>
                        }
                    </div>
                    <div class="cc-key"><span><i style="background:var(--red)"></i>At risk</span><span><i style="background:var(--amber)"></i>Moderate risk</span><span><i style="background:var(--green)"></i>On track</span><span><i style="background:var(--ink);width:2px"></i>Plan</span><span>Slip in working days</span></div>
                }
            </section>

            <section class="cc-sec" aria-labelledby="cc-load">
                <header><h2 id="cc-load">Team load, next 8 weeks</h2><a href="/capacity">Capacity</a></header>
                @if (_weekTotals.Count == 0) { <p class="cc-calm">No engineers yet.</p> }
                else if (_coverage < 0.10m)
                {
                    <p class="cc-note">Only <b>@((_coverage * 100).ToString("0"))%</b> of the next 8 weeks is assigned (@_alloc.ToString("N0") of @_cap.ToString("N0") hours). @_idleNow of @_people engineers have nothing planned this week. Load shows here once tasks have engineers.</p>
                    <p style="margin-top:10px"><a class="btn secondary" href="/planner">Assign engineers in the Planner</a></p>
                }
                else
                {
                    <div class="cc-weeks">
                        @foreach (var t in _weekTotals)
                        {
                            var u = t.Cap == 0 ? 0 : t.Alloc / t.Cap;
                            <div class="cc-week" title="@t.Alloc.ToString("N0") h of @t.Cap.ToString("N0") h; @t.Over over capacity, @t.Idle with nothing planned">
                                <b>@((u * 100).ToString("0"))%</b>
                                <div class="col"><i class="@(u > 1 ? "over" : "")" style="height:@Pct(Math.Min(u, 1))"></i></div>
                                <span>@t.Week.ToString("dd MMM")</span>
                            </div>
                        }
                    </div>
                }
                @if (_hot.Count > 0)
                {
                    <div class="cc-chips">@foreach (var p in _hot) { <a class="@(p.Over ? "over" : "")" href="/people/@p.Id">@p.Name @p.Peak.ToString("0")%</a> }</div>
                }
            </section>
        </div>

        @if (_gapBySkill.Count > 0 || _cc.Milestones.Count > 0)
        {
            <div class="cc-cols" style="margin-top:16px">
                @if (_gapBySkill.Count > 0)
                {
                    var gmax = _gapBySkill.Max(g => Math.Abs(g.Gap));
                    <section class="cc-sec" aria-labelledby="cc-skill">
                        <header><h2 id="cc-skill">Skills short of demand</h2><a href="/demand">Demand</a></header>
                        <div class="cc-gap">
                            @foreach (var g in _gapBySkill)
                            {
                                <span>@g.Skill</span>
                                <span class="bar"><i class="@(g.Gap > 0 ? "" : "spare")" style="width:@Pct(gmax == 0 ? 0 : Math.Abs(g.Gap) / gmax)"></i></span>
                                <span class="num @(g.Gap > 0 ? "bad" : "")">@(g.Gap > 0 ? $"{g.Gap:N0} h short" : $"{-g.Gap:N0} h spare")</span>
                            }
                        </div>
                    </section>
                }
                @if (_cc.Milestones.Count > 0)
                {
                    <section class="cc-sec" aria-labelledby="cc-ms">
                        <header><h2 id="cc-ms">Milestones, next 30 days</h2><a href="/calendar">Calendar</a></header>
                        <div class="cc-ms">@foreach (var m in _cc.Milestones) { <span>@m.Date?.ToString("dd MMM")</span><div><b>@m.ProjectNo</b> @m.Name</div> }</div>
                    </section>
                }
            </div>
        }
    }
</div>

@code {
    private sealed record Need(string Area, string Href, bool High, string Subject, string Message);
    private sealed record WeekTotal(DateOnly Week, decimal Alloc, decimal Cap, int Over, int Idle);
    private sealed record Hot(int Id, string Name, decimal Peak, bool Over);
    private sealed record SkillGap(string Skill, decimal Gap);

    private CommandCenter? _cc;
    private List<Need> _needs = [];
    private List<ProjectHealthView> _projects = [];
    private List<WeekTotal> _weekTotals = [];
    private List<Hot> _hot = [];
    private List<SkillGap> _gapBySkill = [];
    private int _people, _idleNow, _minor;
    private decimal _alloc, _cap, _coverage;
    private string? _headline, _subline;

    private static string Pct(decimal v) => (Math.Clamp(v, 0, 1) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
    private static string Slip(int? d) => d switch { null => "â€“", > 0 => $"+{d} d", 0 => "on time", _ => $"{d} d" };
    private static string HClass(string h) => h switch { "At Risk" => "r", "Moderate Risk" => "a", "On Track" => "g", _ => "" };

    private static (string Area, string Href) Route(string kind) => kind switch
    {
        "project" or "task" => ("Delivery", "/projects"),
        "person" or "demand" or "skill" => ("People", "/capacity"),
        "host" => ("Servers", "/infrastructure"),
        "scenario" or "movement" => ("Decision", "/whatif"),
        "doubt" => ("Training", "/training"),
        _ => ("Data", "/alerts"),
    };

    protected override async Task LoadAsync()
    {
        var asOf = AsOf;
        _cc = await Q(sp => sp.GetRequiredService<DashboardService>().GetAsync(asOf));
        var k = _cc.Kpis;

        _projects = _cc.Projects
            .OrderByDescending(p => p.Health == "At Risk").ThenByDescending(p => p.Health == "Moderate Risk")
            .ThenByDescending(p => p.ProgressGapPoints).ToList();

        var groups = _cc.Alerts.GroupBy(a => (a.SubjectKind, a.Subject))
            .Select(g => (Sev: g.Max(a => a.Severity), Kind: g.Key.SubjectKind, Subject: g.Key.Subject, Msg: g.OrderByDescending(a => a.Severity).First().Message))
            .ToList();
        var shown = groups.Where(g => g.Sev >= AlertSeverity.Serious).ToList();
        if (shown.Count < 4) shown = shown.Concat(groups.Where(g => g.Sev == AlertSeverity.Warning && g.Kind is "scenario" or "movement" or "project")).ToList();
        _needs = shown.OrderByDescending(g => g.Sev).ThenBy(g => Route(g.Kind).Area).Take(10)
            .Select(g => { var r = Route(g.Kind); return new Need(r.Area, r.Href, g.Sev >= AlertSeverity.Serious, Names.Short(g.Subject), g.Msg); }).ToList();
        _minor = groups.Count - _needs.Count;

        var load = _cc.LoadNext8Weeks;
        _people = load.Select(r => r.PersonId).Distinct().Count();
        _weekTotals = load.GroupBy(r => r.WeekStart).OrderBy(g => g.Key)
            .Select(g => new WeekTotal(g.Key, g.Sum(r => r.AllocatedHours), g.Sum(r => r.CapacityHours),
                g.Count(r => r.Band == LoadBand.OverAllocated), g.Count(r => r.AllocatedHours == 0))).ToList();
        _alloc = _weekTotals.Sum(t => t.Alloc);
        _cap = _weekTotals.Sum(t => t.Cap);
        _coverage = _cap == 0 ? 0 : _alloc / _cap;
        _idleNow = _weekTotals.FirstOrDefault()?.Idle ?? 0;
        _hot = load.Where(r => r.CapacityHours > 0 && (r.Band == LoadBand.Stretched || r.Band == LoadBand.OverAllocated))
            .GroupBy(r => r.PersonId)
            .Select(g => new Hot(g.Key, g.First().PersonName, g.Max(r => r.AllocatedHours / r.CapacityHours * 100), g.Any(r => r.Band == LoadBand.OverAllocated)))
            .OrderByDescending(h => h.Peak).ToList();

        var worst = _projects.FirstOrDefault(p => p.Health == "At Risk");
        var overNow = _weekTotals.FirstOrDefault()?.Over ?? 0;
        _headline = worst is not null
            ? $"{k.AtRiskProjects} project{(k.AtRiskProjects == 1 ? " is" : "s are")} at risk. {worst.ProjectNo} is furthest behind."
            : overNow > 0 ? $"{overNow} engineer{(overNow == 1 ? " is" : "s are")} over capacity this week."
            : "Nothing is at risk right now.";
        var bits = new List<string>();
        if (worst is not null) bits.Add($"{worst.ProjectNo} is {worst.ProgressGapPoints:0} points behind plan" + (worst.ScheduleVarianceDays > 0 ? $" and forecast {worst.ScheduleVarianceDays} working days late" : ""));
        if (k.DelayedTasks > 0) bits.Add($"{k.DelayedTasks} tasks are late");
        if (k.HostsLowOnDisk > 0) bits.Add($"{k.HostsLowOnDisk} server{(k.HostsLowOnDisk == 1 ? " is" : "s are")} nearly out of disk");
        _subline = bits.Count == 0 ? null : string.Join("; ", bits) + ".";

        _gapBySkill = _cc.SupplyDemand.Where(r => r.ProjectDemandHours + r.PipelineHours > 0)
            .GroupBy(r => r.SkillName).Select(g => new SkillGap(g.Key, g.Sum(r => r.GapHours)))
            .Where(g => g.Gap != 0).OrderByDescending(g => g.Gap).ToList();
    }
}
