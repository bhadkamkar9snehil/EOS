@page "/people/{Id:int}"
@inherits EosPage
@using EOS.Domain.Capacity
@using EOS.Infrastructure.People
@using EOS.Infrastructure.Persistence
@using EOS.Infrastructure.Skills
<PageTitle>@(_p?.Person.FullName ?? "Person") · EOS</PageTitle>

<div class="page">
    @if (Loading && _p is null) { <p class="muted">Loading…</p> }
    else if (LoadError is not null) { <div class="plate error">@LoadError</div> }
    else if (_p is not null)
    {
        var person = _p.Person;
        <div class="page-head">
            <div><h1>@person.FullName <span class="muted" style="font-weight:400">@person.Code</span></h1>
                <p class="muted">@person.RoleTitle · @(person.Team ?? "no team") · @person.BaseLocation · availability @((person.AvailabilityFraction * 100).ToString("0"))% · @_p.ModulesKnown / @_p.ModulesTotal modules known · @_p.OpenDoubts open doubts</p></div>
            <div class="actions"><a class="btn secondary" href="/people">All people</a></div>
        </div>

        <div class="grid-2">
            <div class="plate">
                <h2>Skills <span class="muted" style="text-transform:none;letter-spacing:0">(ratings change only here, by you)</span></h2>
                <table class="grid"><thead><tr><th>Skill</th><th class="num">Rating</th><th>Assessed</th><th></th></tr></thead><tbody>
                @foreach (var s in _p.Skills)
                {
                    <tr><td>@s.Skill</td><td class="num"><b>@s.Rating</b></td><td class="muted">@s.AssessedOn?.ToString("dd MMM yy") @s.AssessedBy</td>
                        <td><button class="icon" @onclick="() => StartRate(s.SkillId, s.Rating)">Change</button></td></tr>
                }
                </tbody></table>
                @if (_rateSkill != 0)
                {
                    <div class="form-row" style="margin-top:8px">
                        <div class="field"><label>New rating</label><select @bind="_rating">@for (var i = 0; i <= _levels; i++) { <option value="@i">@i</option> }</select></div>
                        <div class="field"><label>Reason</label><input @bind="_reason" style="width:260px" placeholder="Why is the rating changing?" /></div>
                        <button @onclick="SaveRating">Save rating</button><button class="secondary" @onclick="() => _rateSkill = 0">Cancel</button>
                    </div>
                }
            </div>
            <div class="plate">
                <h2>Projects</h2>
                @if (_p.Projects.Count == 0) { <div class="empty">Not assigned to any plan.</div> }
                @foreach (var pr in _p.Projects) { <div><a href="/projects/@pr.ProjectId"><b>@pr.ProjectNo</b></a> <span class="muted">@pr.Name</span></div> }
                <h2 style="margin-top:14px">Leave</h2>
                @foreach (var l in _p.Leave) { <div>@l.FromDate.ToString("dd MMM yy") – @l.ToDate.ToString("dd MMM yy") <span class="muted">@l.Kind</span> <button class="icon" @onclick="() => RemoveLeave(l.Id)">✕</button></div> }
                <div class="form-row" style="margin-top:8px">
                    <div class="field"><label>From</label><input type="date" @bind="_leaveFrom" /></div>
                    <div class="field"><label>To</label><input type="date" @bind="_leaveTo" /></div>
                    <button class="secondary" @onclick="AddLeave">Add leave</button>
                </div>
            </div>
        </div>

        <div class="plate" style="margin-top:16px">
            <h2>Capacity · next months</h2>
            <table class="grid"><thead><tr><th>Month</th><th class="num">Available</th><th class="num">Leave</th><th class="num">Allocated</th><th class="num">Load</th><th>By project</th></tr></thead><tbody>
            @foreach (var c in _p.Capacity)
            {
                <tr><td>@c.Month.ToString("MMM yyyy")</td><td class="num">@c.AvailableHours.ToString("0")</td><td class="num">@c.LeaveHours.ToString("0")</td><td class="num">@c.AllocatedHours.ToString("0")</td>
                    <td class="num"><span class="heat @c.Band">@((c.LoadVsPlanned * 100).ToString("0"))%</span></td><td class="muted">@string.Join(", ", c.ByProject.Select(b => b.ProjectNo + " " + b.Hours.ToString("0") + "h"))</td></tr>
            }
            </tbody></table>
        </div>

        <div class="plate" style="margin-top:16px">
            <h2>Rating history</h2>
            <table class="grid"><thead><tr><th>When</th><th>Skill</th><th>Change</th><th>By</th><th>Reason</th></tr></thead><tbody>
            @foreach (var t in _history)
            { <tr><td class="muted">@t.AtUtc.ToString("dd MMM yy HH:mm")</td><td>@t.Skill</td><td>@(t.OldRating?.ToString() ?? "–") → <b>@t.NewRating</b></td><td>@t.ChangedBy</td><td class="muted">@t.Reason</td></tr> }
            </tbody></table>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private PersonProfile? _p;
    private List<(DateTime AtUtc, string Skill, int? OldRating, int? NewRating, string ChangedBy, string? Reason)> _history = [];
    private int _rateSkill, _rating, _levels = 5; private string _reason = "";
    private DateTime _leaveFrom = DateTime.Today, _leaveTo = DateTime.Today;

    protected override async Task LoadAsync()
    {
        var asOf = AsOf;
        _p = await Q(sp => sp.GetRequiredService<PeopleService>().GetProfileAsync(Id, asOf));
        var rows = await Q(sp => sp.GetRequiredService<EosDbContext>().SkillTransactions.AsNoTracking().Where(t => t.PersonId == Id)
            .Join(sp.GetRequiredService<EosDbContext>().Skills, t => t.SkillId, s => s.Id, (t, s) => new { t.AtUtc, s.Name, t.OldRating, t.NewRating, t.ChangedBy, t.Reason })
            .OrderByDescending(x => x.AtUtc).Take(50).ToListAsync());
        _history = rows.Select(x => (x.AtUtc, x.Name, x.OldRating, x.NewRating, x.ChangedBy, x.Reason)).ToList();
        var resolver = await Q(sp => sp.GetRequiredService<SettingsStore>().LoadResolverAsync());
        _levels = resolver.Get<int>(EOS.Domain.Settings.SettingKeys.SkillLevelCount, EOS.Domain.Settings.SettingsResolver.Chain(), asOf);
    }

    private void StartRate(int skillId, int current) { _rateSkill = skillId; _rating = current; _reason = ""; }

    private async Task SaveRating()
    {
        var skill = _rateSkill; var rating = _rating; var reason = _reason;
        await Act((sp, a) => sp.GetRequiredService<SkillRatingService>().SetRatingAsync(Id, skill, rating, a, reason), "Rating saved.");
        _rateSkill = 0;
    }

    private Task AddLeave() => Act((sp, a) => sp.GetRequiredService<PeopleService>().AddLeaveAsync(
        new Leave { PersonId = Id, FromDate = DateOnly.FromDateTime(_leaveFrom), ToDate = DateOnly.FromDateTime(_leaveTo) }, a), "Leave added.");
    private Task RemoveLeave(int id) => Act((sp, a) => sp.GetRequiredService<PeopleService>().RemoveLeaveAsync(id, a));
}
