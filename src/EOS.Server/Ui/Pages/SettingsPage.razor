    private void Discard() { _edit.Clear(); _errors.Clear(); _reason = ""; }

    private async Task SaveAll()
    {
        var edits = _edit.ToList(); var scope = ScopeObj(); var reason = _reason.Trim(); var from = DateOnly.FromDateTime(_from);
        await Act(async (sp, actor) =>
        {
            var store = sp.GetRequiredService<SettingsStore>();
            foreach (var (key, json) in edits) await store.SetAsync(key, scope, json, from, actor, reason);
        }, $"Saved {edits.Count} setting(s).");
        _edit.Clear(); _errors.Clear(); _reason = "";
    }

    private async Task Reset(SettingMeta m)
    {
        if (!await Confirm($"Go back to {(_scope == "global" ? "the default" : "the inherited value")} for “{m.Label}”?")) return;
        _edit.Remove(m.Key); _errors.Remove(m.Key);
        var scope = ScopeObj(); var from = DateOnly.FromDateTime(_from);
        await Act((sp, a) => sp.GetRequiredService<SettingsStore>().ClearAsync(m.Key, scope, from, a, "reset from the settings screen"), "Reset.");
    }

    private void ToggleCalDay(int day) { if (!_calDays.Remove(day)) _calDays.Add(day); }

