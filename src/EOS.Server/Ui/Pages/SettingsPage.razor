        new WorkCalendarDef { Id = c.Id, Name = c.Name, HoursPerDay = _calHours, WorkDays = string.Join(',', _calDays.OrderBy(d => d == 0 ? 7 : d)), IsDefault = c.IsDefault }, a), "Calendar saved.");
