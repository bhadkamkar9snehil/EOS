        new CustomFieldDefinition { EntityKind = _fEntity, Key = _fKey.Trim(), Label = _fLabel.Trim(), Type = _fType, Options = string.IsNullOrWhiteSpace(_fOptions) ? null : _fOptions }, a), "Field added.");

    private Task MapAlias(int aliasId, object? v) => Act(async (sp, a) =>
    {
        var db = sp.GetRequiredService<EosDbContext>();
        var alias = await db.PersonAliases.SingleAsync(x => x.Id == aliasId);
        alias.PersonId = int.TryParse(v?.ToString(), out var pid) && pid != 0 ? pid : null;
        db.AuditEvents.Add(new AuditEvent { AtUtc = DateTime.UtcNow, Actor = a, Action = "alias.map", SubjectKind = "alias", SubjectId = alias.Alias, Detail = $"-> person {alias.PersonId}" });
        await db.SaveChangesAsync();
    }, "Alias mapped. Re-run the import to apply it.");

    private async Task Revoke(int id)
    {
        if (await Confirm("Revoke this token? Anything using it stops working immediately.")) await Act((sp, a) => sp.GetRequiredService<TokenService>().RevokeAsync(id, a), "Token revoked.");
    }
    private Task NewToken() => Act(async (sp, a) => { _newToken = await sp.GetRequiredService<TokenService>().CreateAsync(_tokenName.Trim(), a); _tokenName = ""; });
    private Task Backup() => Act(async (sp, a) => await sp.GetRequiredService<BackupService>().CreateAsync(Options.BackupDirectory, a), "Backup created.");
