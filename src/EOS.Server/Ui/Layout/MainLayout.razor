@inherits LayoutComponentBase
@inject UiState State
@implements IDisposable

<div class="shell">
    <header class="band">
        <a class="brand" href="/" aria-label="EOS home">EOS</a>
        <span class="spacer"></span>
        <div class="asof">
            <label for="asof">As of</label>
            <input id="asof" type="date" value="@State.AsOf.ToString("yyyy-MM-dd")" @onchange="OnAsOf" />
        </div>
        <form class="signout" method="post" action="/auth/logout" onsubmit="eosSignOut(event)"><button type="submit">Sign out</button></form>
    </header>
    <nav class="navband" aria-label="Main">
        <NavLink href="/" Match="NavLinkMatch.All">Command Center</NavLink>
        <NavLink href="/projects">Projects</NavLink>
        <NavLink href="/gantt">Gantt</NavLink>
        <NavLink href="/capacity">Capacity</NavLink>
        <NavLink href="/whatif">What-if</NavLink>
        <NavLink href="/demand">Demand</NavLink>
        <span class="sep"></span>
        <NavLink href="/people">People</NavLink>
        <NavLink href="/skills">Skills</NavLink>
        <NavLink href="/training">Training</NavLink>
        <span class="sep"></span>
        <NavLink href="/infrastructure">Infrastructure</NavLink>
        <NavLink href="/alerts">Alerts</NavLink>
        <NavLink href="/reports">Reports</NavLink>
        <NavLink href="/imports">Imports</NavLink>
        <NavLink href="/settings">Settings</NavLink>
    </nav>
    <main>@Body</main>
    @if (State.Toast is not null)
    {
        <div class="toast @(State.ToastIsError ? "error" : "")" role="status" @onclick="State.ClearToast">@State.Toast</div>
    }
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void OnAsOf(ChangeEventArgs e) { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) State.SetAsOf(d); }
    public void Dispose() => State.Changed -= OnChanged;
}
